                                    <label class="px-0 pt-2">
                                        @Html.RadioButtonFor(model => model.TypePayment, 1, new { onchange = $"_onChangeTypePayment(this, '{AppProcessor.Messagor.GetMessage("TypePayment_Advance")}', '#Payment #TypePaymentName')" })
                                        <span class="badge bgc-warning brc-warning text-white badge-lg arrowed arrowed-in-right mb-1">
