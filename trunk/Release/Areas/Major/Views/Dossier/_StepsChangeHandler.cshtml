@using TSFramework.App.Processors
@model Cores.Major.Models.MajorDossierTaskModel

@Html.HiddenFor(model => model.ProcUnionId)
@Html.HiddenFor(model => model.AllowChangeHandler)
@Html.HiddenFor(model => model.UnionHandle)
@Html.HiddenFor(model => model.UnionHandleName)

<div class="card ccard" id="StepChangeHandles">
    <div class="card-header">
        <h5 class="card-title text-120 text-primary-d2">
            <i class="fas fa-user-check"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Step_AssigneeToHandler")
        </h5>

        <div class="card-toolbar">

            <div class="card-toolbar no-border">
                <a href="#" data-action="toggle" class="card-toolbar-btn btn btn-sm radius-1 btn-outline-default mx-2px">
                    <i class="fa fa-angle-double-up w-2 mx-1px"></i>
                </a>
            </div>
        </div>
    </div><!-- /.card-header -->
    <ul class="nav nav-tabs nav-tabs-simple nav-tabs-scroll border-b-1 brc-dark-l3 mx-0 mx-md-0 px-3 px-md-1 pt-2px" role="tablist">
        @{
            int iIdx = 1;
            foreach (var stepChangeHandle in Model.ListStepsChangeHandler)
            {
                <li class="nav-item mr-1">
                    <a class="nav-link @(iIdx == 1 ? "active" : "")  p-3 bgc-h-primary-l4 radius-0" id="step@(iIdx)-tab-btn" data-toggle="tab" href="#step@(iIdx)" role="tab" aria-controls="step@(iIdx)" aria-selected="true">
                        <i class="fas fa-tasks text-success mr-3px"></i>
                        @stepChangeHandle.StepName
                    </a>
                </li>
                iIdx += 1;
            }
        }

    </ul>

    <div class="card-body px-0 py-2">
        <div class="tab-content tab-sliding border-0 px-0" style="min-height: calc(90vh - 300px);">
            @{
                iIdx = 1;
                foreach (var stepChangeHandle in Model.ListStepsChangeHandler)
                {
                    <div class="@(stepChangeHandle.StepId) tab-pane @(iIdx == 1 ? "show active" : "") px-25" id="step@(iIdx)" role="tabpanel" aria-labelledby="step@(iIdx)-tab-btn">
                        <div class="form-group row">
                            <div class="col-md-8">
                                <label class="">
                                    @Html.CheckBox($"StepHandlers[{stepChangeHandle.StepId}].AllowSwitchHandler", false, new{ @class = "checkbox mr-2" })
                                    @Html.Label($"StepHandlers[{stepChangeHandle.StepId}].AllowSwitchHandler", AppProcessor.Messagor.GetMessage("Step_AllowSwitchHandler"), new{ @class = "font-bold" })
                                </label>
                            </div>
                        </div>
                        <hr class="border-none border-t-3 brc-grey-l2 border-double"/>

                        <div class="form-group row">
                            <div class="col-12 mt-4 mt-lg-0">
                                <div class="card ccard radius-t-0 h-100">
                                    <div class="position-tl w-102 border-t-3 brc-primary-tp3 ml-n1px mt-n1px"></div><!-- the blue line on top -->

                                    <div class="card-header brc-secondary-l3 pb-3">
                                        <h5 class="card-title mb-2 mb-md-0 text-dark-m3">
                                            Nhân viên thực hiện
                                        </h5>

                                        <div class="card-toolbar no-border pl-0 pl-md-2">
                                        </div>
                                    </div>

                                    <div class="card-body bgc-white p-0 pb-15">
                                        <div class="form-group row my-3">
                                            <label class="col-sm-2 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("Department_Title")</label>
                                            <div class="col-md-6">
                                                @Html.Select($"StepHandlers[{stepChangeHandle.StepId}].DeptHandle", "", "", Model.ListUnions, new { @class = "form-control col-md-12 none-select2", onchange = $"_onLoadStaffViaUnion(this, '#step{iIdx}_Staffs','{stepChangeHandle.StepId}', 'StepHandlers[{stepChangeHandle.StepId}].DeptHandleName')" })
                                                @Html.Hidden($"StepHandlers[{stepChangeHandle.StepId}].DeptHandleName")
                                            </div>
                                        </div>

                                        <hr class="border-none border-t-3 brc-grey-l2 border-double">

                                        <div class="card-body pt-2 pb-1" id="step@(iIdx)_Staffs">
                                            @{
                                                foreach (var staff in Model.ListStaffs)
                                                {
                                                    <div class="task-item d-flex align-items-center border-t-1 bgc-h-green-l3 brc-secondary-l3 px-2">
                                                        <label class="">
                                                            <input name="StepHandlers[@(stepChangeHandle.StepId)].HandledBy" type="radio" class="align-middle ml-2 mr-25" id="@(stepChangeHandle.StepId).staff-@staff.UserName" value="@staff.UserName"/>
                                                        </label>
                                                        @Html.Hidden($"StepHandlers[{stepChangeHandle.StepId}].HandledByName", staff.FullName)

                                                        <label class="flex-grow-1 mr-3 py-3 text-105 text-500" for="@(stepChangeHandle.StepId).staff-@staff.UserName">
                                                            <span class="align-middle">
                                                                @staff.FullName
                                                            </span>
                                                        </label>

                                                        <span class="badge bgc-danger-l3 border-r-2 radius-r-0 brc-danger-m2 text-danger-d1 ml-1 mr-2 text-90">
                                                            @staff.PositionName
                                                        </span>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div><!-- /.card-body -->
                                </div>
                            </div>
                        </div>
                    </div>
                    iIdx += 1;
                }
            }

        </div>
    </div>
</div><!-- /.card -->

<script type="text/javascript">

    //debugger;

    $(document).ready(function () {

        setTimeout(function () {
            $.each($('#StepChangeHandles .tab-pane.show.active select'), function (idx, selc) {
                _initSelect($(selc));
            });
        }, 1000);

        $('#StepChangeHandles a[data-toggle="tab"]').on('shown.bs.tab', function () {
            var tabActivePanel = $(this).attr("href");

            _initSelect(tabActivePanel + " select[id*=DeptHandle]");
            //_initSelect(tabActivePanel + " select#PositionId");
        });
    });

    function _onLoadStaffViaUnion(cbbUnions, eleStaffs, stepId, eleUnionName) {

        $('[name="' + eleUnionName +'"]').val($(cbbUnions).children("optgroup").children("option:selected").text());
        var unionId = $(cbbUnions).val();

        var urlStaffsViaUnionAndPosition ="@Url.Action("StaffsViaUnion", "Dossier", new { area = "Major" })?unionId=" + unionId;

        $.ajax({
            type: "GET",
            url: urlStaffsViaUnionAndPosition,
            dataType: "JSON",
            success: function (response) {
                $(eleStaffs).empty();
                $.each(response, function (index, staff) {
                    var staffHtmlTemplate = '<div class="task-item d-flex align-items-center border-t-1 bgc-h-green-l3 brc-secondary-l3 px-2"><label class=""><input name="StepHandlers[{0}].HandledBy" type="radio" class="align-middle ml-2 mr-25" id="{0}.staff-{1}" value="{1}" /></label><label class="flex-grow-1 mr-3 py-3 text-105 text-500" for="{0}.staff-{1}"><span class="align-middle">{2}</span></label><span class="badge bgc-danger-l3 border-r-2 radius-r-0 brc-danger-m2 text-danger-d1 ml-1 mr-2 text-90">{3}</span></div >'.format(stepId, staff.UserName, staff.FullName, staff.PositionName);
                $(eleStaffs).append(staffHtmlTemplate);
                });
            }
        });
    }


</script>