@using TSFramework.App.Processors
@model Cores.Major.Models.MajorContractModel

@{
    ViewBag.Title = Html.Raw($"{AppProcessor.Messagor.GetMessage("Contract_Title")} - {Model.ContractTypeName} [{Model.ContractNo}/{Model.ContractSignal}]");
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    info
}

@section FormIcon{
    <i class="fas fa-eye"></i>
}

@section FormBody{

    <div class="row modal-body py-0" id="bodyForm">
        <div class="col-12">
            <a class="btn px-4 btn-outline-success mb-1" name="DownloadRefDoc" onclick="_onDownloadDoc(this);" href="@Url.Action("RenderContract", "Contract", new{ contractFile = Model.ContractFile}, Request.Url.Scheme)"><i class="fas fa-cloud-download-alt"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Download")</a>

            <a href="javascript:void(0);" onclick="_onFullscreen();" class="btn px-4 btn-outline-primary mb-1">
                <i class="fa fa-expand d-n-active"></i> Toàn màn hình
            </a>
        </div>
        <div class="col-12 table-responsive-md" id="ContractViewer">
            <iframe src='' width='100%' height='100%' style="min-height:calc(100vh - 200px);" frameborder='0'></iframe>
        </div>
    </div>

    <script type="text/javascript">
        //debugger;

        var appViewerUrl = "@Html.Raw(ViewBag.AppViewerUrl)";
        var docUrl = appViewerUrl.format("@Url.Action("RenderContract", "Contract", new{ contractFile = Model.ContractFile }, Request.Url.Scheme)");

        $(document).ready(function () {
            //_onWaiting();
            $("#ContractViewer iframe").attr("src", docUrl);
            $('#ContractViewer iframe').on('load', function () {
                _endWaiting();
                _onFullscreen();
            });
        });

        function _onFullscreen() {
            var iframe = document.querySelector('#ContractViewer iframe');
            // Do fullscreen
            if (iframe.requestFullscreen) {
                iframe.requestFullscreen();
            } else if (iframe.webkitRequestFullscreen) {
                iframe.webkitRequestFullscreen();
            } else if (iframe.mozRequestFullScreen) {
                iframe.mozRequestFullScreen();
            } else if (iframe.msRequestFullscreen) {
                iframe.msRequestFullscreen();
            }
        }

    </script>
}
@section SubmitControl{

}

