@using TSFramework.App.Processors
@model Cores.Major.Models.MajorContractModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Contract_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Contract", new { area = "Major" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Contract_OnProcessSuccess(data, 'DeleteContract')",
        OnBegin = "_onWaiting()"
    }, new { @class = "form-horizontal", id = "DeleteContract" }))
    {
        <div id="bodyForm">
	        @Html.Partial("_DeleteBody")
        </div>
    }
}