@using TSFramework.App.Processors
@model Cores.Cate.Models.CateContentLandModel

@Html.AntiForgeryToken()

@Html.HiddenFor(model => model.ContentLandId)

<div class="form-group row">
    @Html.TitleFor(model => model.ContractTypeId, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-8">
        @Html.DropDownListFor(model => model.ContractTypeId, new SelectList(Model.ListTypeContracts, "Value", "Text"), "", new { id = "ContractTypeDropdown", @class = "form-control" })
        @Html.ValidationMessageFor(model => model.ContractTypeId, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row">
    @Html.TitleFor(model => model.ContentLandName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-8">
        @Html.TextAreaFor(model => model.ContentLandName, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("ContentLand_Label_Name"), rows = 3 })
        @Html.ValidationMessageFor(model => model.ContentLandName, "", new { @class = "text-danger" })
    </div>
</div>
