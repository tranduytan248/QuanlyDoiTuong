@using Modules.Major.Cores.Enums
@using Cores.Major.Enums
@using TSFramework.App.Processors
@model Cores.Major.Models.SAVComplainModel

@Html.AntiForgeryToken()

<style type="text/css">
    .ace-file-container {
        max-height: calc(70vh);
        overflow-x: auto;
        width: 100%;
    }

    #suggestionsContainer {
        position: absolute !important;
        z-index: 1000 !important;
    }

    #suggestionsList {
        display: block !important;
        max-height: 200px !important; /* Điều chỉnh chiều cao tối đa nếu cần thiết */
        overflow-y: auto !important;
    }
</style>

<div id="Complain" class="row">
	<div class="col-12 col-md-6">
		@Html.HiddenFor(model => model.ComplainId)
		@Html.HiddenFor(model => model.SourceId)

        @* lưu tọa độ *@
        @*@Html.HiddenFor(model => model.Latitude, new { @id = "Latitude" })
        @Html.HiddenFor(model => model.Longitude, new { @id = "Longitude" })*@

		<div class="form-group row">
			<span class="has-float-label input-floating-label col-12 text-danger-d2 brc-danger-m1">
				@Html.TextAreaFor(model => model.Title, new { @class = "form-control shadow-none", placeholder = AppProcessor.Messagor.GetMessage("Complain_Name") })
				@Html.TitleFor(model => model.Title, new { @class = "floating-label text-grey-m3 text-500" })
			</span>
			@Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger col-12" })
		</div>
		<div class="form-group row">
			<span class="has-float-label input-floating-label col-12 text-danger-d2 brc-danger-m1">
				@Html.TextAreaFor(model => model.Contents, new { @class = "form-control shadow-none", placeholder = AppProcessor.Messagor.GetMessage("Complain_Contents") })
				@Html.TitleFor(model => model.Contents, new { @class = "floating-label text-grey-m3 text-500" })
			</span>
            @Html.ValidationMessageFor(model => model.Contents, "", new { @class = "text-danger col-12" })
		</div>
		
		<div class="form-group row">
			<span class="has-float-label input-floating-label col-8 brc-danger-m1">
				@Html.SelectFor(model => model.ReflectBy, Model.ListUnionReflects, "", new { disabled = true, @class = "form-control col-11", placeholder = Html.DisplayNameFor(model => model.ReflectBy), onchange = "_onChangeCombo(this, '#Complain #ReflectName', true)" })
				@Html.TitleFor(model => model.ReflectBy, new { @class = "floating-label text-grey-m3 text-500" })
			</span>
			<div class="col-4"></div>
			@Html.HiddenFor(model => model.ReflectBy)
			@Html.HiddenFor(model => model.ReflectName)
		</div>

		@{
			if (Model.ComplainId != null && Model.ComplainId != Guid.Empty)
			{
				<hr />
				<div class="form-group row">
					<span class="has-float-label input-floating-label col-12 text-blue-d2 brc-blue-m1">
						@Html.TextAreaFor(model => model.Reason, new { @class = "form-control shadow-none", placeholder = AppProcessor.Messagor.GetMessage("Reason_Title") })
						@Html.TitleFor(model => model.Reason, new { @class = "floating-label text-grey-m3 text-500" })
					</span>
					@Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger px-3" })
				</div>}
		}
		
		<hr />
		<div class="form-group row">
			<div class="col-md-12">
				@Html.TextBoxFor(model => model.RefImages, new { type = "file", multiple = true, @class = "ace-file-input" })
			</div>
		</div>
		@{
			if (Model.ListRefImgs.Count > 0)
			{
				<hr />
				<div class="row mx-0">
					@{
						foreach (var k in Model.ListRefImgs.Keys)
						{
							int idx;
							if (k == 0)
							{
								idx = 0;
								<!-- column 1 -->
								<div class="col-6 col-sm-4 col-md-3 text-center px-2">
									@foreach (var img in Model.ListRefImgs[k])
									{
										<div class="pos-rel d-style my-3 radius-1 shadow-sm overflow-hidden bgc-brown-m3" id="@img.FileId">
											<a href="#" class="show-lightbox">
												<img alt="Hình ảnh @($"{k}{idx}")" src="@img.FilePath" class="w-100 d-zoom-2 " data-size="@img.Dimensions" />
											</a>
											<div class="mt-hover position-tl w-100 bgc-black-tp5 p-25">
												<div class="d-flex justify-content-center action-buttons text-110">
													<a href="/Cate/Doc/DeleteDoc?fileId=@img.FileId" class="mx-2" data-modal="true" data-modal-id="DeleteDoc">
														<i class="fa fa-times text-danger-m2"></i>
													</a>
												</div>
											</div>
										</div>
										idx += 1;
									}
								</div>
							}
							else if (k == 1)
							{
								idx = 0;
								<!-- column 2 -->
								<div class="col-6 col-sm-4 col-md-3 text-center px-2">
									@foreach (var img in Model.ListRefImgs[k])
									{
										<div class="pos-rel d-style my-3 radius-1 shadow-sm overflow-hidden bgc-brown-m3" id="@img.FileId">
											<a href="#" class="show-lightbox">
												<img alt="Hình ảnh @($"{k}{idx}")" src="@img.FilePath" class="w-100 d-zoom-2 " data-size="@img.Dimensions" />
											</a>
											<div class="mt-hover position-tl w-100 bgc-black-tp5 p-25">
												<div class="d-flex justify-content-center action-buttons text-110">
													<a href="/Cate/Doc/DeleteDoc?fileId=@img.FileId" class="mx-2" data-modal="true" data-modal-id="DeleteDoc">
														<i class="fa fa-times text-danger-m2"></i>
													</a>
												</div>
											</div>
										</div>
										idx += 1;
									}
								</div>
							}
							else if (k == 2)
							{
								idx = 0;
								<!-- column 3 -->
								<div class="col-6 col-sm-4 col-md-3 text-center px-2">
									@foreach (var img in Model.ListRefImgs[k])
									{
										<div class="pos-rel d-style my-3 radius-1 shadow-sm overflow-hidden bgc-brown-m3" id="@img.FileId">
											<a href="#" class="show-lightbox">
												<img alt="Hình ảnh @($"{k}{idx}")" src="@img.FilePath" class="w-100 d-zoom-2 " data-size="@img.Dimensions" />
											</a>
											<div class="mt-hover position-tl w-100 bgc-black-tp5 p-25">
												<div class="d-flex justify-content-center action-buttons text-110">
													<a href="/Cate/Doc/DeleteDoc?fileId=@img.FileId" class="mx-2" data-modal="true" data-modal-id="DeleteDoc">
														<i class="fa fa-times text-danger-m2"></i>
													</a>
												</div>
											</div>
										</div>
										idx += 1;
									}
								</div>
							}

						}
					}

				</div>

			}
		}

	</div>
	<div class="col-12 col-md-6">
		<div class="form-group row">
			<label for="Status" class="col-sm-3 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("Complain_ResultChecking")</label>
			<label class="col-form-label col-4">
				@Html.RadioButtonFor(model => model.Status, (int)EnumComplainHandleStatus.ForwardToHandle, new { disabled = true, id = "ForwardToHandle", onchange = "_onChangeStatus(this);" })
				@Html.Label(AppProcessor.Messagor.GetMessage("HandleComplain_ForwardToHandle"), new { @for = "ForwardToHandle" })
			</label>
		</div>
		<div class="form-group row">
			@Html.TitleFor(model => model.Note, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
			<div class="col-md-8">
				@Html.TextAreaFor(model => model.Note, new { rows = 2, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Complain_Note") })
				@Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger" })
			</div>
		</div>
		<div class="form-group row">
			<label for="RefFiles" class="col-sm-3 col-form-label text-sm-right pr-0 font-bold text-danger">@AppProcessor.Messagor.GetMessage("Doc_Ref") (*)</label>
			<div class="col-md-8">
				@Html.FileFor(model => model.RefFiles, ".doc,.docx,.pdf", false, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Form_RefDocs") })
				@Html.ValidationMessageFor(model => model.RefFiles, "", new { @class = "text-danger" })
			</div>
		</div>

        <div class="form-group row">
            <label for="" class="col-sm-3 col-form-label text-sm-right pr-0 font-bold mt-2">Địa chỉ vi phạm</label>
            <div class="col-md-8 input-floating-label text-blue-d2 brc-blue-m1">
                <input id="searchInput" type="text" placeholder="Tìm kiếm địa chỉ..." class="form-control shadow-none" />
                <span class="floating-label text-grey-m3">
                    Tìm kiếm địa chỉ... 
                </span>
                <!-- Container cho danh sách gợi ý -->
                <div id="suggestionsContainer" class="dropdown">
                    <ul id="suggestionsList" class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                        <!-- Danh sách gợi ý sẽ được hiển thị ở đây -->
                    </ul>
                </div>
            </div>
            @*<div class="col-md-3 mt-3">
                <button id="searchButton" class="btn btn-outline-primary" type="button">Tìm kiếm</button>
            </div>*@
            @*<span class="col-sm-3"></span>*@
            <div class="col-md-12 mt-3 border border-2 brc-black-m2">
                <!-- Bản đồ sẽ được hiển thị ở đây -->
                <div id='map_canvas' style="width:100%; height: 300px;"></div>
                <!-- Thêm hai thẻ div để hiển thị tọa độ -->
                <div class="col-md-12 row mt-3 mb-3 font-bold">
                    <div class="col-md-6 text-center" id="latitudeDisplay">Vĩ độ: </div>
                    <div class="col-md-6 text-center" id="longitudeDisplay">Kinh độ: </div>
                </div>
                <div class="col-md-12 justify-content-center">
                    <button type="button" class="btn btn-outline-primary col-md" id="viewOnGoogleMapsBtn">Xem địa chỉ đã chọn trên Google Maps</button>
                </div>
                <p class="mt-3">* Hướng dẫn: Giữ và kéo điểm đánh dấu đến vị trí để thực hiện lấy tọa độ </p>
            </div>
        </div>

	</div>
</div>

