        @Html.DropDownListFor(model => model.ConstructionParticipantId, new SelectList(Model.ConstructionParticipants, "ConstructionParticipantId", "ConstructionParticipantName"), "", new { @class = "form-control col-12", placeholder = Html.DisplayNameFor(model => model.ConstructionParticipantId) })
