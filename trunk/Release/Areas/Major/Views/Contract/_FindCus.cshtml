@using TSFramework.App.Processors
@model Modules.Major.Areas.Major.Models.SearchCustomerModel

@{
    ViewBag.Title = Html.Raw($"{AppProcessor.Messagor.GetMessage("Button_Search")} {AppProcessor.Messagor.GetMessage("Customer_Title")}");
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    info
}

@section FormIcon{
    <i class="fas fa-user-tie"></i>
}

@section FormBody{
    <div class="row modal-body" id="bodyForm">
        <div class="col-sm-12">
            @Html.Partial("_SearchCus")
        </div>
        <div class="col-sm-12">
            <div class="mt-3">
                <div class="card dcard">
                    <div class="p-2 table-responsive-md">
                        <table id="Customers" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                            <thead class="sticky-nav text-secondary-m1 text-uppercase text-85">
                                <tr>
                                    <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                                    <th>@AppProcessor.Messagor.GetMessage("Customer_Label_CusType")</th>
                                    <th>@AppProcessor.Messagor.GetMessage("Customer_Label_CusName")</th>
                                    @if (Model.TypeCus == "CONSUMER")
                                    {
                                        <th>@AppProcessor.Messagor.GetMessage("Customer_IdentifierNo")</th>
                                    }
                                    else
                                    {
                                        <th>@AppProcessor.Messagor.GetMessage("Customer_TaxCode")</th>
                                    }
                                    <th style="width:30%">@AppProcessor.Messagor.GetMessage("Customer_Label_Address")</th>
                                    <th>@AppProcessor.Messagor.GetMessage("Customer_Label_PhoneNumber")</th>
                                    <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        //debugger;

        var _CustomerActionURLs = {
            Customer_GetData: "@Url.Action("GetListCustomer", "Contract", new { area = "Major" })"
        };
        var _tableCustomer;
        $(document).ready(function () {
            initTableCustomer();
        });

        function initTableCustomer() {
            _tableCustomer = $("#Customers").DataTable({
                "Responsive": true,
                "language": {
                    "processing": "<div class='overlay'><i class='fas fa-cog fa-spin'></i></div>"
                },
                "lengthChange": false,
                "info": false,
                "pageLength": 50,
                "searching": false,
                "processing": true,
                "serverSide": true,
                "autoWidth": false,
                "ordering": false,
                "ajax":
                {
                    "url": _CustomerActionURLs.Customer_GetData,
                    "type": "POST",
                    "dataType": "JSON",
                    "data": {
                        "Keyword": function () {
                            return $("#Search #Keyword").val() != null &&
                                $("#Search #Keyword").val().length > 0
                                ? $("#Search #Keyword").val()
                                : "";
                        },
                        "TypeCus": function () {
                            return $("#Search #TypeCus").val() != null &&
                                $("#Search #TypeCus").val().length > 0
                                ? $("#Search #TypeCus").val()
                                : "";
                        },
                    }
                },
                "columns": [
                    {
                        "data": "",
                        "className": "text-center",
                        "defaultContent": "1",
                        "render": function (data, type, row, meta) {
                            return meta.row + 1;
                        }
                    },
                    {
                        "data": "TypeCus",
                        "render": function (data, type, row, meta) {
                            if (data == 'CONSUMER') {
                                return '<span class="badge bgc-info brc-info text-white badge-lg arrowed arrowed-in-right mb-1"><span class="px-3">' + 'Cá nhân' + '</span></span>';
                            } else {
                                return '<span class="badge bgc-success brc-success text-white badge-lg arrowed arrowed-in-right mb-1"><span class="px-3">' + 'Doanh nghiệp' + '</span></span>';
                            }
                        }
                    },
                    {
                        "data": "CusName",
                        "defaultContent": ""
                    },
                    {
                        "data": "TypeCus",
                        "render": function (data, type, row, meta) {
                            // Kiểm tra giá trị của trường TypeCus
                            if (row.TypeCus === 'CONSUMER') {
                                // Nếu TypeCus là 'CONSUMER', hiển thị giá trị của trường IdentifierNo
                                return row.IdentifierNo;
                            } else {
                                // Ngược lại, hiển thị giá trị của trường TaxCode
                                return row.TaxCode;
                            }
                        }
                    },
                    {
                        "data": "Address",
                        "defaultContent": ""
                    },
                    {
                        "data": "Phone",
                        "defaultContent": ""
                    },
                    {
                        "data": "CusId",
                        "style": "width:100px;",
                        "orderable": false,
                        "render": function (data, type, row, meta) {
                            var html = '<span class="d-none d-lg-inline">';
                            if (type === "display") {
                                html = '<button onclick="selectCus(' + meta.row +')" class="btn px-4 btn-lighter-success mr-1 v-hover" title="Chọn" data-rel="tooltip"><i class="fa fa-check-circle text-success text-120"></i></button>'
                            }
                            html += "</span>";

                            return html;
                        }
                    }
                ]
            });
        }

        function ContractCustomer_OnProcessSuccess(response, formId) {
            if (response.status != undefined) {
                if ($("#ModalContent #modal_" + formId + " #chkNotDismissModal").is(":checked")) {
                    if (response.status != undefined) {
                        eval(response.message);
                        _tableCustomer.ajax.reload(null, false);
                        response.status = undefined;
                        var urlAction = $("#ModalContent #modal_" + formId + " form").attr("action");
                        $("#ModalContent #modal_" + formId + " #modal-content").load(urlAction, function (data, textStatus, xhr) {
                            _initElement();
                        });
                    }
                } else {
                    $("#ModalContent #modal_" + formId).modal("hide");
                    $("#ModalContent #modal_" + formId).on("hidden.bs.modal",
                        function () {
                            if (response.status != undefined) {
                                eval(response.message);
                                _tableCustomer.ajax.reload(null, false);
                                response.status = undefined;
                            }
                        });
                }
            } else {
                $("#ModalContent #modal_" + formId + " #bodyForm").html(response);
            }
        }

        function selectCus(rowIdx) {
            var cusData = _tableCustomer.rows().data()[rowIdx];

            var cusPrefix = "@(Model.PrefixCus ?? "")";
            var cusInfo = $("input[type='hidden'][id='CusInfo']").val();
            var arrCusInfos = cusInfo.split(';');
            $.each(arrCusInfos, function (idx, cusInfo) {
                if (cusPrefix.length > 0) {
                    if ($('[name="' + cusPrefix + cusInfo + '"]').is("input[type='text']") ||
                        $('[name="' + cusPrefix + cusInfo + '"]').is("input[type='hidden']") ||
                        $('[name="' + cusPrefix + cusInfo + '"]').is("textarea")) {
                        $('[name="' + cusPrefix + cusInfo + '"]').val(cusData[cusInfo]);
                    }
                    else if ($('[name="' + cusPrefix + cusInfo + '"]').is("input[type='radio']") ||
                        $('[name="' + cusPrefix + cusInfo + '"]').is("input[type='checkbox']")) {
                        $('[name="' + cusPrefix + cusInfo + '"][value="' + cusData[cusInfo] + '"]').prop('checked', true);
                    }
                }
            });

            // Đóng modal
            $("#ModalContent #modal_FindCustomer").modal("hide");
        }
        
    </script>
}
@section SubmitControl{

}