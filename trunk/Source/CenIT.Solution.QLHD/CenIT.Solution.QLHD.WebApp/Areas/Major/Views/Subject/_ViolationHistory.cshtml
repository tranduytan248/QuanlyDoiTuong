@using System
@using System.Collections.Generic
@using System.Linq
@using Cores.Major.Models
@model Cores.Major.Models.MajorSubjectModel
@{
    ViewBag.Title = "Lịch sử vi phạm";
    Layout = "~/Views/Shared/_Form.cshtml";
    var listViolations = Model?.ListViolations ?? new List<MajorSubjectViolationModel>();
}
@section FormType{ danger }
@section FormIcon{ <i class="fa fa-exclamation-triangle"></i> }
@section SubmitControl{ }
@section FormBody{
    <!-- THÔNG TIN ĐỐI TƯỢNG -->
    <div class="card border-1 brc-primary-m3 shadow-sm mb-3">
        <div class="card-body p-2">
            <div class="d-flex align-items-center flex-wrap">
                <img src="@(!string.IsNullOrEmpty(Model?.AvatarUrl) ? Model.AvatarUrl : "/Contents/Base/imgs/avatar-default.png")"
                     onerror="this.src='/Contents/Base/imgs/avatar-default.png';"
                     class="radius-round border-2 brc-primary-m2 mr-3 shadow-sm"
                     style="width:52px;height:52px;object-fit:cover;" />
                <div class="flex-grow-1" style="min-width:180px;">
                    <div class="font-bolder text-dark-m1 text-105">@(Model?.FullName)</div>
                    <div class="text-secondary text-85">
                        <i class="far fa-id-card mr-1"></i>@(Model?.IdentityCardNumber)
                        @if (Model?.DateOfBirth != null)
                        {
                            <span class="ml-2"><i class="far fa-calendar mr-1"></i>@(Model?.DateOfBirthStr)</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (listViolations.Count == 0)
    {
        <div class="alert alert-info py-3 mb-0 text-center">
            <i class="fas fa-info-circle mr-1"></i>
            Chưa ghi nhận lần vi phạm nào mà bạn được phép xem.
        </div>
    }
    else
    {
        <div class="ace-scrollbar" style="max-height: 62vh; overflow-y: auto;">
            @foreach (var violation in listViolations)
            {
                <div class="card border-1 brc-danger-l1 shadow-sm mb-2 violation-history-card">
                    <!-- DÒNG TIÊU ĐỀ: thời gian + lĩnh vực + thao tác -->
                    <div class="card-header bgc-danger-l4 py-2 px-3">
                        <div class="d-flex flex-wrap align-items-center justify-content-between">
                            <div class="d-flex flex-wrap align-items-center">
                                <span class="font-bolder text-danger text-95 mr-3">
                                    <i class="far fa-clock mr-1"></i>@violation.ViolationDateStr
                                </span>
                                @if (!string.IsNullOrEmpty(violation.FieldNames))
                                {
                                    foreach (var fieldName in violation.FieldNames.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="badge badge-primary text-80 mr-1 mb-1">
                                            <i class="fas fa-layer-group mr-1"></i>@fieldName.Trim()
                                        </span>
                                    }
                                }
                            </div>
                            <div class="btn-group btn-group-sm mt-1 mt-sm-0" role="group">
                                @if (violation.IsOwner)
                                {
                                    @* Dung thuoc tinh data-modal de khung TSFramework tu mo modal,
                                       giong cach Html.Button va _renderButton dang lam. *@
                                    <a href="@Url.Action("Edit", "SubjectViolation", new { area = "Major", id = violation.ViolationId })"
                                       class="btn btn-light-primary" title="Chỉnh sửa"
                                       data-modal="true" data-modal-id="EditViolation" data-width="1100px"
                                       data-modal-id-parent="ViolationHistory" data-close-modal-parent="true">
                                        <i class="far fa-edit"></i><span class="d-none d-md-inline ml-1">Sửa</span>
                                    </a>
                                    <a href="@Url.Action("Delete", "SubjectViolation", new { area = "Major", id = violation.ViolationId })"
                                       class="btn btn-light-danger" title="Xoá"
                                       data-modal="true" data-modal-id="DeleteViolation" data-width="800px"
                                       data-modal-id-parent="ViolationHistory" data-close-modal-parent="true">
                                        <i class="far fa-trash-alt"></i><span class="d-none d-md-inline ml-1">Xoá</span>
                                    </a>
                                }
                                else
                                {
                                    <a href="javascript:void(0);" class="btn btn-light-info"
                                       title="Xem chi tiết"
                                       onclick="toggleViolationDetail(this);">
                                        <i class="far fa-eye"></i><span class="d-none d-md-inline ml-1">Xem</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-3 violation-detail-body">
                        <!-- HÀNH VI VI PHẠM -->
                        @if (!string.IsNullOrEmpty(violation.BehaviorNames))
                        {
                            <div class="mb-2">
                                <span class="font-bold text-secondary text-85 d-block mb-1">
                                    <i class="fas fa-gavel mr-1"></i>Hành vi vi phạm:
                                </span>
                                @foreach (var behaviorName in violation.BehaviorNames.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge badge-danger text-85 mr-1 mb-1">@behaviorName.Trim()</span>
                                }
                            </div>
                        }

                        <!-- BIỆN PHÁP XỬ LÝ & GHI CHÚ -->
                        <div class="row">
                            @if (!string.IsNullOrEmpty(violation.TreatmentMeasures))
                            {
                                <div class="col-md-6 mb-2">
                                    <span class="font-bold text-secondary text-85 d-block mb-1">
                                        <i class="fas fa-balance-scale mr-1"></i>Biện pháp xử lý:
                                    </span>
                                    <div class="text-85 text-dark-m2">@violation.TreatmentMeasures</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(violation.Notes))
                            {
                                <div class="col-md-6 mb-2">
                                    <span class="font-bold text-secondary text-85 d-block mb-1">
                                        <i class="far fa-sticky-note mr-1"></i>Ghi chú:
                                    </span>
                                    <div class="text-85 text-dark-m2">@violation.Notes</div>
                                </div>
                            }
                        </div>

                        <!-- VĂN BẢN & HÌNH ẢNH -->
                        @if (!string.IsNullOrEmpty(violation.RelatedDocuments))
                        {
                            <div class="mb-2">
                                <span class="font-bold text-secondary text-85 d-block mb-1">
                                    <i class="fas fa-paperclip mr-1"></i>Văn bản liên quan:
                                </span>
                                @foreach (var doc in violation.ListRelatedDocuments)
                                {
                                    <a href="@doc.Url" target="_blank" class="badge badge-info text-85 mr-1 mb-1 px-2 py-1">
                                        <i class="fas fa-paperclip mr-1"></i>@doc.Name
                                        @if (!string.IsNullOrEmpty(doc.SizeText))
                                        {
                                            <span class="text-80 ml-1">(@doc.SizeText)</span>
                                        }
                                    </a>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(violation.Images))
                        {
                            <div class="mb-2">
                                <span class="font-bold text-secondary text-85 d-block mb-1">
                                    <i class="far fa-images mr-1"></i>Hình ảnh:
                                </span>
                                <div class="d-flex flex-wrap">
                                    @foreach (var imgUrl in violation.Images.Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <a href="@imgUrl" target="_blank" class="mr-1 mb-1">
                                            <img src="@imgUrl" class="radius-1 border-1 brc-grey-m2"
                                                 style="width:52px;height:52px;object-fit:cover;" />
                                        </a>
                                    }
                                </div>
                            </div>
                        }

                        <!-- NGƯỜI BÁO CÁO -->
                        <div class="border-t-1 brc-grey-l2 pt-2 mt-2 text-80 text-secondary">
                            <i class="fas fa-user-shield mr-1"></i>
                            <span class="font-bold">@violation.ReporterName</span>
                            @if (!string.IsNullOrEmpty(violation.ReporterPosition))
                            {
                                <span> &mdash; @violation.ReporterPosition</span>
                            }
                            @if (!string.IsNullOrEmpty(violation.ReporterUnit))
                            {
                                <span> &mdash; @violation.ReporterUnit</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <style>
        .violation-history-card .violation-detail-body { transition: all .2s ease; }
        @@media (max-width: 575.98px) {
            .violation-history-card .card-header .btn-group { width: 100%; margin-top: .35rem; }
        }
    </style>
}
