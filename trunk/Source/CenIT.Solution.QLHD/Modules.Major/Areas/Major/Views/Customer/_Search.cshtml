@using TSFramework.App.Processors
@model Modules.Major.Areas.Major.Models.SearchCustomerModel

<div class="card dcard">
    <div class="card-header">
        <h5 class="card-title text-120 text-primary-d2">@AppProcessor.Messagor.GetMessage("Condition_Title")</h5>
        <div class="card-toolbar no-border">
            <a href="#" data-action="toggle" class="card-toolbar-btn btn btn-sm radius-1 btn-outline-default mx-2px">
                <i class="fa fa-angle-double-up w-2 mx-1px"></i>
            </a>
        </div>
    </div>
    <div class="card-body p-0 collapse show">
        <div class="form-group row col-md-12 form-horizontal mt-3" id="Search">
            <div class="col-md-6">
                @*@Html.TitleFor(model => model.Keyword, new { @class = "col-sm-4 col-form-label text-sm-right pr-0 font-bold" })*@
                @*<div class="input-group">*@
                    @Html.TextBoxFor(model => model.Keyword, new { @class = "form-control col-md-11", placeholder = AppProcessor.Messagor.GetMessage("Customer_Search_Info"), title = AppProcessor.Messagor.GetMessage("Customer_Search_Info"), data_rel = "tooltip" })
                    @*<div class="input-group-append">
                        <button class="btn btn-outline-primary" type="button" onclick="onSearchCus()">
                            <i class="fas fa-search-plus mr-1"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Search")
                        </button>
                    </div>
                </div>*@
            </div>
            <div class="col-md-6 row">
                @*@Html.TitleFor(model => model.TypeCus, new { @class = "col-sm-4 col-form-label text-sm-right pr-0 font-bold" })*@
                <label class="col-lg-4 col-md-4 col-sm-4 my-auto">
                    @Html.RadioButtonFor(model => model.TypeCus, "", new { id = "BusinessCheckBox", @checked = Model.TypeCus == "" })
                    <span class="badge bgc-pink brc-pink text-white badge-lg arrowed arrowed-in-right mb-1">
                        <span class="px-2">@AppProcessor.Messagor.GetMessage("CusType_All")</span>
                    </span>
                </label>
                <label class="col-lg-4 col-md-4 col-sm-4 my-auto">
                    @Html.RadioButtonFor(model => model.TypeCus, "CONSUMER", new { id = "BusinessCheckBox" })
                    <span class="badge bgc-info brc-info text-white badge-lg arrowed arrowed-in-right mb-1">
                        <span class="px-2">@AppProcessor.Messagor.GetMessage("CusType_Consumer")</span>
                    </span>
                </label>
                <label class="col-lg-4 col-md-4 col-sm-4 my-auto">
                    @Html.RadioButtonFor(model => model.TypeCus, "BUSINESS", new { id = "BusinessCheckBox" })
                    <span class="badge bgc-success brc-success text-white badge-lg arrowed arrowed-in-right mb-1">
                        <span class="px-2">@AppProcessor.Messagor.GetMessage("CusType_Business")</span>
                    </span>
                </label>
            </div>
        </div>
        <div class="card-footer">
            <div class="col-md-12 text-center">
                <button type="button" class="btn btn-primary" onclick="onSearchCus();"><i class="fa fa-search-plus"></i>&nbsp;Tìm kiếm</button>
            </div>
        </div>
    </div>
</div>
