                        </div>
                    </div>
                    <div class="form-group row">
                        <label for="HandleInStep" class="col-sm-3 col-form-label text-sm-right pr-0 font-bold text-danger">@AppProcessor.Messagor.GetMessage("Dossier_ForwardToHandle") (*)</label>
                        <div class="col-md-8">
                            @Html.SelectFor(model => model.HandleInStep, Model.ListUnionHandles, "", new { @class = "form-control col-md-12" })
                            @Html.ValidationMessageFor(model => model.HandleInStep, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>*@
            <hr />
            <div class="form-group row">
                @Html.TitleFor(model => model.Reason, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-md-8">
                    @Html.TextAreaFor(model => model.Reason, new { rows = 3, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Reason_Title") })
                    @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
                </div>
            </div>
            <hr />
            <div class="form-group">
                <div class="col-md-12">
                    @Html.TextBoxFor(model => model.RefImages, new { type = "file", multiple = true, @class = "ace-file-input" })
                </div>
            </div>
        </div>
    </div>
</div>

@Html.RenderScripts(ScriptPosition.BodyInside)

<script type="text/javascript">
    $(function () {
        // multiple with image preview
        $('#RefImages').aceFileInput({
            style: 'drop',
            droppable: true,

            container: 'border-1 border-dashed brc-grey-l1 brc-h-info-m2 shadow-sm table-responsive',

            placeholderClass: 'text-125 text-600 text-grey-l1 my-2',
            placeholderText: 'Kéo thả ảnh vào đây hoặc nhấn để chọn',
            placeholderIcon: '<i class="fa fa-cloud-upload-alt fa-3x text-info-m2 my-2"></i>',

            //previewSize: 64,
            thumbnail: 'small',

            //allowExt: 'gif|jpg|jpeg|png|webp|svg',
            //allowMime: 'image/png|image/jpeg',
            allowMime: 'image/*',

            //maxSize: 100000,
        });

        let fileInput = document.getElementById('RefImages')
        fileInput.addEventListener('changed.ace.file', function (e) {
            $(this)[0].files = fileListFrom(e.$_selectedFiles.list);
        });
    });
</script>

<script type="text/javascript">
