    function _onChangeStatus(cbb) {
        var statusId = $(cbb).val();
        var forwardToHandle = @((int)EnumComplainHandleStatus.ForwardToHandle);

        var cbbId = $(cbb).attr('id');
        var handleInfo = $('label[for="{0}"]'.format(cbbId)).text();

        $("#Complain #Note").val(handleInfo);
        if(statusId == forwardToHandle )
        {
            $("#TransferToHandle").removeClass("d-none");
        }
        else{
            $("#TransferToHandle").addClass("d-none");
        }
    }

