                            <span class="input-group-text">
                                <i class="fas fa-calendar-alt"></i>
                            </span>
                        </div>
                        @Html.TextBoxFor(model => model.ApplyFrom, new { @class = "form-control col-md-12 datepicker", placeholder = AppProcessor.Messagor.GetMessage("Dossier_ApplyFrom") })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="input-group">
                        <div class="input-group-prepend">
