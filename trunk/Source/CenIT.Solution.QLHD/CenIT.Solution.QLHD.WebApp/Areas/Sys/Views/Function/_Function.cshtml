@using TSFramework.App.Processors
@model Cores.Sys.Models.Sys.SysFunctionModel

@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(model => model.FunctionId)

<div id="Function">
    <div class="form-group row">
        <div class="col-md-4">
            @Html.TitleFor(model => model.ModuleId, new { @class = "col-form-label pr-0 font-bold" })
            @Html.DropDownListFor(model => model.ModuleId, new SelectList(Model.Modules, "Value", "Text"), AppProcessor.Messagor.GetMessage("AppModule_Label_ModuleName"), new { @class = "form-control col-md-12" })
            @Html.ValidationMessageFor(model => model.ModuleId, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-3">
            @Html.TitleFor(model => model.Area, new { @class = "col-form-label pr-0 font-bold" })
            @Html.TextBoxFor(model => model.Area, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Function_Label_Area") })
            @Html.ValidationMessageFor(model => model.Area, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-5">
            @Html.TitleFor(model => model.Name, new { @class = "col-form-label pr-0 font-bold" })
            @Html.TextBoxFor(model => model.Name, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Function_Label_Function") })
            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-12">
            @Html.TitleFor(model => model.Description, new { @class = "col-form-label pr-0 font-bold" })
            @Html.TextAreaFor(model => model.Description, new { rows = "2", @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Function_Label_Description") })
            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row" id="actions">
        @Html.HiddenFor(model => model.SelectedActions)
        <div class="col-md-12">
            <label class="col-form-label pr-0 font-bold">@AppProcessor.Messagor.GetMessage("Function_Label_Action") </label>
            <div class="col-md-12 row">
                @foreach (var item in Model.Actions)
                {
                    <label class="col-md-3">
                        <input id="@item.Value" type="checkbox" aria-label="@item.Value" onclick="OnEventActionChecked(this)" value="@item.Value" />
                        @item.Text
                    </label>
                }
                @Html.ValidationMessageFor(model => model.Actions, "", new { @class = "text-danger col-md-12" })
            </div>
        </div>
    </div>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#actions input[type=checkbox]').each(function () {
                var actions = $('input[type="hidden"][id="SelectedActions"]').val().split(',');

                var idrole = $(this).val();
                var index = actions.indexOf(idrole);

                if (index > -1) {
                    this.checked = true;
                }
            });
        });

    </script>
</div>