@using TSFramework.App.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("ContractForm_Label_Title");
}

@section PageTitle
{
    @ViewBag.Title
}
@section PageAction
{
    @Html.Button(true, "AddContractForm", Url.Action("Add", new { area = "Cate" }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right", data_width = "860px" })
}
<div class="mt-3">
    <div class="card dcard">
        <div class="p-2 table-responsive-md">
            <table id="DSContractForm" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="nls-w">@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        @*<th>@AppProcessor.Messagor.GetMessage("Code_Title")</th>*@
                        <th>@AppProcessor.Messagor.GetMessage("TemplateName")</th>
                        @*<th>@AppProcessor.Messagor.GetMessage("ContractType")</th>*@
                        <th>@AppProcessor.Messagor.GetMessage("TemplatePath")</th>
                        @*<th>@AppProcessor.Messagor.GetMessage("CreateName")</th>
                            <th>@AppProcessor.Messagor.GetMessage("Status")</th>*@
                        <th class="nls-w">@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="~/Areas/Cate/Views/ContractForm/ContractForm.js"></script>
}