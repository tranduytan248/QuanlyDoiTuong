@using TSFramework.App.Processors
@model Modules.Major.Areas.Major.Models.SearchDossierModel

<div class="card dcard">
    <div class="card-header">
        <h5 class="card-title text-120 text-primary-d2">@AppProcessor.Messagor.GetMessage("Condition_Title")</h5>
        <div class="card-toolbar no-border">
            <a href="#" data-action="toggle" class="card-toolbar-btn btn btn-sm radius-1 btn-outline-default mx-2px">
                <i class="fa fa-angle-double-up w-2 mx-1px"></i>
            </a>
        </div>
    </div>
    <div class="card-body p-0 collapse show">
        <div class="col-md-12 form-horizontal mt-3" id="Search">
            <div class="form-group row">
                <div class="col-md-4">
                    @Html.TextBoxFor(model => model.SearchValue, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("SearchDossier_Value") })
                </div>
                <div class="form-group row col-md-8">
                    @Html.TitleFor(model => model.FromDate, new { @class = "col-sm-2 col-form-label text-sm-right pr-0 font-bold" })
                    <div class="col-4">
                        @Html.TextBoxFor(model => model.FromDate, new { @class = "form-control mr-1 datepicker", placeholder = AppProcessor.Messagor.GetMessage("Common_FromDate") })
                    </div>
                    <label class="col-sm-2 col-form-label text-sm-right pr-0 font-bold" for="FromDate">@AppProcessor.Messagor.GetMessage("Common_ToDate")</label>
                    <div class="col-4">
                        @Html.TextBoxFor(model => model.ToDate, new { @class = "form-control datepicker", placeholder = AppProcessor.Messagor.GetMessage("Common_ToDate") })
                    </div>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-12">
                    @Html.TitleFor(model => model.ListDossierStatusIds, new { @class = "col-form-label pr-0 font-bold" })
                    @{
                        var arrStatus = new Dictionary<string, string> { { "-1", "secondary" }, { "1", "warning" }, { "2", "primary" }, { "3", "success" } };
                        <div class="col-12">
                            @foreach (var status in Model.ListDossierStatus.OrderBy(s => int.Parse(s.Value)))
                            {
                                <label class="px-0 pt-2">
                                    <input name="ListDossierStatusIds" type="checkbox" value="@status.Value">
                                    <span class="badge bgc-@arrStatus[status.Value] brc-@arrStatus[status.Value] text-white badge-lg arrowed arrowed-in-right mb-1">
                                        <span class="px-3">@status.Text</span>
                                    </span>
                                </label>
                            }
                        </div>
                    }
                </div>
                <div class="col-md-12">
                    @Html.TitleFor(model => model.ListHandleTypeIds, new { @class = "col-form-label pr-0 font-bold" })
                    @{
                        var arrHandle = new Dictionary<string, string> { { "1", "success" }, { "2", "danger" }, { "3", "purple" } };
                        <div class="col-12">
                            @foreach (var handle in Model.ListHandleTypes.OrderBy(s => int.Parse(s.Value)))
                            {
                                <label class="px-0 pt-2">
                                    <input name="ListHandleTypeIds" type="checkbox" value="@handle.Value">
                                    <span class="badge bgc-@arrHandle[handle.Value] brc-@arrHandle[handle.Value] text-white badge-lg arrowed arrowed-in-right mb-1">
                                        <span class="px-3">@handle.Text</span>
                                    </span>
                                </label>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="col-md-12 text-center">
                <button type="button" class="btn btn-primary" onclick="_tableDossier.ajax.reload(null, false);"><i class="fa fa-search-plus"></i>&nbsp;Tìm kiếm</button>
            </div>
        </div>
    </div>
</div>
