@using TSFramework.App.Processors
@model Cores.Cate.Models.CatePurPoseModel

@Html.AntiForgeryToken()
@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(model => model.PurPoseId)

<div class="form-group row">
    <div class="col-md-6">
        @Html.TitleFor(model => model.ContractTypeId, new { @class = "col-form-label pr-0 font-bold" })
        @Html.DropDownListFor(model => model.ContractTypeId, new SelectList(Model.ListTypeContracts, "Value", "Text"), "", new { @class = "form-control col-md-12" })
        @Html.ValidationMessageFor(model => model.ContractTypeId, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row">
    <div class="col-md-12">
        @Html.TitleFor(model => model.PurPoseName, new { @class = "col-form-label pr-0 font-bold" })
        @Html.TextAreaFor(model => model.PurPoseName, new { row = 2, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("WorkPurpose") })
        @Html.ValidationMessageFor(model => model.PurPoseName, "", new { @class = "text-danger" })
    </div>
</div>

@Html.RenderScripts(ScriptPosition.BodyInside)