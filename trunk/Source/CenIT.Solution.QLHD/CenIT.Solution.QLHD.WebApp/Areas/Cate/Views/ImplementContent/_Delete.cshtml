@using TSFramework.App.Processors
@model Cores.Cate.Models.CateImplementContentModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("cateImplementContent_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "ImplementContent", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ImplementContent_OnProcessSuccess(data, 'DeleteImplementContent')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model =>model.ImplementContentId)
        @Html.HiddenFor(model => model.WorkContent)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}