@using TSFramework.App.Processors
@model Cores.Major.Models.MajorContractTaskModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("ContractTask_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("DeleteTask", "Contract", new { area = "Major" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Task_OnProcessSuccess(data, 'DeleteTask')",
        OnBegin = "_onWaiting()"
    }, new { @class = "form-horizontal", id = "DeleteTask" }))
    {
        <div id="bodyForm">
	        @Html.Partial("_DeleteTaskBody")
        </div>
    }
}