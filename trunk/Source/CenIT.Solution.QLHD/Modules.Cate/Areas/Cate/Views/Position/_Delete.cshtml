@using TSFramework.App.Processors
@model Cores.Cate.Models.CatePositionModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Position_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Position", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Position_OnProcessSuccess(data, 'DeletePosition')"
    }, new { @class = "form-horizontal", id = "DeletePosition" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.PositionID)
        @Html.HiddenFor(model => model.PositionName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}