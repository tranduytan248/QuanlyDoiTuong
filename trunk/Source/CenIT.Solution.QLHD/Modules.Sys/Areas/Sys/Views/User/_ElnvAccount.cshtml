@using TSFramework.App.Processors
@model Cores.Sys.Models.Sys.SysElnvAccountModel
@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.UserId)
<div class="form-group row">
    <div class="col-md-7">
        @Html.TitleFor(model => model.FullName, new { @class = "col-form-label pr-0 font-bold" })
        @Html.TextBoxFor(model => model.FullName, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("ElnvAccount_FullName"), @readonly = "readonly" })
        @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-5">
        @Html.TitleFor(model => model.EmpAccount, new { @class = "col-form-label pr-0 font-bold" })
        @Html.TextBoxFor(model => model.EmpAccount, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("EmpAccount_Label"), @readonly = "readonly" })
        @Html.ValidationMessageFor(model => model.EmpAccount, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row">
    <div class="col-md-6">
        @Html.TitleFor(model => model.ElnvAccount, new { @class = "col-form-label pr-0 font-bold" })
        @Html.TextBoxFor(model => model.ElnvAccount, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("ElnvAccount_Label") })
        @Html.ValidationMessageFor(model => model.ElnvAccount, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-6">
        @Html.TitleFor(model => model.ElnvACPassword, new { @class = "col-form-label pr-0 font-bold" })
        @Html.TextBoxFor(model => model.ElnvACPassword, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("ElnvACPassword_Label"), type = "password" })
        @Html.ValidationMessageFor(model => model.ElnvACPassword, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row mb-0">
    <div class="col-md-12">
        @Html.TitleFor(model => model.Reason, new { @class = "col-form-label pr-0 font-bold" })
        @Html.TextAreaFor(model => model.Reason, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Reason_Label"), rows = 2 })
        @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
    </div>
</div>
