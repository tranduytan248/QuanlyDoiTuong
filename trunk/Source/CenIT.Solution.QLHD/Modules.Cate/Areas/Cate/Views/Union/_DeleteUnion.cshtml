@using TSFramework.App.Processors
@model Cores.Cate.Models.CateUnionManagerModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), $"{AppProcessor.Messagor.GetMessage("Union_Manager_Title")} - {Model.FullName}");
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("DeleteUnion", "Union", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Union_OnProcessSuccess(data, 'DeleteUnion')"
    }, new { @class = "form-horizontal", id = "DeleteUnion" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.UnionId)
        @Html.HiddenFor(model => model.UnionName)
        @Html.HiddenFor(model => model.UserName)
        @Html.HiddenFor(model => model.FullName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}