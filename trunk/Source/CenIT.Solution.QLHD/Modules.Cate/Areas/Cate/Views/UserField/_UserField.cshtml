@using System
@using System.Collections.Generic
@using System.Linq
@using Cores.Cate.Models
@model Cores.Cate.Models.CateUserFieldModel

@{
    var listFields = ViewBag.ListFields as List<CateFieldModel> ?? Model?.ListFields ?? new List<CateFieldModel>();
    var assignedIds = (Model?.FieldIds ?? string.Empty)
        .Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(item => item.Trim())
        .ToList();
}

@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.UserName)
@Html.Hidden("FieldIds", Model?.FieldIds, new { id = "FieldIds" })

<div class="card border-1 brc-primary-m3 shadow-sm mb-2">
    <div class="card-header bgc-primary-l4 py-2">
        <h6 class="card-title text-primary font-bold mb-0 text-95">
            <i class="fas fa-user-shield mr-2"></i>Người dùng: <span class="text-danger">@Model?.UserName</span>
        </h6>
    </div>
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <label class="font-bold text-dark-m1 text-90 mb-0">
                <i class="fas fa-layer-group mr-1 text-primary"></i>Chọn lĩnh vực người dùng được phép quản lý
            </label>
            <div>
                <button type="button" class="btn btn-xs btn-outline-primary" onclick="toggleAllUserFields(true);">Chọn tất cả</button>
                <button type="button" class="btn btn-xs btn-outline-secondary" onclick="toggleAllUserFields(false);">Bỏ chọn</button>
            </div>
        </div>

        @if (listFields.Count == 0)
        {
            <div class="alert alert-warning py-2 mb-0 text-85">
                <i class="fas fa-exclamation-triangle mr-1"></i>Chưa có lĩnh vực nào trong danh mục.
            </div>
        }
        else
        {
            <div class="row ace-scrollbar" style="max-height: 340px; overflow-y: auto;">
                @foreach (var field in listFields)
                {
                    var isChecked = assignedIds.Contains(field.FieldId.ToString());
                    <div class="col-md-6 mb-2">
                        <div class="border-1 brc-grey-l2 radius-1 p-2 bgc-grey-l5 user-field-card @(isChecked ? "is-selected" : "")" id="card-field-@field.FieldId">
                            <label class="d-flex align-items-center mb-0" style="cursor:pointer;">
                                <input type="checkbox" class="mr-2 js-user-field" id="chk-field-@field.FieldId"
                                       value="@field.FieldId" @(isChecked ? "checked" : "") onchange="onUserFieldChange(this);" />
                                <span>
                                    <span class="font-bold text-dark-m1 text-90">@field.FieldName</span>
                                    @if (!string.IsNullOrEmpty(field.FieldCode))
                                    {
                                        <span class="badge badge-secondary text-80 ml-1">@field.FieldCode</span>
                                    }
                                </span>
                            </label>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="mt-2 text-85 text-secondary">
            Đã chọn: <span class="font-bold text-primary" id="countSelectedFields">@assignedIds.Count</span> lĩnh vực
        </div>
    </div>
</div>

<style>
    .user-field-card.is-selected {
        background-color: #eff6ff !important;
        border-color: #3b82f6 !important;
    }
</style>
