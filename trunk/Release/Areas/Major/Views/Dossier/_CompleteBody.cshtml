@using TSFramework.App.Processors
@model Cores.Major.Models.MajorDossierTaskModel

@Html.AntiForgeryToken()

@Html.HiddenFor(model => model.TaskId)
@Html.HiddenFor(model => model.DossierId)
@Html.HiddenFor(model => model.InStep)
@Html.HiddenFor(model => model.InStepName)
@Html.HiddenFor(model => model.PrevStep)
@Html.HiddenFor(model => model.PrevStepName)
@Html.HiddenFor(model => model.UnionHandle)
@Html.HiddenFor(model => model.HandledBy)
@Html.HiddenFor(model => model.PositionId)
@Html.HiddenFor(model => model.HandlingTime)
@Html.HiddenFor(model => model.Status)
@Html.HiddenFor(model => model.StatusName)
@Html.HiddenFor(model => model.ProcUnionId)
@Html.HiddenFor(model => model.ProcedureId)
@Html.HiddenFor(model => model.ProcedureName)
@Html.HiddenFor(model => model.AllowChangeHandler)
@Html.HiddenFor(model => model.StepsChangeHandler)
@Html.HiddenFor(model => model.SelectedSituationName)
@Html.HiddenFor(model => model.IsRollbackPrev)

<link rel="stylesheet" type="text/css" href="~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-select/dist/css/bootstrap-select.css">

<div id="CompleteDossier">
    <div class="card ccard">
        <ul class="nav nav-tabs nav-tabs-simple nav-tabs-scroll border-b-1 brc-dark-l3 mx-0 mx-md-0 px-3 px-md-1 pt-2px" role="tablist">
            @*<li class="nav-item mr-1">
                    <a class="nav-link p-3 bgc-h-info-l4 radius-0" id="infor-contract" data-toggle="tab" href="#infor-contract-pane" role="tab" aria-controls="infor-contract-pane" aria-selected="true">
                        <i class="fas fa-info-circle text-info mr-3px"></i>Thông tin hợp đồng
                    </a>
                </li>*@

            <li class="nav-item mr-1">
                <a class="nav-link active brc-success-m1 d-style p-3 bgc-h-success-l4 radius-0" id="handle-dossier" data-toggle="tab" href="#handle-dossier-pane" role="tab" aria-controls="handle-dossier-pane" aria-selected="false">
                    <i class="fas fa-user-edit text-success mr-3px"></i>
                    <span class="d-n-active">
                        Xử lý công việc
                    </span>
                    <span class="d-active text-success-d1">
                        Xử lý công việc
                    </span>
                </a>
            </li>
        </ul>

        <div class="card-body px-0 py-2">
            <div class="tab-content tab-sliding border-0 px-0">
                <div class="tab-pane text-95 px-25" id="infor-contract-pane" role="tabpanel" aria-labelledby="infor-contract">
                    @*@{ Html.RenderAction("ViewContract", "Contract", new { area = "Major", contractId = Model.DossierId });}*@
                </div>

                <div class="tab-pane show active text-95 px-25" id="handle-dossier-pane" role="tabpanel" aria-labelledby="handle-dossier">
                    @{
                        if (Model.InStepView?.Situations?.Count > 0)
                        {
                            @Html.Partial("_Situations")
                            <hr class="border-none border-t-3 brc-grey-l2 border-double">
                        }
                    }

                    <div class="form-group row">
                        <div class="col-md-12">
                            <i class="fas fa-user-edit"></i>&nbsp;@Html.TitleFor(model => model.HandlingResult, new { @class = "col-form-label pr-0 font-bold" })
                            @Html.TextAreaFor(model => model.HandlingResult, new { rows = 4, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Task_HandleResult") })
                            @Html.ValidationMessageFor(model => model.HandlingResult, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    @{
                        if (!Model.AllowChangeHandler)
                        {
                            <div class="form-group row">
                                <div class="col-md-12">
                                    <label class="text-danger-d1 col-md-12 px-0 mb-0">
                                        <i class="fas fa-user-tie"></i>&nbsp;@Html.TitleFor(model => model.NextStepHandler, new { @class = "col-form-label pr-0 font-bold" })
                                    </label>
                                    <select id="NextStepHandler" name="NextStepHandler" class="form-control col-md-7 none-select2 show-tick" data-size="7" data-live-search="true" data-container="body" onchange="_onChangeCombo(this, '#CompleteDossier #NextStepHandlerName')">
                                        @{
                                            foreach (var dept in Model.ListNextStepHandlers.GroupBy(s => s.UnionName)
                                                         .Select(g => new { UnionName = g.Key, Handlers = g.Select(h => h) }).ToList())
                                            {
                                                <optgroup data-icon="fas fa-building" label="@dept.UnionName">
                                                    @foreach (var handler in dept.Handlers)
                                                    {
                                                        @Html.Raw($"<option value='{handler.UserName}' data-content=\"<div class='d-flex align-items-start'><div class='mx-2 text-grey-d1'><div class='text-600 text-blue-d1'><i class='w-3 text-center fas fa-user-tie'></i>{handler.FullName}</div><i class='w-3 text-center fas fa-at text-95'></i>{handler.Email}</div></div>\">{handler.FullName}</option>")
                                                    }
                                                </optgroup>
                    
                                            }
                                        }
                                    </select>
                                    @Html.ValidationMessageFor(model => model.NextStepHandler, "", new { @class = "text-danger" })
                                    @Html.HiddenFor(model => model.NextStepHandlerName)
                                </div>
                            </div>
                        }
                    }

                    <hr class="border-none border-t-3 brc-grey-l2 border-double">

                    <div class="form-group row">
                        <div class="col-md-12">
                            @Html.TitleFor(model => model.ResultFiles, new { @class = "col-form-label pr-0 font-bold" })
                            @Html.FileFor(model => model.ResultFiles, ".doc,.docx,.pdf", true, new { @class = "form-control col-md-11" })
                            @Html.ValidationMessageFor(model => model.ResultFiles, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <!--<div class="form-group row">
                    <div class="col-md-12">
                        <div id="TaskHandleResult_@(Model.TaskId)" enctype="multipart/form-data" class="dropzone bgc-white brc-dark-l3 brc-h-primary-m4 bgc-h-primary-l4 radius-1">
                            <div class="fallback d-none" enctype="multipart/form-data">
                                @Html.TextBoxFor(model => model.ResultFiles, new { type = "file", multiple = true })
                            </div>

                            <div class="dz-default dz-message my-0">
                                <span class="text-120 text-grey-d2">
                                    <span class="text-115 font-bolder"><i class="fa fa-caret-right text-danger-m1"></i> Kéo thả hoặc nhấn chọn tệp để tải lên</span>
                                    <br />
                                    <i class="upload-icon fas fa-cloud-upload-alt text-blue-m1 fa-3x mt-2"></i>
                                </span>
                            </div>
                        </div>
                    </div>-->
                    @*@Html.HiddenFor(model => model.ResultFiles)*@
                    <!--</div>-->

                    @{
                        if (Model.AllowChangeHandler)
                        {
                            @Html.Partial("_StepsChangeHandler")
                        }
                    }

                </div>
            </div>
        </div>
    </div>

</div>

<script src="@Url.Content("~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-select/dist/js/bootstrap-select.js")"></script>
<script src="@Url.Content("~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-select/dist/js/defaults-vi_VN.min.js")"></script>

<script type="text/javascript">

    $(document).ready(function () {

        // bootstrap select
        $('#CompleteDossier select#NextStepHandler').selectpicker('val', '@Model.NextStepHandler');
    });

    function _reloadStepHandler(situationId) {
        var dossierId = "@Model.DossierId";

        var urlStepHandlerViaSituation = "@Url.Action("StepHandlerViaSituation", "Dossier", new { area = "Major" })?dossierId=" + dossierId + "&situationId=" + situationId;

        $.ajax({
            type: "GET",
            url: urlStepHandlerViaSituation,
            dataType: "JSON",
            success: function (response) {
                debugger;
                var unions = response.Unions;
                var primaryHandler = response.Handler;
                if (unions != null && unions.length > 0) {
                    $('#CompleteDossier select#NextStepHandler').empty();
                    $.each(unions, function (index, union) {
                        var handlers = union.Handlers;
                        if (handlers != null && handlers.length > 0) {
                            var htmlHandlers = "";

                            $.each(handlers, function (index, handler) {
                                htmlHandlers += "<option value='{0}' data-content=\"<div class='d-flex align-items-start'><div class='mx-2 text-grey-d1'><div class='text-600 text-blue-d1'><i class='w-3 text-center fas fa-user-tie'></i>{1}</div><i class='w-3 text-center fas fa-at text-95'></i>{2}</div></div>\">{1}</option>".format(handler.UserName, handler.FullName, handler.Email);
                            });

                            $('#CompleteDossier select#NextStepHandler').append('<optgroup data-icon="fas fa-building" label="{0}">{1}</optgroup>'.format(union.UnionName, htmlHandlers));
                        }
                    });
                }
                $('#CompleteDossier select#NextStepHandler').selectpicker('val', primaryHandler).selectpicker('refresh');
            }
        });
    }

</script>

@Html.RenderScripts(ScriptPosition.BodyInside)
