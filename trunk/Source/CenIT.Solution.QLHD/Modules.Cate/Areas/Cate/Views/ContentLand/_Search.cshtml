@using TSFramework.App.Processors
@model Modules.Cate.Areas.Cate.Models.SearchContentLandModel

<style type="text/css">

    .bootstrap-select .dropdown-toggle {
        word-wrap: break-word !important;
        text-overflow: inherit !important;
        white-space: normal !important;
    }

        .bootstrap-select .dropdown-toggle:focus {
            border-color: #80bdff !important;
            outline: unset !important;
        }
</style>

<div class="card dcard" id="SearchContentLand">
    <div class="card-header">
        <h5 class="card-title text-120 text-primary-d2">@AppProcessor.Messagor.GetMessage("Condition_Title")</h5>
        <div class="card-toolbar no-border">
            <a href="#" data-action="toggle" class="card-toolbar-btn btn btn-sm radius-1 btn-outline-default mx-2px">
                <i class="fa fa-angle-double-up w-2 mx-1px"></i>
            </a>
        </div>
    </div>
    <div class="card-body p-0 collapse show">
        <div class="col-md-12 form-horizontal mt-3" id="Search">
            <div class="form-group row">
                <div class="col-md-12">
                    @*<label class="col-form-label text-sm-right pr-0 font-bold col-md-4">@AppProcessor.Messagor.GetMessage("ContractType_Label_Name")</label>
                        <div class="col-md-6 dropdownlist_search">
                            @Html.DropDownListFor(model => model.SearchContractTypeId, new SelectList(Model.ListTypeContracts, "Value", "Text"), "", new { @class = "form-control" })
                        </div>*@
                    <select id="ListTypeContractIds" name="ListTypeContractIds" class="form-control none-select2 selectpicker show-menu-arrow" multiple data-actions-box="true" title="@AppProcessor.Messagor.GetMessage("ContractType_Title")" data-selected-text-format="count > 4">
                        @{
                            var arrTypeContracts = new Dictionary<string, string> { { "1", "primary" }, { "2", "success" }, { "3", "info" }, { "4", "warning" }, { "5", "purple" } };

                            foreach (var typeContract in Model.ListTypeContracts)
                            {
                                <option data-content="<span class='badge text-white badge-lg arrowed arrowed-in-right mb-1 bgc-@arrTypeContracts[typeContract.Value] brc-@arrTypeContracts[typeContract.Value] '>@typeContract.Text</span>" value="@typeContract.Value">@typeContract.Text</option>
                            }
                        }
                    </select>

                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="col-md-12 text-center">
                <button type="button" class="btn btn-primary" onclick="Search()"><i class="fa fa-search-plus"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Search")</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {
        $('.selectpicker').on('loaded.bs.select', function (e, clickedIndex, isSelected, previousValue) {
            $(this).next('button').tooltip({ trigger: 'hover' });
        });
    });

</script>