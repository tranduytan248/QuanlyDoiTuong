@using TSFramework.App.Processors
@using Cores.Major.Models
@model Cores.Major.Models.MajorSubjectModel
@{
    ViewBag.Title = $"Hồ sơ Đối tượng - {Model.FullName}";
    var listViolations = ViewBag.ListViolations as List<MajorSubjectViolationModel> ?? new List<MajorSubjectViolationModel>();
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
    <a href="@Url.Action("Index", "Subject", new { area = "Major" })" class="btn btn-outline-secondary radius-3 py-2 text-600 text-90 mr-2">
        <i class="fa fa-arrow-left mr-1"></i> Quay lại danh sách
    </a>
    @Html.Button(true, "AddSubjectViolation", Url.Action("Add", "SubjectViolation", new { area = "Major", subjectId = Model.SubjectId }), "<i class='fa fa-plus mr-1'></i>", "Thêm lần vi phạm", new { @class = "btn btn-danger radius-3 py-2 text-600 text-90", data_width = "960px" })
}

<div class="row">
    <!-- Cột trái: Thông tin định danh & liên lạc -->
    <div class="col-lg-4 col-md-5">
        <div class="card dcard mb-3">
            <div class="card-body text-center p-4">
                <img src="@(!string.IsNullOrEmpty(Model.AvatarUrl) ? Model.AvatarUrl : "/Contents/Base/imgs/avatar-default.png")" class="radius-round border-3 brc-primary-m2 shadow-sm mb-3" style="width:120px;height:120px;object-fit:cover;" />
                <h4 class="text-primary font-bold mb-1">@Model.FullName</h4>
                @if (!string.IsNullOrEmpty(Model.OtherName))
                {
                    <p class="text-secondary mb-2">Tên gọi khác: <b>@Model.OtherName</b></p>
                }
                @if (!string.IsNullOrEmpty(Model.SubjectTypeNames))
                {
                    <div class="my-2 d-flex flex-wrap justify-content-center">
                        @foreach (var typeName in Model.SubjectTypeNames.Split(','))
                        {
                            <span class="badge badge-lg badge-light-blue text-primary-d2 border-1 brc-primary-m3 font-bold mr-1 mb-1 shadow-none">
                                <i class="fas fa-tag mr-1 text-80"></i>@typeName.Trim()
                            </span>
                        }
                    </div>
                }
                <div class="badge badge-lg @(Model.ViolationCount > 0 ? "badge-danger" : "badge-success") px-3 py-2 mt-1">
                    <i class="fas fa-exclamation-circle mr-1"></i> Đã vi phạm: @Model.ViolationCount lần
                </div>
            </div>
            <ul class="list-group list-group-flush text-90">
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-secondary"><i class="far fa-id-card mr-2 text-primary"></i>Số CCCD/Định danh:</span>
                    <span class="font-bold text-primary">@Model.IdentityCardNumber</span>
                </li>
                @if (!string.IsNullOrEmpty(Model.SubjectTypeNames))
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-secondary"><i class="fas fa-tags mr-2 text-primary"></i>Loại đối tượng:</span>
                        <span class="font-bold text-right text-primary-d1">@Model.SubjectTypeNames</span>
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-secondary"><i class="far fa-calendar-alt mr-2 text-primary"></i>Ngày sinh:</span>
                    <span class="font-bold">@Model.DateOfBirthStr</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-secondary"><i class="fas fa-venus-mars mr-2 text-primary"></i>Giới tính:</span>
                    <span class="font-bold">@Model.Gender</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-secondary"><i class="fas fa-users mr-2 text-primary"></i>Dân tộc:</span>
                    <span class="font-bold">@Model.Ethnicity</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-secondary"><i class="fas fa-praying-hands mr-2 text-primary"></i>Tôn giáo:</span>
                    <span class="font-bold">@Model.Religion</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-secondary"><i class="fas fa-globe mr-2 text-primary"></i>Quốc tịch:</span>
                    <span class="font-bold">@Model.Nationality</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-secondary"><i class="fas fa-phone mr-2 text-primary"></i>Số điện thoại:</span>
                    <span class="font-bold">@Model.PhoneNumber</span>
                </li>
            </ul>
        </div>

        <div class="card dcard mb-3">
            <div class="card-header bgc-primary-l4">
                <h6 class="card-title text-primary font-bold mb-0"><i class="fas fa-map-marked-alt mr-2"></i>Nơi cư trú & Quê quán</h6>
            </div>
            <div class="card-body p-3 text-90">
                <div class="mb-2">
                    <label class="font-bold text-secondary d-block">Quê quán:</label>
                    <div>@(!string.IsNullOrEmpty(Model.PlaceOfOrigin) ? Model.PlaceOfOrigin : "Chưa cập nhật")</div>
                </div>
                <div class="mb-2">
                    <label class="font-bold text-secondary d-block">Nơi đăng ký khai sinh:</label>
                    <div>@(!string.IsNullOrEmpty(Model.BirthRegistrationPlace) ? Model.BirthRegistrationPlace : "Chưa cập nhật")</div>
                </div>
                <div>
                    <label class="font-bold text-secondary d-block">Nơi ở hiện tại:</label>
                    <div class="text-primary font-bold">@(!string.IsNullOrEmpty(Model.CurrentResidence) ? Model.CurrentResidence : "Chưa cập nhật")</div>
                </div>
            </div>
        </div>

        <div class="card dcard mb-3">
            <div class="card-header bgc-primary-l4">
                <h6 class="card-title text-primary font-bold mb-0"><i class="fas fa-id-badge mr-2"></i>Hình ảnh thẻ CCCD</h6>
            </div>
            <div class="card-body p-3 text-center">
                <div class="row">
                    <div class="col-6">
                        <label class="font-bold text-85 mb-1 d-block">Mặt trước</label>
                        @if (!string.IsNullOrEmpty(Model.IdentityCardFrontUrl))
                        {
                            <a href="@Model.IdentityCardFrontUrl" target="_blank">
                                <img src="@Model.IdentityCardFrontUrl" class="img-fluid radius-1 border-1 brc-default-m3" style="max-height:100px;object-fit:cover;" />
                            </a>
                        }
                        else
                        {
                            <span class="text-secondary text-85">Chưa có ảnh</span>
                        }
                    </div>
                    <div class="col-6">
                        <label class="font-bold text-85 mb-1 d-block">Mặt sau</label>
                        @if (!string.IsNullOrEmpty(Model.IdentityCardBackUrl))
                        {
                            <a href="@Model.IdentityCardBackUrl" target="_blank">
                                <img src="@Model.IdentityCardBackUrl" class="img-fluid radius-1 border-1 brc-default-m3" style="max-height:100px;object-fit:cover;" />
                            </a>
                        }
                        else
                        {
                            <span class="text-secondary text-85">Chưa có ảnh</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Lịch sử các lần vi phạm -->
    <div class="col-lg-8 col-md-7">
        <div class="card dcard">
            <div class="card-header bgc-danger-l4 d-flex justify-content-between align-items-center">
                <h5 class="card-title text-danger font-bold mb-0">
                    <i class="fas fa-history mr-2"></i>Lịch sử vi phạm của đối tượng (@listViolations.Count lần)
                </h5>
            </div>
            <div class="card-body p-3">
                @if (listViolations.Count == 0)
                {
                    <div class="alert alert-success text-center my-4 py-4">
                        <i class="fas fa-check-circle fa-3x text-success mb-2"></i>
                        <h5 class="font-bold">Đối tượng này chưa có lịch sử vi phạm nào.</h5>
                    </div>
                }
                else
                {
                    <div class="timeline">
                        @foreach (var v in listViolations)
                        {
                            <div class="card border-1 brc-danger-m3 mb-3 shadow-sm">
                                <div class="card-header bgc-danger-l4 d-flex justify-content-between align-items-center py-2">
                                    <span class="font-bold text-danger">
                                        <i class="far fa-clock mr-1"></i> Thời gian: @v.ViolationDate.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                    <div>
                                        @Html.Button(true, "EditSubjectViolation", Url.Action("Edit", "SubjectViolation", new { area = "Major", id = v.ViolationId }), "<i class='far fa-edit text-primary'></i>", "Sửa", new { @class = "btn btn-xs btn-lighter-primary mr-1", data_width = "960px" })
                                        @Html.Button(true, "DeleteSubjectViolation", Url.Action("Delete", "SubjectViolation", new { area = "Major", id = v.ViolationId }), "<i class='far fa-trash-alt text-danger'></i>", "Xóa", new { @class = "btn btn-xs btn-lighter-danger" })
                                    </div>
                                </div>
                                <div class="card-body p-3">
                                    <div class="mb-2">
                                        <label class="font-bold text-dark mb-1 d-block"><i class="fas fa-exclamation-triangle text-danger mr-1"></i>Hành vi vi phạm:</label>
                                        <div class="p-2 bgc-light radius-1 border-1 brc-grey-l2 font-bold text-danger">
                                            @v.BehaviorNames
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(v.TreatmentMeasures))
                                    {
                                        <div class="mb-2">
                                            <label class="font-bold text-dark mb-1 d-block"><i class="fas fa-gavel text-primary mr-1"></i>Biện pháp xử lý:</label>
                                            <div class="p-2 bgc-light radius-1 border-1 brc-grey-l2">
                                                @Html.Raw(v.TreatmentMeasures)
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(v.RelatedDocuments))
                                    {
                                        <div class="mb-2">
                                            <label class="font-bold text-dark mb-1 d-block"><i class="fas fa-file-alt text-info mr-1"></i>Văn bản liên quan:</label>
                                            <div class="p-2 bgc-light radius-1 border-1 brc-grey-l2">
                                                @foreach (var doc in v.ListRelatedDocuments)
                                                {
                                                    <a href="@doc.Url" target="_blank" class="badge badge-info text-90 mr-1 mb-1 px-2 py-1">
                                                        <i class="fas fa-paperclip mr-1"></i>@doc.Name
                                                        @if (!string.IsNullOrEmpty(doc.SizeText))
                                                        {
                                                            <span class="text-80 ml-1">(@doc.SizeText)</span>
                                                        }
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(v.Images))
                                    {
                                        <div class="mb-2">
                                            <label class="font-bold text-dark mb-1 d-block"><i class="fas fa-images text-success mr-1"></i>Hình ảnh tại thời điểm vi phạm:</label>
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var imgUrl in v.Images.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries))
                                                {
                                                    <a href="@imgUrl.Trim()" target="_blank" class="mr-2 mb-2">
                                                        <img src="@imgUrl.Trim()" class="radius-1 border-1 brc-default-m2 shadow-sm" style="width:100px;height:75px;object-fit:cover;" />
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <div class="text-right text-secondary text-85 mt-2 border-top pt-2">
                                        <i class="far fa-user mr-1"></i> Người tạo: <b>@v.CreatedBy</b> - Ngày tạo: <b>@(v.CreatedDate.HasValue ? v.CreatedDate.Value.ToString("dd/MM/yyyy HH:mm") : "")</b>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="~/Areas/Major/Views/SubjectViolation/SubjectViolation.js"></script>
}
