@using TSFramework.App.Processors
@model CenIT.Solution.QLHD.WebApp.Models.ChangePasswordModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(model => model.UserName)
<div id="User">
    <div class="form-group row">
        @Html.TitleFor(model => model.CurrentPassword, new { @class = "col-form-label text-sm-right pr-0 font-bold col-md-4" })
        <div class="col-md-8">
            <div class="input-group col-md-8">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fa fa-key"></i>
                    </span>
                </div>
                @Html.TextBoxFor(model => model.CurrentPassword, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Authorize_Current_Password"), type = "password" })
                <div class="input-group-append">
                    <a class="input-group-text btn text-blue" href="javascript:void(0);" onclick="_showPassword($('#CurrentPassword'));">
                        <i class="fa fa-eye-slash"></i>
                    </a>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.CurrentPassword, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.NewPassword, new { @class = "col-form-label text-sm-right pr-0 font-bold col-md-4" })
        <div class="col-md-8">
            <div class="input-group col-md-8">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fa fa-key"></i>
                    </span>
                </div>
                @Html.TextBoxFor(model => model.NewPassword, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Authorize_New_Password"), type = "password" })
                <div class="input-group-append">
                    <a class="input-group-text btn text-blue" href="javascript:void(0);" onclick="_showPassword($('#NewPassword'));">
                        <i class="fa fa-eye-slash"></i>
                    </a>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.ConfirmPassword, new { @class = "col-form-label text-sm-right pr-0 font-bold col-md-4" })
        <div class="col-md-8">
            <div class="input-group col-md-8">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fa fa-key"></i>
                    </span>
                </div>
                @Html.TextBoxFor(model => model.ConfirmPassword, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("User_Label_ConfirmPassword"), type = "password" })
                <div class="input-group-append">
                    <a class="input-group-text btn text-blue" href="javascript:void(0);" onclick="_showPassword($('#ConfirmPassword'));">
                        <i class="fa fa-eye-slash"></i>
                    </a>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
        </div>
    </div>
</div>