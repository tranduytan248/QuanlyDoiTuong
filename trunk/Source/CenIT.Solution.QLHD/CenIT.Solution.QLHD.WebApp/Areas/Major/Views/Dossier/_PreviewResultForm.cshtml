@using TSFramework.App.Processors
@model string

@{
    ViewBag.Title = Html.Raw($"{AppProcessor.Messagor.GetMessage("Doc_Title")}");
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    info
}

@section FormIcon{
    <i class="fas fa-eye"></i>
}

@section FormBody{

    <div class="row modal-body py-0" id="bodyForm">
        <div class="col-12">
            <a class="btn px-4 btn-outline-success mb-1" name="DownloadRefDoc" onclick="_onDownloadDoc(this);" href="@Url.Action("TmpExport", "Dossier", new{ fileId = Model}, Request.Url.Scheme)"><i class="fas fa-cloud-download-alt"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Download")</a>
            <a href="javascript:void(0);" onclick="_onFullscreen();" class="btn px-4 btn-outline-primary mb-1">
                <i class="fa fa-expand d-n-active"></i> Toàn màn hình
            </a>
        </div>
        <div class="col-12 table-responsive-md" id="DocViewer">
            <iframe src='' width='100%' height='100%' style="min-height:calc(100vh - 200px);" frameborder='0'></iframe>
        </div>
    </div>

    <script type="text/javascript">
        //debugger;

        //var appViewerUrl = "https://view.officeapps.live.com/op/embed.aspx?src={0}&embedded=true&timespan=5&wdStartOn=1&wdPrint=1&wdEmbedCode=0&ui=vi-VN";
        //var appViewerUrl = "https://docs.google.com/viewerng/viewer?url={0}&hl=vi&pid=explorer&efh=false&a=v&chrome=false&embedded=true";
        // https://view.officeapps.live.com/op/view.aspx?src={0}&embedded=true×pan=5&wdStartOn=1&wdPrint=1&wdEmbedCode=0&ui=vi-VN

        var appViewerUrl = "@Html.Raw(ViewBag.AppViewerUrl)";

        var docUrl = appViewerUrl.format("@Url.Action("TmpExport", "Dossier", new{ fileId = Model}, Request.Url.Scheme)");

        $(document).ready(function () {
            //_onWaiting();
            $("#DocViewer iframe").attr("src", docUrl);
            $('#DocViewer iframe').on('load', function () {
                _endWaiting();
                _onFullscreen();
            });
        });

        function _onFullscreen() {
            var iframe = document.querySelector('#DocViewer iframe');
            // Do fullscreen
            if (iframe.requestFullscreen) {
                iframe.requestFullscreen();
            } else if (iframe.webkitRequestFullscreen) {
                iframe.webkitRequestFullscreen();
            } else if (iframe.mozRequestFullScreen) {
                iframe.mozRequestFullScreen();
            } else if (iframe.msRequestFullscreen) {
                iframe.msRequestFullscreen();
            }
        }

    </script>
}
@section SubmitControl{

}
