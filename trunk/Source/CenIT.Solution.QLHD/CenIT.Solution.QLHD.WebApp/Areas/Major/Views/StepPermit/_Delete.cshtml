@using TSFramework.App.Processors
@model Cores.Major.Models.SAVProcedureStepPermisionModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Permit_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "StepPermit", new { area = "Major" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "StepPermit_OnProcessSuccess(data, 'DeleteStepPermit')"
    }, new { @class = "form-horizontal", id = "DeleteStepPermit" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.StepId)
        @Html.HiddenFor(model => model.StepName)
        @Html.HiddenFor(model => model.UserName)
        @Html.HiddenFor(model => model.FullName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}