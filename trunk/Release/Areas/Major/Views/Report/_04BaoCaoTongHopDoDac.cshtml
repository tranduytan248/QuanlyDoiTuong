@using TSFramework.App.Processors
@model Modules.Major.Areas.Major.Models.ReportModel
<div id="_04BaoCaoTongHopDoDac">
    <div class="form-group row">
        <div class="col-2 col-form-label text-sm-right pr-0 font-bold mt-1 mr-3">
            <label for="ForYear" class="mb-0">
                Năm
            </label>
        </div>
        <div class="col-sm-3">
            <div class="input-group date">
                <div class="input-group-addon input-group-prepend">
                    <div class="input-group-text">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                </div>
                @Html.TextBox("ForYear", DateTime.Now.ToString("yyyy"), new { @class = "form-control" })
            </div>
        </div>

    </div>
    <div class="form-group row">
    <div class="col-2 col-form-label text-sm-right pr-0 font-bold mt-1 mr-3">
        <label for="UnionId" class="mb-0">
            Địa bàn
        </label>
    </div>
    <div class="col-sm-9">
        @Html.SelectFor(model => model.Unions, Model.ListUnions, AppProcessor.Messagor.GetMessage("Union_Title"), new { multiple = true, @class = "form-control col-11", onchange = "_onChangeCombo(this, '#_04BaoCaoTongHopDoDac #UnionName', true)" })
        @Html.HiddenFor(model => model.UnionName)
    </div>
</div>
</div>
<script type="text/javascript">
    $(function () {
        $("#ForYear").datepicker({
            format: "yyyy",
            viewMode: "years",
            minViewMode: "years",
            autoclose: true
        });
    });
</script>