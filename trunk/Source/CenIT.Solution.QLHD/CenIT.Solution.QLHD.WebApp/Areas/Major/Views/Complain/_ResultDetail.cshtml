            <div class="form-group row">
                <span class="has-float-label input-floating-label col-12 text-blue-d2 brc-blue-m1">
                    @Html.TextAreaFor(model => model.Title, new { @class = "form-control shadow-none text-primary-d2", disabled = true })
                    @Html.LabelFor(model => model.Title, new { @class = "floating-label text-grey-m3 text-500" })
                </span>
            </div>
            <div class="form-group row">
                <span class="has-float-label input-floating-label col-12 text-blue-d2 brc-blue-m1">
                    @Html.TextAreaFor(model => model.Contents, new { rows = 10, @class = "form-control shadow-none text-primary-d2", disabled = true })
                    @Html.LabelFor(model => model.Contents, new { @class = "floating-label text-grey-m3 text-500" })
                </span>
            </div>
            <div class="form-group row">
                    <span class="has-float-label input-floating-label col-12 text-blue-d2 brc-blue-m1">
                        @Html.TextAreaFor(model => model.Location, new { @class = "form-control shadow-none text-primary-d2", disabled = true })
                        @Html.LabelFor(model => model.Location, new { @class = "floating-label text-grey-m3 text-500" })
                    </span>
                </div>
            <div class="form-group row">
                <div class="col-8 input-floating-label text-danger-d2 brc-danger-m1">
                    @Html.TextBoxFor(model => model.ReflectName, new { @class = "form-control shadow-none text-primary-d2", disabled = true })
                    @Html.LabelFor(model => model.ReflectName, new { @class = "floating-label text-grey-m3 text-500" })
                </div>
            </div>
            @{if (Model.ListRefImgs.Count > 0)
                {
                    <hr />
                    <div class="row mx-0">
                        @{foreach (var k in Model.ListRefImgs.Keys)
                            {
                                int idx;
                                if (k == 0)
                                {
                                    idx = 0;
									<!-- column 1 -->
                                    <div class="col-6 col-sm-4 col-md-3 text-center px-2">
                                        @foreach (var img in Model.ListRefImgs[k])
                                        {
                                            <div class="pos-rel d-style my-3 radius-1 shadow-sm overflow-hidden bgc-brown-m3" id="@img.FileId">
                                                <a href="#" class="show-lightbox">
                                                    <img alt="Hình ảnh @($"{k}{idx}")" src="@img.FilePath" class="w-100 d-zoom-2 " data-size="@img.Dimensions" />
                                                </a>
                                            </div>
                                            idx += 1;
                                        }
                                    </div>
                                }
                                else if (k == 1)
                                {
                                    idx = 0;
									<!-- column 2 -->
                                    <div class="col-6 col-sm-4 col-md-3 text-center px-2">
                                        @foreach (var img in Model.ListRefImgs[k])
                                        {
                                            <div class="pos-rel d-style my-3 radius-1 shadow-sm overflow-hidden bgc-brown-m3" id="@img.FileId">
                                                <a href="#" class="show-lightbox">
                                                    <img alt="Hình ảnh @($"{k}{idx}")" src="@img.FilePath" class="w-100 d-zoom-2 " data-size="@img.Dimensions" />
                                                </a>
                                            </div>
                                            idx += 1;
                                        }
                                    </div>
                                }
                                else if (k == 2)
                                {
                                    idx = 0;
									<!-- column 3 -->
                                    <div class="col-6 col-sm-4 col-md-3 text-center px-2">
                                        @foreach (var img in Model.ListRefImgs[k])
                                        {
                                            <div class="pos-rel d-style my-3 radius-1 shadow-sm overflow-hidden bgc-brown-m3" id="@img.FileId">
                                                <a href="#" class="show-lightbox">
                                                    <img alt="Hình ảnh @($"{k}{idx}")" src="@img.FilePath" class="w-100 d-zoom-2 " data-size="@img.Dimensions" />
                                                </a>
                                            </div>
                                            idx += 1;
                                        }
                                    </div>
                                }

                            }
                        }

                    </div>
                            }
            }

            <div class="position-rc h-100 border-l-1 brc-secondary-l3"></div>
        </div>
        <div class="col-12 col-md-7">
            <div class="form-group row">
                <label for="Status" class="col-sm-3 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("Complain_ResultChecking")</label>
                <label class="col-form-label col-4">
                    @Html.RadioButtonFor(model => model.HandleStatus, (int)EnumComplainHandleStatus.WrongInfo, new { id = "WrongInfo", onchange = "_onChangeStatus(this);" })
                    @Html.Label(AppProcessor.Messagor.GetMessage("HandleComplain_WrongInfo"), new { @for = "WrongInfo" })
                </label>
                <label class="col-form-label col-4">
                    @Html.RadioButtonFor(model => model.HandleStatus, (int)EnumComplainHandleStatus.ForwardToHandle, new { id = "ForwardToHandle", onchange = "_onChangeStatus(this);" })
                    @Html.Label(AppProcessor.Messagor.GetMessage("HandleComplain_ForwardToHandle"), new { @for = "ForwardToHandle" })
                </label>
            </div>
            <div class="form-group row">
                @Html.TitleFor(model => model.Note, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-md-8">
                    @Html.TextAreaFor(model => model.Note, new { rows = 2, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Complain_Note") })
                    @Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group row">
                <label for="RefFiles" class="col-sm-3 col-form-label text-sm-right pr-0 font-bold text-danger">@AppProcessor.Messagor.GetMessage("Doc_Ref") (*)</label>
                <div class="col-md-8">
                    @Html.FileFor(model => model.RefFiles, ".doc,.docx,.pdf", false, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Form_RefDocs") })
                    @Html.ValidationMessageFor(model => model.RefFiles, "", new { @class = "text-danger" })
                </div>
            </div>

