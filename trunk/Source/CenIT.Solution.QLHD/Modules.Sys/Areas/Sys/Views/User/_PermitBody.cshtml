@using TSFramework.App.Processors
@model Modules.Sys.Areas.Sys.Models.UserPermitModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(model => model.UserId)
@Html.HiddenFor(model => model.UserName)
@Html.HiddenFor(model => model.FullName)
@Html.HiddenFor(model => model.Email)

<div id="Permit">
    <div class="form-group row">
        <div class="col-md-12">
            @Html.TitleFor(model => model.FullName, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="far fa-user-circle"></i>
                    </span>
                </div>
                @Html.TextBoxFor(model => model.FullName, new { disabled = true, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("User_Label_FullName") })
            </div>
            @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-5">
            @Html.TitleFor(model => model.UserName, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fa fa-user"></i>
                    </span>
                </div>
                @Html.TextBoxFor(model => model.UserName, new { disabled = true, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("User_Label_UserName") })

            </div>
            @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-7">
            @Html.TitleFor(model => model.Email, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fa fa-envelope"></i>
                    </span>
                </div>
                @Html.TextBoxFor(model => model.Email, new { disabled = true, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("User_Label_Email") })
            </div>
            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
        </div>
    </div>

    <hr />
    <div class="form-group row" id="Roles">
        @Html.HiddenFor(model => model.RoleIDs)
        <div class="col-md-12">
            @Html.TitleFor(model => model.ListRoleIDs, new { @class = "col-form-label pr-0 font-bold" })
            <select id="ListRoleIDs" name="ListRoleIDs" class="form-control col-md-12 none-select2 selectpicker show-menu-arrow" multiple data-actions-box="true" title="@AppProcessor.Messagor.GetMessage("Role_Title")" data-selected-text-format="count > 8">
                @{
                    foreach (var role in Model.ListRoles)
                    {
                        <option data-content='<span class="m-1 badge bgc-danger-l4 border-1 brc-danger-m3 text-danger-d2 px-3 text-95"><span class="pos-rel">@role.Name</span></span>' value="@role.RoleId">@role.Name</option>
                    }
                }
            </select>
            @*@foreach (var item in Model.ListRoles)
                {
                    var sChecked = string.IsNullOrEmpty(Model.RoleIDs) || Model.RoleIDs.Split(',').ToList().IndexOf(item.RoleId.ToString()) == -1 ? "" : "checked";
                    <label class="col-sm-5">
                        <input id="group-@item.RoleId" name="form-field-checkbox" type="checkbox" aria-label="@item.Name" onclick="OnCheckRole(this)" value="@item.RoleId" @sChecked/>
                        @item.Name
                    </label>
                }*@
        </div>
        @Html.ValidationMessageFor(model => model.RoleIDs, "", new { @class = "text-danger" })
    </div>

    <hr />
    <div class="form-group row" id="Modules">
        @Html.HiddenFor(model => model.ModuleIDs)
        <div class="col-md-12">
            @Html.TitleFor(model => model.ListModuleIDs, new { @class = "col-form-label pr-0 font-bold" })
            <select id="ListModuleIDs" name="ListModuleIDs" class="form-control col-md-12 none-select2 selectpicker show-menu-arrow" multiple data-actions-box="true" title="@AppProcessor.Messagor.GetMessage("Module_Title")" data-selected-text-format="count > 8">
                @{
                    foreach (var module in Model.ListModules)
                    {
                        <option data-content='<span class="m-1 badge bgc-primary-l4 border-1 brc-primary-m3 text-primary-d2 px-3 text-95"><span class="pos-rel">@module.Description</span></span>' value="@module.ModuleId">@module.Description</option>
                    }
                }
            </select>
            @*@foreach (var item in Model.ListModules)
                {
                    var sChecked = string.IsNullOrEmpty(Model.ModuleIDs) || Model.ModuleIDs.Split(',').ToList().IndexOf(item.ModuleId.ToString()) == -1 ? "" : "checked";
                    <label class="col-sm-5">
                        <input id="group-@item.ModuleId" name="form-field-checkbox" type="checkbox" aria-label="@item.Description" onclick="OnCheckModule(this)" value="@item.ModuleId" @sChecked/>
                        @item.Description
                    </label>
                }*@
        </div>
        @Html.ValidationMessageFor(model => model.ModuleIDs, "", new { @class = "text-danger" })
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        @{
            if (!string.IsNullOrEmpty(Model.RoleIDs))
            {
                @Html.Raw($"$('#Roles #ListRoleIDs').val('{Model.RoleIDs}'.split(','));")
            }
            if (!string.IsNullOrEmpty(Model.ModuleIDs))
            {
                @Html.Raw($"$('#Modules #ListModuleIDs').val('{Model.ModuleIDs}'.split(','));")
            }
        }

        //$('#Permit #Roles input[type=checkbox]').each(function () {
        //    var roleIDs = $('#Permit input[type="hidden"][id$="ListRoleIDs"]').val().split(',');

        //    var roleId = $(this).val();
        //    var index = roleIDs.indexOf((roleId));

        //    if (index > -1) {
        //        this.checked = true;
        //    }
        //});

        //$('#Permit #Modules input[type=checkbox]').each(function () {
        //    var moduleIDs = $('#Permit input[type="hidden"][id$="ListModuleIDs"]').val().split(',');

        //    var moduleId = $(this).val();
        //    var index = moduleIDs.indexOf((moduleId));

        //    if (index > -1) {
        //        this.checked = true;
        //    }
        //});
    });

    function OnCheckRole(chk) {
        var roleIDs = $('#Permit #Roles input[type="hidden"][id$="ListRoleIDs"]').val().split(',');

        var index;
        if ($(chk)[0].checked) {
            index = roleIDs.indexOf(($(chk).val()));
            if (index == -1) {
                roleIDs.push($(chk).val());
            }
        } else {
            index = roleIDs.indexOf(($(chk).val()));
            roleIDs.splice(index, 1);
        }
        $('#Permit #Roles input[type="hidden"][id$="ListRoleIDs"]').val(roleIDs);
    }

    function OnCheckModule(chk) {
        var moduleIDs = $('#Permit #Modules input[type="hidden"][id$="ListModuleIDs"]').val().split(',');

        var index;
        if ($(chk)[0].checked) {
            index = moduleIDs.indexOf(($(chk).val()));
            if (index == -1) {
                moduleIDs.push($(chk).val());
            }
        } else {
            index = moduleIDs.indexOf(($(chk).val()));
            moduleIDs.splice(index, 1);
        }
        $('#Permit #Modules input[type="hidden"][id$="ListModuleIDs"]').val(moduleIDs);
    }
</script>