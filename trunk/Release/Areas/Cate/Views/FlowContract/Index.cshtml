@using TSFramework.App.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("FlowContract_Label_Title");
}

@section PageTitle
{
    @ViewBag.Title
}

<div class="mt-3">
    <div class="card dcard">
        <div class="p-2 table-responsive-md">
            <table id="DSFlowContract" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="nls-w">@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        @*<th>@AppProcessor.Messagor.GetMessage("ContractFlowTemplateId_Title")</th>*@
                        <th>@AppProcessor.Messagor.GetMessage("ContractFlowName_Title")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ContractFlowDescription_Title")</th>
                        <th>@AppProcessor.Messagor.GetMessage("ContractFlowDisable_Title")</th>
                        <th class="nls-w">@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="~/Areas/Cate/Views/FlowContract/FlowContract.js"></script>
}