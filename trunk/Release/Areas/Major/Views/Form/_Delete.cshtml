@using TSFramework.App.Processors
@model Cores.Major.Models.SAVFormModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Form_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Form", new { area = "Major" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Form_OnProcessSuccess(data, 'DeleteForm')"
    }, new { @class = "form-horizontal", id = "DeleteForm" }))
    {
        <div id="bodyForm">
            @Html.Partial("_DelBody")
        </div>
    }
}
