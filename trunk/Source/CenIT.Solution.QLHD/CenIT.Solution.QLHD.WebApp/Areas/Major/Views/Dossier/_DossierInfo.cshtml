@model Cores.Major.Models.SAVDossierModel
@using Modules.Major.Cores.Enums
@using Cores.Major.Enums
@using TSFramework.App.Processors
@using TSFramework.Core.Utils

@Html.AntiForgeryToken()

<ul class="w-100 nav nav-tabs nav-tabs-simple bgc-blue-d2 radius-t-1 pt-2 pl-2" role="tablist">
    <li class="nav-item mr-3px">
        <a class="@(Model.ActiveTab == "#infoComplain" ? "active":"") btn btn-brc-tp btn-outline-white btn-h-light-blue btn-h-text-dark btn-a-text-blue btn-a-white px-3 px-lg-4 py-25 border-0 radius-b-0" id="conplain-tab-btn" data-toggle="tab" href="#infoComplain" role="tab" aria-controls="infoComplain" aria-selected="true">
            Thông tin vi phạm
        </a>
    </li>

    <li class="nav-item mr-3px">
        <a class="@(Model.ActiveTab == "#handlingDossier" ? "active":"") btn btn-brc-tp btn-outline-white btn-h-light-blue btn-h-text-dark btn-a-text-blue btn-a-white px-3 px-lg-4 py-25 border-0 radius-b-0" id="dossier-tab-btn" data-toggle="tab" href="#handlingDossier" role="tab" aria-controls="handlingDossier" aria-selected="false">
            Xử lý vi phạm
        </a>
    </li>

</ul>

<div id="Dossier">
    <div class="tab-content tab-sliding ace-scrollbar px-1 px-md-3 text-grey-d3 border-1 border-t-0 radius-b-1 brc-primary-l2">

        <div class="tab-pane @(Model.ActiveTab == "#infoComplain" ? "show active":"") p-2" id="infoComplain" role="tabpanel" aria-labelledby="conplain-tab-btn">

            @Html.HiddenFor(model => model.ActiveTab)
            @Html.HiddenFor(model => model.DossierId)
            @Html.HiddenFor(model => model.ComplainId)
            @Html.HiddenFor(model => model.SourceId)
            @Html.HiddenFor(model => model.Title)
            @Html.HiddenFor(model => model.ProcedureId)
            @Html.HiddenFor(model => model.FieldViolatedId)
            @Html.HiddenFor(model => model.FieldViolatedName)

            @Html.HiddenFor(model => model.SourceName)
            @Html.HiddenFor(model => model.Contents)
            @Html.HiddenFor(model => model.Location)
            @Html.HiddenFor(model => model.ReflectBy)
            @Html.HiddenFor(model => model.ReflectName)
            @Html.HiddenFor(model => model.Note)
            @Html.HiddenFor(model => model.DossierCode)
            @Html.HiddenFor(model => model.ProcedureName)
            @Html.HiddenFor(model => model.Reason)

            @Html.HiddenFor(model => model.SituationId)
