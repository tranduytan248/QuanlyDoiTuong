@using TSFramework.App.Processors
@model Cores.Cate.Models.CateContractTypeModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("ContractType_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "ContractType", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ContractType_OnProcessSuccess(data, 'DeleteContractType')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model =>model.ContractTypeId)
        @Html.HiddenFor(model => model.ContractTypeName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}