<div class="form-group col-12 row">
    @Html.TitleFor(model => model.IsPermanent, new { @class = "col-md-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-1">
        <div class="form-check">
            @Html.CheckBoxFor(model => model.IsPermanent, new { @class = "form-check-input", id = "IsPermanent" })
            @Html.ValidationMessageFor(model => model.IsPermanent, "", new { @class = "text-danger" })
        </div>
        @Html.ValidationMessageFor(model => model.IsPermanent, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group row">
    @Html.TitleFor(model => model.Date, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-8">
        <div class="row">
            <div class="col-md-3">
                @Html.DropDownListFor(model => model.Day, Model.Days.Select(x => new SelectListItem
                {
                    Text = x.ToString(),
                    Value = x.ToString()
                }), "Ngày", new { @class = "form-control", id = "dayDropdown" })
            </div>

            <div class="col-md-3">
                @Html.DropDownListFor(model => model.Month, Model.Months.Select(x => new SelectListItem
                {
                    Text = x.ToString(),
                    Value = x.ToString()
                }), "Tháng", new { @class = "form-control", id = "monthDropdown" })
            </div>

            <div class="col-md-4">
                @Html.TextBoxFor(model => model.Year, new { @class = "form-control", placeholder = "Năm", id = "yearTextbox", Value = DateTime.Now.Year })
            </div>
        </div>
        @Html.ValidationMessageFor(model => model.Day, "", new { @class = "text-danger" })
        @Html.ValidationMessageFor(model => model.Month, "", new { @class = "text-danger" })
    </div>
</div>


<div class="form-group row">
    @Html.TitleFor(model => model.IsLunarCalendar, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-8">
        <label class="px-0 pt-2">
            @Html.RadioButtonFor(model => model.IsLunarCalendar, true, new { })
            <span class="badge bgc-info brc-info text-white badge-lg arrowed arrowed-in-right">
                <span class="px-3">@AppProcessor.Messagor.GetMessage("Holiday_LunarCalendar")</span>
            </span>
        </label>
        <label class="px-0 pt-2">
            @Html.RadioButtonFor(model => model.IsLunarCalendar, false, new { })
            <span class="badge bgc-success brc-success text-white badge-lg arrowed arrowed-in-right">
                <span class="px-3">@AppProcessor.Messagor.GetMessage("Holiday_Calendar")</span>
            </span>
        </label>
    </div>
</div>

<div class="form-group row">
    @Html.TitleFor(model => model.HolidayName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-8">
        @Html.TextAreaFor(model => model.HolidayName, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Holiday_Label_HolidayName"), rows = 3 })
        @Html.ValidationMessageFor(model => model.HolidayName, "", new { @class = "text-danger" })
    </div>
</div>


<script>
    $(document).ready(function () {
        // Ẩn trường năm khi trang được tải lần đầu tiên nếu IsPermanent đã được chọn
        if ($("#IsPermanent").is(":checked")) {
            $("#yearTextbox").hide();
        }

        // Xử lý sự kiện thay đổi của checkbox IsPermanent
        $("#IsPermanent").change(function () {
            if ($(this).is(":checked")) {
                $("#yearTextbox").hide();
            } else {
                $("#yearTextbox").show();
            }
        });
    });
</script>
