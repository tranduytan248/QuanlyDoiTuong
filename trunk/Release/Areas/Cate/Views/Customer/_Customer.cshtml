@using TSFramework.App.Processors
@model Cores.Cate.Models.CateCustomerModel

@Html.AntiForgeryToken()
<style>
    .select2 {
        width: 100% !important
    }

    .address-modal {
        position: fixed; /* Stay in place */
        z-index: 1; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    .address-modal-content {
        background-color: #fefefe;
        margin: 15% auto; /* 15% from the top and centered */
        border: 1px solid #888;
        width: 70%; /* Could be more or less, depending on screen size */
    }
</style>
<div id="Cate">
    @Html.HiddenFor(model => model.CustomerId)
    @Html.HiddenFor(model => model.ApartmentNumber)
    @Html.HiddenFor(model => model.Alley)
    @Html.HiddenFor(model => model.ProvinceId)
    @Html.HiddenFor(model => model.DistrictId)
    @Html.HiddenFor(model => model.WardId)
    @Html.HiddenFor(model => model.StreetId)

    <div class="form-group row" style="margin-bottom:-20px!important">
        <div class="form-group row col-lg-12 justify-content-center">
            <label class="col-lg-4 px-0 row justify-content-sm-center align-items-center">
                @Html.RadioButtonFor(model => model.UserType, "CONSUMER", new
                {
                    id = "BusinessCheckBox",
                    onchange = "showBusiness()"
                })
                @AppProcessor.Messagor.GetMessage("CONSUMER")
            </label>
            <label class="col-lg-4 px-0 row justify-content-sm-center align-items-center">
                @Html.RadioButtonFor(model => model.UserType, "BUSINESS", new
                {
                    id = "BusinessCheckBox",
                    onchange = "showBusiness()"
                })
                @AppProcessor.Messagor.GetMessage("BUSINESS")
            </label>
        </div>
    </div>
    <div id="business" class="mb-3">
        <h5 class="px-sm-4">Thông tin doanh nghiệp</h5>
        <div class="form-group row mb-1">
            <div class="form-group row col-lg-6 mb-2">
                @Html.TitleFor(model => model.UnionName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-lg-9">
                    @Html.TextBoxFor(model => model.UnionName, new { @class = "form-control col-lg-12", placeholder = AppProcessor.Messagor.GetMessage("Customer_Label_UnionName") })
                    @Html.ValidationMessageFor(model => model.UnionName, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group row col-lg-6 mb-2">
                @Html.TitleFor(model => model.PositionName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-lg-9">
                    @Html.TextBoxFor(model => model.PositionName, new { @class = "form-control col-lg-12", placeholder = AppProcessor.Messagor.GetMessage("Customer_Label_PositionName") })
                    @Html.ValidationMessageFor(model => model.PositionName, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="form-group row mb-1">
            <div class="form-group row col-lg-6">
                @Html.TitleFor(model => model.BusinessCode, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-lg-9">
                    @Html.TextBoxFor(model => model.BusinessCode, new { @class = "form-control col-lg-12", placeholder = AppProcessor.Messagor.GetMessage("Customer_Label_BusinessCode") })
                    @Html.ValidationMessageFor(model => model.BusinessCode, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group row col-lg-6">
                @Html.TitleFor(model => model.DateGetBusinessCode, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-lg-9">
                    @Html.TextBoxFor(model => model.DateGetBusinessCode, new
                    {
                        id = "dateGetBusinessCode",
                   @class = "form-control col-lg-12",
                        placeholder = "dd/mm/yyyy"
                    })
                    @Html.ValidationMessageFor(model => model.DateGetBusinessCode, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="form-group row mb-1">
            <div class="form-group row col-lg-6">
                @Html.TitleFor(model => model.PlaceGetBusinessCode, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-lg-9">
                    @Html.TextBoxFor(model => model.PlaceGetBusinessCode, new { @class = "form-control col-lg-12", placeholder = AppProcessor.Messagor.GetMessage("Customer_Label_PlaceGetBusinessCode") })
                    @Html.ValidationMessageFor(model => model.PlaceGetBusinessCode, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <hr class="mx-5" />
        <h4 class="px-sm-4">Thông tin người đại diện</h4>
    </div>
    <h4 class="px-sm-4" id="consumer-title">Thông tin cá nhân</h4>
    <div class="form-group row mb-1">
        <div class="form-group row col-lg-6">
            @Html.TitleFor(model => model.FullName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
            <div class="col-lg-9">
                @Html.TextBoxFor(model => model.FullName, new { @class = "form-control col-lg-12", placeholder = AppProcessor.Messagor.GetMessage("Customer_Label_FullName") })
                @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group row col-lg-6">
            @Html.TitleFor(model => model.Gender, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
            <div class="col-lg-9 mt-2">
                <label class="col-6">
                    @Html.RadioButtonFor(model => model.Gender, true)
                    Nam
                </label>
                <label>
                    @Html.RadioButtonFor(model => model.Gender, false)
                    Nữ
                </label>
            </div>
        </div>
    </div>
    <div class="form-group row mb-1">
        <div class="form-group row col-lg-6">
            @Html.TitleFor(model => model.TaxCode, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
            <div class="col-lg-9">
                @Html.TextBoxFor(model => model.TaxCode, new { @class = "form-control col-lg-12", placeholder = AppProcessor.Messagor.GetMessage("Customer_Label_TaxCode") })
                @Html.ValidationMessageFor(model => model.TaxCode, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group row col-lg-6">
            @Html.TitleFor(model => model.PhoneNumber, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
            <div class="col-lg-9">
                @Html.TextBoxFor(model => model.PhoneNumber, new { @class = "form-control col-lg-12", placeholder = AppProcessor.Messagor.GetMessage("Customer_Label_PhoneNumber") })
                @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="form-group row mb-1">
        <div class="form-group row col-lg-6">
            @Html.TitleFor(model => model.Address, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
            @*<p class="col-sm-3 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("Union_Address")</p>*@
            <div class="col-lg-9">
                <div class="d-flex">
                    <div>
                        @Html.TextAreaFor(model => model.Address, new { @class = "form-control col-lg-12", placeholder = AppProcessor.Messagor.GetMessage("Customer_Label_Address"), @readonly = "readonly", cols = "40" })
                        @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
                    </div>
                    <div>
                        <a class="btn border-0 radius-3 p-2 text-600 text-90 pull-right" data-modal="true" data-modal-id="EditAddress" id="addressButton" data_width="1024px" href="/Cate/Customer/EditAddress">
                            <i class="fas fa-edit text-primary fa-2x"></i>
                        </a>
                    </div>
                </div>
                @Html.ValidationMessageFor(model => model.PlaceGetBusinessCode, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="form-group row mb-1">
        <div class="form-group row col-lg-6">
            @Html.TitleFor(model => model.Email, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
            <div class="col-lg-9">
                @Html.TextBoxFor(model => model.Email, new { @class = "form-control col-lg-12", placeholder = AppProcessor.Messagor.GetMessage("Customer_Label_Email") })
                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group row col-lg-6">
            @Html.TitleFor(model => model.Zalo, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
            <div class="col-lg-9">
                @Html.TextBoxFor(model => model.Zalo, new { @class = "form-control col-lg-12", placeholder = AppProcessor.Messagor.GetMessage("Customer_Label_Zalo") })
                @Html.ValidationMessageFor(model => model.Zalo, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <hr class="mx-5" />
    <h4 class="px-sm-4">Thông tin giấy tờ</h4>
    <div class="form-group row mb-1">
        <div class="form-group row col-lg-6">
            @Html.TitleFor(model => model.PageType, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
            <div class="col-lg-9 mt-2 row">
                <label class="col-4">
                    @Html.RadioButtonFor(model => model.PageType, 2, new
                   {
                       onchange = "showCCCD()",
                       id = "PageTypeCheckBox",

                   })
                    CCCD
                </label>
                <label class="col-4">
                    @Html.RadioButtonFor(model => model.PageType, 1, new
                   {
                       onchange = "showCCCD()",
                       id = "PageTypeCheckBox",

                   })
                    Passport
                </label>
                <label class="col-4">
                    @Html.RadioButtonFor(model => model.PageType, 0, new
                   {
                       onchange = "showCCCD()",
                       id = "PageTypeCheckBox",

                   })
                    Khác
                </label>
            </div>
        </div>
    </div>
    <div class="form-group row mb-1">
        <div class="form-group row col-lg-3">
            <p id="ct_label" class="col-sm-5 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("Customer_Label_CitizenIdentification")</p>
            <p id="passport_label" class="col-sm-5 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("Customer_Label_Passport")</p>
            <p id="other_label" class="col-sm-5 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("Customer_Label_PageNumber")</p>
            <div class="col-lg-7">
                @Html.TextBoxFor(model => model.CitizenIdentification, new { @class = "form-control col-lg-12", placeholder = "" })
                @Html.ValidationMessageFor(model => model.CitizenIdentification, "", new { @class = "text-danger" })
            </div>
        </div>
        <div id="place_get_ct" class="form-group row col-lg-9">
            <div class="form-group row col-lg-7">
                @Html.TitleFor(model => model.PlaceGetCitizenIdentification, new { @class = "col-sm-4 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-lg-8">
                    @Html.TextBoxFor(model => model.PlaceGetCitizenIdentification, new { @class = "form-control col-lg-12", placeholder = AppProcessor.Messagor.GetMessage("Customer_Label_PlaceGetCitizenIdentification") })
                    @Html.ValidationMessageFor(model => model.PlaceGetCitizenIdentification, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group row col-lg-5">
                @Html.TitleFor(model => model.DateGetCitizenIdentification, new { @class = "col-sm-5 pl-1 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-lg-7">
                    @Html.TextBoxFor(model => model.DateGetCitizenIdentification, new
                    {
                        id = "DateGetCitizenIdentification",
                   @class = "form-control col-lg-12",
                        placeholder = "dd/mm/yyyy"
                    })
                    @Html.ValidationMessageFor(model => model.DateGetCitizenIdentification, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

    </div>
</div>

<script type="text/javascript">
    var ttKH = @Html.Raw(Json.Encode(Model))
    $(document).ready(function () {
        showBusiness();
        showCCCD();
        getAddress(ttKH)
        updateAddessHref(ttKH)
    });

    $("#dateGetBusinessCode").datepicker("remove");
    $("#dateGetBusinessCode").datepicker({
        format: "dd/mm/yyyy",
        autoclose: true
    });
    $("#dateGetBusinessCode").datepicker().trigger("update");

    function showBusiness() {
        $("#business").hide()
        $("#consumer-title").hide()

        const checked = $('input[name="UserType"]:checked').val();
        if (checked === 'BUSINESS') {
            $("#business").show()
        } else {
            $("#consumer-title").show()
        }
    }

    function showCCCD() {
        $("#ct_label").hide()
        $("#passport_label").hide()
        $("#other_label").hide()

        const checked = $('input[name="PageType"]:checked').val();

        switch (checked) {
            case '1':
                $("#passport_label").show()
                $("#place_get_ct").hide()
                break;
            case '2':
                $("#ct_label").show()
                $("#place_get_ct").show()
                break;
            default:
                $("#other_label").show()
                $("#place_get_ct").hide()
        }
    }
    function OnChangeProvince(cbbProvince, cbbDistrict) {
        if ($("#ProvinceName").length > 0) {
            $("#ProvinceName").val($(cbbProvince).children("option:selected").text());
        }

        var selectedProvince = $(cbbProvince).val();
        var urlDistrictsViaProvince =
            "@Url.Action("GetDistrictsBelongProvince", "Ajax", new { area = "Cate" })?provinceIds=" + selectedProvince;
        $.ajax({
            type: "GET",
            url: urlDistrictsViaProvince,
            dataType: "JSON",
            success: function(response) {
                $(cbbDistrict).empty();
                $(cbbDistrict).append('<option value=""></option>');

                $.each(response.Districts,
                    function(index, item) {
                        $(cbbDistrict).append('<optgroup label="' + index + '">');
                        $.each(item,
                            function(idx, district) {
                                $(cbbDistrict).append('<option value="' + district.DistrictId + '">' + district.DistrictName + "</option>");
                            });
                        $(cbbDistrict).append('</optgroup>');
                    });
            }
        });
    }

    function OnChangeDistrict(cbbDistrict, cbbWard) {
        if ($("#DistrictName").length > 0) {
            $("#DistrictName").val($(cbbDistrict).children("option:selected").text());
        }

        var selectedDistrict = $(cbbDistrict).val();
        var urlWardsViaDistrict =
            "@Url.Action("GetWardsBelongDistrict", "Ajax", new { area = "Cate" })?districtIds=" + selectedDistrict;
        $.ajax({
            type: "GET",
            url: urlWardsViaDistrict,
            dataType: "JSON",
            success: function(response) {
                $(cbbWard).empty();
                $(cbbWard).append('<option value=""></option>');

                $.each(response.Wards,
                    function(index, item) {
                        $(cbbWard).append('<optgroup label="' + index + '">');
                        $.each(item,
                            function(idx, ward) {
                                $(cbbWard).append('<option value="' + ward.WardId + '">' + ward.WardName + "</option>");
                            });
                        $(cbbWard).append('</optgroup>');
                    });
            }
        });
    }

    function OnChangeWard(cbbWard, cbbStreet) {
    if ($("#WardName").length > 0) {
        $("#WardName").val($(cbbWard).children("option:selected").text());
    }

    var selectedWard = $(cbbWard).val();
    var urlStreetsViaWard =
        "@Url.Action("GetStreetsBelongWard", "Ajax", new { area = "Cate" })?wardId=" + selectedWard;
    $.ajax({
        type: "GET",
        url: urlStreetsViaWard,
        dataType: "JSON",
        success: function(response) {
            $(cbbStreet).empty();
            $(cbbStreet).append('<option value=""></option>');

            $.each(response.Streets,
                function (index, item) {
                    $(cbbStreet).append('<option value="' + item.StreetId + '">' + item.StreetName + "</option>");
                });
        }
    });


    }

    function OnChangeStreet(cbbStreet) {
        if ($("#StreetName").length > 0) {
            $("#StreetName").val($(cbbStreet).children("option:selected").text());
        }

    }

</script>