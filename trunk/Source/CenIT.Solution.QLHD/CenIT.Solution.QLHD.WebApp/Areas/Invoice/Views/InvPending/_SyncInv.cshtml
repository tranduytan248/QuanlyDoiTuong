@using TSFramework.App.Processors
@model Modules.Major.Areas.Invoice.Data.ConfirmInvModel

@{
    ViewBag.Title = $"{AppProcessor.Messagor.GetMessage("Modal_Title_SyncInv")} <b>[{(Model.TotalInvs <= 1 ? $"{Model.Pattern};{Model.Serial}-{Model.InvKey}" :$"{Model.TotalInvs} Hóa đơn")}]</b>";
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    primary
}

@section FormBody{
    @using (Ajax.BeginForm("SyncInv", "InvPending", new { area = "Invoice" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "PendingInv_OnProcessSuccess(data, 'SyncInv')"
    }, new { @class = "form-horizontal", id = "SyncInv" }))
    {
        <div id="bodyForm">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.InvId)
            @Html.HiddenFor(model => model.InvKey)
            @Html.HiddenFor(model => model.InvNo)
            @Html.HiddenFor(model => model.Pattern)
            @Html.HiddenFor(model => model.Serial)
            @Html.HiddenFor(model => model.CreatedOn)
            @Html.HiddenFor(model => model.TotalInvs)
            @Html.HiddenFor(model => model.IsOldVersion)
            <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
            <hr />
        </div>
    }
}