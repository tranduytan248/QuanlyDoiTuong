@Html.RenderScripts(ScriptPosition.BodyInside)

<script type="text/javascript">

    //debugger;
    Dropzone.autoDiscover = false;

    $(function () {
        @{
	        foreach (var form in Model.ListHandleForms)
	        {
		        @Html.Raw($"initDropzoneUpload(\"#DossierHandleResult_{EHashMD5.CalculateMD5Hash(form.FormId.ToString())}\",\"SAV_Dossier_Tasks\");")
                if (form.RequireUpload)
                {
			        @Html.Raw($"$('[name=\"DossierHandleResult.{EHashMD5.CalculateMD5Hash(form.FormId.ToString())}\"]').attr('required',true);")
		        }
	        }
        }

    });

    function initDropzoneUpload(ele, sTypeObject) {

        try {

            $(ele).addClass('dropzone');
            var myDropzone = new Dropzone(ele, {

                url:"@Url.Action("UploadFile", new{ dossierId = Model.DossierId })&taskId=@Model.TaskId&sTypeObject="+sTypeObject,
                method:"POST",
                parallelUploads:2,
                autoProcessQueue:true,
                paramName:"refFile",

                previewTemplate: $('#preview-template').html(),

                thumbnailHeight: 120,
                thumbnailWidth: 120,
                maxFilesize: 15,
                filesizeBase: 1000,

                addRemoveLinks: true,

                acceptedFiles:"image/*,application/pdf",
                init: function() {

                    thisDropzone = this;
                    this.on("success", function(file, responseText) {
                        var hiddenEle = ele.replace('_','.').replace("#",'');

                        if(!responseText.status){
                            file.previewElement.classList.toggle('dz-error');
                            file.previewElement.classList.toggle('dz-success');

                            var errorDisplay = file.previewElement.querySelectorAll('[data-dz-errormessage]');
                            errorDisplay[0].innerHTML = responseText.msg;
                        }
                        else if(responseText.status){
                            $('[name="{0}"]'.format(hiddenEle)).removeAttr('required');

                            file._removeLink.remove();

                            var fileId = responseText.data.fileId;
                            var fileExt = responseText.data.fileExt;

                            var divEle = document.createElement('div');
                            divEle.className = 'text-center w-100 mt-1 tools';

                            var viewButton = document.createElement('a');
                            viewButton.setAttribute("fileId",fileId);
                            viewButton.setAttribute("fileExt",fileExt);
                            viewButton.setAttribute("data-modal",true);
                            viewButton.setAttribute("data-modal-id","ViewRefFile");
                            viewButton.setAttribute("data_width","1024px");

                            viewButton.className = 'btn btn-outline-primary btn-xs mr-1 viewUploadFile';
                            viewButton.href = "@Url.Action("ViewDoc","Doc", new{area = "Cate"})?fileId=" + fileId;
                            viewButton.innerHTML = '<i class="far fa-eye"></i>&nbsp;Xem';
                            divEle.appendChild(viewButton);

                            var _this = this;

                            var delButton = document.createElement('a');
                            delButton.setAttribute("fileId",fileId);
                            delButton.setAttribute("fileExt",fileExt);

                            delButton.className = 'btn btn-outline-danger btn-xs mr-1 delUploadFile';
                            delButton.href = "javascript:void(0);";
                            delButton.innerHTML = '<i class="fas fa-trash-alt"></i>&nbsp;Xoá';
                            delButton.onclick = function(){
                                var fileId = this.getAttribute('fileid');
                                var fileExt = this.getAttribute('fileext');
                                $.ajax({
                                    url: "@Url.Action("DelUploadFile")",
                                    data: {
                                        fileId: fileId
                                    },
                                    type: 'POST',
                                    success: function (data) {
                                        if (data.status) {
                                            toastr.success(data.msg);
                                            _this.removeFile(file);
                                            if(_this.files.length <=0 ){
                                                $('[name="{0}"]'.format(hiddenEle)).attr('required', true);
                                            }
                                        } else {
                                            toastr.error(data.msg);
                                        }},
                                    error: function (data) {
                                        toastr.error(data.msg);
                                    }
                                });
                            }
                            divEle.appendChild(delButton);
                            file.previewTemplate.appendChild(divEle);
                        }
                    });
                    this.on("error", function(file, errormessage, xhr){
                        if(xhr) {
                            var response = JSON.parse(xhr.responseText);
                            alert(response.message);
                        }
                    });
                },
                thumbnail: function (file, dataUrl) {
                    if (file.previewElement) {
                        $(file.previewElement).removeClass("dz-file-preview");
                        $(file.previewElement).find("[data-dz-thumbnail]").each(function () {
                            var thumbnailElement = this;
                            thumbnailElement.alt = file.name;
                            thumbnailElement.src = dataUrl;
                        })

                        setTimeout(function () { $(file.previewElement).addClass("dz-image-preview") }, 1)
                    }
                }
            });// new Dropzone

            myDropzone.options.dictDefaultMessage = "Thả tệp vào đây để tải lên";
            myDropzone.options.dictFallbackMessage = "Trình duyệt của bạn không hỗ trợ kéo và thả tệp để tải lên.";
            myDropzone.options.dictFallbackText = "Vui lòng sử dụng biểu mẫu dự phòng bên dưới để tải tệp của bạn lên.";
            myDropzone.options.dictFileTooBig = "Tệp quá lớn ({{filesize}}MiB). Kích thước tệp tối đa: {{maxFilesize}}MiB.";
            myDropzone.options.dictInvalidFileType = "Bạn không thể tải lên các tệp thuộc loại này.";
            myDropzone.options.dictResponseError = "Máy chủ phản hồi mã {{statusCode}}.";
            myDropzone.options.dictCancelUpload = "Hủy tải lên";
            myDropzone.options.dictCancelUploadConfirmation = "Bạn có chắc chắn muốn hủy việc tải lên này không?";
            //myDropzone.options.dictRemoveFile = "Xóa tập tin";
            myDropzone.options.dictRemoveFile = "<span class='fa fa-trash text-danger text-150'></span>";

            myDropzone.options.dictMaxFilesExceeded = "Bạn không thể tải lên bất kỳ tập tin nào nữa.";

            myDropzone.on('addedfile', function(file) {
                $(file.previewElement).attr('data-rel', "tooltip");
                $(file.previewElement).attr('title', file.name);
                var ext = file.name.split('.').pop();

                if (ext == "pdf") {
                    $(file.previewElement).find(".dz-image img").attr("src", "/Contents/Modules/Major/imgs/pdf.png");
                } else if (ext.indexOf("doc") != -1 || ext.indexOf("docx") != -1) {
                    $(file.previewElement).find(".dz-image img").attr("src", "/Contents/Modules/Major/imgs/word.png");
                } else if (ext.indexOf("xls") != -1 || ext.indexOf("xlsx") != -1) {
                    $(file.previewElement).find(".dz-image img").attr("src", "/Contents/Modules/Major/imgs/excel.png");
                }
                $('[data-rel="tooltip"]').tooltip({ trigger: 'hover' });
            });
            myDropzone.on('removedfile', function(file) {
                $("[role='tooltip']").remove();
            });

        } catch (err) {
            $(ele).addClass('p-0')
            .find('.fallback').removeClass('d-none')
            .end().find('.dz-default').addClass('d-none')
            .end().find('input[type=file]').aceFileInput({
