@using TSFramework.App.Processors
@model Cores.Cate.Models.CateLandCalculationModel

@Html.AntiForgeryToken()

@Html.HiddenFor(model => model.LandCalculationId)

<div class="form-group row">
    @Html.TitleFor(model => model.ContentLandId, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-8">
        @Html.DropDownListFor(model => model.ContentLandId, new SelectList(Model.ListContentLands.OrderBy(x => x.ContentLandId), "ContentLandId", "ContractTypeAndContentLand"), "", new { id = "ContentLandDropdown", @class = "form-control" })
        @Html.ValidationMessageFor(model => model.ContentLandId, "", new { @class = "text-danger" })
    </div>
</div>
