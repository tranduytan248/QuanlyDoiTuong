@using Newtonsoft.Json
@using TSFramework.App.Processors
@model Cores.Major.Models.MajorProcedureStepModel

<div class="card dcard mb-3 col-12">
    <div class="card-header">
        <h5 class="card-title text-120 text-500 text-primary-d2 my-auto">
            <i class="fas fa-user-shield"></i>&nbsp;@Html.LabelFor(model => model.HandledBy)
        </h5>
        <div class="card-toolbar no-border">
            <a href="#" data-action="toggle" class="card-toolbar-btn btn btn-sm radius-1 btn-outline-default mx-2px">
                <i class="fa fa-angle-double-up w-2 mx-1px"></i>
            </a>
        </div>
    </div><!-- /.card-header -->
    <div class="card-body p-0 collapse show">
        <div class="row py-3">
            <div class="col-12 mb-3">
                @Html.Button(true, "AddHandler", Url.Action("AddHandler", new { area = "Major", stepId = Model.StepId, procedureId = Model.ProcedureId }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "card-toolbar-btn btn px-4 btn-outline-purple mb-1", title = "Thêm thẩm quyền xử lý", data_rel = "tooltip" })
            </div>
            <div class="col-sm-12">
                <table id="ListHandlers" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                    <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                        <tr>
                            <th class="w-75">@AppProcessor.Messagor.GetMessage("Step_Handler")</th>
                            @*<th class="">@AppProcessor.Messagor.GetMessage("Step_AllowChangeHandler")</th>*@
                            @*<th class="">@AppProcessor.Messagor.GetMessage("Step_AllowSwitchHandler")</th>*@
                            @*<th class="">@AppProcessor.Messagor.GetMessage("Position_Title")</th>*@
                            @*<th class="">@AppProcessor.Messagor.GetMessage("Staff_Title")</th>*@
                            <th class="">@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    //debugger;

    $(document).ready(function () {
        _initTableHandlers();
    });

    var _tableHandlers;

    function _initTableHandlers() {
    _tableHandlers = $("#ListHandlers").DataTable({
        fixedHeader: {
            header: true,
            footer: true
        },
        "Responsive": true,
        "language": {
            "processing":
                "<div class='overlay'><i class='fas fa-cog fa-spin'></i></div>"
        },
        "lengthChange": false,
        "processing": true,
        "serverSide": false,
        "searching": false,
        "paging": false, "info": false,
        "columns": [
            {
                "data": "UnionName",
                "defaultContent": "",
                "render": function (data, type, row, meta) {
                    var htmlTemplate = '<span class="text-105">Đơn vị: <b>{0}</b></span ><div class="text-100 text-primary-d1">Phòng ban: <b>{1}</b></div><div class="text-100 text-primary-d1">Chức vụ: <b>{2}</b></div><div class="text-100 text-primary-d1 mb-2">Nhân viên: <b>{3}</b></div>';
                    var htmlCheckboxTemplate = '<p><i class="w-3 text-center fa fa-check text-110 text-success"></i>{0}</p>';

                    if (type == "display") {
                        var displayHtml = htmlTemplate.format(data, row.DeptName ?? "", row.PositionName ?? "", row.StaffName ?? "");

                        if (row.AllowChangeHandler) {
                            if (row.ListStepNameChanges != null && row.ListStepNameChanges.length > 0) {
                                var htmlStepTemplates = "";
                                $.each(row.ListStepNameChanges, function (idx, stepName) {
                                    htmlStepTemplates += '<span class="d-inline-block radius-round bgc-purple-l2 text-dark-tp3 text-90 px-25 py-3px mx-2px my-2px">{0}</span>'.format(stepName);
                                });

                                var htmlStepChangeTemplate = '<div class="text-left d-inline-flex flex-wrap">{0}</div>'.format(htmlStepTemplates);
                                displayHtml += htmlCheckboxTemplate.format("@AppProcessor.Messagor.GetMessage("Step_AllowChangeHandler")" + " " + htmlStepChangeTemplate);
                            } else {
                                displayHtml += htmlCheckboxTemplate.format("@AppProcessor.Messagor.GetMessage("Step_AllowChangeHandler")");
                            }
                        }
                        if (row.AllowSwitchHandler) {
                            displayHtml += htmlCheckboxTemplate.format("@AppProcessor.Messagor.GetMessage("Step_AllowSwitchHandler")");
                        }
                        return displayHtml;
                    }
                }
            },
            //{
            //    "data": "PositionName",
            //    "defaultContent": ""
            //},
            //{
            //    "data": "StaffName",
            //    "defaultContent": "",
            //},
            {
                "data": "StepId",
                "style": "width:100px;",
                "orderable": false,
                "render": function (data, type, row, meta) {
                    var html = '<span class="d-none d-lg-inline">';

                    if (type === "display") {
                        html += _renderButton(true,
                            "EditHandler",
                            "btn px-4 btn-outline-primary mr-1 v-hover",
                            "/Major/Procedure/EditHandler?stepId=" + data + "&unionId=" + row.UnionId,
                            '<i class="far fa-edit text-120"></i>',
                            "Cập nhật");

                        html += _renderButton(true,
                            "DeleteHandler",
                            "btn px-4 btn-outline-danger mr-1 v-hover",
                            "/Major/Procedure/DeleteHandler?stepId=" + data + "&unionId=" + row.UnionId,
                            '<i class="far fa-trash-alt text-120"></i>',
                            "Xoá");
                    }
                    html += "</span>";

                    return html;
                }
            }
        ]
    });

    var dataHandlers = JSON.parse('@Html.Raw(JsonConvert.SerializeObject(Model.DataHandlers))');
    if (typeof dataHandlers != null) {
        _tableHandlers.clear().rows.add(dataHandlers).draw();
        _tableHandlers.column(0).data().sort();
    }
}

    function HandlerStep_OnProcessSuccess(response, formId) {
        if (response.status != undefined) {
            if ($("#ModalContent #modal_" + formId + " #chkNotDismissModal").is(":checked")) {
                if (response.status != undefined) {
                    eval(response.message);
                    if (response.status) {
                        var jsonDataHandlers = JSON.parse(response.data);
                        _tableHandlers.clear().rows.add(jsonDataHandlers).draw();
                        $("#EditStep input[type='hidden'][id='WarningSave']").val("True");
                    }

                    response.status = undefined;
                    var urlAction = $("#ModalContent #modal_" + formId + " form").attr("action");
                    $("#ModalContent #modal_" + formId + " #modal-content").load(urlAction, function (data, textStatus, xhr) {
                        _initElement();
                    });
                }
            } else {
                $("#ModalContent #modal_" + formId).modal("hide");
                $("#ModalContent #modal_" + formId).on("hidden.bs.modal",
                    function () {
                        if (response.status != undefined) {
                            eval(response.message);
                            if (response.status) {
                                var jsonDataHandlers = JSON.parse(response.data);
                                _tableHandlers.clear().rows.add(jsonDataHandlers).draw();
                                $("#EditStep input[type='hidden'][id='WarningSave']").val("True");
                            }
                            response.status = undefined;
                        }
                    });
            }
        } else {
            $("#ModalContent #modal_" + formId + " #bodyForm").html(response);
        }
    }

</script>