@using TSFramework.App.Processors
@model Modules.Major.Areas.Major.Models.ContractModel

@Html.AntiForgeryToken()

@Html.HiddenFor(model => model.DossierId)
@Html.HiddenFor(model => model.DossierCode)
@Html.HiddenFor(model => model.DossierName)

<div id="ApproveDossier">
    <div class="form-group row">
        @Html.TitleFor(model => model.ContractNo, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-4">
            @Html.TextBoxFor(model => model.ContractNo, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Contract_No") })
            @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.ReceivedOn, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-3">
            @*<div class="input-group date" data-provide="datepicker">
                    <input class="form-control" id="wodate1" name="date" placeholder="MM.YYYY" value="" bootstrap-datepicker="" data-date-end-date="0d">
                    <div class="input-group-addon">
                        <i class="fa fa-calendar"></i>
                    </div>
                </div>*@
            <div class="input-group">
                @Html.TextBoxFor(model => model.ReceivedOn, "{0:dd/MM/yyyy}", new { @class = "form-control col-md-12 datepicker", placeholder = AppProcessor.Messagor.GetMessage("Contract_ReceivedOn") })
                <div class="input-group-addon input-group-append">
                    <div class="input-group-text">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.ReceivedOn, "", new { @class = "text-danger" })
        </div>
        @Html.TitleFor(model => model.ConfirmOn, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-3">
            <div class="input-group">
                @Html.TextBoxFor(model => model.ConfirmOn, "{0:dd/MM/yyyy}", new { @class = "form-control col-md-12 datepicker", placeholder = AppProcessor.Messagor.GetMessage("Contract_ConfirmOn") })
                <div class="input-group-addon input-group-append">
                    <div class="input-group-text">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.ConfirmOn, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        @Html.TitleFor(model => model.HandleTime, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-3">
            @Html.TextBoxFor(model => model.HandleTime, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Contract_HandleTime") })
            @Html.ValidationMessageFor(model => model.HandleTime, "", new { @class = "text-danger" })
        </div>
        @Html.TitleFor(model => model.GiveResultOn, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-3">
            <div class="input-group">
                @Html.TextBoxFor(model => model.GiveResultOn, "{0:dd/MM/yyyy}", new { @class = "form-control col-md-12 datepicker", placeholder = AppProcessor.Messagor.GetMessage("Contract_GiveResultOn") })
                <div class="input-group-addon input-group-append">
                    <div class="input-group-text">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.GiveResultOn, "", new { @class = "text-danger" })
        </div>
    </div>
</div>
