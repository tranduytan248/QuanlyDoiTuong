@using TSFramework.App.Processors
@model Cores.Major.Models.MajorContractPaymentModel
@using Cores.Major.Enums

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("ContractPayment_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("AddPayment", "ContractPayment", new { area = "Major" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ContractPayment_OnProcessSuccess(data, 'AddPayment')"
    }, new { @class = "form-horizontal", id = "AddPayment" }))
    {
        <div id="bodyForm">
            @if (Model.Status == (int)EnumPaymentStatus.Received)
            {
                @Html.Partial("_PaymentReceived")
            }
            else
            {
                @Html.Partial("_PaymentRefunded")
            }
        </div>
    }
}

@section ContinueForm{

}