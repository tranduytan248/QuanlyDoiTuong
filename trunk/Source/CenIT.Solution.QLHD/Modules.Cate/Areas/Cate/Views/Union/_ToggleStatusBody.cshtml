@using TSFramework.App.Processors
@model Cores.Cate.Models.CateUnionModel

@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.UnionId)
@Html.HiddenFor(model => model.UnionCode)
@Html.HiddenFor(model => model.UnionName)
@Html.HiddenFor(model => model.BelongUnion)
@Html.HiddenFor(model => model.BelongUnionName)
@Html.HiddenFor(model => model.IsActive)
<h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>

<hr class="brc-danger-m1" />

<div class="form-group row">
    <div class="col-md-12">
        @Html.TitleFor(model => model.Reason, new { @class = "col-form-label pr-0 font-bold" })
        @Html.TextAreaFor(model => model.Reason, new { rows = 2, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Reason_Title") })
        @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
    </div>
</div>

