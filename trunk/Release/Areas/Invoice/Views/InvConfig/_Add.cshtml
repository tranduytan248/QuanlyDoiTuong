@using TSFramework.App.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("InvConfig_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

	@using (Html.BeginForm("Add", "InvConfig", new { area = "Invoice" }, FormMethod.Post, new { encType = "multipart/form-data", id = "AddConfig", @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_InvConfig")
        </div>
    }
    
	<script type="text/javascript">
        $('form#AddConfig').ajaxForm({
            success: function (response) {
                if (response.status != undefined) {
                    if ($("#ModalContent #modal_AddConfig #chkNotDismissModal").is(":checked")) {
                        if (response.status != undefined) {
                            eval(response.message);
                            _tableAppConfig.ajax.reload(null, false);
                            response.status = undefined;
                            $("#ModalContent #modal_AddConfig form")[0].reset();
                        }
                    } else {
                        $("#ModalContent #modal_AddConfig").modal("hide");
                        $("#ModalContent #modal_AddConfig").on('hidden.bs.modal',
                            function () {
                                if (response.status != undefined) {
                                    eval(response.message);
                                    _tableAppConfig.ajax.reload(null, false);
                                    response.status = undefined;
                                }
                            });
                    }
                } else {
                    $("#ModalContent #modal_AddConfig" + " #bodyForm").html(response);
                }
            }
        });
    </script>
}

@section ContinueForm{

}