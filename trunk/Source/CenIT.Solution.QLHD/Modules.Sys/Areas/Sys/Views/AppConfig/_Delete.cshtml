@using TSFramework.App.Processors
@model Modules.Sys.Areas.Sys.Models.AppConfigModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("AppConfig_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "AppConfig", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "AppConfig_OnProcessSuccess(data, 'DeleteAppConfig')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.AppKey)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}