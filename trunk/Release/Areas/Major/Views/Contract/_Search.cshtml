@using TSFramework.App.Processors
@model Modules.Major.Areas.Major.Models.SearchContractModel

<div class="card dcard">
    <div class="card-header">
        <h5 class="card-title text-120 text-primary-d2">@AppProcessor.Messagor.GetMessage("Condition_Title")</h5>
        <div class="card-toolbar no-border">
            <a href="#" data-action="toggle" class="card-toolbar-btn btn btn-sm radius-1 btn-outline-default mx-2px">
                <i class="fa fa-angle-double-up w-2 mx-1px"></i>
            </a>
        </div>
    </div>
    <div class="card-body p-0 collapse show">
        <div class="col-md-12 form-horizontal mt-3" id="Search">
            <div class="form-group row">
                <div class="col-md-4 row mt-2">
                    <div class="col-1 col-form-label"></div>
                    @Html.TextBoxFor(model => model.SearchValue, new { @class = "form-control col-11", placeholder = "Tìm kiếm theo số HĐ hoặc họ tên" })
                </div>
                <div class="col-md-4 row mr-4 mt-2">
                    <label for="FromDate" class="col-5 col-form-label font-bold text-right">@Html.DisplayNameFor(model => model.FromDate)</label>
                    @Html.TextBoxFor(model => model.FromDate, "dd/MM/yyyy", new { @class = "col-7 form-control datepicker", placeholder = AppProcessor.Messagor.GetMessage("Common_FromDate") })
                </div>
                <div class="col-md-4 row mt-2">
                    <label for="ToDate" class="col-5 col-form-label font-bold text-right">@Html.DisplayNameFor(model => model.ToDate)</label>
                    @Html.TextBoxFor(model => model.ToDate, "dd/MM/yyyy", new { @class = "col-7 form-control datepicker", placeholder = AppProcessor.Messagor.GetMessage("Common_ToDate") })
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-4 row mt-2">
                    <label for="ListContractStatusIds" class="col-4 col-form-label font-bold text-right">@Html.DisplayNameFor(model => model.ListContractStatusIds)</label>
                    @{
                        var arrStatus = new Dictionary<string, string> { { "-1", "info" }, { "0", "warning" }, { "1", "primary" }, { "2", "secondary" }, { "3", "success" }, { "4", "purple" }, { "99", "danger" } };
                    }
                    <div class="dropdown col-8 d-flex align-items-center">
                        <button class="btn dropdown-toggle w-100 btn-status" type="button" id="contractStatusDropdownButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Chọn trạng thái
                        </button>
                        <button type="button" class="btn btn-link text-danger p-0 ml-2" id="clearAllButton" title="Xóa tất cả" style="display: none;">
                            <i class="fa fa-times"></i>
                        </button>
                        @*<input type="text" class="form-control dropdown-toggle btn-status" id="contractStatusDropdownButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" placeholder="Chọn trạng thái">*@
                        <div class="dropdown-menu p-3 status-menu" aria-labelledby="contractStatusDropdownButton">
                            @foreach (var status in Model.ListContractStatus.OrderBy(s => int.Parse(s.Value)))
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="ListContractStatusIds" value="@status.Value" id="status-@status.Value">
                                    <label class="form-check-label" for="status-@status.Value">
                                        <span class="badge bgc-@arrStatus[status.Value] brc-@arrStatus[status.Value] text-white badge-lg arrowed arrowed-in-right mb-1">
                                            <span class="px-3">@status.Text</span>
                                        </span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-4 row mr-4 mt-2">
                    <label for="ListTypeContractIds" class="col-form-label font-bold col-5 text-right">@Html.DisplayNameFor(model => model.ListTypeContractIds)</label>
                    @Html.DropDownListFor(model => model.ListTypeContractIds, new SelectList(Model.ListTypeContracts, "Value", "Text"), "", new { multiple = true, @class = "form-control col-7", placeholder = AppProcessor.Messagor.GetMessage("Combobox_Select") })
                </div>
                <div class="col-md-4 row mt-2">
                    <label for="ListTypeCusIds" class="col-form-label font-bold col-5 text-right">@Html.DisplayNameFor(model => model.ListTypeCusIds)</label>
                    @Html.SelectFor(model => model.ListTypeCusIds, Model.ListTypeCus, null, new { multiple = true, @class = "form-control col-7", placeholder = AppProcessor.Messagor.GetMessage("Combobox_Select") })
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="col-md-12 text-center">
                <button type="button" class="btn btn-primary" onclick="_tableContracts.ajax.reload(null, false);"><i class="fa fa-search-plus"></i>&nbsp;Tìm kiếm</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const dropdownButton = document.getElementById('contractStatusDropdownButton');
        const clearAllButton = document.getElementById('clearAllButton');
        const checkboxes = document.querySelectorAll('input[name="ListContractStatusIds"]');
        const labels = document.querySelectorAll('.form-check-label');

        checkboxes.forEach(checkbox => {
            checkbox.addEventListener('change', updateDropdownText);
        });

        labels.forEach(label => {
            label.addEventListener('click', function (event) {
                event.stopPropagation();
            });
        });

        clearAllButton.addEventListener('click', function () {
            checkboxes.forEach(checkbox => {
                checkbox.checked = false;
            });
            updateDropdownText();
        });

        function updateDropdownText() {
            const selected = Array.from(checkboxes).filter(i => i.checked).map(i => i.nextElementSibling.textContent.trim());
            dropdownButton.textContent = selected.length > 0 ? selected.join(', ') : 'Chọn trạng thái';
            clearAllButton.style.display = selected.length > 0 ? 'inline-block' : 'none';
        }
    });
</script>


<style>
    .btn-status {
        display: block; /* Đảm bảo button có thể mở rộng chiều ngang */
        width: 100%; /* Để button chiếm toàn bộ chiều rộng của container */
        text-align: left; /* Căn chỉnh văn bản về phía bên trái */
        white-space: normal; /* Cho phép văn bản xuống dòng nếu cần */
        overflow: hidden; /* Ẩn văn bản tràn ra ngoài */
        text-overflow: ellipsis; /* Thêm ellipsis nếu văn bản quá dài */
        word-wrap: break-word; /* Ngắt từ nếu cần */
    }

    .status-menu {
        max-height: 200px; /* Chiều cao tối đa của menu */
        overflow-y: auto; /* Thêm thanh cuộn dọc nếu cần */
        white-space: normal; /* Cho phép text xuống dòng */
        box-sizing: border-box; /* Đảm bảo padding không làm chiều rộng vượt quá */
    }

    .btn-status {
        padding: 0.375rem 0.75rem;
        white-space: normal; /* Cho phép text xuống dòng nếu cần */
        background-color: #ffffff;
        color: #495057;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
    }
</style>
