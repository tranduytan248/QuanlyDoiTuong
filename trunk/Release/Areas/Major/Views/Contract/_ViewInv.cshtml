@using TSFramework.App.Processors
@model Modules.Major.Areas.Major.Models.ViewInvModel
@{
    ViewBag.Title = $"{AppProcessor.Messagor.GetMessage("Inv_Title")} - {AppProcessor.Messagor.GetMessage("Contract_Title")} [{Model.InvNo}-{Model.Pattern}-{Model.Serial}]";
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    success
}

@section FormIcon{
    <i class="fas fa-file-invoice-dollar"></i>
}

@section FormBody{

    @using (Html.BeginForm("PublishInv", "Contract", new { area = "Major" }, FormMethod.Post, new { encType = "multipart/form-data", id = "ViewInv", @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            <div class="col-12">
                <div class="acard card h-100">
                    <div class="card-header pb-15">
                        <div class="card-toolbar no-border">
                            @*@Html.Button(true, "CancelInv", Url.Action("CancelInv", "Inv", new { area = "Invoice", invId = Model.InvId }), "<i class=\"fas fa-recycle\"></i>", AppProcessor.Messagor.GetMessage("CancelInv_Title"), new { @class = "btn btn-danger btn-h-outline-danger text-600 px-3" })*@

                            @*<button id="id-ripple" class="btn btn-danger btn-h-outline-danger text-600 px-3">
                                    <i class="fas fa-recycle"></i>&nbsp;Huỷ hoá đơn
                                </button>*@
                        </div><!-- /.card-toolbar -->
                    </div>

                    <div class="card-body">
                        <div class="row col-12">
                            @Html.Raw(Model.HtmlInv)
                        </div>
                    </div><!-- /.card-body -->
                </div><!-- /.card -->
            </div><!-- /.col -->
        </div>
    }

}

@section SubmitControl{

