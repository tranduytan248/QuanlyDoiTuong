@using TSFramework.App.Enums
@using TSFramework.App.Processors
@model Cores.Cate.Models.CateDocModel

@{
    ViewBag.Title = Html.Raw($"{AppProcessor.Messagor.GetMessage("Doc_Title")} [{Model.FileName}]");
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    info
}

@section FormIcon{
    <i class="fas fa-eye"></i>
}

@section FormBody{

    <style type="text/css">
        iframe img {
            width: -webkit-fill-available;
        }
    </style>
    <div class="row modal-body py-0" id="bodyForm">
        <div class="col-12">
            <a class="btn px-4 btn-outline-success mb-1" name="DownloadRefDoc" onclick="_onDownloadDoc(this);" href="javascript:void(0);" data-href="/Cate/Doc/RefDoc?fileId=@Model.FileId"><i class="fas fa-cloud-download-alt"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Download")</a>
            @{
                if (ConstMIMEType.IsDoc(Model.FileExt) || ConstMIMEType.IsPdf(Model.FileExt))
                {
                    <a href="javascript:void(0);" onclick="_onFullscreen();" class="btn px-4 btn-outline-primary mb-1" id="btnFullScreen">
                        <i class="fa fa-expand d-n-active"></i> Toàn màn hình
                    </a>
                }
            }

        </div>
        <div class="col-12 table-responsive-md" id="DocViewer">
            @{
                if (ConstMIMEType.IsDoc(Model.FileExt) || ConstMIMEType.IsPdf(Model.FileExt))
                {
                    <iframe src='' width='100%' height='100%' style="min-height:calc(100vh - 200px);" frameborder='0' allowfullscreen="true" mozallowfullscreen="true" webkitallowfullscreen="true"></iframe>
                }
                else
                {
                    <div class="pos-rel d-style radius-1 shadow-sm overflow-hidden bgc-brown-m3" id="@Model.FileId">
                        <a href="#" class="show-lightbox" id="img-@Model.FileId">
                            <img class="w-100 d-zoom-2 " style="width: -webkit-fill-available;" src="@Model.UrlPath" alt="Hình ảnh @Model.FileName" data-size="@Model.Dimensions">
                        </a>
                    </div>
                }
            }
        </div>
    </div>

    <script type="text/javascript">
        //debugger;
        @{
	        if (ConstMIMEType.IsDoc(Model.FileExt))
	        {
                @Html.Raw($"var appViewerUrl = '{Html.Raw(ViewBag.AppViewerUrl)}';")
                @Html.Raw($"var docUrl = appViewerUrl.format('{Model.UrlPath}');")
            }
            else if (ConstMIMEType.IsPdf(Model.FileExt))
            {
	            @Html.Raw($"var docUrl = '{Model.UrlPath}';")

            }
        }

        $(document).ready(function () {
            @{
	            if (ConstMIMEType.IsDoc(Model.FileExt) || ConstMIMEType.IsPdf(Model.FileExt))
	            {
                    @Html.Raw("$(\"#DocViewer iframe\").attr(\"src\", docUrl);\r\n            $('#DocViewer iframe').on('load', function () {\r\n                _endWaiting();\r\n                _onFullscreen();\r\n            });")
	            }
	            else
	            {
                    @Html.Raw($"_initGalary(\"#DocViewer\"); $('#img-{Model.FileId}').click();")
	            }
            }
            //_onWaiting();
        });

        function _onFullscreen() {
            var iframe = document.querySelector('#DocViewer iframe');
            // Do fullscreen
            if (iframe.requestFullscreen) {
                iframe.requestFullscreen();
            } else if (iframe.webkitRequestFullscreen) {
                iframe.webkitRequestFullscreen();
            } else if (iframe.mozRequestFullScreen) {
                iframe.mozRequestFullScreen();
            } else if (iframe.msRequestFullscreen) {
                iframe.msRequestFullscreen();
            }
        }

    </script>
}
@section SubmitControl{

}
