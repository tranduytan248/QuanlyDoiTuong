@using TSFramework.App.Processors
@model Cores.Major.Models.MajorContractPaymentModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("ContractPayment_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("AddPayment", "Contract", new { area = "Major", contractId = Model.ContractId }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Payment_OnProcessSuccess(data, 'AddPayment')"
    }, new { @class = "form-horizontal", id = "AddPayment" }))
    {
        <div id="bodyForm">
            @Html.Partial("_Payment")
        </div>
    }
}

