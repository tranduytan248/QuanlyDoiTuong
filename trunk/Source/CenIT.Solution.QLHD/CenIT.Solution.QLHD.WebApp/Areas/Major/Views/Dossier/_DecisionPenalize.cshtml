@using TSFramework.App.Processors
@model Cores.Major.Models.SAVDossierModel

<link rel="stylesheet" href="~/Contents/Base/plugins/bootstrap-datetimepicker/css/bootstrap-datetimepicker.css" />

<div class="" id="DecisionPenalize">
	<input type="hidden" id="ConstructionParticipantId" name="ConstructionParticipantId" />
	<input type="hidden" id="TruongHopViPham" name="TruongHopViPham" />
    <input type="hidden" id="ViolationBehaviorId" name="ViolatedConstructionId" />
    <input type="hidden" id="CongTrinhViPham" name="CongTrinhViPham" />
    <input type="hidden" id="RegulationId" name="RegulationId" />
    <input type="hidden" id="TienPhat_Number" name="TienPhat_Number" />
	<input type="hidden" id="CanCuVBPhapLuat" name="CanCuVBPhapLuat" value="@ViewBag.BasedOnLegalDocuments" />

    <input type="hidden" id="KhacPhucHauQua" name="KhacPhucHauQua" />
	<input type="hidden" id="QDKhacPhucHauQua" name="QDKhacPhucHauQua" />

	<input type="hidden" id="CCKhauTruTaiKhoan" name="CCKhauTruTaiKhoan" />
	<input type="hidden" id="QuyDinhCCKhauTruTaiKhoan" name="QuyDinhCCKhauTruTaiKhoan" />
    
	<div class="form-group row">
		<h3 class="text-center font-500 col-12 text-primary-d2">XỬ LÝ VI PHẠM</h3>
	</div>
	<hr class="brc-danger-m1"/>
    
	<div class="" id="ViolatorInfo">
	</div>

    <hr class="brc-warning-m1" />

	<div class="form-group row">
		<span class="col-11 text-danger-d2 brc-danger-m1">
			<label class="text-danger-m3 text-500" for="HanhViViPham">
				Hành vi vi phạm (*)
			</label>
			<textarea required="" class="form-control shadow-none text-500 text-blue-d3" id="HanhViViPham" name="HanhViViPham" placeholder="Hành vi vi phạm (*)" rows="4"></textarea>
		</span>
	</div>

	<div class="form-group row d-none" id="areaChiTietCuThe">
		<span class="col-11">
			<label class="text-500" for="ChiTietCuThe">
				Chi tiết cụ thể
			</label>
			<textarea class="form-control shadow-none" id="ChiTietCuThe" name="ChiTietCuThe" placeholder="Hiện trạng xây dựng: 
+ Cấu trúc công trình: Nhà 02 tầng. 
+ Hiện trạng đang xây dựng: Đang hoàn thiện tầng 2.
+ Diện tích xây dựng: 6x7= 42m².
" rows="4"></textarea>
		</span>
	</div>

	<div class="form-group row">
		<div class="col-10">
			<span class="text-500">
				Quy định tại
			</span>
			<input readonly="readonly" required="" type="text" placeholder="Quy định tại" class="form-control shadow-none text-500 text-blue-d3" id="QuyDinhXPHC" name="QuyDinhXPHC"/>
		</div>
	</div>
	
</div>

<script type="text/javascript" src="~/Contents/Base/plugins/bootstrap-datetimepicker/js/moment-with-locales.js"></script>
<script type="text/javascript" src="~/Contents/Base/plugins/bootstrap-datetimepicker/js/bootstrap-datetimepicker.js"></script>

<script type="text/javascript">

    $(document).ready(function () {

        //$('#Construction input[name="Construction.LandParcelNo"], #Construction input[name="Construction.MapNo"]').change(function () {
        //    var landParcelNo = $('#Construction input[name="Construction.LandParcelNo"]').val();
        //    var mapNo = $('#Construction input[name="Construction.MapNo"]').val();
        //    $("#DecisionPenalize #LapBienBanTai").val("Thửa đất số {0}, TBĐ số {1}".format(landParcelNo, mapNo));
        //});

        $('#DecisionPenalize [name="HanhViViPham"]').click(function () {
            var eleSelectViolation = $.parseHTML('@Html.Button(true, "SelectViolation", Url.Action("SelectViolation", new { area = "Major", fieldViolatedId = Model.FieldViolatedId }), "<i class=\"fas fa-check-double\"></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-purple btn-h-purple btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right", data_width = "1024px" })');

            document.body.appendChild(eleSelectViolation[0]);
            $(eleSelectViolation).click();
        });
    });

    $(function () {
        $('.datetimepicker').datetimepicker({
            locale: 'vi',
            format: 'DD/MM/YYYY HH:mm',
            icons: {
                time: 'far fa-clock text-green-d1 text-120',
                date: 'far fa-calendar text-blue-d1 text-120',

                up: 'fa fa-chevron-up text-secondary',
                down: 'fa fa-chevron-down text-secondary',
                previous: 'fa fa-chevron-left text-secondary',
                next: 'fa fa-chevron-right text-secondary',

                today: 'far fa-calendar-check text-purple-d1 text-120',
                clear: 'fa fa-trash-alt text-orange-d2 text-120',
                close: 'fa fa-times text-danger text-120'
            },

            // sideBySide: true,

            toolbarPlacement: "top",

            allowInputToggle: true,
            // showClose: true,
            // showClear: true,
            showTodayButton: true,

            //"format": "HH:mm:ss"
        })

        //***** NOTE *******//
        // the above `date/time` picker plugin was designed for BS3.
        // To make it work with BS4, the following piece of code is required
        $('.datetimepicker')
        .on('dp.show', function () {
            $(this).find('.collapse.in').addClass('show')
            $(this).find('.table-condensed').addClass('table table-borderless')

            $(this).find('[data-action][title]').tooltip() // enable tooltip
        })
        // now listen to the `.collapse` events inside this datetimepicker accordion (one `.collapse` is for timepicker, the other one is for datepicker)
        // then add or remove the old `in` BS3 class so the plugin works correctly
        $(document)
        .on('show.bs.collapse', '.bootstrap-datetimepicker-widget .collapse', function () {
            $(this).addClass('in')
        }).on('hide.bs.collapse', '.bootstrap-datetimepicker-widget .collapse', function () {
            $(this).removeClass('in')
        })
    });
        
</script>