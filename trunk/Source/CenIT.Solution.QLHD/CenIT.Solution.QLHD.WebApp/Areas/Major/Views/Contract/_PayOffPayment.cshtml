@using Cores.Major.Enums
@using TSFramework.App.Processors
@model Cores.Major.Models.MajorContractPaymentModel

@Html.AntiForgeryToken()

@Html.HiddenFor(model => model.PaymentId)
@Html.HiddenFor(model => model.ContractId)
@Html.HiddenFor(model => model.IsEdit)
@Html.HiddenFor(model => model.HasTaxForContract)
@Html.HiddenFor(model => model.TaxInfo)

<div id="Payment">
    <div class="form-row">
        <div class="col-md-6">
            @Html.TitleFor(model => model.ContractNo, new { @class = "col-form-label pr-0 font-bold" })
            @Html.TextBoxFor(model => model.ContractNo, new { @readonly = true, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Contract_ContractNo") })
            @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6">
            @Html.TitleFor(model => model.Total, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                @Html.TextBoxFor(model => model.FormatterTotal, new { @readonly = true, @class = "form-control col-md-12 text-500 text-danger-d1 text-110 text-right formatter", placeholder = AppProcessor.Messagor.GetMessage("Contract_Total") })
                <div class="input-group-append">
                    <span class="input-group-text">đ</span>
                </div>
            </div>
            @{
                if (Model.HasTaxForContract)
                {
                    @Html.Raw($"<span class=\"text-danger-d1 text-500\">({Model.TaxInfo})</span>")
                }
            }

            @Html.ValidationMessageFor(model => model.FormatterTotal, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.Total)
        </div>
    </div>
    @{
        if (!Model.HasTaxForContract)
        {
            <div class="form-row">
                @Html.TitleFor(model => model.InfoDiscountContract, new { @class = "col-form-label pr-0 font-bold" })
                <div class="col-md-12">
                    <div class="input-group">
                        @Html.TextAreaFor(model => model.InfoDiscountContract, new { row = 3, @readonly = true, @class = "form-control col-md-12 text-500 text-danger-d1 text-110" })
                    </div>
                </div>
            </div>
        }
    }

    <div class="form-row">
        <div class="col-md-6">
            @Html.TitleFor(model => model.TotalPaidAmount, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                @Html.TextBoxFor(model => model.FormatterTotalPaidAmount, new { @readonly = true, @class = "form-control col-md-12 text-500 text-danger-d1 text-110 text-right formatter", rawValue = Model.TotalPaidAmount, placeholder = AppProcessor.Messagor.GetMessage("ContractPayment_TotalPaidAmount") })
                <div class="input-group-append">
                    <span class="input-group-text">đ</span>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.FormatterTotalPaidAmount, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.TotalPaidAmount)
        </div>
    </div>
    @Html.HiddenFor(model => model.TypePayment)
    @Html.HiddenFor(model => model.TypePaymentName)
    @Html.HiddenFor(model => model.Status)
    @Html.HiddenFor(model => model.StatusName)

    @Html.HiddenFor(model => model.PercentAdvance)
    @Html.HiddenFor(model => model.DiscountRate)
    @Html.HiddenFor(model => model.TaxRate)

    <hr class="border-none border-t-3 brc-grey-l2 border-double">
    <div id="FormArising">

        @{
            var dictTypeArisingColors = new Dictionary<string, string>{
                {$"{(int)EnumPaymentArising.Increase}","success"},
                {$"{(int)EnumPaymentArising.Decrease}","warning"}
            };
            <div class="form-group row" id="eleArising">
                <div class="col-12">
                    <div class="card acard" id="card-5">
                        @if (Model.IsEdit)
                        {
                            <div class="card-header border-0">
                                <div class="form-group row col-12 my-auto pt-2">
                                    <label class="checkbox-inline my-auto">
                                        @Html.CheckBoxFor(model => model.HasArising, new { disabled = true, @class = "checkbox", data_action = "toggle" })
                                        @Html.LabelFor(model => model.HasArising, new { @class = "font-bold" })
                                    </label>
                                </div>
                            </div>
                            <div class="card-body border-t-1 brc-dark-l2 p-0 collapse @(Model.HasArising ? "show" : "")">
                                <div class="form-row p-3">
                                    <div class="col-md-6 disabled">
                                        @{
                                            foreach (var typeArising in Model.ListTypeArisings.OrderBy(ps => ps.Value))
                                            {
                                                <label class="px-0 pt-2">
                                                    @Html.RadioButtonFor(model => model.TypeArising, typeArising.Value, new { onchange = $"_onTypeArising('#Payment #TypeArisingName', '{typeArising.Text}', '#Payment #FormatterArisingAmount' )", realArisingValue = Model.RealArisingValue[typeArising.Value] })
                                                    <span class="badge bgc-@dictTypeArisingColors[typeArising.Value] brc-@dictTypeArisingColors[typeArising.Value] text-white badge-lg arrowed arrowed-in-right mb-1">
                                                        <span class="px-3">@typeArising.Text</span>
                                                    </span>
                                                </label>
                                            }
                                        }
                                        @Html.HiddenFor(model => model.TypeArising)
                                        @Html.HiddenFor(model => model.TypeArisingName)
                                    </div>

                                    <div class="col-md-6">
                                        <div class="input-group">
                                            @Html.TextBoxFor(model => model.FormatterArisingAmount, new { @readonly = true, @class = "form-control col-md-12 text-500 text-danger-d1 text-110 text-right formatter", rawValue = Model.ArisingAmount, placeholder = AppProcessor.Messagor.GetMessage("ContractPayment_ArisingAmount") })
                                            <div class="input-group-append">
                                                <span class="input-group-text">đ</span>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.FormatterArisingAmount, "", new { @class = "text-danger" })
                                        @Html.HiddenFor(model => model.ArisingAmount)
                                    </div>
                                </div>
                            </div>

                        }
                        else
                        {
                            <div class="card-header border-0">
                                <div class="form-group row col-12 my-auto pt-2">
                                    <label class="checkbox-inline my-auto">
                                        @Html.CheckBoxFor(model => model.HasArising, new { @class = "checkbox", data_action = "toggle", onchange = "_onHasArising(this, '#Payment #FormatterArisingAmount')" })
                                        @Html.LabelFor(model => model.HasArising, new { @class = "font-bold" })
                                    </label>
                                </div>
                            </div>
                            <div class="card-body border-t-1 brc-dark-l2 p-0 collapse @(Model.HasArising ? "show" : "")">
                                <div class="form-row p-3">
                                    <div class="col-md-6">
                                        @{
                                            foreach (var typeArising in Model.ListTypeArisings.OrderBy(ps => ps.Value))
                                            {
                                                <label class="px-0 pt-2">
                                                    @Html.RadioButtonFor(model => model.TypeArising, typeArising.Value, new { onchange = $"_onTypeArising('#Payment #TypeArisingName', '{typeArising.Text}', '#Payment #FormatterArisingAmount' )", realArisingValue = Model.RealArisingValue[typeArising.Value] })
                                                    <span class="badge bgc-@dictTypeArisingColors[typeArising.Value] brc-@dictTypeArisingColors[typeArising.Value] text-white badge-lg arrowed arrowed-in-right mb-1">
                                                        <span class="px-3">@typeArising.Text</span>
                                                    </span>
                                                </label>
                                            }
                                        }
                                        @Html.HiddenFor(model => model.TypeArisingName)
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-group">
                                            @Html.TextBoxFor(model => model.FormatterArisingAmount, new { @class = "form-control col-md-12 text-500 text-danger-d1 text-110 text-right formatter", rawValue = Model.ArisingAmount, placeholder = AppProcessor.Messagor.GetMessage("ContractPayment_ArisingAmount"), onchange = "_onChangeArisingAmount(this,'#Payment #ArisingAmount','#Payment #FormatterLiquidationAmount','#Payment #FormatterDiscountAmount','#Payment #FormatterTotalPaidAmount','#Payment #FormatterPaidAmount','#Payment #PaidAmount','#Payment [name=\"TypeArising\"]:checked','#Payment #HasArising');" })
                                            <div class="input-group-append">
                                                <span class="input-group-text">đ</span>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.FormatterArisingAmount, "", new { @class = "text-danger" })
                                        @Html.HiddenFor(model => model.ArisingAmount)
                                    </div>
                                </div>
                            </div>

                        }
                    </div>
                </div>
            </div>
        }

        <hr class="border-none border-t-3 brc-grey-l2 border-double">

        <div class="form-row">
            <div class="col-md-6">
                @Html.TitleFor(model => model.FormatterLiquidationAmount, new { @class = "col-form-label pr-0 font-bold" })
                <div class="input-group">
                    @Html.TextBoxFor(model => model.FormatterLiquidationAmount, new { @readonly = true, @class = "form-control col-md-12 text-500 text-danger-d1 text-110 text-right formatter", rawValue = Model.LiquidationAmount, placeholder = AppProcessor.Messagor.GetMessage("ContractPayment_LiquidationAmount"), onchange = "_onChangeAmount(this,'#Payment #LiquidationAmount');" })
                    <div class="input-group-append">
                        <span class="input-group-text">đ</span>
                    </div>
                </div>
                @Html.ValidationMessageFor(model => model.LiquidationAmount, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.LiquidationAmount)
            </div>
            @{
                if (!Model.HasTaxForContract)
                {
                    <div class="col-md-6">
                        @Html.TitleFor(model => model.DiscountAmount, new { @class = "col-form-label pr-0 font-bold" })
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text text-500 text-danger">20% * @Model.DiscountRate%</span>
                            </div>
                            @Html.TextBoxFor(model => model.FormatterDiscountAmount, new { @readonly = true, @class = "form-control col-md-12 text-500 text-danger-d1 text-110 text-right formatter", formulaDiscount = Model.DiscountFormula, rawValue = Model.DiscountAmount, placeholder = AppProcessor.Messagor.GetMessage("ContractPayment_DiscountAmount"), onchange = "_onChangeAmount(this,'#Payment #DiscountAmount');" })
                            <div class="input-group-append">
                                <span class="input-group-text">đ</span>
                            </div>
                        </div>
                        @Html.ValidationMessageFor(model => model.DiscountAmount, "", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.DiscountAmount)
                    </div>
                }
                @*else
                    {
                        <div class="col-md-6">
                            @Html.TitleFor(model => model.TaxAmount, new { @class = "col-form-label pr-0 font-bold" })
                            <div class="input-group">
                                @Html.TextBoxFor(model => model.FormatterTaxAmount, new { @readonly = true, @class = "form-control col-md-12 text-500 text-danger-d1 text-110 text-right formatter", rawValue = Model.TaxAmount })
                                <div class="input-group-append">
                                    <span class="input-group-text">đ</span>
                                </div>
                            </div>
                            @Html.HiddenFor(model => model.TaxAmount)
                        </div>
                    }*@
            }

        </div>

        <hr class="border-none border-t-3 brc-grey-l2 border-double">
    </div>

    <div class="form-row">
        @{
            if (Model.IsEdit)
            {
                <div class="col-md-5">
                    @Html.TitleFor(model => model.PaidAmount, new { @class = "col-form-label pr-0 font-bold" })
                    <div class="input-group">
                        @Html.TextBoxFor(model => model.FormatterPaidAmount, new { @readonly = true, @class = "form-control col-md-12 text-500 text-danger-d1 text-110 text-right formatter", rawValue = Model.PaidAmount, placeholder = AppProcessor.Messagor.GetMessage("ContractPayment_PaidAmount"), onchange = $"_onChangePaidAmount('#Payment [name=\"FormatterPaidAmount\"]',{Model.PaidAmount} )" })
                        <div class="input-group-append">
                            <span class="input-group-text">đ</span>
                        </div>
                    </div>
                    @Html.ValidationMessageFor(model => model.PaidAmount, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.PaidAmount)
                </div>
            }
            else
            {
                <div class="col-md-5">
                    @Html.TitleFor(model => model.PaidAmount, new { @class = "col-form-label pr-0 font-bold" })
                    <div class="input-group">
                        @Html.TextBoxFor(model => model.FormatterPaidAmount, new { @readonly = true, @class = "form-control col-md-12 text-500 text-danger-d1 text-110 text-right formatter", rawValue = Model.PaidAmount, placeholder = AppProcessor.Messagor.GetMessage("ContractPayment_PaidAmount") })
                        <div class="input-group-append">
                            <span class="input-group-text">đ</span>
                        </div>
                    </div>
                    @Html.ValidationMessageFor(model => model.PaidAmount, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.PaidAmount)
                </div>
            }
        }

        @{
            if (Model.IsEdit)
            {
                <div class="col-md-7">
                    @Html.TitleFor(model => model.RefDocNo, new { @class = "col-form-label pr-0 font-bold" })
                    @Html.TextBoxFor(model => model.RefDocNo, new { @readonly = true, @class = "form-control col-md-11", placeholder = AppProcessor.Messagor.GetMessage("ContractPayment_RefDocNo") })
                    @Html.ValidationMessageFor(model => model.RefDocNo, "", new { @class = "text-danger" })
                </div>
            }
        }

    </div>

    <div class="form-row">
        <div class="col-md-6">
            @Html.TitleFor(model => model.PaymentMethod, new { @class = "col-form-label pr-0 font-bold" })
            @Html.DropDownListFor(model => model.PaymentMethod, new SelectList(Model.ListPaymentMethods, "Value", "Text"), "", new { @class = "form-control col-md-12", onchange = "_onChangeCombo(this, '#Payment #PaymentMethodName',false)" })
            @Html.ValidationMessageFor(model => model.PaymentMethod, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.PaymentMethodName)
        </div>
        <div class="col-md-6">
            @Html.TitleFor(model => model.PaidOn, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                @Html.TextBoxFor(model => model.PaidOn, "{0:dd/MM/yyyy}", new { @class = "form-control col-md-12 datepicker", placeholder = AppProcessor.Messagor.GetMessage("Contract_PaidOn") })
                <div class="input-group-append">
                    <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.PaidOn, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-row">
        <div class="col-md-12">
            @Html.TitleFor(model => model.Note, new { @class = "col-form-label pr-0 font-bold" })
            @Html.TextAreaFor(model => model.Note, new { rows = 2, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("ContractPayment_Note") })
            @Html.ValidationMessageFor(model => model.Note, "", new { @class = "text-danger" })
        </div>
    </div>

    @{
        if (Model.IsEdit)
        {
            <hr class="border-none border-t-3 brc-grey-l2 border-double">
            <div class="form-row">
                <div class="col-md-12">
                    @Html.TitleFor(model => model.Reason, new { @class = "col-form-label pr-0 font-bold" })
                    @Html.TextAreaFor(model => model.Reason, new { rows = 2, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Reason_Title") })
                    @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
                </div>
            </div>
        }
        else
        {
            @Html.HiddenFor(model => model.Reason)
        }
    }

</div>

<script src="~/Contents/Modules/Major/plugins/jquery.masknumber/jquery.masknumber.min.js"></script>

<script type="text/javascript">
    //debugger;

    $(document).ready(function () {
        //$('#Payment [name="FormatterTotal"],#Payment [name="FormatterPaidAmount"],#Payment [name="FormatterRemainingAmount"]').maskNumber({ integer: true });
        //$('#Payment [name="FormatterTotal"],#Payment [name="FormatterPaidAmount"],#Payment [name="FormatterRemainingAmount"]').trigger('keyup');

        $('#Payment .formatter').maskNumber({ integer: true });
        $('#Payment .formatter').trigger('keyup');

        $('#Payment #PercentAdvance').trigger("change");
        if ($('input[name="Status"]:checked').val() === '@((int)EnumPaymentStatus.Refunded)') {
            $('#FormTypePayment').hide();
        }
        $('input[name="Status"]').change(function() {
            var selectedStatus = $(this).val();
            var paidAmountInput = $('#FormatterPaidAmount');
            _changeStatus(selectedStatus, paidAmountInput)
        });
    });

    function _changeStatus(selectedStatus, paidAmountInput) {
        if (selectedStatus === '@((int)EnumPaymentStatus.Received)') {
            paidAmountInput.prop('readonly', true);
            $('#FormTypePayment').show();

        } else if (selectedStatus === '@((int)EnumPaymentStatus.Refunded)') {
            paidAmountInput.prop('readonly', false);
            $('#TypePaymentName').val('');
            $('#TypePayment').val(0);
            $('#FormTypePayment').hide();

        }
    }

    function _onChangePercentAdvance(elePercent, remainingAmount, eleFormatterAmountViaPercent, eleAmountViaPercent) {
        var percentAdvance = $(elePercent).val();
        var rate = parseInt(percentAdvance) / 100;
        //var remainingAmount = $(eleRemainingAmount).val();
        //var amountViaPercent = Math.round(remainingAmount * rate / 1000) * 1000;
        var amountViaPercent = Math.round(remainingAmount * rate, 0);
        $(eleFormatterAmountViaPercent).val(amountViaPercent).trigger('keyup');
        $(eleAmountViaPercent).val(amountViaPercent);
    }

    function _onChangeAmount(eleFormatterAmount, eleAmount) {
        var formatterAmount = $(eleFormatterAmount).val();
        var realAmount = Number(formatterAmount.replace(/[^0-9.-]+/g, ""));
        $(eleAmount).val(realAmount);
    }

    function _onHasArising(chkHasArising, eleFormatterArisingAmount) {
        $(eleFormatterArisingAmount).trigger('keyup');
        if ($(chkHasArising).is(":checked")) {
            $("[name='TypeArising'][value='0']").prop('checked', true);
        }
    }

    function _onTypeArising(eleTypeArisingName, typeArisingName, eleFormatterArisingAmount) {
        $(eleTypeArisingName).val(typeArisingName);
        $(eleFormatterArisingAmount).trigger('keyup');
    }

    debugger;
    var isCalcTax = @(Model.HasTaxForContract ? 1 : 0) == 1;

    function _onChangeArisingAmount(eleFormatterArisingAmount, eleArisingAmount, eleFormatterLiquidationAmount, eleFormatterDiscountAmount, eleFormatterTotalPaidAmount, eleFormatterPaidAmount, elePaidAmount, eleTypeArising, eleHasArising) {
        var realArisingAmount = 0;
        if ($(eleHasArising).is(':checked')) {
            var realArisingValue = $(eleTypeArising).attr('realArisingValue');
            realArisingValue = realArisingValue == undefined ? 1 : realArisingValue;

            var formatterArisingAmount = $(eleFormatterArisingAmount).val();
            realArisingAmount = Number(formatterArisingAmount.replace(/[^0-9.-]+/g, ""));
            $(eleArisingAmount).val(realArisingAmount);
            realArisingAmount = realArisingAmount * realArisingValue;
        }

        var formatterLiquidationAmount = $(eleFormatterLiquidationAmount).attr('rawValue');
        var realLiquidationAmount = Number(formatterLiquidationAmount.replace(/[^0-9.-]+/g, ""));

        var newLiquidationAmount = realArisingAmount + realLiquidationAmount;
        $(eleFormatterLiquidationAmount).val(newLiquidationAmount).trigger('keyup');

        var newLiquidationAmountInRound = Math.round(newLiquidationAmount);//Math.round(newLiquidationAmount / 1000) * 1000;

        var discountAmount = 0;
        var taxAmount = 0;

        if (!isCalcTax) {
            var formulaDiscount = $(eleFormatterDiscountAmount).attr('formulaDiscount');
            //var discountAmount = Math.round(eval(formulaDiscount.format(newLiquidationAmount)) / 1000) * 1000;
            discountAmount = Math.round(eval(formulaDiscount.format(newLiquidationAmountInRound)));
            $(eleFormatterDiscountAmount).val(discountAmount).trigger('keyup');
        }

        var formatterTotalPaidAmount = $(eleFormatterTotalPaidAmount).attr('rawValue');
        var realTotalPaidAmount = Number(formatterTotalPaidAmount.replace(/[^0-9.-]+/g, ""));

        //var formatterPaidAmount = $(eleFormatterPaidAmount).attr('rawValue');
        //var realPaidAmount = Number(formatterPaidAmount.replace(/[^0-9.-]+/g, ""));

        //var paidAmount = newLiquidationAmount - discountAmount - realTotalPaidAmount;
        var paidAmount = newLiquidationAmountInRound + (isCalcTax ? taxAmount : discountAmount * -1) - realTotalPaidAmount;
        $(eleFormatterPaidAmount + '+div+span[id="eleReadNegative"]').remove();
        if (paidAmount < 0) {
            $('label[for="PaidAmount"] span.text-danger').html("Số tiền hoàn trả khách hàng (*)");
            var eleReadNegativeVal = '<span id="eleReadNegative" class="form-control text-500 text-110 border-0">({0} đ)</span>';
            $(eleFormatterPaidAmount).parent().append(eleReadNegativeVal.format(paidAmount.toLocaleString()));
        } else {
            $('label[for="PaidAmount"] span.text-danger').html("Số tiền cần thanh toán (*)");
        }

        $(elePaidAmount).val(paidAmount);
        $(eleFormatterPaidAmount).val(paidAmount).trigger('keyup');
    }

    function _onChangePaidAmount(eleFormatterPaidAmount, paidAmount) {
        $(eleFormatterPaidAmount + '+div+span[id="eleReadNegative"]').remove();
        if (paidAmount < 0) {
            $('label[for="PaidAmount"] span.text-danger').html("Số tiền hoàn trả khách hàng (*)");
            var eleReadNegativeVal = '<span id="eleReadNegative" class="form-control text-500 text-110 border-0">({0} đ)</span>';
            $(eleFormatterPaidAmount).parent().append(eleReadNegativeVal.format(paidAmount.toLocaleString()));
        } else {
            $('label[for="PaidAmount"] span.text-danger').html("Số tiền cần thanh toán (*)");
        }
    }

</script>

<script type="text/javascript">

    function _onChangeTypePayment(rdbTypePayment, typePaymentName, eleTypePaymentName) {
        var remainingAmount = $('#Payment [name="RemainingAmount"]').val();

        //var rawPaidAmount = $('#Payment [name="FormatterPaidAmount"]').attr("rawValue");
        //if (isEdit) {
        //    //var paidAmount = $('#Payment [name="PaidAmount"]').val();
        //    remainingAmount = parseFloat(rawPaidAmount) + parseFloat(remainingAmount);
        //}

        $(eleTypePaymentName).val(typePaymentName);
        var typePayment = $(rdbTypePayment).val();
        if (typePayment == "1") {
            $("#TypePaymentAdvance").removeClass('d-none');

            var percentAdvance = $('#Payment [name="PercentAdvance"]').val();
            var rate = parseInt(percentAdvance) / 100;
            var amountViaPercent = Math.round(remainingAmount * rate);// Math.round(remainingAmount * rate / 1000) * 1000;
            $('#Payment [name="FormatterPaidAmount"]').val(amountViaPercent).trigger('keyup');
        } else {
            $("#TypePaymentAdvance").addClass('d-none');
            $("#PercentAdvanceContractVal").val(100);
            $('#Payment [name="PaidAmount"]').val(remainingAmount);
            $('#Payment [name="FormatterPaidAmount"]').val(remainingAmount).trigger('keyup');
        }
    }
</script>