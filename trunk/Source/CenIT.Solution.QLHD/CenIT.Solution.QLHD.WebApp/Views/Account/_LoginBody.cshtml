@using CaptchaMvc.HtmlHelpers
@using TSFramework.App.Processors
@model CenIT.Solution.QLHD.WebApp.Models.LoginModel
@Html.AntiForgeryToken()

<div class="form-group col-sm-10 offset-sm-1 col-md-8 offset-md-2">
    <div class="d-flex align-items-center input-floating-label text-blue brc-blue-m2">
        @Html.TextBoxFor(model => model.UserName, new { @class = "form-control form-control-lg pr-4 shadow-none", placeholder = AppProcessor.Messagor.GetMessage("Authorize_UserName") })
        <i class="fa fa-user text-grey-m2 ml-n4"></i>
        @Html.LabelFor(model => model.UserName, new { @class = "floating-label text-grey-l1 ml-n3" })
    </div>
    @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
</div>

<div class="form-group col-sm-10 offset-sm-1 col-md-8 offset-md-2 mt-2 mt-md-1">
    <div class="d-flex align-items-center input-floating-label text-blue brc-blue-m2">
        @Html.TextBoxFor(model => model.Password, new { type = "Password", @class = "form-control form-control-lg pr-4 shadow-none", placeholder = AppProcessor.Messagor.GetMessage("Authorize_Password") })
        <i class="fa fa-key text-grey-m2 ml-n4"></i>
        @Html.LabelFor(model => model.Password, new { @class = "floating-label text-grey-l1 ml-n3" })
    </div>
    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
</div>
<div class="form-group col-sm-10 offset-sm-1 col-md-8 offset-md-2">
    <button type="submit" class="btn btn-primary px-2 btn-bold">
        @AppProcessor.Messagor.GetMessage("Button_Login")&nbsp;<i class="fas fa-sign-in-alt"></i>
    </button>
    <a href="#" class="text-primary-m1 text-95 position-rc" data-toggle="tab" data-target="#id-tab-forgot">
        @AppProcessor.Messagor.GetMessage("Message_ForgotPassword")
    </a>
</div>
@if (Model?.IsShowWarning ?? false)
{
	<div class="col-sm-10 offset-sm-1 col-md-8 offset-md-2 text-left text-md-left mt-n2 mb-2">
        <p class="text-500 text-danger-d2 mb-0">@Html.DisplayTextFor(model => model.MessageLoginFailCount)</p>
		<p class="text-500 text-danger-d2 mb-0">@Html.DisplayTextFor(model => model.Warning)</p>
	</div>
}


@{
    if (Model?.NeedCaptcha ?? false)
    {
        <div class="form-group col-sm-10 offset-sm-1 col-md-8 offset-md-2">
            @Html.Captcha("Làm mới", "Nhập captcha", 7, "Bạn chưa nhập Captcha")
        </div>
    }
}