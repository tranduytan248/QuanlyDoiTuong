@using TSFramework.App.Processors
@model Cores.Major.Models.MajorCustomerModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Customer_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Customer", new { area = "Major" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Customer_OnProcessSuccess(data, 'DeleteCustomer')"
    }, new { @class = "form-horizontal", id = "DeleteCustomer" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.CusId)
        @Html.HiddenFor(model => model.CusName)
        @Html.HiddenFor(model => model.TypeCus)
        @Html.HiddenFor(model => model.TypeCusName)
        @Html.HiddenFor(model => model.Gender)
        @Html.HiddenFor(model => model.Phone)
        @Html.HiddenFor(model => model.TaxCode)
        @Html.HiddenFor(model => model.Email)
        @Html.HiddenFor(model => model.TypeIdentifier)
        @Html.HiddenFor(model => model.TypeIdentifierName)
        @Html.HiddenFor(model => model.IdentifierNo)
        @Html.HiddenFor(model => model.RefCus)
        @Html.HiddenFor(model => model.WardId)
        @Html.HiddenFor(model => model.ProvinceId)
        @Html.HiddenFor(model => model.StreetName)
        @Html.HiddenFor(model => model.AddressNo)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}