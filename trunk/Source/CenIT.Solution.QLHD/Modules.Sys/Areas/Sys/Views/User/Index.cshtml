@using TSFramework.App.Processors
@model string[]
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("User_Title");
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
    @Html.Button(true, "AddUser", Url.Action("Add", new { area = "Sys" }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right", data_width = "860px" })
}

<div class="mt-3">
    <div class="card dcard">
        <div class="p-2 table-responsive-md">
            <table id="DSUser" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="text-center" style="width:50px;">@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th style="min-width:230px;">@AppProcessor.Messagor.GetMessage("User_Label_FullName")</th>
                        <th style="width:130px;">@AppProcessor.Messagor.GetMessage("User_Label_UserName")</th>
                        <th style="min-width:190px;">Đơn vị &amp; Chức vụ</th>
                        <th style="min-width:150px;">Vai trò</th>
                        <th class="text-center" style="width:110px;">Lĩnh vực</th>
                        <th class="text-center" style="width:120px;">Trạng thái</th>
                        <th class="text-center" style="width:90px;">@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="@Url.Content("~/Areas/Sys/Views/User/User.js")?v=@(System.IO.File.GetLastWriteTime(Server.MapPath("~/Areas/Sys/Views/User/User.js")).Ticks)"></script>
    <script type="text/javascript">
    $(function () {
        var permissions = function () { return @Html.Raw(Json.Encode(Model)); }();
        window['Permissions'] = permissions;
    });
    </script>
}