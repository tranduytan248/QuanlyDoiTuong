@using TSFramework.App.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("Procedure_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="far fa-edit"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("Edit", "Procedure", new { area = "Major" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Procedure_OnProcessSuccess(data, 'EditProcedure')"
    }, new { @class = "form-horizontal", id = "EditProcedure" }))
    {
        <div id="bodyForm">
            @Html.Partial("_Procedure")
        </div>
    }
}