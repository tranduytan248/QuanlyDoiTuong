@using Cores.eContract.Consts
@using TSFramework.App.Processors
@model Cores.Major.Models.MajorContractModel

@*<div class="form-group row">
        <div class="col-sm-3 col-form-label text-sm-right pr-0 font-bold">
            @Html.Button(true, "FindCustomer", Url.Action("FindCustomer", new { area = "Major", typeCus = ConstsCusType.BUSINESS }), "<i class='fas fa-search'></i>", AppProcessor.Messagor.GetMessage("Button_FindBusiness"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right", data_width = "1024px" })
        </div>
    </div>
    <hr />*@
<div id="Business">

    @Html.Hidden("CusInfo", "CusId;EnterpriseName;TaxCode;Phone;Email;ProvinceId;ProvinceName;DistrictId;DistrictName;WardId;WardName;StreetName;AddressNo;Address;RepresenterName;RepresenterGender;RepresenterTitle", new { disabled = true })

    <div class="form-group row">
        @Html.TitleFor(model => model.CusInfo.EnterpriseName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-8">
            <div class="input-group">
                @Html.TextBoxFor(model => model.CusInfo.EnterpriseName, new { @class = "form-control col-md-10", placeholder = AppProcessor.Messagor.GetMessage("Customer_Enterprise_Name") })
                <div class="input-group-append">
                    @Html.Button(true, "FindCustomer", Url.Action("FindCustomer", new { area = "Major", typeCus = ConstsCusType.BUSINESS, prefix = "CusInfo" }), "<i class='fas fa-search'></i>", AppProcessor.Messagor.GetMessage("Button_Search"), new { @class = "btn btn-outline-primary", data_width = "1024px" })
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.CusInfo.EnterpriseName, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group row">
        @Html.TitleFor(model => model.CusInfo.TaxCode, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-3">
            @Html.TextBoxFor(model => model.CusInfo.TaxCode, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Customer_TaxCode") })
            @Html.ValidationMessageFor(model => model.CusInfo.TaxCode, "", new { @class = "text-danger" })
        </div>
        @Html.TitleFor(model => model.CusInfo.Phone, new { @class = "col-sm-2 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-3">
            @Html.TextBoxFor(model => model.CusInfo.Phone, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Customer_Phone") })
            @Html.ValidationMessageFor(model => model.CusInfo.Phone, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        <label for="Email" class="col-sm-3 col-form-label text-sm-right pr-0 font-bold">
            <span class="text-danger">Email (*)</span>
        </label>
        <div class="col-md-4">
            @Html.TextBoxFor(model => model.CusInfo.Email, new { @class = "form-control col-md-10", placeholder = AppProcessor.Messagor.GetMessage("Customer_Email") })
            @Html.ValidationMessageFor(model => model.CusInfo.Email, "", new { @class = "text-danger" })
        </div>
    </div>

    @Html.HiddenFor(model => model.CusInfo.ProvinceId)
    @Html.HiddenFor(model => model.CusInfo.ProvinceName)
    @Html.HiddenFor(model => model.CusInfo.DistrictId)
    @Html.HiddenFor(model => model.CusInfo.DistrictName)
    @Html.HiddenFor(model => model.CusInfo.WardId)
    @Html.HiddenFor(model => model.CusInfo.WardName)
    @Html.HiddenFor(model => model.CusInfo.StreetName)
    @Html.HiddenFor(model => model.CusInfo.AddressNo)

    <div class="form-group row">
        @Html.TitleFor(model => model.CusInfo.Address, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-9">
            @Html.TextAreaFor(model => model.CusInfo.Address, new { rows = 3, @class = "form-control col-md-10", placeholder = AppProcessor.Messagor.GetMessage("Customer_Address"), onclick = "_onTypeAddress('#Business #CusInfo_',$('#Business #CusInfo_ProvinceId').val(),$('#Business #CusInfo_DistrictId').val(),$('#Business #CusInfo_WardId').val(),$('#Business #CusInfo_StreetName').val(),$('#Business #CusInfo_AddressNo').val());" })
            @Html.ValidationMessageFor(model => model.CusInfo.Address, "", new { @class = "text-danger" })
        </div>
    </div>

    <hr class="border-none border-t-3 brc-grey-l2 border-double">

    <div class="ccard h-100 d-flex flex-column mx-2 px-2 py-2">
        <div class="card-header bg-transparent">
            <h5 class="card-title">
                <i class="fas fa-user-tie text-blue opacity-1"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Customer_Representer")
            </h5>
        </div>
        <div class="card-body">
            <div class="form-group row">
                @Html.TitleFor(model => model.CusInfo.RepresenterName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.CusInfo.RepresenterName, new { @class = "form-control col-md-8", placeholder = AppProcessor.Messagor.GetMessage("Customer_Representer_Name") })
                    @Html.ValidationMessageFor(model => model.CusInfo.RepresenterName, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group row">
                @Html.TitleFor(model => model.CusInfo.RepresenterGender, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-md-9">
                    <label class="px-0 pt-2">
                        @Html.RadioButtonFor(model => model.CusInfo.RepresenterGender, 1, new { })
                        <span class="badge bgc-danger brc-danger text-white badge-lg arrowed arrowed-in-right mb-1">
                            <span class="px-3">@AppProcessor.Messagor.GetMessage("Gender_Male")</span>
                        </span>
                    </label>
                    <label class="px-0 pt-2">
                        @Html.RadioButtonFor(model => model.CusInfo.RepresenterGender, 0, new { })
                        <span class="badge bgc-purple brc-purple text-white badge-lg arrowed arrowed-in-right mb-1">
                            <span class="px-3">@AppProcessor.Messagor.GetMessage("Gender_Female")</span>
                        </span>
                    </label>
                </div>
            </div>
            <div class="form-group row">
                @Html.TitleFor(model => model.CusInfo.RepresenterTitle, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.CusInfo.RepresenterTitle, new { @class = "form-control col-md-6", placeholder = AppProcessor.Messagor.GetMessage("Customer_Representer_Title") })
                    @Html.ValidationMessageFor(model => model.CusInfo.RepresenterTitle, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    
    $(document).ready(function () {
        $("input[name='CusInfo.Phone']").inputFilter(function (value) {
            return /^\d*$/.test(value);
        }, "Phải nhập số nguyên không dấu");
    });

</script>