@using Syncfusion.EJ2
@using TSFramework.App.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Dashboard_Title");
}

@section PluginCss
{
    <link rel="stylesheet" type="text/css" href="/Contents/Base/plugins/ace_v4/node_modules/tiny-date-picker/tiny-date-picker.css">
    <link rel="stylesheet" type="text/css" href="/Contents/Base/plugins/ace_v4/node_modules/tiny-date-picker/date-range-picker.css">
    <link rel="stylesheet" type="text/css" href="~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-select/dist/css/bootstrap-select.css">

    <style type="text/css">
        .datepicker.datepicker-dropdown.dropdown-menu {
            z-index: 998 !important;
        }

        .dp-daterange-picker.visible {
            z-index: 999 !important;
        }
    </style>
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{

}

@Html.Partial("_Search")

@*@Html.Partial("_DataGrid")*@

<div class="card bcard h-auto">
    <div class="p-2 table-responsive-md p-2">
        <table id="ListContracts" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table">
            <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1 text-center">
                <tr>
                    <th class="w-5">@AppProcessor.Messagor.GetMessage("Column_No")</th>
                    <th class="">@AppProcessor.Messagor.GetMessage("Contract_ContractNo")</th>
                    <th class="">@AppProcessor.Messagor.GetMessage("Contract_ReceivedOn")</th>
                    <th class="">@AppProcessor.Messagor.GetMessage("Contract_GiveResultOn")</th>
                    <th class="">@AppProcessor.Messagor.GetMessage("Customer_Title")</th>
                    <th class="">@AppProcessor.Messagor.GetMessage("Purpose_Title")</th>
                    <th class="">@AppProcessor.Messagor.GetMessage("Contract_Address")</th>
                    <th class="">@AppProcessor.Messagor.GetMessage("Contract_Status")</th>
                    <th class="">@AppProcessor.Messagor.GetMessage("Contract_RemainingTime")</th>
                    <th class="">@AppProcessor.Messagor.GetMessage("Procedure_Title")</th>
                    <th class="">@AppProcessor.Messagor.GetMessage("Contract_Note")</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section PluginJs
{
    <script src="@Url.Content("~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-select/dist/js/bootstrap-select.js")"></script>
    <script src="@Url.Content("~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-select/dist/js/defaults-vi_VN.min.js")"></script>
    <script src="/Contents/Base/plugins/ace_v4/node_modules/tiny-date-picker/dist/date-range-picker.js"></script>
}

@section BottomScript
{
