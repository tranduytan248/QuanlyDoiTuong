@using TSFramework.App.Processors
@model Modules.Sys.Areas.Cate.Models.SearchTeamModel
<div class="card dcard">
    <div class="card-header">
        <h5 class="card-title text-120 text-primary-d2">@AppProcessor.Messagor.GetMessage("Condition_Title")</h5>
        <div class="card-toolbar no-border">
            <a href="#" data-action="toggle" class="card-toolbar-btn btn btn-sm radius-1 btn-outline-default mx-2px">
                <i class="fa fa-angle-double-up w-2 mx-1px"></i>
            </a>
        </div>
    </div>
    <div class="card-body p-0 collapse show">
        <div class="col-md-12 form-horizontal mt-3" id="Search">
            <div class="form-group row">
                @Html.TitleFor(model => model.ListProvinceId, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-md-9">
                    @Html.DropDownListFor(model => model.ListProvinceId, new SelectList(Model.ListProvinces, "Value", "Text"), "", new { multiple = true, @class = "form-control col-md-10", data_placeholder = AppProcessor.Messagor.GetMessage("Combobox_Select") })
                </div>
            </div>
            <div class="form-group row">
                @Html.TitleFor(model => model.ListWardId, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-md-9">
                    @Html.DropDownListFor(model => model.ListWardId, new SelectList(Model.ListWards, "Value", "Text"), "", new { multiple = true, @class = "form-control col-md-10", data_placeholder = AppProcessor.Messagor.GetMessage("Combobox_Select") })
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <div class="col-md-12 text-center">
            <button type="button" class="btn btn-primary" onclick="_tableTeam.ajax.reload(null, false);"><i class="fa fa-search-plus"></i>&nbsp;Tìm kiếm</button>
        </div>
    </div>
</div>