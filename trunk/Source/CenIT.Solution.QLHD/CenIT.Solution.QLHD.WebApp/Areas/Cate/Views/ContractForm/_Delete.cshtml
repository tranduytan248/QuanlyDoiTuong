@using TSFramework.App.Processors
@model Cores.Cate.Models.CateContractTemplateModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("ContractForm_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "ContractForm", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ContractForm_OnProcessSuccess(data, 'DeleteContractForm')"
    }, new { @class = "form-horizontal", id = "DeleteContractForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model => model.TemplateName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}