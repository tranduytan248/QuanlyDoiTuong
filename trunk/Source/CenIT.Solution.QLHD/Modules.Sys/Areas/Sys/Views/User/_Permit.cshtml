@using TSFramework.App.Processors
@using EnumHelper = TSFramework.Core.Helpers.EnumHelper
@model Modules.Sys.Areas.Sys.Models.UserPermitModel

@{
    ViewBag.Title = $"{AppProcessor.Messagor.GetMessage("Modal_Title_Accessibility")} - {AppProcessor.Messagor.GetMessage("User_Title")} [{Model.FullName}]";
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{@Html.Raw(EnumHelper.GetDescription(EnumTypeModal.Primary))}

@section FormIcon{
    <i class="fa fa-shield-alt"></i>
}

@section FormBody{

    <link rel="stylesheet" type="text/css" href="~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-select/dist/css/bootstrap-select.css">

    <script src="@Url.Content("~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-select/dist/js/bootstrap-select.js")"></script>
    <script src="@Url.Content("~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-select/dist/js/defaults-vi_VN.min.js")"></script>

    @using (Ajax.BeginForm("Permit", "User", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "User_OnProcessSuccess(data, 'PermitUser')"
    }, new { @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_PermitBody")
        </div>
    }

    <script type="text/javascript">
        $(document).ready(function () {
            // bootstrap select
            $.fn.selectpicker.Constructor.DEFAULTS.tickIcon = 'fas fa-check text-125 text-success-m3 my-2';
            $('#bodyForm .selectpicker').selectpicker({
                selectAllText: "Chọn tất cả",
                deselectAllText: "Bỏ chọn tất cả"
            });
        });
    </script>

}