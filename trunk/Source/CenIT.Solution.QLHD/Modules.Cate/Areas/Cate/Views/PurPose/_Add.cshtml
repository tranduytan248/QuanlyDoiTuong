@using TSFramework.App.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("catePurPose_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{


    @using (Ajax.BeginForm("Add", "PurPose", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "PurPose_OnProcessSuccess(data, 'AddPurPose')"
    }, new { @class = "form-horizontal", id = "AddPurPose" }))
    {
        <div id="bodyForm">
            @Html.Partial("_PurPose")
        </div>
    }
}