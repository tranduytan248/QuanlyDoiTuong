@model Cores.Cate.Models.CateUnionMemberModel
@using TSFramework.App.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), $"{AppProcessor.Messagor.GetMessage("Union_Manager_Title")} - {Model.UnionName}");
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="far fa-edit"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("EditManager", "Union", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "UnionMember_OnProcessSuccess(data, 'EditManager')"
    }, new { @class = "form-horizontal", id = "EditManager" }))
    {
        <div id="bodyForm">
            @Html.Partial("_Manager")
        </div>
    }
}