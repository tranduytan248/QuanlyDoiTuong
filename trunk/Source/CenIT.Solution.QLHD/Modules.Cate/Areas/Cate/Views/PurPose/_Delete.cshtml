@using TSFramework.App.Processors
@model Cores.Cate.Models.CatePurPoseModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("catePurPose_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "PurPose", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "PurPose_OnProcessSuccess(data, 'DeletePurPose')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model =>model.PurPoseId)
        @Html.HiddenFor(model => model.PurPoseName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}