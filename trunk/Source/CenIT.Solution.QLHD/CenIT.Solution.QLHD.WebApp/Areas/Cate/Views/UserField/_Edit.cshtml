@model Cores.Cate.Models.CateUserFieldModel
@{
    ViewBag.Title = "Phân quyền lĩnh vực";
    Layout = "~/Views/Shared/_Form.cshtml";
}
@section FormType{ primary }
@section FormIcon{ <i class="fa fa-layer-group"></i> }
@section FormBody{
    @using (Ajax.BeginForm("Edit", "UserField", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "UserField_OnProcessSuccess(data, 'EditUserField')"
    }, new { @class = "form-horizontal", id = "EditUserField" }))
    {
        <div id="bodyForm">@Html.Partial("_UserField", Model)</div>
    }

    <script>
        /* Ham xu ly ket qua sau khi luu */
        window.UserField_OnProcessSuccess = function (response, formId) {
            if (response == null) return;
            if (response.status === undefined && typeof response === "string") {
                $("#bodyForm").html(response);
                return;
            }

            var $modal = $("#ModalContent #modal_" + formId);
            if (!$modal.length || !$modal.hasClass("show")) {
                $modal = $(".modal.show, #ModalContent .modal");
            }

            if (response.message) {
                try { eval(response.message); } catch (e) { console.error(e); }
            }

            $modal.modal("hide");

            /* Lam moi bang du lieu cua man hinh dang mo */
            if (typeof _tableUserField !== "undefined" && _tableUserField) { _tableUserField.ajax.reload(null, false); }
            if (typeof _tableUser !== "undefined" && _tableUser) { _tableUser.ajax.reload(null, false); }
            if (typeof _tableSubject !== "undefined" && _tableSubject) { _tableSubject.ajax.reload(null, false); }
        };

        /* Dam bao dong bo danh sach checkbox truoc khi submit */
        $(document).off("submit", "#EditUserField").on("submit", "#EditUserField", function () {
            if (typeof syncSelectedUserFields === "function") {
                syncSelectedUserFields();
            }
            return true;
        });
    </script>
}
