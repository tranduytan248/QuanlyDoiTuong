@using Cores.Cate.Enum
@using Cores.eContract.Consts
@using TSFramework.App.Processors
@model Cores.Major.Models.MajorContractModel

<div id="ExtendContract">
    @Html.Hidden("ExtendFields", $"Amount;NumberCopies;NumberCopiesContract;NumberCopiesHoldedContract;{(ConstsCusType.CONSUMER)}.RepresenterName;{(ConstsCusType.CONSUMER)}.RepresenterAlias;{(ConstsCusType.CONSUMER)}.RepresenterGender;{(ConstsCusType.CONSUMER)}.RepresenterGender;{(ConstsCusType.CONSUMER)}.RepresenterTitle;{(ConstsCusType.BUSINESS)}.RepresenterName;{(ConstsCusType.BUSINESS)}.RepresenterAlias;{(ConstsCusType.BUSINESS)}.RepresenterGender;{(ConstsCusType.BUSINESS)}.RepresenterGender;{(ConstsCusType.BUSINESS)}.RepresenterTitle;", new { })
    @{
        //Cắm móc ranh giới
        if (Model.ContractTypeId == (int)EnumContractType.BoundaryMarkers)
        {
            <div class="form-group row">
                <label class="col-sm-2 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("Contract_Extend_Amount")</label>
                <div class="col-md-3">
                    @Html.TextBox("Amount", 2, new { type = "number", min = 0, max = 1000000, step = 1, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Contract_Extend_Amount") })
                </div>
                <label class="col-sm-2 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("Contract_Extend_NumberCopies")</label>
                <div class="col-md-3">
                    @Html.TextBox("NumberCopies", 2, new { type = "number", min = 0, max = 100, step = 1, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Contract_Extend_NumberCopies") })
                </div>
            </div>
        }
        else
        {
            <div class="form-group row">
                <label class="col-sm-2 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("Contract_Extend_NumberCopies")</label>
                <div class="col-md-3">
                    @Html.TextBox("NumberCopies", 2, new { type = "number", min = 0, max = 100, step = 1, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Contract_Extend_NumberCopies") })
                </div>
            </div>
        }

        <div class="form-group row">
            <label class="col-sm-2 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("Contract_Extend_NumberCopiesContract")</label>
            <div class="col-md-3">
                @Html.TextBox("NumberCopiesContract", 2, new { type = "number", min = 0, max = 100, step = 1, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Contract_Extend_NumberCopiesContract") })
            </div>
            <label class="col-sm-2 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("Contract_Extend_NumberCopiesHoldedContract")</label>
            <div class="col-md-3">
                @Html.TextBox("NumberCopiesHoldedContract", 1, new { type = "number", min = 0, max = 100, step = 1, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Contract_Extend_NumberCopiesHoldedContract") })
            </div>
        </div>
    }
    <hr class="border-none border-t-3 brc-grey-l2 border-double">
    <div class="ccard h-100 d-flex flex-column">
        <div class="card-header bg-transparent">
            <h5 class="card-title">
                <i class="fas fa-user-friends text-blue opacity-1"></i>&nbsp;Đại diện Bên B (Bên cung cấp dịch vụ):
            </h5>
        </div>
        <div class="card-body p-0">
            <ul class="w-100 nav nav-tabs nav-tabs-simple bgc-green-d2 radius-t-1 pt-2 pl-2 d-none" role="tablist">
                <li class="nav-item mr-3px">
                    <a class="active btn btn-brc-tp btn-outline-white btn-h-light-green btn-h-text-dark btn-a-text-green btn-a-white px-3 px-lg-4 py-25 border-0 radius-b-0" id="consumer-tab-btn" data-toggle="tab" href="#consumer" role="tab" aria-controls="consumer" aria-selected="true">
                        <i class="fas fa-user text-105 mr-3px"></i>&nbsp;@($"{AppProcessor.Messagor.GetMessage("Customer_Title")} {AppProcessor.Messagor.GetMessage("CusType_Consumer")}")
                    </a>
                </li>

                <li class="nav-item mr-3px">
                    <a class="btn btn-brc-tp btn-outline-white btn-h-light-green btn-h-text-dark btn-a-text-green btn-a-white px-3 px-lg-4 py-25 border-0 radius-b-0" id="business-tab-btn" data-toggle="tab" href="#business" role="tab" aria-controls="business" aria-selected="false">
                        <i class="fas fa-user-tie text-105 mr-3px"></i>&nbsp;@($"{AppProcessor.Messagor.GetMessage("Customer_Title")} {AppProcessor.Messagor.GetMessage("CusType_Business")}")
                    </a>
                </li>
            </ul>

            <div class="tab-content tab-sliding px-1 px-md-3 text-grey-d3 border-0 border-t-0 radius-b-1 brc-secondary-l2" id="Representor">
                <div class="tab-pane show active p-2" id="consumer" role="tabpanel" aria-labelledby="consumer-tab-btn">
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="@(ConstsCusType.CONSUMER).RepresenterName"><span class="text-danger">Tên (*)</span></label>
                        <div class="col-md-9">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text text-500" id="@(ConstsCusType.CONSUMER).ViewAlias">Ông</span>
                                </div>
                                <input class="form-control col-md-11" data-val="true" data-val-requiredif="Dữ liệu [Tên] bắt buộc nhập" id="@(ConstsCusType.CONSUMER).RepresenterName" name="@(ConstsCusType.CONSUMER).RepresenterName" placeholder="Tên" type="text" value="">
                            </div>
                            <span class="field-validation-valid text-danger" data-valmsg-for="@(ConstsCusType.CONSUMER).RepresenterName" data-valmsg-replace="true"></span>
                        </div>
                        <input type="hidden" name="@(ConstsCusType.CONSUMER).RepresenterAlias" />
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="@(ConstsCusType.CONSUMER).RepresenterGender">Giới tính</label>
                        <div class="col-md-9">
                            <label class="px-0 pt-2">
                                <input checked="checked" data-val="true" id="@(ConstsCusType.CONSUMER).RepresenterGender" name="@(ConstsCusType.CONSUMER).RepresenterGender" type="radio" value="1" onchange="_onChangeGender('#ExtendContract [name=\'@(ConstsCusType.CONSUMER).RepresenterAlias\']','#ExtendContract [id=\'@(ConstsCusType.CONSUMER).ViewAlias\']','Ông')">
                                <span class="badge bgc-danger brc-danger text-white badge-lg arrowed arrowed-in-right mb-1">
                                    <span class="px-3">@AppProcessor.Messagor.GetMessage("Gender_Male")</span>
                                </span>
                            </label>
                            <label class="px-0 pt-2">
                                <input id="@(ConstsCusType.CONSUMER).RepresenterGender" name="@(ConstsCusType.CONSUMER).RepresenterGender" type="radio" value="0" onchange="_onChangeGender('#ExtendContract [name=\'@(ConstsCusType.CONSUMER).RepresenterAlias\']','#ExtendContract [id=\'@(ConstsCusType.CONSUMER).ViewAlias\']','Bà')">
                                <span class="badge bgc-purple brc-purple text-white badge-lg arrowed arrowed-in-right mb-1">
                                    <span class="px-3">@AppProcessor.Messagor.GetMessage("Gender_Female")</span>
                                </span>
                            </label>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="@(ConstsCusType.CONSUMER).RepresenterTitle"><span class="text-danger">Chức vụ (*)</span></label>
                        <div class="col-md-9">
                            <input class="form-control col-md-9" data-val="true" data-val-requiredif="Dữ liệu [Chức vụ] bắt buộc nhập" id="RepresenterTitle" name="@(ConstsCusType.CONSUMER).RepresenterTitle" placeholder="Chức vụ" type="text" value="">
                            <span class="field-validation-valid text-danger" data-valmsg-for="@(ConstsCusType.CONSUMER).RepresenterTitle" data-valmsg-replace="true"></span>
                        </div>
                    </div>
                </div>

                <div class="tab-pane p-2" id="business" role="tabpanel" aria-labelledby="business-tab-btn">
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="@(ConstsCusType.BUSINESS).RepresenterName"><span class="text-danger">Tên (*)</span></label>
                        <div class="col-md-9">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text text-500" id="ViewAlias">Ông</span>
                                </div>
                                <input class="form-control col-md-11" data-val="true" data-val-requiredif="Dữ liệu [Tên] bắt buộc nhập" id="@(ConstsCusType.BUSINESS).RepresenterName" name="@(ConstsCusType.BUSINESS).RepresenterName" placeholder="Tên" type="text" value="">
                            </div>
                            <span class="field-validation-valid text-danger" data-valmsg-for="@(ConstsCusType.BUSINESS).RepresenterName" data-valmsg-replace="true"></span>
                        </div>
                        <input type="hidden" name="@(ConstsCusType.BUSINESS).RepresenterAlias" />
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="@(ConstsCusType.BUSINESS).RepresenterGender">Giới tính</label>
                        <div class="col-md-9">
                            <label class="px-0 pt-2">
                                <input checked="checked" data-val="true" id="@(ConstsCusType.BUSINESS).RepresenterGender" name="@(ConstsCusType.BUSINESS).RepresenterGender" type="radio" value="1" onchange="_onChangeGender('#ExtendContract [name=\'@(ConstsCusType.BUSINESS).RepresenterAlias\']','#ExtendContract [id=\'@(ConstsCusType.BUSINESS).ViewAlias\']','Ông')">
                                <span class="badge bgc-danger brc-danger text-white badge-lg arrowed arrowed-in-right mb-1">
                                    <span class="px-3">@AppProcessor.Messagor.GetMessage("Gender_Male")</span>
                                </span>
                            </label>
                            <label class="px-0 pt-2">
                                <input id="@(ConstsCusType.BUSINESS).RepresenterGender" name="@(ConstsCusType.BUSINESS).RepresenterGender" type="radio" value="0" onchange="_onChangeGender('#ExtendContract [name=\'@(ConstsCusType.BUSINESS).RepresenterAlias\']','#ExtendContract [id=\'@(ConstsCusType.BUSINESS).ViewAlias\']','Bà')">
                                <span class="badge bgc-purple brc-purple text-white badge-lg arrowed arrowed-in-right mb-1">
                                    <span class="px-3">@AppProcessor.Messagor.GetMessage("Gender_Female")</span>
                                </span>
                            </label>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="@(ConstsCusType.BUSINESS)RepresenterTitle"><span class="text-danger">Chức vụ (*)</span></label>
                        <div class="col-md-9">
                            <input class="form-control col-md-9" data-val="true" data-val-requiredif="Dữ liệu [Chức vụ] bắt buộc nhập" id="@(ConstsCusType.BUSINESS).RepresenterTitle" name="@(ConstsCusType.BUSINESS).RepresenterTitle" placeholder="Chức vụ" type="text" value="">
                            <span class="field-validation-valid text-danger" data-valmsg-for="@(ConstsCusType.BUSINESS).RepresenterTitle" data-valmsg-replace="true"></span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

<script type="text/javascript">
    //debugger;
    $(document).ready(function () {

        @{
            if (Model.TypeCus == ConstsCusType.CONSUMER)
            {
                @Html.Raw("$('#consumer-tab-btn').removeClass('d-none').click();\r\n$('#business-tab-btn').addClass('d-none');");
            }
            else
            {
                @Html.Raw(" $('#business-tab-btn').removeClass('d-none').click();\r\n $('#consumer-tab-btn').addClass('d-none');");
            }
        }
        var unionInfo =  @(string.IsNullOrEmpty(Model.ExtendInfos)? Html.Raw("[]") : Html.Raw(Model.ExtendInfos));

        for (var key in unionInfo) {
             if (key == "EnterpriseName") {
                     $("#EnterpriseName").val(@Html.Raw(Json.Encode(Model.UnionName)));
             }
             else if (key == "EnterpriseNameUpperCase") {
                 $("#EnterpriseNameUpperCase").val(@Html.Raw(Json.Encode(Model.UnionName?.ToUpper())));
             }
            else {
                 if ($("#ExtendContract input[name='" + key + "']").is(':radio') || $("#ExtendContract input[name='"+key+"']").is(':checkbox')){
                     $("#ExtendContract input[name='"+key+"'][value='"+unionInfo[key]+"']").prop('checked', true).trigger('change');
                }
                else{
                     $("#ExtendContract input[name='" + key + "'], #ExtendContract textarea[name='" + key +"']").val(unionInfo[key]);
                }
            }
        }
    });

    function _onChangeGender(eleName, eleViewAlias, name) {
        $(eleName).val(name);
        $(eleViewAlias).html(name);
    }
</script>