@using Newtonsoft.Json
@using TSFramework.App.Processors
@model Cores.Major.Models.MajorProcedureStepModel

<div class="card dcard mb-3 col-12" id="configStep">
    <div class="card-header">
        <h5 class="card-title text-120 text-500 text-primary-d2 my-auto">
            <i class="fas fa-list-ol"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Flow_Handle_Title")
        </h5>
        <div class="card-toolbar no-border">
            <a href="#" data-action="toggle" class="card-toolbar-btn btn btn-sm radius-1 btn-outline-default mx-2px">
                <i class="fa fa-angle-double-up w-2 mx-1px"></i>
            </a>
        </div>
    </div><!-- /.card-header -->
    <div class="card-body p-0 collapse show">
        <div class="p-0 py-2">
            <div class="form-group row">
                <div class="col-md-6">
                    @Html.TitleFor(model => model.PrevStep, new { @class = "col-form-label pr-0 font-bold" })
                    @Html.SelectFor(model => model.PrevStep, Model.ListPrevSteps, "", new { @class = "form-control col-md-12", onchange = "_onChangeCombo(this, '#configStep #PrevStepName')" })
                    @Html.ValidationMessageFor(model => model.PrevStep, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.PrevStepName)
                </div>
                <div class="col-md-6">
                    @Html.TitleFor(model => model.NextStep, new { @class = "col-form-label pr-0 font-bold" })
                    @Html.SelectFor(model => model.NextStep, Model.ListNextSteps, "", new { @class = "form-control col-md-12", onchange = "_onChangeCombo(this, '#configStep #NextStepName')" })
                    @Html.ValidationMessageFor(model => model.NextStep, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.NextStepName)
                </div>
            </div>

            @Html.HiddenFor(model => model.NextProcId)
            @Html.HiddenFor(model => model.NextProcName)
            
            <hr class="border-none border-t-3 brc-grey-l2 border-double" />
            <div class="row py-3">
                <div class="col-12 mb-3">
                    @Html.Button(true, "AddSituation", Url.Action("AddSituation", new { area = "Major", stepId = Model.StepId, procedureId = Model.ProcedureId }), "<i class='fa fa-plus'></i>", $"{AppProcessor.Messagor.GetMessage("Button_Add")} {AppProcessor.Messagor.GetMessage("Situation_Title")}", new { @class = "card-toolbar-btn btn px-4 btn-outline-purple mb-1", title = $"{AppProcessor.Messagor.GetMessage("Button_Add")} {AppProcessor.Messagor.GetMessage("Situation_Title")}", data_rel = "tooltip" })
                </div>
                <div class="col-sm-12">
                    <table id="ListSituations" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                        <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                            <tr>
                                <th class="w-75">@AppProcessor.Messagor.GetMessage("Situation_Title")</th>
                                <th class="">@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div><!-- /.card-body -->
    </div>
</div>

<script type="text/javascript">
    //debugger;

    $(document).ready(function () {
        _initTableSituations();
    });

    var _tableSituations;

    function _initTableSituations() {
    _tableSituations = $("#ListSituations").DataTable({
        fixedHeader: {
            header: true,
            footer: true
        },
        "Responsive": true,
        "language": {
            "processing": '<div id="tableLoading" class="pageload-overlay show pageload-loading" data-opening="M 0,0 80,-10 80,60 0,70 0,0" data-closing="M 0,-10 80,-20 80,-10 0,0 0,-10" style=""><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 80 60" preserveAspectRatio="none"><path d="M 0,70 80,60 80,80 0,80 0,70"></path></svg></div>'
                //"<div class='overlay'><i class='fas fa-cog fa-spin'></i></div>"
        },
        "lengthChange": false,
        "processing": true,
        "serverSide": false,
        "searching": false,
        "paging": false, "info": false,
        "columns": [
            {
                "data": "SituationName",
                "defaultContent": "",
                "render": function (data, type, row, meta) {
                    var htmlTemplate = '<span class="text-105"><b>{0}</b></span><div class="text-100 text-primary-d1">Chuyển tới: <b>{1}</b></div>';

                    if (type == "display") {
                        var displayHtml = htmlTemplate.format(data, row.NextStepName ?? "");
                        return displayHtml;
                    }
                }
            },
            {
                "data": "StepId",
                "style": "width:100px;",
                "orderable": false,
                "render": function (data, type, row, meta) {
                    var html = '<span class="d-none d-lg-inline">';

                    if (type === "display") {
                        html += _renderButton(true,
                            "EditSituation",
                            "btn px-4 btn-outline-primary mr-1 v-hover",
                            "/Major/Procedure/EditSituation?stepId=" + data + "&situationId=" + row.SituationId,
                            '<i class="far fa-edit text-120"></i>',
                            "Cập nhật");

                        html += _renderButton(true,
                            "DeleteSituation",
                            "btn px-4 btn-outline-danger mr-1 v-hover",
                            "/Major/Procedure/DeleteSituation?stepId=" + data + "&situationId=" + row.SituationId,
                            '<i class="far fa-trash-alt text-120"></i>',
                            "Xoá");
                    }
                    html += "</span>";

                    return html;
                }
            }
        ]
    });

    var dataSituations = JSON.parse('@Html.Raw(JsonConvert.SerializeObject(Model.DataSituations))');
    if (typeof dataSituations != null) {
        _tableSituations.clear().rows.add(dataSituations).draw();
        _tableSituations.column(0).data().sort();
    }
}

    function SituationStep_OnProcessSuccess(response, formId) {
        if (response.status != undefined) {
            if ($("#ModalContent #modal_" + formId + " #chkNotDismissModal").is(":checked")) {
                if (response.status != undefined) {
                    eval(response.message);
                    if (response.status) {
                        var jsonDataSituations = JSON.parse(response.data);
                        _tableSituations.clear().rows.add(jsonDataSituations).draw();
                        $("input[type='hidden'][id='WarningSave']").val("True");
                    }

                    response.status = undefined;
                    var urlAction = $("#ModalContent #modal_" + formId + " form").attr("action");
                    $("#ModalContent #modal_" + formId + " #modal-content").load(urlAction, function (data, textStatus, xhr) {
                        _initElements(this);
                    });
                }
            } else {
                $("#ModalContent #modal_" + formId).modal("hide");
                $("#ModalContent #modal_" + formId).on("hidden.bs.modal",
                    function () {
                        if (response.status != undefined) {
                            eval(response.message);
                            if (response.status) {
                                var jsonDataSituations = JSON.parse(response.data);
                                _tableSituations.clear().rows.add(jsonDataSituations).draw();
                                $("input[type='hidden'][id='WarningSave']").val("True");
                            }
                            response.status = undefined;
                        }
                    });
            }
        } else {
            $("#ModalContent #modal_" + formId + " #bodyForm").html(response).promise().done(function () {_initElements(this);});
        }
    }

</script>