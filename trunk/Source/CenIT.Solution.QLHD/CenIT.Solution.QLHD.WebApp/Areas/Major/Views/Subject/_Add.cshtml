@model Cores.Major.Models.MajorSubjectModel
@{
    ViewBag.Title = "Thêm mới Đối tượng";
    Layout = "~/Views/Shared/_Form.cshtml";
}
@section FormType{ primary }
@section FormIcon{ <i class="fa fa-user-plus"></i> }
@section FormBody{
