@using TSFramework.App.Processors
@model Modules.Major.Areas.Major.Models.AcceptantContractModel
@{
    ViewBag.Title = $"{AppProcessor.Messagor.GetMessage("Modal_Title_Acceptant")} [{AppProcessor.Messagor.GetMessage("Contract_Title")} - {Model.ContractNoInfo} - {Model.CusName}]";
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    danger
}

@section FormIcon{
    <i class="fas fa-check-double"></i>
}

@section FormBody{

    @using (Html.BeginForm("Acceptant", "Contract", new { area = "Major" }, FormMethod.Post, new { encType = "multipart/form-data", id = "Acceptant", @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_AcceptantBody")
        </div>
    }

    <script type="text/javascript">

        $('form#Acceptant').ajaxForm({
            beforeSubmit: function () {
                _onWaiting();
            },
            success: function (response) {
                if (response.status != undefined) {

                    $("#ModalContent #modal_Acceptant").modal("hide");
                    $("#ModalContent #modal_Acceptant").on("hidden.bs.modal",
                        function () {
                            if (response.status != undefined) {
                                eval(response.message);
                                _tableContracts.ajax.reload(null, false);
                                response.status = undefined;
                            }
                        });
                } else {
                    $("#ModalContent #modal_Acceptant #bodyForm").html(response).promise().done(function () {_initElements(this);});
                }
                _endWaiting();
            }
        });
    </script>
}
@section SubmitControl{
    <button type="submit" id="btnAcceptant" class="btn px-4 btn-outline-primary mb-1"><i class="fas fa-check-double"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Approve")</button>
}