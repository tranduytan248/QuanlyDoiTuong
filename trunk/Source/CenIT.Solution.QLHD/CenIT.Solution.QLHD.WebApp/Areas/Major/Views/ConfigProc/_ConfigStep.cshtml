@using TSFramework.App.Processors
@model Cores.Major.Models.SAVProcedureStepModel

@Html.AntiForgeryToken()

@using (Ajax.BeginForm("ConfigStep", "ConfigProc", new { area = "Major" }, new AjaxOptions
{
    HttpMethod = "POST",
    OnSuccess = "ConfigProc_OnProcessSuccess(data, 'ConfigStep')"
}, new { @class = "form-horizontal", id = "ConfigStep" }))
{
    @Html.HiddenFor(model => model.ProcedureId)
    @Html.HiddenFor(model => model.StepId)
    @Html.HiddenFor(model => model.StepName)
    @Html.HiddenFor(model => model.StepDesc)

    <div id="Step" class="mt-3 mx-2">
        <div class="form-group row">
            @Html.TitleFor(model => model.StepDesc, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
            <div class="col-md-9">
                @Html.TextAreaFor(model => model.StepDesc, new { disabled = true, rows = 2, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Step_Name") })
                @Html.ValidationMessageFor(model => model.StepDesc, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group row">
            @Html.TitleFor(model => model.HandledBy, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
            <div class="col-md-5">
                @Html.SelectFor(model => model.HandledBy, Model.ListHandlers, "", new { @class = "form-control col-md-12", onchange = "_onChangeCombo(this, '#Step #Handler')" })
                @Html.ValidationMessageFor(model => model.HandledBy, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.Handler)
            </div>
            @Html.TitleFor(model => model.ProcessedTime, new { @class = "col-sm-2 col-form-label text-sm-right pr-0 font-bold" })
            <div class="col-md-2">
                <div class="input-group">
                    @Html.TextBoxFor(model => model.ProcessedTime, new { type = "number", min = 0, max = 100, step = 0.1, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Step_ProcessedTime") })
                    <div class="input-group-append">
                        <span class="input-group-text">Ngày</span>
                    </div>
                </div>

                @Html.ValidationMessageFor(model => model.ProcessedTime, "", new { @class = "text-danger" })
            </div>
        </div>

        @*@{
                if (Model.StepId != null)
                {
                    <hr/>
                    <div class="form-group row">
                        @Html.TitleFor(model => model.Reason, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                        <div class="col-md-8">
                            @Html.TextAreaFor(model => model.Reason, new { rows = 2, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Reason_Title") })
                            @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
                        </div>
                    </div>
                }
            }*@
        <hr />
        <div class="form-group row">
            <div class="col-md-3 text-right p-0">
                <button type="submit" id="btnSave" class="btn px-4 btn-outline-primary mb-1"><i class="fa fa-save"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Save")</button>
            </div>
            <div class="col-md-9">

            </div>
        </div>
    </div>

}
