@using TSFramework.App.Processors
@model Core.Inv.Models.MajorInvModel

@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.InvId)
@Html.HiddenFor(model => model.InvKey)
@Html.HiddenFor(model => model.InvNo)
@Html.HiddenFor(model => model.Pattern)
@Html.HiddenFor(model => model.Serial)
<h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
<hr />
<div class="form-group row">
    <div class="col-md-12">
        @Html.TitleFor(model => model.Reason, new { @class = "col-form-label pr-0 font-bold text-danger" }) <spam class="col-form-label pr-0 font-bold text-danger"> (*)</spam>
        @Html.TextAreaFor(model => model.Reason, new { rows = 2, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Reason_Title") })
        @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
    </div>
</div>