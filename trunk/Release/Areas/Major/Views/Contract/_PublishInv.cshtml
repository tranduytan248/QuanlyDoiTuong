@using TSFramework.App.Processors
@model Modules.Major.Areas.Major.Models.PublishInvModel
@{
    ViewBag.Title = $"{AppProcessor.Messagor.GetMessage("PublishInv_Title")} - {AppProcessor.Messagor.GetMessage("Contract_Title")} [{Model.ContractNoInfo}]";
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    success
}

@section FormIcon{
    <i class="fas fa-file-invoice-dollar"></i>
}

@section FormBody{

    @using (Html.BeginForm("PublishInv", "Contract", new { area = "Major" }, FormMethod.Post, new { encType = "multipart/form-data", id = "PublishInv", @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_Invoice")
        </div>
    }

    <script type="text/javascript">

        //debugger;

        $('form#PublishInv').ajaxForm({
            beforeSubmit: function (arr, $form, options) {
            },
            success: function (response) {
                if (response.status != undefined) {
                    if ($("#ModalContent #modal_PublishInv #chkNotDismissModal").is(":checked")) {
                        if (response.status != undefined) {
                            eval(response.message);
                            _tableContracts.ajax.reload(null, false);
                            response.status = undefined;
                            var urlAction = $("#ModalContent #modal_PublishInv form").attr("action");
                            $("#ModalContent #modal_PublishInv #modal-content").load(urlAction, function (data, textStatus, xhr) {
                                _initElement();
                            });
                        }
                    } else {
                        $("#ModalContent #modal_PublishInv").modal("hide");
                        $("#ModalContent #modal_PublishInv").on("hidden.bs.modal",
                            function () {
                                if (response.status != undefined) {
                                    eval(response.message);
                                    _tableContracts.ajax.reload(null, false);
                                    response.status = undefined;
                                }
                            });
                    }
                } else {
                    $("#ModalContent #modal_PublishInv #bodyForm").html(response);
                }
            }
        });

        var arrPanels = { "0": 'a[href="#contract"]', "1": 'a[href="#invPattern"]', "2": 'a[href="#invoice"]' };

        //2^0: "None";
        //2^1: "Disable";
        //2^2: "View";

        var arrConditionButtonStatus = {
            "0": { "#btnConfirm": 2, "#btnReject": 0 },
            "1": { "#btnConfirm": 1, "#btnReject": 2 },
            "2": { "#btnConfirm": 2, "#btnReject": 2 }
        };

        function _onApprove(btnConfirm, btnReject, currentPanel) {
            //Trường hợp panel đầu tiên: Thông tin hợp đồng
            var nextPanel = currentPanel + 1;
            $(btnReject).attr('onclick', '_onReject("{0}","{1}",{2})'.format(btnConfirm, btnReject, nextPanel));
            $(btnConfirm).attr('onclick', '_onApprove("{0}","{1}",{2})'.format(btnConfirm, btnReject, nextPanel));

            var btnConfirmStatus = arrConditionButtonStatus[nextPanel][btnConfirm];
            var btnRejectStatus = arrConditionButtonStatus[nextPanel][btnReject];

            if(btnConfirmStatus == 0){
                $(btnConfirm).addClass('d-none');
            } else if (btnConfirmStatus == 1) {
                $(btnConfirm).removeClass('d-none');
                $(btnConfirm).addClass('disabled');
            } else if (btnConfirmStatus == 2) {
                $(btnConfirm).removeClass('d-none');
                $(btnConfirm).removeClass('disabled');
            }

            if (btnRejectStatus == 0) {
                $(btnReject).addClass('d-none');
            } else if (btnRejectStatus == 1) {
                $(btnReject).removeClass('d-none');
                $(btnReject).addClass('disabled');
            } else if (btnRejectStatus == 2) {
                $(btnReject).removeClass('d-none');
                $(btnReject).removeClass('disabled');
            }

            $(arrPanels[nextPanel]).click();
        }

        function _onReject(btnConfirm, btnReject, currentPanel) {
            var prevPanel = currentPanel - 1;
            $(btnReject).attr('onclick', '_onReject("{0}","{1}",{2})'.format(btnConfirm, btnReject, prevPanel));
            $(btnConfirm).attr('onclick', '_onApprove("{0}","{1}",{2})'.format(btnConfirm, btnReject, prevPanel));

            var btnConfirmStatus = arrConditionButtonStatus[prevPanel][btnConfirm];
            var btnRejectStatus = arrConditionButtonStatus[prevPanel][btnReject];

            if (btnConfirmStatus == 0) {
                $(btnConfirm).addClass('d-none');
            } else if (btnConfirmStatus == 1) {
                $(btnConfirm).removeClass('d-none');
                $(btnConfirm).addClass('disabled');
            } else if (btnConfirmStatus == 2) {
                $(btnConfirm).removeClass('d-none');
                $(btnConfirm).removeClass('disabled');
            }

            if (btnRejectStatus == 0) {
                $(btnReject).addClass('d-none');
            } else if (btnRejectStatus == 1) {
                $(btnReject).removeClass('d-none');
                $(btnReject).addClass('disabled');
            } else if (btnRejectStatus == 2) {
                $(btnReject).removeClass('d-none');
                $(btnReject).removeClass('disabled');
            }

            $(arrPanels[prevPanel]).click();
        }

    </script>

}

@section SubmitControl{

    <button type="submit" id="btnConfirm" class="btn px-4 btn-outline-primary mb-1"><i class="fas fa-check-double"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Approve")</button>

    @*<button type="button" id="btnReject" class="btn px-4 btn-outline-warning mb-1 d-none" onclick="_onReject('#btnConfirm','#btnReject', 0)"><i class="fas fa-arrow-left"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Reject")</button>

        <button type="button" id="btnConfirm" class="btn px-4 btn-outline-primary mb-1" onclick="_onApprove('#btnConfirm','#btnReject', 0)"><i class="fas fa-check-double"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Approve")</button>*@
}