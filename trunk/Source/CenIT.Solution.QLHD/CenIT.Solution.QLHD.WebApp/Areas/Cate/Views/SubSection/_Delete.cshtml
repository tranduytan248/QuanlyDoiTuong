@using TSFramework.App.Processors
@model Cores.Cate.Models.CateSubSectionModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("SubSection_Label_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{

    @using (Ajax.BeginForm("Delete", "SubSection", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "SubSection_OnProcessSuccess(data, 'DeleteSubSection')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.SubSectionId)
        @Html.HiddenFor(model => model.SubSectionName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}