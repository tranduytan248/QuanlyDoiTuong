@using TSFramework.App.Processors
@model Cores.Cate.Models.CateContractTemplateModel

@Html.AntiForgeryToken()

@Html.HiddenFor(model => model.Id)
@Html.HiddenFor(model => model.FileName)
@Html.HiddenFor(model => model.TemplateName)
@Html.HiddenFor(model => model.IsUsed)
@Html.HiddenFor(model => model.Status)
@Html.HiddenFor(model => model.TemplateFields)
@Html.HiddenFor(model => model.TemplatePath)
@Html.HiddenFor(model => model.TemplatePathCosumer)
@Html.HiddenFor(model => model.TemplateType)
@Html.HiddenFor(model => model.Username)
@Html.HiddenFor(model => model.Version)
<div class="form-group row">
    @Html.TitleFor(model => model.ContractTypeId, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-8">
        @Html.DropDownListFor(model => model.ContractTypeId, new SelectList(Model.ListTypeContracts, "ContractTypeId", "ContractTypeName"), "", new { id = "ContractTypeDropdown", @class = "form-control" })
        @Html.ValidationMessageFor(model => model.ContractTypeId, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group row">
    @Html.TitleFor(model => model.FullName, new { @class = "col-md-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-7">
        @Html.TextBoxFor(model => model.FullName, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("TemplateName") })
        @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group row">
    @Html.TitleFor(model => model.IndexTabel, new { @type = "number", @class = "col-md-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-3">
        @Html.TextBoxFor(model => model.IndexTabel, new { @type = "number", @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("TemplateName") })
        @Html.ValidationMessageFor(model => model.IndexTabel, "", new { @class = "text-danger" })
    </div>

</div>
<div class="form-group row">

    @Html.TitleFor(model => model.IndexRowInTable, new { @class = "col-md-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-3">
        @Html.TextBoxFor(model => model.IndexRowInTable, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("TemplateName") })
        @Html.ValidationMessageFor(model => model.IndexRowInTable, "", new { @class = "text-danger" })
    </div>
</div>
@{
    var name = Model.FileName != null ? Model.FileName.Split(',') : new string[0];
}
<div class="form-group row">
    @Html.TitleFor(model => model.RefFiles, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-8">
        <div class="col-md-12 form-group">
            @if (name.Length > 0)
            {<div class="col-form-label col-md-12"><a href="@Model.TemplatePathCosumer" download>@name[0]</a></div>}
            <div class="row">
                <lable class="col-form-label text-sm-right pr-0 font-bold">CN-</lable> <div class="col-md-10"> @Html.FileFor(model => model.RefFilesCosumer, ".doc,.docx,.pdf", false, new { @class = "form-control col-md-12" })</div>
            </div>
            @Html.ValidationMessageFor(model => model.RefFiles, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-12 form-group">
            @if (name.Length > 1)
            {
                <div class="col-form-label col-md-12"><a href="@Model.TemplatePath" download>@name[1]</a></div>}
            <div class="row">
                <lable class="col-form-label text-sm-right pr-0 font-bold">DN-</lable> <div class="col-md-10">@Html.FileFor(model => model.RefFiles, ".doc,.docx,.pdf", false, new { @class = "form-control col-md-12" })</div>
            </div>
            @Html.ValidationMessageFor(model => model.RefFiles, "", new { @class = "text-danger" })
        </div>
    </div>
</div>

@Html.RenderScripts(ScriptPosition.BodyInside)
