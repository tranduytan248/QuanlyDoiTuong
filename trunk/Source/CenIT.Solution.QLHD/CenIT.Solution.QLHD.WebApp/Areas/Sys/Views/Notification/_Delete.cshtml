@using TSFramework.App.Processors
@model Cores.Sys.Models.Sys.SysNotificationModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Notification_Label_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{

    @using (Ajax.BeginForm("Delete", "Notification", new { area = "Sys" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Notification_OnProcessSuccess(data, 'DeleteNotification')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.NotificationId)
        @Html.HiddenFor(model => model.NotificationCode)
        @Html.HiddenFor(model => model.ChannelType)
        @Html.HiddenFor(model => model.Situation)
        @Html.HiddenFor(model => model.Receiver)
        @Html.HiddenFor(model => model.Content)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}