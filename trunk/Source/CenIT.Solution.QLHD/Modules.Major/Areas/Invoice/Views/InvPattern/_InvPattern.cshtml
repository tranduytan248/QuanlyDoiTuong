@using TSFramework.App.Processors
@model Core.Inv.Models.MajorInvPatternModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(model => model.PatternId)

<div id="InvPattern">

    <div class="form-row">
        <div class="col-md-4">
            @Html.TitleFor(model => model.Pattern, new { disabled = true, @class = "col-form-label pr-0 font-bold" })
            @Html.TextBoxFor(model => model.Pattern, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("InvPattern_Pattern") })
            @Html.ValidationMessageFor(model => model.Pattern, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-4">
            @Html.TitleFor(model => model.Serial, new { @class = "col-form-label pr-0 font-bold" })
            @Html.TextBoxFor(model => model.Serial, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("InvPattern_Serial"), onchange = "_onLoadInfoPattern('#InvPattern #Pattern', this)" })
            @Html.ValidationMessageFor(model => model.Serial, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-3">
            @Html.TitleFor(model => model.Status, new { @class = "col-form-label pr-0 font-bold" })
            <label class="">
                @Html.CheckBoxFor(model => model.IsActive, new { @class = "checkbox mr-2" })
                @Html.LabelFor(model => model.IsActive, new { @class = "badge bgc-success brc-success text-white badge-lg arrowed arrowed-in-right mb-1" })
            </label>
        </div>
    </div>

    <div id="infoPatternView" class="d-none">
        <hr class="border-none border-t-3 brc-grey-l2 border-double">
        <div class="border-1 brc-dark-l3 radius-1 px-3 py-25 bgc-white text-secondary-d1" id="infoPattern">
        </div>
    </div>
</div>

<script type="text/javascript">
    //debugger;

    $(function () {
        $('#InvPattern #Serial').trigger('change');
    });

    function _onLoadInfoPattern(elePattern, eleSerial) {
        $("#infoPattern").empty();

        var pattern = $(elePattern).val();
        var serial = $(eleSerial).val();
        var urlInfoViaPattern =
            "@Url.Action("GetInfoViaPattern", "InvPattern", new { area = "Invoice" })?pattern=" + pattern + "&serial=" + serial;
        $.ajax({
            type: "GET",
            url: urlInfoViaPattern,
            dataType: "JSON",
            success: function (response) {
                if (response.data == null || response.data.length <= 0) {
                    $("#infoPatternView").addClass('d-none');
                }
                else {
                    var arrayNameInfo = { "Serial": "Ký hiệu", "TotalInv": "Tổng số hoá đơn đăng ký", "InvNoFrom": "Số hoá đơn từ", "InvNoTo": "Đến số hoá đơn", "CurrentInvNo": "Số hoá đơn hiện tại:", "TotalRemainingInv": "Tổng số hoá đơn còn lại", "BeginUsedFrom": "Bắt đầu sử dụng từ" };
                    var arrPatterns = Object.entries(response.data).map(([key, value]) => ({ key, value }));
                    $.each(arrPatterns, function (idx, val) {
                        $("#infoPattern").append('<div class="mt-3">{0}: <span class="badge badge-pill bgc-secondary-l2 text-secondary-d3 px-2 text-500 text-95">{1}</span></div>'.format(arrayNameInfo[val.key], typeof val.value == 'number' ? val.value.toLocaleString() : val.value));
                    });
                    $("#infoPatternView").removeClass('d-none');
                }
            }
        });
    }

</script>
