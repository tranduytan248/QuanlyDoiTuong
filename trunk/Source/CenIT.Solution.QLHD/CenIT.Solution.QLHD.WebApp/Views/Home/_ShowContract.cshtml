@using TSFramework.App.Processors
@model string

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
</head>
<body>
    <object data="data:application/pdf;base64,@Model" type="application/pdf" width="100%" height="600" style="min-height:calc(100vh - 20px);">
        <p>@AppProcessor.Messagor.GetMessage("ContentDownloadContract"): <a href="data:application/pdf;base64,@Model" download="Contract.pdf">Tải xuống hợp đồng</a>.</p>
    </object>
</body>
</html>
