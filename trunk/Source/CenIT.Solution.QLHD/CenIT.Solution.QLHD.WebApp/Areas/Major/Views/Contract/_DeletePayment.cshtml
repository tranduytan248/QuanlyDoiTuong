@using TSFramework.App.Processors
@model Cores.Major.Models.MajorContractPaymentModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("ContractPayment_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("DeletePayment", "Contract", new { area = "Major" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Payment_OnProcessSuccess(data, 'DeletePayment')",
        OnBegin = "_onWaiting()"
    }, new { @class = "form-horizontal", id = "DeletePayment" }))
    {
        <div id="bodyForm">
	        @Html.Partial("_DeletePaymentBody")
        </div>
    }
}