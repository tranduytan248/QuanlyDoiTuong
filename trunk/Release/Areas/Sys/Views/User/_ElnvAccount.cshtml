@using TSFramework.App.Processors
@model Cores.Sys.Models.Sys.SysElnvAccountModel
@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.UserId)
<div class="form-group row">
    @Html.TitleFor(model => model.FullName, new { @class = "col-md-4 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-7">
        @Html.TextBoxFor(model => model.FullName, new { @class = "form-control",  placeholder = AppProcessor.Messagor.GetMessage("ElnvAccount_FullName"), @rows = 3, @readonly = "readonly" })
        @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row">
    @Html.TitleFor(model => model.EmpAccount, new { @class = "col-md-4 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-7">
        @Html.TextBoxFor(model => model.EmpAccount, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("EmpAccount_Label"), @rows = 3, @readonly = "readonly" })
        @Html.ValidationMessageFor(model => model.EmpAccount, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row">
    @Html.TitleFor(model => model.ElnvAccount, new { @class = "col-md-4 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-7">
        @Html.TextBoxFor(model => model.ElnvAccount, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("ElnvAccount_Label"), @rows = 3 })
        @Html.ValidationMessageFor(model => model.ElnvAccount, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row">
    @Html.TitleFor(model => model.ElnvACPassword, new { @class = "col-md-4 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-7">
        @Html.TextBoxFor(model => model.ElnvACPassword, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("ElnvACPassword_Label"), type = "password" })
        @Html.ValidationMessageFor(model => model.ElnvACPassword, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row">
    @Html.TitleFor(model => model.Reason, new { @class = "col-md-4 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-7">
        @Html.TextAreaFor(model => model.Reason, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Reason_Label"), @rows = 3 })
        @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
    </div>
</div>
