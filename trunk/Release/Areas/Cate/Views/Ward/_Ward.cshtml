@using TSFramework.App.Processors
@model Cores.Sys.Models.Cate.CateWardModel

@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.WardId)
@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<div id="Ward">
    @{
        if (Model.WardId > 0)
        {
            <div class="form-group row">
                @Html.TitleFor(model => model.ProvinceId, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.ProvinceId, new SelectList(Model.Provinces, "Value", "Text"), "", new { @class = "form-control col-md-10", onchange = "OnChangeProvince(this, $('#Ward select#DistrictId'))" })
                    @Html.ValidationMessageFor(model => model.ProvinceId, "", new { @class = "text-danger" })
                </div>
            </div>
        }
        else
        {
            <div class="form-group row">
                @Html.TitleFor(model => model.ProvinceId, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.ProvinceId, new SelectList(Model.Provinces, "Value", "Text"), "", new { @class = "form-control col-md-10", onchange = "OnChangeProvince(this, $('#Ward select#DistrictId'))" })
                    @Html.ValidationMessageFor(model => model.ProvinceId, "", new { @class = "text-danger" })
                </div>
            </div>
        }
    }

    <div class="form-group row">
        @Html.TitleFor(model => model.DistrictId, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-8">
            @Html.DropDownListFor(model => model.DistrictId, new SelectList(Model.Districts, "Value", "Text"), "", new { @class = "form-control col-md-10", onchange = "OnChangeCombo(this, '#Ward #DistrictName');" })
            @Html.ValidationMessageFor(model => model.DistrictId, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.DistrictName)

        </div>
    </div>

    @{
        if (Model.WardId > 0)
        {
            <div class="form-group row">
                @Html.TitleFor(model => model.WardCode, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.WardCode, new { @class = "form-control col-md-8", @readonly = "readonly" })

                </div>
            </div>
        }
        @*else
            {
                <div class="form-group row hidden">
                    @Html.TitleFor(model => model.WardCode, new {@class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold"})
                    <div class="col-md-8">
                        @Html.TextBoxFor(model => model.WardCode, new {@class = "form-control col-md-8" })

                    </div>
                </div>
            }*@
    }
    <div class="form-group row">
        @Html.TitleFor(model => model.WardName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-8">
            @Html.TextBoxFor(model => model.WardName, new { @class = "form-control col-md-10", placeholder = AppProcessor.Messagor.GetMessage("Ward_Label_Name") })
            @Html.ValidationMessageFor(model => model.WardName, "", new { @class = "text-danger" })
        </div>
    </div>
</div>
<script type="text/javascript">

    function OnChangeProvince(cbbProvince, cbbDistrict) {
        if ($("#Ward #ProvinceName").length > 0) {
            $("#Ward #ProvinceName").val($(cbbDistrict).children("option:selected").text());
        }

        var selectedProvince = $(cbbProvince).val();
        var urlDistrictsViaProvince =
            "@Url.Action("GetDistrictsBelongProvince", "Ajax", new { area = "Cate" })?provinceIds=" + selectedProvince;
        $.ajax({
            type: "GET",
            url: urlDistrictsViaProvince,
            dataType: "JSON",
            success: function(response) {
                $(cbbDistrict).empty();
                $(cbbDistrict).append('<option value=""></option>');

                $.each(response.Districts,
                    function(index, item) {
                        $(cbbDistrict).append('<optgroup label="' + index + '">');
                        $.each(item,
                            function(idx, district) {
                                $(cbbDistrict).append('<option value="' + district.DistrictId + '">' + district.DistrictName + "</option>");
                            });
                        $(cbbDistrict).append('</optgroup>');
                    });
            }
        });
    }
</script>