@using TSFramework.App.Processors
@model Cores.Major.Models.MajorProcedureModel

@{
    ViewBag.Title = Html.Raw($"{AppProcessor.Messagor.GetMessage("Step_Title")} - <b>{AppProcessor.Messagor.GetMessage("Procedure_Title")} [{Model.ProcedureName}]</b> - {Model.ContractTypeName}");
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    warning
}

@section FormIcon{
    <i class="fas fa-eye"></i>
}

@section FormBody{
    <style type="text/css">
        .jqtree.tree-dotted .jqtree_common:not(.jqtree-folder) > .jqtree-element::before {
            /*background-color: unset;*/
            display: none;
        }

        .jqtree-filtering a.jqtree-toggler,
        .jqtree-filtering li > ul {
            display: none !important;
        }

        .jqtree-filtering li.jqtree-filtered > ul, .jqtree-filtering li.jqtree-filtered > div > a.jqtree-toggler {
            display: block !important;
        }
    </style>

    <div class="row" id="Proc">
        <div class="col-12 col-md-4 mt-3 mt-md-0">
            <div class="card dcard">
                <div class="card-header bgc-dark">
                    <h3 class="card-title text-120 text-white">
                        <span class="text-90">@AppProcessor.Messagor.GetMessage("Procedure_Title")</span>
                        <span class="text-110 font-bolder">[@Model.ProcedureName]</span>
                    </h3>
                </div>

                <div class="card-body bgc-white border-1 border-t-0 brc-default-m3 table-responsive p-2" style="height: calc(100vh - 250px); overflow:auto; overflow-x: hidden;">
                    <div class="d-inline-flex align-items-center ml-sm-0 mb-1 col-12">
                        <i class="fa fa-search text-grey-m1 pos-abs ml-2"></i>
                        <input type="text" class="form-control pl-425" placeholder="Nhập để tìm" id="searchQuery">
                    </div>
                    <hr class="brc-primary-m3" />
                    <div class="jqtree tree-dotted py-1" id="stepTreeViews"></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-8 mt-3 mt-md-0" id="DetailElement">
            <div class="card dcard brc-primary-m3">
                <div class="card-header">
                    <h5 class="text-120 text-primary-d2 my-auto col-9">
                        <i class="fas fa-info mr-2px"></i>
                        Thông tin
                    </h5>
                    <div class="card-toolbar no-border">
                        @*<a class="btn px-4 btn-outline-primary mb-1" data-modal="true" data-modal-id="AddStep" data_width="1024px" href="@Url.Action("Add", "Step", new{procedureId = Model.ProcedureId})"><i class="fa fa-plus mr-1"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Add") @AppProcessor.Messagor.GetMessage("Step_Title")</a>*@

                        @*<a class="btn px-1 btn-outline-primary mr-1" href="javascript:void(0);" onclick="_addStep('@Model.ProcedureId', '@Model.ProcedureName')"><i class="fa fa-plus mr-1"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Add") @AppProcessor.Messagor.GetMessage("Step_Title")</a>*@
                    </div>
                </div>

                <div class="card-body bgc-transparent p-0 border-1 border-t-0 ace-scroll ace-scroll-grey" id="TreeItemDetail" style="height: calc(100vh - 250px); overflow:auto; overflow-x: hidden;">

                </div><!-- /.card-body -->
                <div class="card-footer bgc-white px-4 py-3 brc-dark-l3 d-flex">
                    <button type="button" id="btnSave" class="btn px-4 btn-outline-primary mb-1 d-none" onclick="$('#TreeItemDetail button[type=&quot;submit&quot;]').click();"><i class="fa fa-save"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Save")</button>
                </div>

            </div><!-- /.card -->
        </div><!-- /.col -->
    </div>

    <script src="@Url.Content("~/Contents/Base/plugins/ace_v4/node_modules/sortablejs/Sortable.js")"></script>

    <script type="text/javascript">

        var procTreeView = null;
        var filter = $("input#searchQuery"),
            filtering = false,
            thread = null;;

        jQuery(function ($) {

            // Browse Files Tree
            //var stepDatas = @Html.Raw(Model.StepsTreeView);

            procTreeView = $('#stepTreeViews');
            procTreeView.tree({
                //data: stepDatas,
                dataUrl: '@Url.Action("GetTreeViewData")?id=@Model.ProcedureId',
                autoOpen: true,
                slide: true,
                selectable: false,
                // dragAndDrop: true,
                //useContextMenu: false,
                useContextMenu: true,
                // used to specify drag & dropped item's color
                onCanMoveTo: function (node) {
                    node.element.querySelector('* > .jqtree-element').classList.add('bgc-warning-l1', 'border-x-2', 'brc-warning');
                    return true;
                },
                dots: false,
                closedIcon: $('<i class="fa fa-caret-right text-success"></i>'),
                openedIcon: $('<i class="fa fa-caret-right rotate-45 text-success"></i>'),

                onCreateLi: function (node, $li, is_selected) {
                    $li.find('.jqtree-element').addClass('bgc-h-warning-l3')
                    var $title = $li.find('.jqtree-title');

                    // insert the icons
                    if (node.icons) {

                        var iconDefault = null
                        // prepend the `default` icon
                        if (node.icons.default) {
                            iconDefault = $(node.icons.default[0]).addClass(node.icons.default[1]).addClass('node-icon')
                            $title.prepend(iconDefault)
                        }

                        // prepend the `open` icon
                        if (node.icons.open) {
                            if (iconDefault) iconDefault.addClass('closed-icon')
                            $title.prepend(
                                $(node.icons.open[0]).addClass(node.icons.open[1]).addClass('opened-icon').addClass('node-icon')
                            )
                        }
                    }

                    var search = filter.val().toLowerCase(),
                    value = $title.text().toLowerCase();

                    if (search !== '') {
                        $li.hide();
                        if (value.indexOf(search) > -1) {
                            $li.show();
                            var parent = node.parent;
                            while (typeof (parent.element) !== 'undefined') {
                                $(parent.element)
                                    .show()
                                    .addClass('jqtree-filtered');
                                parent = parent.parent;
                            }
                        }
                        if (!filtering) {
                            filtering = true;
                        };
                        if (!procTreeView.hasClass('jqtree-filtering')) {
                            procTreeView.addClass('jqtree-filtering');
                        };
                    } else {
                        if (filtering) {
                            filtering = false;
                        };
                        if (procTreeView.hasClass('jqtree-filtering')) {
                            procTreeView.removeClass('jqtree-filtering');
                        };
                    };
                },
                onCanMove: function (node) {
                    if (filtering) {
                        return false;
                    } else {
                        return true;
                    };
                }
            });

            filter.keyup(function () {
                clearTimeout(thread);
                thread = setTimeout(function () {
                    procTreeView.tree('loadDataFromUrl', '@Url.Action("GetTreeViewData")?id=@Model.ProcedureId');
                }, 50);
            });

            // function to (un)highlight tree nodes
            var _highlightNode = function (node) {
                var className = node.children.length > 0 ? 'bgc-success-l2' : 'bgc-primary-l2';
                var el = node.element.querySelector('* > .jqtree-element')
                el.classList.add(className)
                el.classList.remove('bgc-h-warning-l3')
            }

            var _unhighlightNode = function (node) {
                var el = node.element.querySelector('* > .jqtree-element')
                el.classList.remove('bgc-success-l2')
                el.classList.remove('bgc-primary-l2')
                el.classList.add('bgc-h-warning-l3')
            }

            var _lastDropdownToggler = null, _lastNodeWithDropdown = null
            // function to hide context menu
            var _hideContextMenu = function (togglerBtn) {
                $(togglerBtn.parentNode).removeClass('dropdown dd-backdrop dd-backdrop-none-md')
                $(togglerBtn).next().remove()
                $(togglerBtn).dropdown('dispose').remove()
                _lastDropdownToggler = null
                _lastNodeWithDropdown = null
            }

            procTreeView
                .on('tree.click', function (e) {
                    // Disable single selection
                    e.preventDefault()

                    // if a context menu is displayed, return
                    if (_lastDropdownToggler != null) return

                    var selectedNode = e.node
                    if (selectedNode.id === undefined) {
                        //console.warn('The multiple selection functions require that nodes have an id');
                        return
                    }

                    _onClickNode(selectedNode.id, selectedNode.name, selectedNode.typeElement);

                    if (selectedNode.children.length > 0) {
                        if (selectedNode.is_open) {
                            procTreeView.tree('closeNode', selectedNode);
                        }
                        else {
                            procTreeView.tree('openNode', selectedNode);
                        }
                    }

                    var selectedNodes = procTreeView.tree('getSelectedNodes');
                    $.each(selectedNodes, function (idx, nodeSelected) {
                        if (nodeSelected != selectedNode) {
                            procTreeView.tree('removeFromSelection', nodeSelected);
                            _unhighlightNode(nodeSelected);
                        }
                    })

                    if (procTreeView.tree('isNodeSelected', selectedNode)) {
                        procTreeView.tree('removeFromSelection', selectedNode);
                        _unhighlightNode(selectedNode);
                    } else {
                        procTreeView.tree('addToSelection', selectedNode);
                        _highlightNode(selectedNode);
                    }
                })
                .on('tree.contextmenu', function (event) {
                    if (_lastDropdownToggler != null) {
                        if (event.node.element == _lastNodeWithDropdown) return; // dropdown already shown
                        _hideContextMenu(_lastDropdownToggler); // hide previous dropdown
                    }

                    _lastNodeWithDropdown = event.node.element

                    var item = event.node.element.querySelector('.jqtree-title');
                    $(item).addClass('dropdown dd-backdrop dd-backdrop-none-md');

                    if (event.node.typeElement === "Step") {
                        // create and append dropdown menu and toggler
                        $(item).append('<a href="#" class="d-none" data-toggle="dropdown">&nbsp;</a>\
            <div class="dropdown-menu dropdown-caret radius-1 border-b-2 shadow-sm brc-default-m2 dd-slide-up dd-slide-none-md"><div class="dropdown-inner">\
                <div class="d-md-none dropdown-title px-3 text-secondary-d3">'+ event.node.name + '</div>\
                <div class="d-md-none dropdown-divider"></div>\
                <a class="dropdown-item" href="javascript:void(0);" onclick="_addStep(\'' + event.node.parent.id + '\',\'' + event.node.parent.name + '\',\'' + event.node.id + '\')"><i class="fa fa-plus text-blue mr-1 w-2"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Add") @AppProcessor.Messagor.GetMessage("Step_Title")</a>\<a data-modal="true" data-modal-id="DeleteProcedureStep" href="/Major/Procedure/DeleteStep/' + event.node.id + '" class="dropdown-item"><i class="fa fa-trash-alt text-danger mr-1 w-2"></i> @AppProcessor.Messagor.GetMessage("Button_Delete")</a>\
            </div></div>');
                    }
                    else if (event.node.typeElement === "Procedure") {
                        $(item).append('<a href="#" class="d-none" data-toggle="dropdown">&nbsp;</a>\
            <div class="dropdown-menu dropdown-caret radius-1 border-b-2 shadow-sm brc-default-m2 dd-slide-up dd-slide-none-md"><div class="dropdown-inner">\
                <div class="d-md-none dropdown-title px-3 text-secondary-d3">'+ event.node.name + '</div>\
                <div class="d-md-none dropdown-divider"></div>\
                <a class="dropdown-item" data-modal="true" data-modal-id="AddStep" data_width="1024px" href="/Major/Procedure/AddStep?procedureId=' + event.node.id + '"><i class="fa fa-plus text-blue mr-1 w-2"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Add") @AppProcessor.Messagor.GetMessage("Step_Title")</a>\
            </div></div>');
                    }
                    // now show dropdown
                    _lastDropdownToggler = item.querySelector('[data-toggle=dropdown]');

                    $(_lastDropdownToggler)
                    .dropdown('show')
                    .parent()
                    .one('hide.bs.dropdown', function (e) {
                        _hideContextMenu(this.querySelector('[data-toggle=dropdown]'));
                    });
                });

            $('#btnSearchInTree').click(function () {
                var search_term = $("input#searchQuery").val();

                var tree = procTreeView.tree('getTree');

                tree.iterate(
                    function (node) {
                        if (node.name.indexOf(search_term) == -1) {
                            // Not found, continue searching
                            return true;
                        }
                        else {
                            // Found. Select node. Stop searching.
                            procTreeView.tree('selectNode', node, true);
                            procTreeView.tree('scrollToNode', node);
                            return false
                        }
                    }
                );
            });

        });

        ///cardIds = "xxx;cccc;vvvv;";
        function _onCollapseCard(cardIds) {
            //debugger;
            var arrCardIds = cardIds.split(';');
            $.each(arrCardIds, function (idx, cardId) {
                if (cardId.length > 0) {
                    $("#" + cardId + " a[data-action='toggle']")[0].click();
                }
            });
        }
    </script>

    <script type="text/javascript">
        //debugger;
        function _onClickNode(eleId, eleName, typeEle) {
                        var warningSave = $("#EditStep input[type='hidden'][id='WarningSave']").val() == "True";
            if (warningSave) {
                bootbox.confirm({
                    title: '<span class="text-danger text-500 text-120"><i class="fas fa-exclamation-triangle"></i>&nbsp;Cảnh báo</span>',
                    message: '<p class="alert bgc-secondary-l4 brc-danger-m1 border-0 border-l-4 radius-0 text-danger-d2 text-500 text-110"><i class="far fa-hand-point-right mr-1"></i><span>Phát hiện có sự thay đổi dữ liệu nhưng chưa được lưu lại. Vui lòng thực hiện lưu lại để tránh mất dữ liệu. </span></p><hr/><div class="alert bgc-primary-l4 brc-primary-m4 d-flex align-items-center text-dark-tp2" role="alert"><i class="fas fa-info-circle mr-3 fa-2x text-blue"></i><span class="text-500">Bạn có muốn lưu dữ liệu?</span></div>',
                    onEscape: true,
                    closeButton: false,
                    buttons: {
                        confirm: {
                            label: '<i class="fas fa-check text-geen"></i> Có',
                            className: 'btn-outline-success'
                        },
                        cancel: {
                            label: '<i class="fas fa-ban text-danger"></i>  Không',
                            className: 'btn-outline-danger'
                        }
                    },
                    callback: function (result) {
                        if (result) {
                            return;
                        } else {
                            _onLoadDetail(eleId, eleName, typeEle);
                        }
                    }
                });
            }
            else {
                _onLoadDetail(eleId, eleName, typeEle);
            }
        }
        function _onLoadDetail(eleId, eleName, typeEle) {

            $('#Proc #DetailElement .card .card-header .card-toolbar').empty();
            $('#Proc #DetailElement .card .card-footer button[type="button"]').addClass("d-none");

            if (typeEle === "Step") {

                var title = "@(string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("Step_Title")))";
                $("#Proc #DetailElement .card-header h5").html("<i class='fas fa-tasks text-white-m1'></i>&nbsp;{0} <b>[{1}]</b>".format(title, eleName));
                $("#Proc #TreeItemDetail").load("@Url.Action("EditStep")?id=" + eleId);

                var htmlAddStep = '<a class="btn px-2 btn-outline-primary mr-1" href="javascript:void(0);" onclick="_addStep(\'@Model.ProcedureId\', \'@Model.ProcedureName\', \'' + eleId + '\')"><i class="fa fa-plus mr-1"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Add") @AppProcessor.Messagor.GetMessage("Step_Title")</a>';

                $('#Proc #DetailElement .card .card-header .card-toolbar').append(htmlAddStep);

                $('#Proc #DetailElement .card .card-footer button[type="button"]').removeClass("d-none");

            }
            else if (typeEle === "End" || typeEle === "Start") {
                var title = "@AppProcessor.Messagor.GetMessage("Step_Title")";
                $("#Proc #DetailElement .card-header h5").html("<i class='fas fa-tasks text-white-m1'></i>&nbsp;{0} <b>[{1}]</b>".format(title, eleName));
                if (typeEle === "Start") {
                    var htmlAddStep = '<a class="btn px-2 btn-outline-primary mr-1" href="javascript:void(0);" onclick="_addStep(\'@Model.ProcedureId\', \'@Model.ProcedureName\', \'' + eleId + '\')"><i class="fa fa-plus mr-1"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Add") @AppProcessor.Messagor.GetMessage("Step_Title")</a>';
                    $('#Proc #DetailElement .card .card-header .card-toolbar').append(htmlAddStep);
                }
            }
            else {
                $("#Proc #DetailElement .card-header h5").html("<b>[{0}]</b>".format(eleName));

                var htmlAddStep = '<a class="btn px-2 btn-outline-primary mr-1" href="javascript:void(0);" onclick="_addStep(\'@Model.ProcedureId\', \'@Model.ProcedureName\')"><i class="fa fa-plus mr-1"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Add") @AppProcessor.Messagor.GetMessage("Step_Title")</a>';
                $('#Proc #DetailElement .card .card-header .card-toolbar').append(htmlAddStep);
            }

            $("#Proc #TreeItemDetail").empty();
        }

        function TreeItem_OnProcessSuccess(response, formId) {
            if (response.status != undefined) {
                eval(response.message);
                response.status = undefined;
                procTreeView.tree('reload');
                if ($("#{0} #chkContinueForm".format(formId)).is(":checked")) { // dùng cho Add
                    var typeEle = response.data.typeEle;
                    var objId = response.data.objId;
                    var objName = response.data.objName;

                    if (typeEle == "Step") {
                        _addStep(objId, objName);
                    }

                } else {
                    $("#Proc #TreeItemDetail").empty();
                    $("#Proc #DetailElement .card-header h5").html('<i class="fas fa-info mr-2px"></i>&nbsp;Thông tin');
                }
            } else {
                $("#Proc #TreeItemDetail").html(response);
            }
        }

        function Step_OnProcessSuccess(response, formId) {
            if (response.status != undefined) {
                $("#ModalContent #modal_" + formId).modal("hide");
                $("#ModalContent #modal_" + formId).on("hidden.bs.modal",
                    function () {
                        if (response.status != undefined) {
                            eval(response.message);
                            response.status = undefined;
                            procTreeView.tree('reload');
                            $("#Proc #TreeItemDetail").empty();
                            $("#Proc #DetailElement .card-header h5").html('<i class="fas fa-info mr-2px"></i>&nbsp;Thông tin');
                        }
                    });
            } else {
                $("#ModalContent #modal_" + formId + " #bodyForm").html(response);
            }
        }

    </script>

    <script type="text/javascript">
        //debugger;

        function _addStep(procId, procName, prevStepId) {
            var title = "@(string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("Step_Title")))";
            $("#Proc #DetailElement .card-header h5").html("<i class='fas fa-plus text-white-m1'></i>&nbsp;{0} - <b>@AppProcessor.Messagor.GetMessage("Procedure_Title") [{1}]</b>".format(title, procName));
            if (prevStepId != undefined) {
                $("#Proc #TreeItemDetail").load("@Url.Action("AddStep")?procedureId=" + procId + "&prevStepId=" + prevStepId);
            } else {
                $("#Proc #TreeItemDetail").load("@Url.Action("AddStep")?procedureId=" + procId);
            }
            $('#Proc #DetailElement .card .card-footer button[type="button"]').removeClass("d-none");
        }

        function _onChangeProcedure(cbbProc, eleProcName, eleStep, selectedStepId, eleStepName, func) {
            var $cbbSteps = $(eleStep);
            $cbbSteps.empty();
            var procId = $(cbbProc).val();
            if (procId == undefined || procId.length <= 0) return;

            $(eleProcName).val($(cbbProc).children("option:selected").text());
            var urlStepsViaProcedure =
                "@Url.Action("StepsViaProcedure", "Procedure", new { area = "Major" })/" + procId;
            $.ajax({
                type: "GET",
                url: urlStepsViaProcedure,
                dataType: "JSON",
                success: function (response) {
                    $cbbSteps.append('<option value=""></option>');

                    $.each(response, function (index, step) {
                        if (step.StepId == selectedStepId) {
                            $cbbSteps.append('<option selected value="' + step.StepId + '">' + step.StepName + "</option>");
                        }
                        else {
                            $cbbSteps.append('<option value="' + step.StepId + '">' + step.StepName + "</option>");
                        }
                    });

                    func($(eleStep), eleStepName);
                }
            });
        }

        function _onLoadStaff(cbbUnions, eleUnionName, cbbPositions, elePositionName, cbbStaffs, staffId) {
            if ($(cbbUnions).length > 0) {
                $(eleUnionName).val($(cbbUnions).children("option:selected").text());
            }
            if ($(cbbPositions).length > 0) {
                $(elePositionName).val($(cbbPositions).children("option:selected").text());
            }

            var unionId = $(cbbUnions).val();
            var positionId = $(cbbPositions).val();

            var urlStaffsViaUnionAndPosition =
                "@Url.Action("StaffsViaUnionAndPosition", "Procedure", new { area = "Major" })?unionId=" + unionId + '&positionId=' + positionId;

            $.ajax({
                    type: "GET",
                    url: urlStaffsViaUnionAndPosition,
                    dataType: "JSON",
                    success: function (response) {
                        $(cbbStaffs).empty();
                        $(cbbStaffs).append('<option value=""></option>');
                        $.each(response, function (index, staff) {
                            $(cbbStaffs).append('<option value="' + staff.UserName + '">' + staff.FullName + "</option>");
                        });
                        if (staffId != undefined && staffId.length > 0) {
                            $(cbbStaffs).val(staffId).trigger("change");
                        }
                    }
                });
        }

    </script>
}
@section SubmitControl{

}
