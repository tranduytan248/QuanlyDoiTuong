@using TSFramework.App.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("EInvoiceAdjust_Title");
}

@section HeadCss{
    <style type="text/css">
        .max-width-280 {
            max-width: 280px;
        }
    </style>
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{

}
<style>
    /* Định nghĩa kiểu kẻ màu trắng bên phải */
    .border-right-white {
        border-right: 1px solid ; /* Màu trắng */
    }

</style>
<div class="mt-3">
    @Html.Partial("_Search")
</div>
<div class="mt-3">
    <div class="card dcard">
        <div class="p-2 table-responsive-md">
            <table id="DSEInvoiceAdjust" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table dtr-inline" width="100%">
                
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="border-right-white"></th>
                        <th colspan="3" class="text-center border-right-white" >@AppProcessor.Messagor.GetMessage("InvoiceAdjusted")</th>
                        <th colspan="3" class="text-center">@AppProcessor.Messagor.GetMessage("InvoiceAdjust")</th>
                    </tr>
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th> <!-- Cột STT -->
                        <th>@AppProcessor.Messagor.GetMessage("Inv_InvNo")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Inv_Pattern")</th>
                        <th class="border-right-white">@AppProcessor.Messagor.GetMessage("InvPattern_Serial")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Inv_InvNo")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Inv_Pattern")</th>
                        <th>@AppProcessor.Messagor.GetMessage("InvPattern_Serial")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>


@section BottomScript
{
    <script src="~/Areas/Invoice/Views/EInvoiceAdjust/EInvoiceAdjust.js"></script>
}