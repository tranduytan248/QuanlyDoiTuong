                                <i class="fas fa-calendar-alt"></i>
                            </span>
                        </div>
                        @Html.TextBoxFor(model => model.ApplyTo, new { @class = "form-control col-md-12 datepicker", placeholder = AppProcessor.Messagor.GetMessage("Dossier_ApplyTo") })
