@using TSFramework.App.Processors
@{
    var titleMsg = AppProcessor.Messagor.GetMessage("SubjectType_Title");
    ViewBag.Title = !string.IsNullOrWhiteSpace(titleMsg) ? titleMsg : "Danh mục Loại đối tượng";
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
    @Html.Button(true, "AddSubjectType", Url.Action("Add", new { area = "Cate" }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add") ?? "Thêm mới", new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right", data_width = "860px" })
}

@Html.Partial("_Search")

<div class="mt-3">
    <div class="card dcard">
        <div class="p-2 table-responsive-md">
            <table id="DSSubjectType" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="text-center" style="width:50px;">STT</th>
                        <th style="width:160px;">Mã loại</th>
                        <th>Tên loại đối tượng</th>
                        <th>Mô tả / Ghi chú</th>
                        <th class="text-center" style="width:90px;">Thứ tự</th>
                        <th class="text-center" style="width:110px;">Trạng thái</th>
                        <th class="text-center" style="width:120px;">Thao tác</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="~/Areas/Cate/Views/SubjectType/SubjectType.js?v=@(System.IO.File.GetLastWriteTime(Server.MapPath("~/Areas/Cate/Views/SubjectType/SubjectType.js")).Ticks)"></script>
}
