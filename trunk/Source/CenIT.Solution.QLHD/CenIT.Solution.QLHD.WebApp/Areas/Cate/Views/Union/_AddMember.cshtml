@model Cores.Cate.Models.CateUnionMemberModel
@using TSFramework.App.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), $"{AppProcessor.Messagor.GetMessage("Union_Member_Title")} - {Model.UnionName}");
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("AddMember", "Union", new { area = "Cate", unionId = Model.UnionId }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "UnionMember_OnProcessSuccess(data, 'AddMember')"
    }, new { @class = "form-horizontal", id = "AddMember" }))
    {
        <div id="bodyForm">
            @Html.Partial("_Member")
        </div>
    }
}

@section ContinueForm{

}