@using System
@using System.Collections.Generic
@using System.Linq
@using Cores.Major.Models
@model Cores.Major.Models.MajorSubjectModel
@{
    ViewBag.Title = "Đơn vị quản lý & Giám sát đối tượng";
    Layout = "~/Views/Shared/_Form.cshtml";
    var listUnits = Model?.ListMonitoringUnits ?? new List<MajorSubjectMonitoringUnitModel>();
    var totalUnits = Model?.TrackingUnitCount > 0 ? Model.TrackingUnitCount : (listUnits.Select(u => u.UnitName).Distinct().Count());
    if (totalUnits == 0) { totalUnits = 1; }
}
@section FormType{ primary }
@section FormIcon{ <i class="fa fa-sitemap"></i> }
@section SubmitControl{
    @if (Model?.SubjectId != null && Model.SubjectId != Guid.Empty)
    {
        <a href="/Major/Subject/Detail/@(Model.SubjectId)" class="btn px-4 btn-outline-primary mb-1" target="_blank">
            <i class="fa fa-external-link-alt mr-1"></i> Xem hồ sơ chi tiết
        </a>
    }
}
@section FormBody{
    <!-- THÔNG TIN ĐỐI TƯỢNG -->
    <div class="card border-1 brc-primary-m3 shadow-sm mb-3">
        <div class="card-body p-3">
            <div class="d-flex align-items-center flex-wrap">
                <img src="@(!string.IsNullOrEmpty(Model?.AvatarUrl) ? Model.AvatarUrl : "/Contents/Base/imgs/avatar-default.png")"
                     onerror="this.src='/Contents/Base/imgs/avatar-default.png';"
                     class="radius-round border-2 brc-primary-m2 mr-3 shadow-sm flex-shrink-0"
                     style="width:56px;height:56px;object-fit:cover;" />
                <div class="flex-grow-1" style="min-width:220px;">
                    <div class="d-flex align-items-center flex-wrap">
                        <span class="font-bolder text-dark-m1 text-115 mr-2">@(Model?.FullName)</span>
                        @if (!string.IsNullOrEmpty(Model?.OtherName))
                        {
                            <span class="text-secondary text-90 mr-2">(Tên khác: <b>@Model.OtherName</b>)</span>
                        }
                        @if (totalUnits > 1)
                        {
                            <span class="badge badge-sm bgc-red-l3 text-red-d2 border-1 brc-red-m3 px-2 py-1 font-bold">
                                <i class="fa fa-exclamation-triangle mr-1"></i> @totalUnits đơn vị cùng khai báo
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-sm bgc-blue-l3 text-blue-d2 border-1 brc-blue-m3 px-2 py-1 font-bold">
                                <i class="fa fa-building mr-1"></i> 1 đơn vị khai báo
                            </span>
                        }
                    </div>
                    <div class="text-secondary text-90 mt-1">
                        <span class="mr-3"><i class="far fa-id-card text-primary mr-1"></i><b>CCCD:</b> @(Model?.IdentityCardNumber)</span>
                        @if (Model?.DateOfBirth != null)
                        {
                            <span class="mr-3"><i class="far fa-calendar text-blue mr-1"></i><b>Ngày sinh:</b> @(Model?.DateOfBirthStr)</span>
                        }
                        @if (!string.IsNullOrEmpty(Model?.Gender))
                        {
                            <span class="mr-3"><i class="fas fa-venus-mars text-purple mr-1"></i><b>Giới tính:</b> @(Model?.Gender)</span>
                        }
                        @if (!string.IsNullOrEmpty(Model?.PlaceOfOrigin))
                        {
                            <span class="mr-3"><i class="fas fa-map-marker-alt text-danger mr-1"></i><b>Quê quán:</b> @(Model?.PlaceOfOrigin)</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Model?.SubjectTypeNames))
                    {
                        <div class="mt-2 d-flex align-items-center flex-wrap">
                            <span class="text-secondary text-90 mr-2"><i class="fas fa-tags text-primary mr-1"></i><b>Loại đối tượng:</b></span>
                            @foreach (var t in Model.SubjectTypeNames.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="badge badge-light-blue text-primary-d2 border-1 brc-primary-m3 text-85 font-bold mr-1 mb-1 px-2 py-1 shadow-none">
                                    <i class="fas fa-tag mr-1 text-80"></i>@t.Trim()
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-light border-l-4 brc-blue-m2 py-2 px-3 mb-3 text-90 text-secondary-d1 d-flex align-items-center justify-content-between">
        <div>
            <i class="fa fa-info-circle text-blue-d1 mr-1"></i>
            Danh sách các đơn vị đã khai báo hồ sơ đối tượng đối với CCCD <b>@(Model?.IdentityCardNumber)</b>.
        </div>
        <small class="text-secondary font-italic d-none d-md-inline">(Click vào từng đơn vị để xem chi tiết)</small>
    </div>

    <!-- DANH SÁCH CÁC ĐƠN VỊ DẠNG ACCORDION -->
    @if (listUnits.Count == 0)
    {
        <div class="alert alert-info py-3 mb-0 text-center">
            <i class="fas fa-info-circle mr-1"></i>
            Chưa có thông tin đơn vị nào khai báo đối tượng này trong phạm vi quyền hạn của bạn.
        </div>
    }
    else
    {
        <div class="accordion" id="accordionUnits" style="max-height: 55vh; overflow-y: auto;">
            @for (int i = 0; i < listUnits.Count; i++)
            {
                var item = listUnits[i];
                var collapseId = "collapseUnit_" + i;
                var headingId = "headingUnit_" + i;

                <div class="card border-1 brc-grey-l2 border-l-4 brc-blue-m1 radius-1 shadow-sm mb-2">
                    <!-- HEADER ĐƠN VỊ (CLICK ĐỂ BUNG/THU GỌN CHI TIẾT) -->
                    <div class="card-header bgc-white hover-bgc-blue-l4 py-2 px-3 cursor-pointer d-flex flex-wrap align-items-center justify-content-between"
                         id="@headingId"
                         data-toggle="collapse"
                         data-target="#@collapseId"
                         aria-expanded="false"
                         aria-controls="@collapseId"
                         style="cursor: pointer; transition: background-color 0.15s ease;">
                        
                        <div class="d-flex align-items-center flex-wrap mr-2 py-1">
                            <span class="d-inline-flex align-items-center justify-content-center radius-round bgc-secondary-l3 text-90 mr-2 shadow-none" style="width:28px;height:28px;">
                                <i class="fas fa-building text-primary"></i>
                            </span>
                            <span class="font-bolder text-dark-m1 text-100 mr-2">
                                @item.UnitName
                            </span>
                            <span class="badge badge-primary text-80 font-bold px-2 py-1 mr-2">
                                <i class="fas fa-folder mr-1"></i>Khai báo hồ sơ đối tượng
                            </span>
                            @if (!string.IsNullOrEmpty(item.ReporterName))
                            {
                                <span class="text-secondary text-85 mr-3">
                                    <i class="fas fa-user-shield text-blue-m1 mr-1"></i>@item.ReporterName
                                    @if (!string.IsNullOrEmpty(item.ReporterPhone))
                                    {
                                        <small class="text-dark-m3 font-600">(@item.ReporterPhone)</small>
                                    }
                                </span>
                            }
                        </div>

                        <div class="d-flex align-items-center py-1">
                            <span class="text-secondary text-85 font-600 mr-3">
                                <i class="far fa-clock mr-1 text-orange-d1"></i>@item.RecordDateStr
                            </span>
                            <span class="btn btn-xs btn-outline-primary radius-1 px-2 font-bold d-inline-flex align-items-center">
                                Chi tiết <i class="fa fa-chevron-down ml-1 text-80 transition-icon"></i>
                            </span>
                        </div>
                    </div>

                    <!-- NỘI DUNG CHI TIẾT KHI CLICK VÀO -->
                    <div id="@collapseId" class="collapse" aria-labelledby="@headingId" data-parent="#accordionUnits">
                        <div class="card-body bgc-secondary-l5 p-3 border-t-1 brc-grey-l3">
                            <!-- THÔNG TIN CÁN BỘ GHI NHẬN -->
                            <div class="row mb-2">
                                <div class="col-md-6 mb-2 mb-md-0">
                                    <span class="text-secondary text-85 d-block font-bold">
                                        <i class="fas fa-user-shield text-blue-d2 mr-1"></i> Cán bộ tiếp nhận / khai báo:
                                    </span>
                                    <div class="text-90 text-dark-m1 font-600 pl-3">
                                        @(string.IsNullOrEmpty(item.ReporterName) ? "Chưa ghi nhận" : item.ReporterName)
                                        @if (!string.IsNullOrEmpty(item.ReporterPosition))
                                        {
                                            <span class="text-secondary font-normal"> &mdash; @item.ReporterPosition</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <span class="text-secondary text-85 d-block font-bold">
                                        <i class="fas fa-phone-alt text-green-d2 mr-1"></i> Số điện thoại liên hệ:
                                    </span>
                                    <div class="text-90 text-dark-m1 pl-3">
                                        @(string.IsNullOrEmpty(item.ReporterPhone) ? "-" : item.ReporterPhone)
                                        @if (!string.IsNullOrEmpty(item.CreatedBy))
                                        {
                                            <small class="text-muted ml-2">(Tài khoản: @item.CreatedBy)</small>
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(item.SubjectTypeNames))
                            {
                                <div class="row mb-2">
                                    <div class="col-md-12">
                                        <span class="text-secondary text-85 d-block font-bold">
                                            <i class="fas fa-tags text-primary mr-1"></i> Loại đối tượng đã khai báo:
                                        </span>
                                        <div class="d-flex flex-wrap pl-3 pt-1">
                                            @foreach (var t in item.SubjectTypeNames.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <span class="badge badge-light-blue text-primary-d2 border-1 brc-primary-m3 text-85 font-bold mr-1 mb-1 px-2 py-1 shadow-none">
                                                    <i class="fas fa-tag mr-1 text-80"></i>@t.Trim()
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="bgc-white p-3 radius-1 border-1 brc-blue-l2 mt-2 text-85 text-secondary-d2">
                                <i class="fa fa-check-circle text-success mr-1"></i> Đơn vị đã tạo hồ sơ định danh và quản lý đối tượng trên hệ thống vào lúc <b>@item.RecordDateStr</b>.
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
