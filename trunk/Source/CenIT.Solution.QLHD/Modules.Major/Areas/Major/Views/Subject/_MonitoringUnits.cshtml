@using System
@using System.Collections.Generic
@using System.Linq
@using Cores.Major.Models
@model Cores.Major.Models.MajorSubjectModel
@{
    ViewBag.Title = "Đơn vị quản lý & Giám sát đối tượng";
    Layout = "~/Views/Shared/_Form.cshtml";
    var listUnits = Model?.ListMonitoringUnits ?? new List<MajorSubjectMonitoringUnitModel>();
    var totalUnits = Model?.TrackingUnitCount > 0 ? Model.TrackingUnitCount : (listUnits.Select(u => u.UnitName).Distinct().Count());
    if (totalUnits == 0) { totalUnits = 1; }
}
@section FormType{ primary }
@section FormIcon{ <i class="fa fa-sitemap"></i> }
@section SubmitControl{
    @if (Model?.SubjectId != null && Model.SubjectId != Guid.Empty)
    {
        <a href="/Major/Subject/Detail/@(Model.SubjectId)" class="btn px-4 btn-outline-primary mb-1" target="_blank">
            <i class="fa fa-external-link-alt mr-1"></i> Xem hồ sơ chi tiết
        </a>
    }
}
@section FormBody{
    <!-- THÔNG TIN ĐỐI TƯỢNG -->
    <div class="card border-1 brc-primary-m3 shadow-sm mb-3">
        <div class="card-body p-3">
            <div class="d-flex align-items-center flex-wrap">
                <img src="@(!string.IsNullOrEmpty(Model?.AvatarUrl) ? Model.AvatarUrl : "/Contents/Base/imgs/avatar-default.png")"
                     onerror="this.src='/Contents/Base/imgs/avatar-default.png';"
                     class="radius-round border-2 brc-primary-m2 mr-3 shadow-sm flex-shrink-0"
                     style="width:58px;height:58px;object-fit:cover;" />
                <div class="flex-grow-1" style="min-width:220px;">
                    <div class="d-flex align-items-center flex-wrap">
                        <span class="font-bolder text-dark-m1 text-120 mr-2">@(Model?.FullName)</span>
                        @if (!string.IsNullOrEmpty(Model?.OtherName))
                        {
                            <span class="text-secondary text-90 mr-2">(Tên khác: <b>@Model.OtherName</b>)</span>
                        }
                        @if (totalUnits > 1)
                        {
                            <span class="badge badge-sm bgc-red-l3 text-red-d2 border-1 brc-red-m3 px-2 py-1 font-bold">
                                <i class="fa fa-exclamation-triangle mr-1"></i> @totalUnits đơn vị cùng giám sát
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-sm bgc-blue-l3 text-blue-d2 border-1 brc-blue-m3 px-2 py-1 font-bold">
                                <i class="fa fa-building mr-1"></i> 1 đơn vị quản lý
                            </span>
                        }
                    </div>
                    <div class="text-secondary text-90 mt-1">
                        <span class="mr-3"><i class="far fa-id-card text-primary mr-1"></i><b>CCCD:</b> @(Model?.IdentityCardNumber)</span>
                        @if (Model?.DateOfBirth != null)
                        {
                            <span class="mr-3"><i class="far fa-calendar text-blue mr-1"></i><b>Ngày sinh:</b> @(Model?.DateOfBirthStr)</span>
                        }
                        @if (!string.IsNullOrEmpty(Model?.Gender))
                        {
                            <span class="mr-3"><i class="fas fa-venus-mars text-purple mr-1"></i><b>Giới tính:</b> @(Model?.Gender)</span>
                        }
                        @if (!string.IsNullOrEmpty(Model?.PlaceOfOrigin))
                        {
                            <span><i class="fas fa-map-marker-alt text-danger mr-1"></i><b>Quê quán:</b> @(Model?.PlaceOfOrigin)</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-light border-l-4 brc-blue-m2 py-2 px-3 mb-3 text-90 text-secondary-d1">
        <i class="fa fa-info-circle text-blue-d1 mr-1"></i>
        Tổng hợp tất cả cơ quan, phòng ban, công an phường/xã đã phát sinh hồ sơ hoặc ghi nhận hành vi vi phạm đối với số định danh CCCD <b>@(Model?.IdentityCardNumber)</b>.
    </div>

    <!-- DANH SÁCH CÁC ĐƠN VỊ VÀ LẦN GHI NHẬN -->
    @if (listUnits.Count == 0)
    {
        <div class="alert alert-info py-3 mb-0 text-center">
            <i class="fas fa-info-circle mr-1"></i>
            Chưa có thông tin đơn vị nào trong phạm vi quyền hạn của bạn.
        </div>
    }
    else
    {
        <div class="ace-scrollbar" style="max-height: 55vh; overflow-y: auto;">
            @for (int i = 0; i < listUnits.Count; i++)
            {
                var item = listUnits[i];
                var isOriginal = item.RecordType == "KHAI_BAO";
                var borderColor = isOriginal ? "brc-blue-m1" : "brc-danger-m1";
                var headerBg = isOriginal ? "bgc-blue-l4" : "bgc-danger-l4";
                var badgeClass = isOriginal ? "badge-primary" : "badge-danger";
                var iconClass = isOriginal ? "fa-id-card text-blue-d1" : "fa-exclamation-triangle text-danger-d1";

                <div class="card border-l-4 @borderColor border-t-1 border-r-1 border-b-1 brc-grey-l2 shadow-sm mb-3">
                    <div class="card-header @headerBg py-2 px-3 d-flex flex-wrap align-items-center justify-content-between">
                        <div class="d-flex align-items-center flex-wrap">
                            <span class="d-inline-flex align-items-center justify-content-center radius-round bgc-white text-90 mr-2 shadow-xs" style="width:28px;height:28px;">
                                <i class="fas @iconClass"></i>
                            </span>
                            <span class="font-bolder text-dark-m1 text-100 mr-2">
                                @item.UnitName
                            </span>
                            <span class="badge @badgeClass text-80 font-bold px-2 py-1 mr-2">
                                @item.RecordTypeName
                            </span>
                        </div>
                        <div class="text-secondary text-85 font-600 mt-1 mt-sm-0">
                            <i class="far fa-clock mr-1"></i> Ngày ghi nhận: <b class="text-dark-m2">@item.RecordDateStr</b>
                        </div>
                    </div>

                    <div class="card-body p-3">
                        <!-- THÔNG TIN CÁN BỘ GHI NHẬN -->
                        <div class="row mb-2">
                            <div class="col-md-6 mb-1">
                                <span class="text-secondary text-85 d-block font-bold">
                                    <i class="fas fa-user-shield text-blue-d2 mr-1"></i> Cán bộ tiếp nhận / thụ lý:
                                </span>
                                <div class="text-90 text-dark-m1 font-600 pl-3">
                                    @(string.IsNullOrEmpty(item.ReporterName) ? "Chưa ghi nhận" : item.ReporterName)
                                    @if (!string.IsNullOrEmpty(item.ReporterPosition))
                                    {
                                        <span class="text-secondary font-normal"> &mdash; @item.ReporterPosition</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6 mb-1">
                                <span class="text-secondary text-85 d-block font-bold">
                                    <i class="fas fa-phone-alt text-green-d2 mr-1"></i> Số điện thoại liên hệ:
                                </span>
                                <div class="text-90 text-dark-m1 pl-3">
                                    @(string.IsNullOrEmpty(item.ReporterPhone) ? "-" : item.ReporterPhone)
                                    @if (!string.IsNullOrEmpty(item.CreatedBy))
                                    {
                                        <small class="text-muted ml-2">(Tài khoản: @item.CreatedBy)</small>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- CHI TIẾT NỘI DUNG VI PHẠM (NẾU LÀ GHI NHẬN VI PHẠM) -->
                        @if (!isOriginal)
                        {
                            <div class="border-t-1 brc-grey-l3 pt-2 mt-2">
                                @if (!string.IsNullOrEmpty(item.FieldNames))
                                {
                                    <div class="mb-2">
                                        <span class="text-secondary text-85 font-bold mr-2"><i class="fas fa-layer-group text-primary mr-1"></i> Lĩnh vực:</span>
                                        @foreach (var field in item.FieldNames.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span class="badge bgc-purple-l3 text-purple-d2 mr-1 mb-1 px-2 py-1">@field.Trim()</span>
                                        }
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(item.BehaviorNames))
                                {
                                    <div class="mb-2">
                                        <span class="text-secondary text-85 font-bold mr-2"><i class="fas fa-gavel text-danger mr-1"></i> Hành vi vi phạm:</span>
                                        @foreach (var beh in item.BehaviorNames.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span class="badge bgc-red-l3 text-red-d2 mr-1 mb-1 px-2 py-1">@beh.Trim()</span>
                                        }
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(item.TreatmentMeasures))
                                {
                                    <div class="mb-1">
                                        <span class="text-secondary text-85 font-bold"><i class="fas fa-balance-scale text-orange-d2 mr-1"></i> Biện pháp xử lý:</span>
                                        <span class="text-90 text-dark-m2 ml-1">@item.TreatmentMeasures</span>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(item.Notes))
                                {
                                    <div class="mb-1">
                                        <span class="text-secondary text-85 font-bold"><i class="far fa-sticky-note text-secondary mr-1"></i> Ghi chú nghiệp vụ:</span>
                                        <span class="text-90 text-dark-m2 ml-1">@item.Notes</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="border-t-1 brc-grey-l3 pt-2 mt-2 text-85 text-secondary-d2">
                                <i class="fa fa-info-circle text-blue mr-1"></i> Đơn vị đã tạo hồ sơ định danh gốc và quản lý đối tượng trên hệ thống.
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
}
