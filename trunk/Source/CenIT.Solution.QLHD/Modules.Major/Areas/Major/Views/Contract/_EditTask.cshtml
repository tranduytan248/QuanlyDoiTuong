@using TSFramework.App.Processors
@model Cores.Major.Models.MajorContractTaskModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("ContractTask_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    purple
}

@section FormIcon{
    <i class="fas fa-user-edit"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("EditTask", "Contract", new { area = "Major" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Task_OnProcessSuccess(data, 'EditTask')",
        OnBegin = "_onWaiting()"
    }, new { @class = "form-horizontal", id = "EditTask" }))
    {

        <div id="bodyForm">
            @Html.Partial("_Task")
        </div>
    }
}
