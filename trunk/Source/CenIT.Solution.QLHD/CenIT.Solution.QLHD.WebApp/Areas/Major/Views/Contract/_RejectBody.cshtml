@using TSFramework.App.Processors
@model Cores.Major.Models.MajorContractRejectModel

@Html.AntiForgeryToken()

@Html.HiddenFor(model => model.ContractId)
@Html.HiddenFor(model => model.ContractNo)
@Html.HiddenFor(model => model.ContractSignal)

<div id="ApproveContract">
    <div class="form-row">
        <div class="col-md-6">
            @Html.TitleFor(model => model.ContractNo, new { @class = "col-form-label pr-0 font-bold" })
            @Html.TextBoxFor(model => model.ContractNoInfo, new { @readonly = true, @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Contract_ContractNo") })
        </div>
        <div class="col-md-4">
            @Html.TitleFor(model => model.ReceivedOn, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                @Html.TextBoxFor(model => model.ReceivedOn, "{0:dd/MM/yyyy HH:mm}", new { disabled = true, @class = "form-control col-md-12 datepicker", placeholder = AppProcessor.Messagor.GetMessage("Contract_ReceivedOn") })
                <div class="input-group-addon input-group-append">
                    <div class="input-group-text">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                </div>
            </div>
            @Html.HiddenFor(model => model.ReceivedOn)
            @Html.ValidationMessageFor(model => model.ReceivedOn, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-row">
        <div class="col-md-6">
            @Html.TitleFor(model => model.CusName, new { @class = "col-form-label pr-0 font-bold" })
            @Html.TextBoxFor(model => model.CusName, new { @readonly = true, @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Customer_Title") })
        </div>
        <div class="col-md-4">
            @Html.TitleFor(model => model.RejectOn, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                @Html.TextBoxFor(model => model.RejectOn, "{0:dd/MM/yyyy HH:mm}", new { disabled = true, @class = "form-control col-md-12 datetimepicker", placeholder = AppProcessor.Messagor.GetMessage("Contract_RejectOn") })
                <div class="input-group-addon input-group-append">
                    <div class="input-group-text">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                </div>
            </div>
            @Html.HiddenFor(model => model.RejectOn)
            @Html.ValidationMessageFor(model => model.RejectOn, "", new { @class = "text-danger" })
        </div>
    </div>

    <hr class="border-none border-t-3 brc-grey-l2 border-double">

    <div class="form-group row">
        <div class="col-md-12">
            @Html.TitleFor(model => model.RefFiles, new { @class = "col-form-label pr-0 font-bold" })
            @Html.FileFor(model => model.RefFiles, ".doc,.docx,.pdf", false, new { @class = "form-control col-md-12" })
            @Html.ValidationMessageFor(model => model.RefFiles, "", new { @class = "text-danger" })
        </div>
    </div>
</div>
@Html.RenderScripts(ScriptPosition.BodyInside)

<script src="~/Contents/Modules/Major/plugins/jquery.masknumber/jquery.masknumber.min.js"></script>