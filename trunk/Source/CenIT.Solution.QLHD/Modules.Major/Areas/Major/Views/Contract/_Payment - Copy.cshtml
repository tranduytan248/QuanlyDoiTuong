        {
            <div class="form-row">
                @Html.TitleFor(model => model.Status, new { @class = "col-form-label pr-0 font-bold" })
                <div class="col-md-12">
                    @{
                        var dictPaymentStatusColors = new Dictionary<string, string>{
                        {$"{(int)EnumPaymentStatus.Received}","success"},
                        {$"{(int)EnumPaymentStatus.Refunded}","danger"}
                    };

                        foreach (var paymentStatus in Model.ListPaymentStatus.OrderBy(ps => ps.Value))
                        {
                            <label class="px-0 pt-2">
                                @Html.RadioButtonFor(model => model.Status, paymentStatus.Value, new { onchange = "_onChangeCombo(this, '#Payment #StatusName')" })
                                <span class="badge bgc-@dictPaymentStatusColors[paymentStatus.Value] brc-@dictPaymentStatusColors[paymentStatus.Value] text-white badge-lg arrowed arrowed-in-right mb-1">
                                    <span class="px-3">@paymentStatus.Text</span>
                                </span>
                            </label>
