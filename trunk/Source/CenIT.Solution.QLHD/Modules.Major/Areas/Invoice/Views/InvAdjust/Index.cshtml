@using TSFramework.App.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("InvAdjust_Title");
}

@section HeadCss{

}


@section PluginCss
{
    <link rel="stylesheet" type="text/css" href="/Contents/Base/plugins/ace_v4/node_modules/tiny-date-picker/tiny-date-picker.css">
    <link rel="stylesheet" type="text/css" href="/Contents/Base/plugins/ace_v4/node_modules/tiny-date-picker/date-range-picker.css">
    <link rel="stylesheet" type="text/css" href="~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-select/dist/css/bootstrap-select.css">
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{

}

<div class="mt-3">
    @Html.Partial("_Search")
</div>

<div class="mt-3">
    <div class="card dcard">
        <div class="p-2 table-responsive-md d-none">
            <table id="DSAdjustInvs" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table dtr-inline" width="100%">

                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="border-1 border-t-0 brc-secondary-m4"></th>
                        <th colspan="3" class="text-center">@AppProcessor.Messagor.GetMessage("Inv_Adjusted")</th>
                        <th colspan="3" class="text-center">@AppProcessor.Messagor.GetMessage("Inv_Adjust")</th>
                    </tr>
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th> <!-- Cột STT -->
                        <th>@AppProcessor.Messagor.GetMessage("Inv_InvNo")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Inv_Pattern")</th>
                        <th class="border-right-white">@AppProcessor.Messagor.GetMessage("InvPattern_Serial")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Inv_InvNo")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Inv_Pattern")</th>
                        <th>@AppProcessor.Messagor.GetMessage("InvPattern_Serial")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section PluginJs
{
    <script src="@Url.Content("~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-select/dist/js/bootstrap-select.js")"></script>
    <script src="@Url.Content("~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-select/dist/js/defaults-vi_VN.min.js")"></script>

    <script src="/Contents/Base/plugins/ace_v4/node_modules/tiny-date-picker/dist/date-range-picker.js"></script>
}

@section BottomScript
{
    <script src="~/Areas/Invoice/Views/InvAdjust/InvAdjust.js"></script>
    <script type="text/javascript">
        //debugger;
        @{
            // 1: Chưa có tài khoản
            // 2: Tài khoản service không có hoặc không đúng

            var typeErr = (Model.HasNotSysInvAccount ?? false) ? 1 : ((Model.IsInvServiceAccountIncorrect ??false) ? 2 : 0);
        }

        $(document).ready(function(){
            var typeErr = @typeErr;
            if (typeErr > 0) {
                $('.main-content > .page-content').addClass('blur');
                var htmlButtonWarningInv = '@Html.Button(true, "WarningInv", Url.Action("WarningInv", "InvChecking", new { area = "Invoice", type = typeErr }), "", "", new { @class = "" })';
                if (htmlButtonWarningInv.length > 0) {
                    var eleButtonWarningInv = $.parseHTML(htmlButtonWarningInv);
                    document.body.appendChild(eleButtonWarningInv[0]);
                    $(eleButtonWarningInv).click().remove();
                }
            }
        });

    </script>
}