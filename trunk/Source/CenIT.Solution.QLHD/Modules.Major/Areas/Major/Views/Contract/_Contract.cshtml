@using TSFramework.App.Processors
@model Cores.Major.Models.MajorContractModel
@Html.AntiForgeryToken()

@Html.HiddenFor(model => model.ContractId)
@Html.HiddenFor(model => model.ContractTypeId)
@Html.HiddenFor(model => model.ContractTypeName)
@Html.HiddenFor(model => model.UnionId)
@Html.HiddenFor(model => model.IsNew)

<div id="ContractContents">
    <div class="card ccard">
        <ul class="nav nav-tabs nav-tabs-simple nav-tabs-scroll border-b-1 brc-dark-l3 mx-0 mx-md-0 px-3 px-md-1 pt-2px" role="tablist">
            <li class="nav-item mr-1">
                <a class="nav-link active brc-danger-m1 d-style p-3 bgc-h-danger-l4 radius-0" id="customer-tab-btn" data-toggle="tab" href="#customer" role="tab" aria-controls="customer" aria-selected="true">
                    <i class="fas fa-user-tie text-danger mr-3px"></i>Thông tin khách hàng
                </a>
            </li>

            <li class="nav-item mr-1">
                <a class="nav-link brc-success-m1 d-style p-3 bgc-h-success-l4 radius-0" id="contract-tab-btn" data-toggle="tab" href="#contract" role="tab" aria-controls="contract" aria-selected="false">
                    <i class="fas fa-file-contract text-success mr-3px"></i>
                    <span class="d-n-active">
                        Thông tin hợp đồng
                    </span>
                    <span class="d-active text-success-d1">
                        Thông tin hợp đồng
                    </span>
                </a>
            </li>

            <li class="nav-item mr-1">
                <a class="nav-link brc-info-m1 d-style p-3 bgc-h-info-l4 radius-0" id="extend-contract-tab-btn" data-toggle="tab" href="#extend-contract" role="tab" aria-controls="extend-contract" aria-selected="false">
                    <i class="fas fa-file-contract text-info mr-3px"></i>
                    <span class="d-n-active">
                        Thông tin khác
                    </span>
                    <span class="d-active text-info-d1">
                        Thông tin khác
                    </span>
                </a>
            </li>
        </ul>

        <div class="card-body px-0 py-2">
            <div class="tab-content tab-sliding border-0 px-0">
                <div class="tab-pane show active px-25" id="customer" role="tabpanel" aria-labelledby="customer-tab-btn">
                    @Html.Partial("_CusInfo", Model)
                </div>

                <div class="tab-pane px-25" id="contract" role="tabpanel" aria-labelledby="contract-tab-btn">
                    @Html.Partial("_ContractInfo", Model)
                </div>

                <div class="tab-pane px-25" id="extend-contract" role="tabpanel" aria-labelledby="extend-contract-tab-btn">
                    @Html.Partial("_ExtendContractInfo", Model)
                </div>

            </div>
        </div>
    </div><!-- /.card -->
    @{
        if (!Model.IsNew)
        {
            <hr class="border-none border-t-3 brc-grey-l2 border-double">
            <div class="form-group row">
                <div class="col-md-12">
                    @Html.TitleFor(model => model.Reason, new { @class = "col-form-label pr-0 font-bold" })
                    @Html.TextAreaFor(model => model.Reason, new { rows = 2, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Reason_Title") })
                    @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
                </div>
            </div>
        }
    }
</div>
