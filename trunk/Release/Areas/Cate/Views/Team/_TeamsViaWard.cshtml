@using TSFramework.App.Processors
@model Cores.Sys.Models.Cate.CateWardModel

@{
    ViewBag.Title = Html.Raw(string.Format(AppProcessor.Messagor.GetMessage("Teams_Belong_Ward"), $"<b>[{Model.WardName}]</b>"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    purple
}

@section FormIcon{
    <i class="fas fa-list-alt"></i>
}

@section FormBody{
    <div class="modal-body row" id="bodyForm">
        <div class="col-md-12">
            <div class="page-header pb-2" id="PageTitle">
                <h1 class="page-title text-primary-d2 text-150"></h1>
                <div class="page-tools d-inline-flex" id="PageAction">
                    @Html.Button(true, "AddTeam", Url.Action("Add", "Team", new { area = "Cate", wardId = Model.WardId }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right" })
                </div>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="mt-3">
                <div class="card dcard">
                    <div class="p-2 table-responsive-md">
                        <table id="TeamsByWard" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                            <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                            <tr>
                                <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                                <th>@AppProcessor.Messagor.GetMessage("District_Title")</th>
                                <th>@AppProcessor.Messagor.GetMessage("Ward_Title")</th>
                                <th>@AppProcessor.Messagor.GetMessage("Team_Label_Code")</th>
                                <th>@AppProcessor.Messagor.GetMessage("Team_Label_Name")</th>
                                <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                            </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        var _TeamActionURLs = {
            TeamsByWard: "/Cate/Team/GetTeamsViaWard"
        };

        var _tableTeamByWard;

        $(document).ready(function () {
            initTableWard();
        });

        function initTableWard() {
            if (window._tableTeamByWard != undefined) {
                $("#TeamsByWard").dataTable().fnDestroy();
            }
            _tableTeamByWard = $("#TeamsByWard").DataTable({
                "Responsive": true,
                "language": {
                    "processing":
                        "<div class='overlay'><i class='fas fa-cog fa-spin'></i></div>"
                },
                "lengthChange": true,
                "processing": true,
                "serverSide": true,
                "ajax":
                {
                    "url": _TeamActionURLs.TeamsByWard,
                    "type": "POST",
                    "dataType": "JSON",
                    "data": {
                        "WardIds": "@Html.Raw(Model.WardId)"
                    }
                },
                "columns": [
                    {
                        "data": "",
                        "defaultContent": "1",
                        "render": function (data, type, row, meta) {
                            return meta.settings._iDisplayStart + meta.row + 1;
                        }
                    },
                    {
                        "data": "DistrictName",
                        "defaultContent": ""
                    },
                    {
                        "data": "WardName",
                        "defaultContent": ""
                    },
                    {
                        "data": "TeamCode",
                        "visible": false,
                        "defaultContent": ""
                    },
                    {
                        "data": "TeamName",
                        "defaultContent": ""
                    },
                    {
                        "data": "TeamId",
                        "style": "width:100px;",
                        "orderable": false,
                        "render": function (data, type, row, meta) {
                            var html = '<span class="d-none d-lg-inline">';

                            if (type === "display") {
                                html += _renderButton(true,
                                    "EditTeam",
                                    "btn px-4 btn-lighter-primary mr-1 v-hover",
                                    "/Cate/Team/Edit/" + data,
                                    '<i class="far fa-edit text-primary text-120"></i>',
                                    "Cập nhật");

                                html += _renderButton(true,
                                    "DeleteTeam",
                                    "btn px-4 btn-lighter-danger mr-1 v-hover",
                                    "/Cate/Team/Delete/" + data,
                                    '<i class="far fa-trash-alt text-danger text-120"></i>',
                                    "Xoá");
                            }
                            html += '</span>';

                            return html;
                        }
                    }
                ]
            });
        }

        function Team_OnProcessSuccess(response, formId) {
            if (response.status != undefined) {
                if ($("#ModalContent #modal_" + formId + " #chkNotDismissModal").is(":checked")) {
                    if (response.status != undefined) {
                        eval(response.message);
                        _tableTeamByWard.ajax.reload(null, false);
                        response.status = undefined;
                        //$("#ModalContent #modal_" + formId + " form")[0].reset();
                        var urlAction = $("#ModalContent #modal_" + formId + " form").attr("action");
                        $("#ModalContent #modal_" + formId + " #modal-content").load(urlAction, function (data, textStatus, xhr) {
                            _initElement();
                        });
                    }
                } else {
                    $("#ModalContent #modal_" + formId).modal("hide");
                    $("#ModalContent #modal_" + formId).on("hidden.bs.modal",
                        function () {
                            if (response.status != undefined) {
                                eval(response.message);
                                _tableTeamByWard.ajax.reload(null, false);
                                response.status = undefined;
                            }
                        });
                }
            } else {
                $("#ModalContent #modal_" + formId + " #bodyForm").html(response);
            }
        }

    </script>
}

@section SubmitControl{

}