            @Html.Button(true, "FindCustomer", Url.Action("FindCustomer", new { area = "Major", typeCus = ConstsCusType.CONSUMER }), "<i class='fas fa-search'></i>", AppProcessor.Messagor.GetMessage("Button_FindConsumer"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right", data_width = "1024px" })

