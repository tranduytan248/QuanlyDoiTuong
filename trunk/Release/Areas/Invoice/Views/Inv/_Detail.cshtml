@using TSFramework.App.Processors
@model Modules.Major.Areas.Major.Models.ViewInvModel
@{
    ViewBag.Title = $"{AppProcessor.Messagor.GetMessage("Inv_Title")} - {AppProcessor.Messagor.GetMessage("Contract_Title")} [{Model.InvNo}-{Model.Pattern}-{Model.Serial}]";
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    success
}

@section FormIcon{
    <i class="fas fa-file-invoice-dollar"></i>
}

@section FormBody{

    @using (Html.BeginForm("PublishInv", "Contract", new { area = "Major" }, FormMethod.Post, new { encType = "multipart/form-data", id = "ViewInv", @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            <div class="col-12">
                <div class="acard card h-100">
                <div>
                   <button class="btn btn-primary"> <i class="fa fa-download"></i> <a style="text-decoration: none; color:white" href="~/Invoice/Inv/DownloadInv?InvKey=@Model.InvKey&InvNo=@Model.InvNo-@Model.Pattern/@Model.Serial">Tải xuống</a></button>
                </div>
                    <div class="card-body">
                        <div class="row col-12">
                            @Html.Raw(Model.HtmlInv)
                        </div>
                    </div><!-- /.card-body -->
                </div><!-- /.card -->
            </div><!-- /.col -->
        </div>
    }

}

@section SubmitControl{
   
}