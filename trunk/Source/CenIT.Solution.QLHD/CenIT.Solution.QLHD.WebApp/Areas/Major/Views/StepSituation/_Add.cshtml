@using TSFramework.App.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("Situation_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("Add", "StepSituation", new { area = "Major", stepId = Model.StepId }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "StepSituation_OnProcessSuccess(data, 'AddStepSituation')"
    }, new { @class = "form-horizontal", id = "AddStepSituation" }))
    {
        <div id="bodyForm">
            @Html.Partial("_StepSituation")
        </div>
    }
}
@section ContinueForm{

}