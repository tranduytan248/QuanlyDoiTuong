<script type="text/javascript">

    function Doc_OnProcessSuccess(response, formId) {
        $("#ModalContent #modal_" + formId).modal("hide");
        $("#ModalContent #modal_" + formId).on("hidden.bs.modal", function () {
            if (response.status != undefined) {
                eval(response.message);
                $("#" + response.fileId).remove();
                response.status = undefined;
            }
        });
    }
</script>

<script type="text/javascript">
    //debugger;
    var districtId = @Model.DistrictId;
    var wardId = @Model.WardId;

    function _onChangeProvince(cbbProvince, cbbDistrict) {
        if ($("#Complain #ProvinceName").length > 0) {
            $("#Complain #ProvinceName").val($(cbbProvince).children("option:selected").text());
        }

        var selectedProvince = $(cbbProvince).val();
        var urlDistrictsViaProvince =
            "@Url.Action("GetDistrictsBelongProvince", "Ajax", new { area = "Cate" })?provinceIds=" + selectedProvince;
        $.ajax({
            type: "GET",
            url: urlDistrictsViaProvince,
            dataType: "JSON",
            success: function (response) {
                $(cbbDistrict).empty();
                $(cbbDistrict).append('<option value=""></option>');

                $.each(response.Districts,
                    function (index, item) {
                        $.each(item, function (idx, district) {
                            $(cbbDistrict).append('<option value="' + district.DistrictId + '">' + district.DistrictName + "</option>");
                        });
                    });
                if(districtId > 0){
                    $(cbbDistrict).val(districtId);
                    $(cbbDistrict).trigger("change");
                }
            }
        });
    }

    function _onChangeDistrict(cbbDistrict, cbbWard) {
        if ($("#Complain #DistrictName").length > 0) {
            $("#Complain #DistrictName").val($(cbbDistrict).children("option:selected").text());
        }

        var selectedDistrict = districtId > 0 ? districtId : $(cbbDistrict).val();
        var urlWardsViaDistrict =
            "@Url.Action("GetWardsBelongDistrict", "Ajax", new { area = "Cate" })?districtIds=" + selectedDistrict;
        $.ajax({
            type: "GET",
            url: urlWardsViaDistrict,
            dataType: "JSON",
            success: function (response) {
                $(cbbWard).empty();
                $(cbbWard).append('<option value=""></option>');

                $.each(response.Wards, function (index, item) {
                    $.each(item, function (idx, ward) {
                        $(cbbWard).append('<option value="' + ward.WardId + '">' + ward.WardName + "</option>");
                    });
                });
                if(wardId > 0){
                    $(cbbWard).val(wardId);
                    $(cbbWard).trigger("change");
                }
            }
        });
    }

    @*</script>

<script type="text/javascript">*@
    jQuery(function ($) {
        _initGalary("#Complain");
        _onChangeProvince($('#Complain select#ProvinceId'), $('#Complain select#DistrictId'))
        if(districtId > 0){
            _onChangeDistrict($('#Complain select#DistrictId'), $('#Complain select#WardId'))
        }
    });

</script>

