@using TSFramework.App.Processors
@model CenIT.Solution.QLHD.WebApp.Models.SearchFEContractModel

<div class="card dcard overflow-hidden" data-aos="fade-right" data-aos-delay="200">
    <div class="card-header p-2 text-center">
        <h5 class="card-title text-primary-d2 pt-1 text-uppercase text-500">
            <i class="fa fa-search"></i>&nbsp;@AppProcessor.Messagor.GetMessage("SearchContract")
        </h5>
    </div>
    <div class="card-body bg-white p-2 collapse show">
        <div class="form-group pb-2">
            <label class="text-500 text-danger-d2"><i class="fas fa-file-contract"></i>&nbsp;@AppProcessor.Messagor.GetMessage("ContractNumber")<span class="text-danger-d1">&nbsp;(*)</span></label>
            @Html.TextBoxFor(model => model.ContractNo, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("ContractNumber"), data_info = "popover", data_content = AppProcessor.Messagor.GetMessage("Guid_Search_ContractNo") })
            @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger", title = AppProcessor.Messagor.GetMessage("ContractNumber") })
        </div>

        <div class="form-group pb-2">
            <label class="text-500 text-danger-d2"><i class="fas fa-phone-alt"></i>&nbsp;@AppProcessor.Messagor.GetMessage("CustommerPhone_Search")<span class="text-danger-d1">&nbsp;(*)</span></label>
            @Html.TextBoxFor(model => model.Phone, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("CustommerPhone_Search"), data_info = "popover", data_content = AppProcessor.Messagor.GetMessage("Guid_Search_Phone") })
            @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger", title = AppProcessor.Messagor.GetMessage("CustommerPhone_Search") })
        </div>

        <div class="form-group pb-2">
            <label class="text-500 text-danger-d2"><i class="fas fa-qrcode"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Search_Captcha_Title")<span class="text-danger-d1">&nbsp;(*)</span></label>
            <input type="text" id="captchaInput" class="form-control" placeholder="@AppProcessor.Messagor.GetMessage("Search_Captcha_Title")" data-info="popover" data-content="@AppProcessor.Messagor.GetMessage("Guid_Search_Captcha")" />
            <span class="field-validation-valid text-danger" data-valmsg-for="captchaInput" data-valmsg-replace="true" title="@AppProcessor.Messagor.GetMessage("Search_Captcha_Title")"></span>
        </div>

        <div class="input-group">
            <span id="captchaCode" readonly class="form-control text-center border-0 text-500"></span>
            <div class="input-group-append">
                <button class="btn btn-outline-secondary" type="button" onclick="generateCaptcha()">
                    <i class="fas fa-sync-alt"></i>
                </button>
            </div>
        </div>

        <div class="mt-1 text-danger-d1">
            <span class="error text-90" id="error"></span>
        </div>

        <hr />
        <div class="footer-search pb-3 mt-3">
            <div class="col-md-12 text-center">
                <button type="button" class="btn btn-outline-primary" onclick="searchContract();"><i class="fa fa-search"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_SearchFronEnd")</button>
                <button type="button" class="btn btn-outline-secondary" onclick="clean();"><i class="fa fa-undo-alt"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Clean")</button>
            </div>
        </div>

        <div class="my-2 text-center">
            <span class="text-danger-d1 text-80"><i class="fas fa-exclamation-triangle mr-1 mb-1"></i> @AppProcessor.Messagor.GetMessage("Warning-Search")</span>
        </div>
    </div>
</div>

<script type="text/javascript">
    $('input[type="text"][data-info= "popover"]').popover({
        container: 'body',
        trigger: 'focus',
        placement: "auto",
        html: true,
        template: '<div class="popover brc-primary-m2 border-b-2" role="tooltip"><div class="arrow arrow2 brc-primary-l2"></div><div class="arrow brc-primary-m1"></div><h3 class="popover-header bgc-primary-l2 border-0 text-110 text-dark-tp3 text-600"></h3><div class="popover-body text-grey-d3 text-105"></div></div>'
    });
</script>