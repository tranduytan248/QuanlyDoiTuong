@using TSFramework.App.Processors

@{
    ViewBag.Title = Html.Raw($"<b>{AppProcessor.Messagor.GetMessage("Major_Message_Title")}</b>");
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    info
}

@section FormIcon{
    <i class="fas fa-eye"></i>
}

@section FormBody{

    <div class="col-md-12">
        <div class="page-header pb-2" id="PageTitle">
            <h1 class="page-title text-primary-d2 text-150"></h1>
            <div class="page-tools d-inline-flex" id="PageAction">
                <a class="btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right mr-2" href="javascript:void(0);" onclick="_onMessageAction('@(Url.Action("MaskAllAsRead", "Notification", new { area = "" }))','GET');"><i class="fas fa-check-double"></i>&nbsp;Đánh dấu tất cả đã đọc</a>
                <a class="btn btn-light-danger btn-h-danger btn-a-danger border-0 radius-3 py-2 text-600 text-90 pull-right" href="javascript:void(0);" onclick="_onMessageAction('@(Url.Action("DeleteAll", "Notification", new { area = "" }))','GET');"><i class="far fa-trash-alt"></i>&nbsp;Xoá tất cả</a>
            </div>
        </div>
    </div>

    <div class="col-md-12">
        <div class="mt-3">
            <div class="card dcard">
                <div class="table-responsive-md">
                    <table id="Messages" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                        <thead class="sticky-nav text-secondary-m1 text-uppercase text-85">
                            <tr>
                                <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                                <th>@AppProcessor.Messagor.GetMessage("Major_Message_Contents")</th>
                                <th>@AppProcessor.Messagor.GetMessage("Major_Message_CreatedOn")</th>
                                <th>@AppProcessor.Messagor.GetMessage("Major_Message_IsReaded")</th>
                                <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        //debugger;
        var _MessageActionURLs = {
            Message_GetData: "@Url.Action("Get", "Notification", new { area = "" })"
        };
        var _tableMessage;
        $(document).ready(function () {
            initTableMessage();
        });

        function initTableMessage() {
            _tableMessage = $("#Messages").DataTable({
                "Responsive": true,
                "language": {
                    "processing": '<div id="tableLoading" class="pageload-overlay show pageload-loading" data-opening="M 0,0 80,-10 80,60 0,70 0,0" data-closing="M 0,-10 80,-20 80,-10 0,0 0,-10" style=""><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 80 60" preserveAspectRatio="none"><path d="M 0,70 80,60 80,80 0,80 0,70"></path></svg></div>'
                        //"<div class='overlay'><i class='fas fa-cog fa-spin'></i></div>"
                },
                "lengthChange": true,
                "processing": true,
                "serverSide": true,
                "autoWidth": false,
                "ajax":
                {
                    "url": _MessageActionURLs.Message_GetData,
                    "type": "POST",
                    "dataType": "JSON",
                    "data": {}
                },
                "columns": [
                    {
                        "data": "",
                        "defaultContent": "1",
                        "render": function (data, type, row, meta) {
                            return meta.settings._iDisplayStart + meta.row + 1;
                        },
                        "createdCell": function (td, cellData, rowData, row, col) {
                            //if (!rowData["IsReaded"]) {
                            //    $(td).addClass("font-bold");
                            //}
                            if (rowData["IsReaded"]) {
                                $(td).parent('tr').addClass("text-secondary");
                            } else {
                                $(td).parent('tr').addClass("text-primary");
                            }
                        }
                    },
                    {
                        "data": "Contents",
                        "defaultContent": "",
                        "width": "55%",
                        //"createdCell": function (td, cellData, rowData, row, col) {
                        //    if (!rowData["IsReaded"]) {
                        //        $(td).addClass("font-bold");
                        //    }
                        //}
                    },
                    {
                        "data": "CreatedOn",
                        "width": "15%",
                        "defaultContent": "",
                        "render": function (data, type, row, meta) {
                            if (type === "display") {
                                return moment(data).format("HH:mm:ss DD/MM/YYYY");
                            }
                            return data;
                        },
                        //"createdCell": function (td, cellData, rowData, row, col) {
                        //    if (!rowData["IsReaded"]) {
                        //        $(td).addClass("font-bold");
                        //    }
                        //}
                    },
                    {
                        "data": "ReadedOn",
                        "width": "15%",
                        "defaultContent": "",
                        "render": function (data, type, row, meta) {
                            if (type === "display") {
                                if (data != null) {
                                    var html = '<span class="text-danger-d1 text-md">&nbsp;{0}</span>'.format(moment(data).format("HH:mm:ss DD/MM/YYYY"));
                                    return html;
                                }
                                return "";
                            }
                            return data;
                        }
                    },
                    {
                        "data": "MessageId",
                        "width": "15%",
                        "orderable": false,
                        "render": function (data, type, row, meta) {
                            var html = '<span class="d-none d-lg-inline">';

                            if (type === "display") {

                                if (!row["IsReaded"]) {
                                    html += '<a class="btn px-4 btn-lighter-success mr-1 v-hover" data-rel="tooltip" title="Đánh dấu đã đọc" href="javascript:void(0);" data-original-title="Đánh dấu đã đọc" onclick="_onMessageAction(\'/Notification/MaskAsRead/' + data + '\');"><i class="fas fa-check-double text-success text-120"></i></a>';
                                }
                                html += '<a class="btn px-4 btn-lighter-danger mr-1 v-hover" data-rel="tooltip" title="Xoá" href="javascript:void(0);" data-original-title="Xoá" onclick="_onMessageAction(\'/Notification/Delete/' + data + '\');"><i class="far fa-trash-alt text-danger text-120"></i></a>';
                            }
                            html += "</span>";

                            return html;
                        }
                    }
                ],
                //"createdRow": function (row, data, dataIndex) {
                //    if (data["IsReaded"]) {
                //        $(row).addClass("text-secondary");
                //    } else {
                //        $(row).addClass("text-primary");
                //    }
                //}
            });

            //_tableMessage.on('draw.dt', function () {
            //    alert( 'Table redrawn' );
            //} );
        }

        function Message_OnProcessSuccess(response, formId) {
            if (response.status != undefined) {
                $("#ModalContent #modal_" + formId).modal("hide");
                $("#ModalContent #modal_" + formId).on("hidden.bs.modal",
                    function () {
                        if (response.status != undefined) {
                            eval(response.message);
                            _tableMessage.ajax.reload(null, false);
                            response.status = undefined;
                        }
                    });
            } else {
                $("#ModalContent #modal_" + formId + " #bodyForm").html(response).promise().done(function () {_initElements(this);});
            }
        }

    </script>

    <script type="text/javascript">
        function _onMessageAction(url, method) {
            $.ajax({
                type: method,
                url: url,
                dataType: "JSON",
                success: function (response) {
                    if (response.status != undefined) {
                        eval(response.message);
                        _tableMessage.ajax.reload(null, false);
                        response.status = undefined;
                        $("#lstMessages").load("@Url.Action("Messages", "Notification", new { area = "" })", function (data, textStatus, xhr) {
                            _initElements(this);
                        });
                    }
                }
            });
        }
    </script>
}

@section SubmitControl{

}
