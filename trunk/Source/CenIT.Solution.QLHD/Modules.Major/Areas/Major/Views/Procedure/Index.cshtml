@using TSFramework.App.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Procedure_Title");
}

@section PluginCss
{
    <link rel="stylesheet" type="text/css" href="~/Contents/Base/plugins/ace_v4/node_modules/jqtree/jqtree.css">
    <link rel="stylesheet" type="text/css" href="~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-select/dist/css/bootstrap-select.css">

    <style type="text/css">
        .ace-switch-status {
            width: 9.25rem !important;
        }

            .ace-switch-status:checked::before {
                content: "ĐANG SỬ DỤNG";
            }

            .ace-switch-status:checked::after {
                left: 6.5rem !important;
            }

            .ace-switch-status::before {
                content: "NGƯNG SỬ DỤNG";
            }
            
    </style>
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
    @Html.Button(true, "AddProcedure", Url.Action("Add", new { area = "Major" }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right", data_width = "860px" })
}

@Html.Partial("_Search")

<div class="mt-3">
    <div class="card dcard">
        <div class="p-2 table-responsive-md">
            <table id="DSProcedure" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="w-5">@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th class="">@AppProcessor.Messagor.GetMessage("Procedure_Name")</th>
                        <th class="">@AppProcessor.Messagor.GetMessage("Procedure_Status")</th>
                        @*<th>@AppProcessor.Messagor.GetMessage("Procedure_ApplyFrom")</th>*@
                        @*<th>@AppProcessor.Messagor.GetMessage("Procedure_ExpiredOn")</th>*@
                        <th class="w-25">@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section PluginJs
{
    <script src="@Url.Content("~/Contents/Base/plugins/ace_v4/node_modules/jqtree/tree.jquery.js")"></script>
    <script src="@Url.Content("~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-select/dist/js/bootstrap-select.js")"></script>
    <script src="@Url.Content("~/Contents/Base/plugins/ace_v4/node_modules/bootstrap-select/dist/js/defaults-vi_VN.min.js")"></script>
}

@section BottomScript
{
    <script src="@Url.Content("~/Contents/Base/plugins/ace_v4/node_modules/bootbox/bootbox.all.js")"></script>
    <script src="@Url.Content("~/Areas/Major/Views/Procedure/Procedure.js")"></script>

    <script type="text/javascript">
        function _toggleUsingStatus(eleCheckbox, procedureId, procedureName) {
            if ($(eleCheckbox).is(':checked')) {
                $(eleCheckbox).prop('checked', false);
            } else {
                $(eleCheckbox).prop('checked', true);
            }
            var msgConfirmChangeStatus = '@AppProcessor.Messagor.GetMessage("Common_MessageConfirm_ChangeStatus")'.format('<span class="text-danger-d1 text-500">[{0}]</span>'.format(procedureName));

            bootbox.prompt({
                title: '<span class="text-danger text-500 text-110"><i class="far fa-question-circle"></i>&nbsp;Xác nhận</span>',
                message: '<div class="alert bgc-warning-l4 brc-warning-m4 d-flex align-items-center text-dark-tp2" role="alert"><i class="fas fa-info-circle mr-3 fa-2x text-danger"></i><span class="text-500">{0}</span></div>'.format(msgConfirmChangeStatus),
                onEscape: true,
                closeButton: false,
                placeholder:"@AppProcessor.Messagor.GetMessage("Reason_Title")",
                buttons: {
                    confirm: {
                        label: '<i class="fas fa-check text-geen"></i> Có',
                        className: 'btn-outline-success'
                    },
                    cancel: {
                        label: '<i class="fas fa-ban text-danger"></i>  Không',
                        className: 'btn-outline-danger'
                    }
                },
                callback: function (result) {
                    if (result != null) {
                        var urlToggleStatus =
                            "@Url.Action("ToggleStatus", "Procedure", new { area = "Major" })";
                        $.ajax({
                            type: "POST",
                            url: urlToggleStatus,
                            dataType: "JSON",
                            data: {
                                ProcedureId: procedureId,
                                ProcedureName: procedureName,
                                Reason: result
                            },
                            success: function (response) {
                                if (response.status) {
                                    eval(response.message)
                                }
                                //else {
                                //}
                                //$(eleCheckbox).toggle("checked");

                                var $checkbox = $(eleCheckbox);
                                $checkbox.prop("checked", !$checkbox.prop("checked"));

                                if ($(eleCheckbox).is(":checked")) {
                                    $(eleCheckbox).attr('title', "Đang sử dụng");
                                } else {
                                    $(eleCheckbox).attr('title', "Ngưng sử dụng");
                                }
                                $(eleCheckbox).tooltip('dispose').tooltip();;
                            }
                        });
                    }
                }
            });
        }
    </script>
}