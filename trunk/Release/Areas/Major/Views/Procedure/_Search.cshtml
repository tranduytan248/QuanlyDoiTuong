@using TSFramework.App.Processors
@model Modules.Major.Areas.Major.Models.SearchProcedureModel
<div class="card dcard">
    <div class="card-header">
        <h5 class="card-title text-120 text-primary-d2">@AppProcessor.Messagor.GetMessage("Condition_Title")</h5>
        <div class="card-toolbar no-border">
            <a href="#" data-action="toggle" class="card-toolbar-btn btn btn-sm radius-1 btn-outline-default mx-2px">
                <i class="fa fa-angle-double-up w-2 mx-1px"></i>
            </a>
        </div>
    </div>
    <div class="card-body p-0 collapse show">
        <div class="col-md-12 form-horizontal mt-3" id="Search">
            <div class="form-group row">
                <div class="col-md-8">
                    @Html.TitleFor(model => model.ListUnionIds, new { @class = "col-12 col-form-label pr-0 font-bold" })
                    @Html.SelectFor(model => model.ListUnionIds, Model.ListUnions, null, new { multiple = true, @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Combobox_Select") })
                </div>
                <div class="col-md-4">
                    @Html.TitleFor(model => model.ListTypeContractIds, new { @class = "col-12 col-form-label pr-0 font-bold" })
                    @Html.DropDownListFor(model => model.ListTypeContractIds, new SelectList(Model.ListTypeContracts, "Value", "Text"), "", new { multiple = true, @class = "form-control col-11", placeholder = AppProcessor.Messagor.GetMessage("Combobox_Select") })
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="col-md-12 text-center">
                <button type="button" class="btn btn-primary" onclick="_tableProcedure.ajax.reload(null, false);"><i class="fa fa-search-plus"></i>&nbsp;Tìm kiếm</button>
            </div>
        </div>
    </div>
</div>
