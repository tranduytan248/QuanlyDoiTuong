@using Cores.Major.Enums
@using TSFramework.App.Processors
@using EnumHelper = TSFramework.Core.Helpers.EnumHelper
@model Cores.Major.Models.MajorDossierModel
@{
    ViewBag.Title = Html.Raw($"{AppProcessor.Messagor.GetMessage("Dossier_Log_Activity")} {AppProcessor.Messagor.GetMessage("Dossier_Title")} <b>[{Model.DossierCode}-{Model.DossierName}]</b>");

    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    info
}

@section FormIcon{
    <i class="fas fa-clipboard-list"></i>
}

@section FormBody{

    <div id="bodyForm" class="form-horizontal">
        <div class="col-12 mt-lg-0 pr-lg-2">
            <div class="bcard card h-100">
                <div class="card-header bg-transparent brc-default-l3 pt-0">
                    <h5 class="card-title text-dark-m2 pl-1 text-110 text-primary-d3 font-bold">
                        @AppProcessor.Messagor.GetMessage("Dossier_Log_Activity")
                    </h5>
                </div>

                <div class="card-body p-3 border-0 overflow-auto ace-scrollbar" id="lstTasks" style="max-height: calc(100vh - 300px);">
                    @{
                        foreach (var task in Model.ListTasks)
                        {
                            var dictStatus = new Dictionary<int, string>
                                                    {
                                {-1, "secondary"},
                                {1, "primary"},
                                {2, "warning"},
                                {3, "success"},
                            };

                            var dictIcons = new Dictionary<int, string>
                                            {
                                {-1, "<i class='fas fa-pause'></i>"},
                                {1, "<i class='fas fa-user-clock'></i>"},
                                {2, "<i class='fas fa-user-edit'></i>"},
                                {3, "<i class='fas fa-user-check'></i>"},
                            };

                            var status = dictStatus[task.Status]; //task.Status == 2 ? "warning" : task.Status == 3 ? "success" : "info";
                            var icon = dictIcons[task.Status];//task.Status == 2 ? "<i class='fas fa-user-edit'></i>" : task.Status == 3 ? "<i class='fas fa-user-check'></i>" : "<i class='fas fa-user-clock'></i>";

                            <div class="text-grey-m1 text-95">
                                <div class="d-flex">
                                    <div class="minh-100 pos-rel" id="taskIcon">
                                        <div class="pos-rel text-center pt-2 mx-2px w-6 h-6 border-4 brc-white radius-round bgc-@status text-white">
                                            @Html.Raw(icon)
                                        </div>
                                    </div>
                                    <div class="mx-2 flex-grow-1">
                                        <div>
                                            <a href="javascript:void(0);" class="font-bolder btn-text-primary btn-h-text-danger d-flex">
                                                @task.InStepName
                                            </a>
                                            <a href="javascript:void(0);" class="text-95 font-bolder btn-text-dark btn-h-text-danger">
                                                @task.UnionHandleName
                                            </a>
                                            @if (task.Status == 1)
                                            {
                                                <div class="ml-auto">
                                                    <span class="badge bgc-info-l3 text-info-d1 border-l-2 brc-info-m3">@AppProcessor.Messagor.GetMessage(EnumHelper.GetDescription(EnumDossierTaskStatus.WaitingForHandle))</span>
                                                </div>
                                            }
                                            else if (task.Status == 2)
                                            {
                                                <div class="ml-auto">
                                                    <span class="badge bgc-primary-l3 text-primary-d1 border-l-2 brc-primary-m3 font-bold text-80"><i class="far fa-clock"></i>&nbsp;Ngày tiếp nhận: @(task.StartHandleOn?.ToString("HH:mm:ss dd/MM/yyyy"))</span>
                                                </div>
                                                if (!string.IsNullOrEmpty(task.SelectedSituationName))
                                                {
                                                    <div class="ml-auto">
                                                        <span class="badge bgc-green-l3 text-green-d1 border-l-2 brc-green-m3 font-bold"><i class="fas fa-check-double"></i>&nbsp;@task.SelectedSituationName</span>
                                                    </div>
                                                }
                                                <div class="ml-auto">
                                                    <span class="badge bgc-@status-l3 text-@status-d1 border-l-2 brc-@status-m3 font-bold text-80">@AppProcessor.Messagor.GetMessage(EnumHelper.GetDescription(EnumDossierTaskStatus.Handling))</span> bởi <span class="text-danger text-500">@task.HandledBy</span>
                                                </div>
                                                if (!string.IsNullOrEmpty(task.Supporters))
                                                {
                                                    <div class="ml-auto">
                                                        @if (!string.IsNullOrEmpty(task.Note))
                                                        {
                                                            @Html.Raw($"<div class=\"text-grey-d3 mt-15 pos-rel\"><i class='fas fa-user-edit mr-2 mb-1 text-blue-d1 align-middle'></i>&nbsp;{task.Note}</div>")
                                                        }
                                                        <span class="badge bgc-info-l3 text-info-d1 border-l-2 brc-info-m3 font-bold text-80">@AppProcessor.Messagor.GetMessage("Supporters_Title")</span> bởi @Html.Raw(task.Supporters)
                                                    </div>
                                                }
                                                if (!string.IsNullOrEmpty(task.PausedLogs))
                                                {
                                                    <hr />
                                                    @Html.Raw(task.PausedLogs)
                                                }
                                            }
                                            else if (task.Status == -1)
                                            {
                                                <div class="ml-auto">
                                                    <span class="badge bgc-primary-l3 text-primary-d1 border-l-2 brc-primary-m3 font-bold text-80"><i class="far fa-clock"></i>&nbsp;Ngày tiếp nhận: @(task.StartHandleOn?.ToString("HH:mm:ss dd/MM/yyyy"))</span>
                                                </div>
                                                if (!string.IsNullOrEmpty(task.SelectedSituationName))
                                                {
                                                    <div class="ml-auto">
                                                        <span class="badge bgc-green-l3 text-green-d1 border-l-2 brc-green-m3 font-bold"><i class="fas fa-check-double"></i>&nbsp;@task.SelectedSituationName</span>
                                                    </div>
                                                }
                                                <div class="ml-auto">
                                                    <span class="badge bgc-@status-l3 text-@status-d1 border-l-2 brc-@status-m3 font-bold text-80">@AppProcessor.Messagor.GetMessage(EnumHelper.GetDescription(EnumDossierTaskStatus.Paused))</span> bởi <span class="text-danger text-500">@task.HandledBy</span> <span class="d-inline-block radius-round bgc-default-l2 text-dark-tp3 text-95 px-25 py-3px mx-2px my-2px">@task.ReasonPaused</span>
                                                </div>
                                                if (!string.IsNullOrEmpty(task.Supporters))
                                                {
                                                    <div class="ml-auto">
                                                        @if (!string.IsNullOrEmpty(task.Note))
                                                        {
                                                            @Html.Raw($"<div class=\"text-grey-d3 mt-15 pos-rel\"><i class='fas fa-user-edit mr-2 mb-1 text-blue-d1 align-middle'></i>&nbsp;{task.Note}</div>")
                                                        }
                                                        <span class="badge bgc-info-l3 text-info-d1 border-l-2 brc-info-m3 font-bold text-80">@AppProcessor.Messagor.GetMessage("Supporters_Title")</span> bởi @Html.Raw(task.Supporters)
                                                                                                                                                                                                                         </div>
                                                }
                                            }
                                            else if (task.Status == 3)
                                            {
                                                <div class="ml-auto">
                                                    <span class="badge bgc-primary-l3 text-primary-d1 border-l-2 brc-primary-m3 font-bold text-80"><i class="far fa-clock"></i>&nbsp;Ngày tiếp nhận: @(task.StartHandleOn?.ToString("HH:mm:ss dd/MM/yyyy"))</span>
                                                </div>
                                                <div class="ml-auto">
                                                    <span class="badge bgc-@status-l3 text-@status-d1 border-l-2 brc-@status-m3 font-bold"><i class="fas fa-check-double"></i>&nbsp;@AppProcessor.Messagor.GetMessage(EnumHelper.GetDescription(EnumDossierTaskStatus.Completed))</span> bởi <span class="text-danger text-500">@task.HandledBy</span> lúc
                                                    <span class="text-95 text-secondary ml-auto text-nowrap text-500">
                                                        @(task.CompletedOn?.ToString("HH:mm:ss dd/MM/yyyy"))
                                                    </span>
                                                </div>
                                                if (!string.IsNullOrEmpty(task.Supporters))
                                                {
                                        <div class="ml-auto">
                                            @if (!string.IsNullOrEmpty(task.Note))
                                            {
                                                @Html.Raw($"<div class=\"text-grey-d3 mt-15 pos-rel\"><i class='fas fa-user-edit mr-2 mb-1 text-blue-d1 align-middle'></i>&nbsp;{task.Note}</div>")
                                            }
                                            <span class="badge bgc-info-l3 text-info-d1 border-l-2 brc-info-m3 font-bold text-80">@AppProcessor.Messagor.GetMessage("Supporters_Title")</span> bởi @Html.Raw(task.Supporters)
                                        </div>
                                                }
                                                if (!string.IsNullOrEmpty(task.PausedLogs))
                                                {
                                                    <hr />
                                                    @Html.Raw(task.PausedLogs)
                                                }
                                            }
                                        </div>
                                        @if (task.Status == 3)
                                        {
                                            <div class="text-grey-d3 text-95 mt-15 pos-rel">
                                                @{
                                                    if (task.SelectedSituation != null)
                                                    {
                                                        <span class="text-success-d2"><i class="far fa-check-circle"></i>&nbsp;@task.SelectedSituationName</span><br />
                                                    }
                                                }

                                                @if (!string.IsNullOrEmpty(task.HandlingResult))
                                                {
                                                    @Html.Raw($"<div class=\"alert bgc-secondary-l3 text-danger-m1 border-none border-l-4 brc-blue radius-0 py-2 mb-0 text-500\"> <i class='fas fa-user-edit mr-2 mb-1 text-blue-d1 align-middle'></i>&nbsp;{task.HandlingResult}</div>")
                                                }
                                            </div>
                                        }
                                        @Html.Raw(task.RefDocs)
                                        @{
                                            if (task.ListRefImgs.Count > 0)
                                            {
                                                <div class="row col-12 mx-0 p-0">
                                                    @{
                                                        foreach (var k in task.ListRefImgs.Keys)
                                                        {
                                                            int idx;
                                                            if (k == 0)
                                                            {
                                                                idx = 0;
                                                                <!-- column 1 -->
                                                                <div class="col-4 col-sm-2 col-md-2 text-center p-0 mr-2">
                                                                    @foreach (var img in task.ListRefImgs[k])
                                                                    {
                                                                        <div class="pos-rel d-style radius-1 shadow-sm overflow-hidden bgc-brown-m3" id="@img.FileId">
                                                                            <a href="#" class="show-lightbox">
                                                                                <img alt="Hình ảnh @($"{k}{idx}")" src="@img.FilePath" class="w-100 d-zoom-2 " data-size="@img.Dimensions" />
                                                                            </a>
                                                                        </div>
                                                                        idx += 1;
                                                                    }
                                                                </div>
                                                            }
                                                            else if (k == 1)
                                                            {
                                                                idx = 0;
                                                                <!-- column 2 -->
                                                                <div class="col-4 col-sm-2 col-md-2 text-center p-0 mr-2">
                                                                    @foreach (var img in task.ListRefImgs[k])
                                                                    {
                                                                        <div class="pos-rel d-style radius-1 shadow-sm overflow-hidden bgc-brown-m3" id="@img.FileId">
                                                                            <a href="#" class="show-lightbox">
                                                                                <img alt="Hình ảnh @($"{k}{idx}")" src="@img.FilePath" class="w-100 d-zoom-2 " data-size="@img.Dimensions" />
                                                                            </a>
                                                                        </div>
                                                                        idx += 1;
                                                                    }
                                                                </div>
                                                            }
                                                            else if (k == 2)
                                                            {
                                                                idx = 0;
                                                                <!-- column 3 -->
                                                                <div class="col-4 col-sm-2 col-md-2 text-center p-0 mr-2">
                                                                    @foreach (var img in task.ListRefImgs[k])
                                                                    {
                                                                        <div class="pos-rel d-style radius-1 shadow-sm overflow-hidden bgc-brown-m3" id="@img.FileId">
                                                                            <a href="#" class="show-lightbox">
                                                                                <img alt="Hình ảnh @($"{k}{idx}")" src="@img.FilePath" class="w-100 d-zoom-2 " data-size="@img.Dimensions" />
                                                                            </a>
                                                                        </div>
                                                                        idx += 1;
                                                                    }
                                                                </div>
                                                            }

                                                        }
                                                    }

                                                </div>
                                            }
                                        }
                                        <hr class="brc-secondary-l3" />
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">

        $(document).ready(function () {
            var tasks = $("#lstTasks");
            tasks.children("div").each(function (i, task) {
                tasks.prepend(task);
                if (i > 0) {
                    $(task).find('#taskIcon').prepend('<div class="position-tl ml-4 h-100 border-l-3 brc-secondary-l1"></div>');
                }
            });

            _initGalary("#lstTasks");

            //$("#modal_Activity .modal-dialog").addClass("modal-dialog-scrollable");
            //$("#modal_Activity .modal-body").addClass("ace-scrollbar");
        });

    </script>
}

@section SubmitControl{

}
