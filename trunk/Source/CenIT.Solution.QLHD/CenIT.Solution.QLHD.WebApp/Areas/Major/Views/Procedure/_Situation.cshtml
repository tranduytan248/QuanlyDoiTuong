@using TSFramework.App.Processors
@model Cores.Major.Models.MajorProcedureStepSituationModel

<div id="Situation">
    @Html.HiddenFor(model => model.SituationId)
    @Html.HiddenFor(model => model.StepId)
    @Html.HiddenFor(model => model.StepName)
    @Html.HiddenFor(model => model.ProcedureId)
    @Html.HiddenFor(model => model.IsEdit)

    <div class="form-group row">
        <div class="col-md-12">
            @Html.TitleFor(model => model.SituationName, new { @class = "col-form-label pr-0 font-bold" })
            @Html.TextBoxFor(model => model.SituationName, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Situation_Title") })
            @Html.ValidationMessageFor(model => model.SituationName, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-12">
            @Html.TitleFor(model => model.NextStep, new { @class = "col-form-label pr-0 font-bold" })
            @Html.SelectFor(model => model.NextStep, Model.ListNextSteps, "", new { @class = "form-control col-md-12", onchange = "_onChangeCombo(this, '#Situation #NextStepName', true)" })
            @Html.ValidationMessageFor(model => model.NextStep, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.NextStepName)
        </div>
    </div>

</div>
