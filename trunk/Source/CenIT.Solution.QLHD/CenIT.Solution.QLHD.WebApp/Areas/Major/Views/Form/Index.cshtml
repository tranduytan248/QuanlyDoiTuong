@using TSFramework.App.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Form_Title");
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
    @Html.Button(false, "DesignForm", "/Major/Design/Index", "<i class='fas fa-pencil-ruler'></i>", "Thiết kế", new { @class = "btn btn-light-purple btn-h-purple btn-a-purple border-0 radius-3 py-2 text-600 text-90 pull-right mr-1" })

    @Html.Button(true, "TestForm", Url.Action("Test", new { area = "Major" }), "<i class='far fa-eye'></i>", "Kiểm tra", new { @class = "btn btn-light-green btn-h-green btn-a-green border-0 radius-3 py-2 text-600 text-90 pull-right mr-1", data_width = "1024" })

    @Html.Button(true, "AddForm", Url.Action("Add", new { area = "Major" }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right", data_width = "1600" })

}

@Html.Partial("_Search")

<div class="mt-3">
    <div class="card dcard">
        <div class="p-2 table-responsive-md">
            <table id="DSForm" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Form_Name")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Form_RefDocs")</th>
                        <th with="10%">@AppProcessor.Messagor.GetMessage("Form_LastModified")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="@Url.Content("~/Contents/Modules/Major/plugins/money2string/money2text.js")"></script>
    <script src="@Url.Content("~/Areas/Major/Views/Form/Form.js")"></script>
}