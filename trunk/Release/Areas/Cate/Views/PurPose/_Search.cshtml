@using TSFramework.App.Processors
@model Modules.Cate.Areas.Cate.Models.SearchPurPoseModel
<div class="card dcard">
    <div class="card-header">
        <h5 class="card-title text-120 text-primary">@AppProcessor.Messagor.GetMessage("Condition_Title")</h5>
        <div class="card-toolbar no-border">
            <a href="#" data-action="toggle" class="card-toolbar-btn btn btn-sm radius-1 btn-outline-default mx-2px text-primary">
                <i class="fa fa-angle-double-up w-2 mx-1px"></i>
            </a>
        </div>
    </div>
    <div class="card-body p-0 collapse show">
        <div class="col-md-12 form-horizontal mt-3 d-flex" id="SearchPurPose">
            <div class="form-group row col-md-6">
                <label class="col-form-label text-sm-right pr-0 font-bold col-md-4">@AppProcessor.Messagor.GetMessage("Label_TuKhoa")</label>
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.TuKhoa, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("SearchPurPose") })
                </div>
            </div>
            <div class="form-group row col-md-6">
                <label class="col-form-label text-sm-right pr-0 font-bold col-md-4">@AppProcessor.Messagor.GetMessage("ContractType")</label>
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.ContractTypeId, new SelectList(Model.ListTypeContracts, "Value", "Text"), "", new { @class = "form-control col-md-10" })
                    @Html.ValidationMessageFor(model => model.ContractTypeId, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="col-md-12 text-center">
                <button type="button" class="btn btn-primary" onclick="_tablePurPose.ajax.reload(null, false);"><i class="fa fa-search-plus"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Condition_Title")</button>
            </div>
        </div>
    </div>
</div>
