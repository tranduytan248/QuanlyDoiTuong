@using TSFramework.App.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Customer_Title");
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
    @Html.Button(true, "AddCustomer", Url.Action("Add", new { area = "Cate" }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right", data_width = "1024px" })
}

@Html.Partial("_Search")

<div class="mt-3">
    <div class="card dcard">
        <div class="p-2 table-responsive-md">
            <table id="DSCustomer" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Union_Label_Name")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_Label_FullName")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_Label_CitizenIdentification")</th>
                        <th style="width:30%">@AppProcessor.Messagor.GetMessage("Customer_Label_Address")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_Label_TaxCode")</th>
                        @*<th>@AppProcessor.Messagor.GetMessage("Position_Label_Name")</th>*@
                        <th>@AppProcessor.Messagor.GetMessage("Customer_Label_PhoneNumber")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_Label_Email")</th>
                        @*<th>@AppProcessor.Messagor.GetMessage("Customer_Label_Zalo")</th>*@
                        <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="@Url.Content("~/Areas/Cate/Views/Customer/Customer.js")"></script>
}