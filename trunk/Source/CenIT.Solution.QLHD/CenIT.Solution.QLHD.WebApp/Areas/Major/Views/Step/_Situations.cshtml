@using TSFramework.App.Processors
@model Cores.Major.Models.SAVProcStepModel

@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Situation_Title");
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fab fa-playstation"></i>
}

@section FormBody{

    <div class="row modal-body" id="bodyForm">
        <div class="col-md-12">
            <div class="page-header pb-2" id="PageTitle">
                <h1 class="page-title text-primary-d2 text-150"></h1>
                <div class="page-tools d-inline-flex" id="PageAction">
                    @Html.Button(true, "AddStepSituation", Url.Action("Add", "StepSituation", new { area = "Major", stepId = Model.StepId }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right", data_width = "1024px" })
                </div>
            </div>
        </div>

        <div class="col-md-12">
            <div class="mt-3">
                <div class="card dcard">
                    <div class="card-header bg-transparent border-0">
                        <h5 class="card-title mb-2 mb-md-0 text-120 text-grey-d3">
                            <i class="fas fa-tasks mr-1 text-primary-d1 text-90"></i>
                            @AppProcessor.Messagor.GetMessage("Step_Title")
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            @Html.LabelFor(model => model.ProcedureId, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                            <div class="col-md-8">
                                @Html.TextBoxFor(model => model.ProcedureName, new { disabled = true, @class = "form-control col-md-12" })
                            </div>
                        </div>

                        @Html.HiddenFor(model => model.StepId)
                        @Html.HiddenFor(model => model.StepName)
                        <div class="form-group row">
                            @*@Html.LabelFor(model => model.StepName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })*@
                            <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("Step_Title")</label>
                            <div class="col-md-8">
                                @Html.TextBoxFor(model => model.StepName, new { disabled = true, @class = "form-control col-md-12" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-12">
            <div class="mt-3">
                <div class="card dcard">
                    <div class="col-sm-12 table-responsive-md">
                        <table id="StepSituations" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                            <thead class="sticky-nav text-secondary-m1 text-uppercase text-85">
                            <tr>
                                @*<th>@AppProcessor.Messagor.GetMessage("Column_No")</th>*@
                                <th>@AppProcessor.Messagor.GetMessage("Situation_Desc")</th>
                                <th>@AppProcessor.Messagor.GetMessage("Situation_NextStep")</th>
                                <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                            </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">

        var _StepSituationActionURLs = {
            StepSituation_GetData: "@Url.Action("Get", "StepSituation", new { area = "Major" })"
        };
        var _tableStepSituation;
        $(document).ready(function () {
            initTableStepSituation();
        });

        var arrIconSituations = { "1": "fa-eye", "3": "fa-pencil-alt", "5": "fa-user-shield" };

        function initTableStepSituation() {
            _tableStepSituation = $("#StepSituations").DataTable({
                "Responsive": true,
                "language": {
                    "processing": "<div class='overlay'><i class='fas fa-cog fa-spin'></i></div>"
                },
                "lengthChange": true,
                "processing": true,
                "serverSide": true,
                "autoWidth": false,
                "ajax":
                {
                    "url": _StepSituationActionURLs.StepSituation_GetData,
                    "type": "POST",
                    "dataType": "JSON",
                    "data": {
                        "stepId": function () {
                            return "@Model.StepId";
                        }
                    }
                },
                "columns": [
                    //{
                    //    "data": "",
                    //    "defaultContent": "1",
                    //    "render": function (data, type, row, meta) {
                    //        return meta.settings._iDisplayStart + meta.row + 1;
                    //    }
                    //},
                    {
                        "data": "SituationDesc",
                        "width": "40%",
                        "defaultContent": ""
                    },
                    {
                        "data": "NextStepName",
                        "width": "40%",
                        "defaultContent": "",
                        "render": function (data, type, row, meta) {
                            var html = "";
                            if (type === "display") {
                                if (data != null) {
                                    return '<div class="mx-2 my-auto"><div class="text-600 text-primary-d1"><span class="text-110">{0}</span></div><span class="text-100 text-danger-d1"><i class="fas fa-random"></i>&nbsp;{1}</span></div>'.format(data, row["NextProcedureName"])
                                }
                            }
                            return data;
                        }
                    },
                    {
                        "data": "SituationId",
                        "style": "width:100px;",
                        "orderable": false,
                        "render": function (data, type, row, meta) {
                            var html = '<span class="d-none d-lg-inline">';

                            if (type === "display") {
                                html += _renderButton(true,
                                    "EditStepSituation",
                                    "btn px-4 btn-lighter-primary mr-1 v-hover",
                                    "/Major/StepSituation/Edit?situationId=" + data,
                                    '<i class="far fa-edit text-primary text-120"></i>',
                                    "Cập nhật", 1024);

                                html += _renderButton(true,
                                    "DeleteStepSituation",
                                    "btn px-4 btn-lighter-danger mr-1 v-hover",
                                    "/Major/StepSituation/Delete?situationId=" + data,
                                    '<i class="far fa-trash-alt text-danger text-120"></i>',
                                    "Xoá");
                            }
                            html += "</span>";

                            return html;
                        }
                    }
                ]
            });
        }

        function StepSituation_OnProcessSuccess(response, formId) {
            if (response.status != undefined) {
                if ($("#ModalContent #modal_" + formId + " #chkNotDismissModal").is(":checked")) {
                    if (response.status != undefined) {
                        eval(response.message);
                        _tableStepSituation.ajax.reload(null, false);
                        response.status = undefined;
                        //$("#ModalContent #modal_" + formId + " form")[0].reset();
                        var urlAction = $("#ModalContent #modal_" + formId + " form").attr("action");
                        $("#ModalContent #modal_" + formId + " #modal-content").load(urlAction, function (data, textStatus, xhr) {
                            _initElement();
                        });
                    }
                } else {
                    $("#ModalContent #modal_" + formId).modal("hide");
                    $("#ModalContent #modal_" + formId).on("hidden.bs.modal",
                        function () {
                            if (response.status != undefined) {
                                eval(response.message);
                                _tableStepSituation.ajax.reload(null, false);
                                response.status = undefined;
                            }
                        });
                }
            } else {
                $("#ModalContent #modal_" + formId + " #bodyForm").html(response);
            }
        }

    </script>
}
@section SubmitControl{

}