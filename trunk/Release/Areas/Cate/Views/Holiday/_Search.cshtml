@using TSFramework.App.Processors
@model Modules.Cate.Areas.Cate.Models.SearchHolidayModel
<div class="card dcard">
    <div class="card-header">
        <h5 class="card-title text-120 text-primary-d2">@AppProcessor.Messagor.GetMessage("Condition_Title")</h5>
        <div class="card-toolbar no-border">
            <a href="#" data-action="toggle" class="card-toolbar-btn btn btn-sm radius-1 btn-outline-default mx-2px">
                <i class="fa fa-angle-double-up w-2 mx-1px"></i>
            </a>
        </div>
    </div>
    <div class="card-body p-0 collapse show">
        <div class="col-md-12 form-horizontal mt-3" id="Search">
            <div class="form-group row col-md-12">
                @Html.LabelFor(model => model.LunarCalendar, new { @class = "col-sm-4 col-form-label text-sm-right pr-0 font-bold mt-1" })
                <div class="col-md-8 d-flex mt-2">
                    <label class="col-lg-2 px-0 row justify-content-sm-center align-items-center">
                        @Html.RadioButtonFor(model => model.LunarCalendar, "", new { @checked = "checked" })
                        @AppProcessor.Messagor.GetMessage("Holiday_All")
                    </label>
                    <label class="col-lg-4 px-0 row justify-content-sm-center align-items-center">
                        @Html.RadioButtonFor(model => model.LunarCalendar, "true")
                        <span class="badge bgc-info brc-info text-white badge-lg arrowed arrowed-in-right mb-1">
                            <span class="px-3">@AppProcessor.Messagor.GetMessage("Holiday_LunarCalendar")</span>
                        </span>
                    </label>
                    <label class="col-lg-4 px-0 row justify-content-sm-center align-items-center">
                        @Html.RadioButtonFor(model => model.LunarCalendar, "false")
                        <span class="badge bgc-success brc-success text-white badge-lg arrowed arrowed-in-right mb-1">
                            <span class="px-3">@AppProcessor.Messagor.GetMessage("Holiday_Calendar")</span>
                        </span>
                    </label>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="col-md-12 text-center">
                <button type="button" class="btn btn-primary" onclick="_tableHoliday.ajax.reload(null, false);"><i class="fa fa-search-plus"></i>&nbsp;Tìm kiếm</button>
            </div>
        </div>
    </div>
</div>