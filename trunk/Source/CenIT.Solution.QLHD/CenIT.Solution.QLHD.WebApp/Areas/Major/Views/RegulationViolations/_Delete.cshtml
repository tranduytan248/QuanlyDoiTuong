@using TSFramework.App.Processors
@model Cores.Major.Models.SAVRegulationViolationsModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("RegulationViolations_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "RegulationViolations", new { area = "Major" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "RegulationViolations_OnProcessSuccess(data, 'DeleteRegulationViolations')"
    }, new { @class = "form-horizontal", id = "DeleteRegulationViolations" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.RegulationViolationsId)
        @Html.HiddenFor(model => model.ConstructionParticipantName)
        @Html.HiddenFor(model => model.ViolationBehaviorName)
        @Html.HiddenFor(model => model.ViolatedConstructionName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}