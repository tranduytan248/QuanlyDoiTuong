@using TSFramework.App.Processors
@model Cores.Cate.Models.CateUnionModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("UnionInfo_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    purple
}

@section FormIcon{
    <i class="fas fa-user-edit"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("Info", "Union", new { area = "Cate", unionId = Model.UnionId, unionName = Model.UnionName }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Union_OnProcessSuccess(data, 'EditInfo')"
    }, new { @class = "form-horizontal", id = "EditInfo" }))
    {
        <div id="bodyForm">
            @Html.Partial("_UnionInfo")
        </div>
    }
}
