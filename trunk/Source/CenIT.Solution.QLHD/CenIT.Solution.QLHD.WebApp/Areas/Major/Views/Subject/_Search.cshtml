@using TSFramework.App.Processors
@using Cores.Cate.Models
@model Modules.Major.Areas.Major.Models.SearchSubjectModel
@{
    var listFields = ViewBag.ListFields as List<CateFieldModel> ?? new List<CateFieldModel>();
    var listBehaviors = ViewBag.ListBehaviors as List<CateViolationBehaviorModel> ?? new List<CateViolationBehaviorModel>();
}
<div class="card dcard">
    <div class="card-header">
        <h5 class="card-title text-120 text-primary">@AppProcessor.Messagor.GetMessage("Condition_Title")</h5>
        <div class="card-toolbar no-border">
            <a href="#" data-action="toggle" class="card-toolbar-btn btn btn-sm radius-1 btn-outline-default mx-2px">
                <i class="fa fa-angle-double-up w-2 mx-1px"></i>
            </a>
        </div>
    </div>
    <div class="card-body collapse show">
        <div class="form-horizontal" id="Search">
            <div class="row">
                <!-- CỘT TRÁI -->
                <div class="col-12 col-lg-6">
                    <div class="form-group row mb-3">
                        <label class="col-sm-4 col-form-label text-sm-right font-bold pr-2">Số CCCD</label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.IdentityCardNumber, new { @class = "form-control", placeholder = "Nhập số CCCD/CMND...", autocomplete = "off" })
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <label class="col-sm-4 col-form-label text-sm-right font-bold pr-2">Lĩnh vực</label>
                        <div class="col-sm-8">
                            <select class="form-control" id="SearchFieldId">
                                <option value="">-- Tất cả lĩnh vực --</option>
                                @foreach (var field in listFields)
                                {
                                    <option value="@field.FieldId">@field.FieldName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-group row mb-0">
                        <label class="col-sm-4 col-form-label text-sm-right font-bold pr-2">Giới tính</label>
                        <div class="col-sm-8">
                            <select class="form-control" id="Gender" name="Gender">
                                <option value="">-- Tất cả giới tính --</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- CỘT PHẢI -->
                <div class="col-12 col-lg-6">
                    <div class="form-group row mb-3">
                        <label class="col-sm-4 col-form-label text-sm-right font-bold pr-2">Họ và tên</label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.FullName, new { @class = "form-control", placeholder = "Nhập họ tên hoặc tên gọi khác...", autocomplete = "off" })
                        </div>
                    </div>

                    <div class="form-group row mb-0">
                        <label class="col-sm-4 col-form-label text-sm-right font-bold pr-2">Hành vi vi phạm</label>
                        <div class="col-sm-8">
                            <select class="form-control" id="BehaviorIds" name="BehaviorIds" multiple size="4">
                                @foreach (var behavior in listBehaviors)
                                {
                                    <option value="@behavior.BehaviorId" data-fieldid="@behavior.FieldId">@behavior.BehaviorName</option>
                                }
                            </select>
                            <small class="form-text text-secondary text-85">
                                <i class="fas fa-info-circle mr-1"></i>Giữ Ctrl để chọn nhiều hành vi. Chọn lĩnh vực để thu gọn danh sách.
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer text-center">
        <button type="button" class="btn btn-primary px-3" onclick="_tableSubject.ajax.reload(null, false);">
            <i class="fa fa-search"></i>&nbsp;Tìm kiếm đối tượng
        </button>
        <button type="button" class="btn btn-secondary px-3" onclick="resetSubjectSearch();">
            <i class="fa fa-eraser"></i>&nbsp;Xoá điều kiện
        </button>
    </div>
</div>
