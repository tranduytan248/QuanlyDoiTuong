@using TSFramework.App.Processors
@model Modules.Major.Areas.Major.Models.ReportModel

<div id="_03BaoCaoDinhKyQLTTXD">
    <div class="form-group row">
        <div class="col-2 col-form-label text-sm-right pr-0 font-bold mt-1 mr-3">
            <label for="ForMonth" class="mb-0">
                Báo cáo tháng
            </label>
        </div>
        <div class="col-sm-3">
            <div class="input-group date">
                <div class="input-group-addon input-group-prepend">
                    <div class="input-group-text">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                </div>
                @Html.TextBox("ForMonth", DateTime.Now.ToString("MM/yyyy"), new { @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-2 col-form-label text-sm-right pr-0 font-bold mt-1 mr-3">
            <label for="UnionId" class="mb-0">
                Địa bàn
            </label>
        </div>
        <div class="col-sm-9">
            @Html.SelectFor(model => model.Unions, Model.ListUnions, AppProcessor.Messagor.GetMessage("Union_Title"), new { multiple = true, @class = "form-control col-11", onchange = "_onChangeCombo(this, '#_05BaoCaoLuyKeNamTTXD #UnionName', true)" })
            @Html.HiddenFor(model => model.UnionName)
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {
        $("#ForMonth").datepicker({
            format: "mm/yyyy",
            viewMode: "months",
            minViewMode: "months",
            autoclose: true
        });
    });
</script>