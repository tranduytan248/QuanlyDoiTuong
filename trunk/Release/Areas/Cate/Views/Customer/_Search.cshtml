@using TSFramework.App.Processors
@model Modules.Cate.Areas.Cate.Models.SearchCustomerModel
<div class="card dcard">
    <div class="card-header">
        <h5 class="card-title text-120 text-primary-d2">@AppProcessor.Messagor.GetMessage("Condition_Title")</h5>
        <div class="card-toolbar no-border">
            <a href="#" data-action="toggle" class="card-toolbar-btn btn btn-sm radius-1 btn-outline-default mx-2px">
                <i class="fa fa-angle-double-up w-2 mx-1px"></i>
            </a>
        </div>
    </div>
    <div class="card-body p-0 collapse show">
        <div class="col-md-12 form-horizontal mt-3" id="Search">
            <div class="form-group row col-md-12">
                @Html.TitleFor(model => model.FullName, new { @class = "col-sm-4 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.FullName, new { @class = "form-control col-md-7", placeholder = AppProcessor.Messagor.GetMessage("Customer_placeholder_TuKhoa") })
                    @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group row col-md-12 ">
                @Html.TitleFor(model => model.UserType, new { @class = "col-sm-4 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-md-8 d-flex mt-2">
                    <label class="col-lg-2 px-0 row justify-content-sm-center align-items-center">
                        @Html.RadioButtonFor(model => model.UserType, "ALL", new { id = "BusinessCheckBox", @checked = Model.UserType == "ALL" })
                        @AppProcessor.Messagor.GetMessage("ALL")
                    </label>
                    <label class="col-lg-3 px-0 row justify-content-sm-center align-items-center">
                        @Html.RadioButtonFor(model => model.UserType, "CONSUMER", new { id = "BusinessCheckBox" })
                        @AppProcessor.Messagor.GetMessage("CONSUMER")
                    </label>
                    <label class="col-lg-6 px-0 row justify-content-sm-center align-items-center">
                        @Html.RadioButtonFor(model => model.UserType, "BUSINESS", new { id = "BusinessCheckBox" })
                        @AppProcessor.Messagor.GetMessage("BUSINESS")
                    </label>

                </div>
            </div>

        </div>
        <div class="card-footer">
            <div class="col-md-12 text-center">
                <button type="button" class="btn btn-primary" onclick="_tableCustomer.ajax.reload(null, false);"><i class="fa fa-search-plus"></i>&nbsp;Tìm kiếm</button>
                <button type="button" class="btn btn-primary" onclick="Export()"><i class="fa fa-download"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Label_Export")</button>
            </div>
        </div>
    </div>
</div>