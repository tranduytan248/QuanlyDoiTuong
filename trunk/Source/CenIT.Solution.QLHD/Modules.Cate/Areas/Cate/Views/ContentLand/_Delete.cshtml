@using TSFramework.App.Processors
@model Cores.Cate.Models.CateContentLandModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("ContentLand_Label_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{

    @using (Ajax.BeginForm("Delete", "ContentLand", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "ContentLand_OnProcessSuccess(data, 'DeleteContentLand')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ContentLandId)
        @Html.HiddenFor(model => model.ContractTypeId)
        @Html.HiddenFor(model => model.ContentLandName)
        @Html.HiddenFor(model => model.ContractTypeName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}