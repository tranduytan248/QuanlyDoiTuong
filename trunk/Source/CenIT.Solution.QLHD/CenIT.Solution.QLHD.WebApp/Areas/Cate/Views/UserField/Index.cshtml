@using TSFramework.App.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("UserField_Title") ?? "Phân quyền lĩnh vực";
}

@section PageTitle
{
    @ViewBag.Title
}

@Html.Partial("_Search")

<div class="mt-3">
    <div class="card dcard">
        <div class="p-2 table-responsive-md">
            <table id="DSUserField" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="text-center" style="width:50px;">STT</th>
                        <th style="width:160px;">Tên đăng nhập</th>
                        <th style="width:220px;">Họ và tên</th>
                        <th>Lĩnh vực được phân quản lý</th>
                        <th class="text-center" style="width:90px;">Số lĩnh vực</th>
                        <th class="text-center" style="width:120px;">Thao tác</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="~/Areas/Cate/Views/UserField/UserField.js?v=@(System.IO.File.GetLastWriteTime(Server.MapPath("~/Areas/Cate/Views/UserField/UserField.js")).Ticks)"></script>
}
