﻿@using TSFramework.App.Processors
@model Cores.Cate.Models.CateSubjectTypeModel
@{
    ViewBag.Title = "Xác nhận xóa Loại đối tượng";
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    danger
}

@section FormIcon{
    <i class="fa fa-trash-alt"></i>
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "SubjectType", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "SubjectType_OnProcessSuccess(data, 'DeleteSubjectType')"
    }, new { @class = "form-horizontal", id = "DeleteSubjectType" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.SubjectTypeId)
        @Html.HiddenFor(model => model.SubjectTypeName)

        <div class="alert alert-warning text-center">
            @Html.Raw(ViewBag.ConfirmMessage ?? $"Bạn có chắc chắn muốn xóa Loại đối tượng <b>[{Model.SubjectTypeName}]</b> không?")
        </div>
    }
}
