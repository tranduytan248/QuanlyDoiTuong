    #suggestionsList {
        display: block !important;
        max-height: 200px !important; /* Điều chỉnh chiều cao tối đa nếu cần thiết */
        overflow-y: auto !important;
    }

    .dz-remove {
        z-index: 999;
        position: absolute;
        display: block;
        top: 0%;
        left: 100%;
        margin-left: 5px;
        /*margin-top: -15px;*/
    }
    .dz-remove span{
        cursor: pointer !important;
    }
</style>

