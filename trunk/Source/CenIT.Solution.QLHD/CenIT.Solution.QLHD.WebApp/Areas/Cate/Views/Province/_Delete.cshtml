@using TSFramework.App.Processors
@model Cores.Sys.Models.Cate.CateProvinceModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Province_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Province", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Province_OnProcessSuccess(data, 'DeleteProvince')"
    }, new { @class = "form-horizontal", id = "DeleteRegulation" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ProvinceId)
        @Html.HiddenFor(model => model.ProvinceCode)
        @Html.HiddenFor(model => model.ProvinceName)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}