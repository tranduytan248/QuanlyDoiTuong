@using TSFramework.App.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Edit"), AppProcessor.Messagor.GetMessage("RegulationViolations_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="far fa-edit"></i>
}

@section FormBody{

    @using (Ajax.BeginForm("Edit", "RegulationViolations", new { area = "Major" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "RegulationViolations_OnProcessSuccess(data, 'EditRegulationViolations')"
    }, new { @class = "form-horizontal", id = "EditRegulationViolations" }))
    {
        <div id="bodyForm">
            @Html.Partial("_RegulationViolations")
        </div>
    }
}