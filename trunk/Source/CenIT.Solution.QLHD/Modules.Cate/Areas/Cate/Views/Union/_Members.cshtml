@using TSFramework.App.Processors
@model Cores.Cate.Models.CateUnionModel

@{
    ViewBag.Title = Html.Raw($"{AppProcessor.Messagor.GetMessage("Union_Member_Title")} - <b>{AppProcessor.Messagor.GetMessage("Union_Title")} [{Model.UnionName}]</b>");
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fas fa-tasks"></i>
}

@section FormBody{

    <div class="row modal-body" id="bodyForm">
        <div class="col-md-12">
            <div class="page-header pb-2" id="PageTitle">
                <h1 class="page-title text-primary-d2 text-150"></h1>
                <div class="page-tools d-inline-flex" id="PageAction">
                    @Html.Button(true, "AddMember", Url.Action("AddMember", "Union", new { area = "Cate", unionId = Model.UnionId }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right" })
                </div>
            </div>
        </div>

        <div class="col-sm-12">
            <div class="mt-3">
                <div class="card dcard">
                    <div class="p-2 table-responsive-md">
                        <table id="Members" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                            <thead class="sticky-nav text-secondary-m1 text-uppercase text-85">
                                <tr>
                                    <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                                    <th>@AppProcessor.Messagor.GetMessage("Union_Member_Title")</th>
                                    <th>@AppProcessor.Messagor.GetMessage("Position_Title")</th>
                                    <th>@AppProcessor.Messagor.GetMessage("Union_Member_Permit")</th>
                                    <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">

        var _MemberActionURLs = {
            Member_GetData: "@Url.Action("GetMembers", "Union", new { area = "Cate" })"
        };
        var _tableMember;
        $(document).ready(function () {
            initTableMember();
        });

        function initTableMember() {
            _tableMember = $("#Members").DataTable({
                "Responsive": true,
                "language": {
                    "processing": "<div class='overlay'><i class='fas fa-cog fa-spin'></i></div>"
                },
                "lengthChange": false,
                "info": false,
                "pageLength": 50,
                "searching": false,
                "processing": true,
                "serverSide": true,
                "autoWidth": false,
                "ordering": false,
                "ajax":
                {
                    "url": _MemberActionURLs.Member_GetData,
                    "type": "POST",
                    "dataType": "JSON",
                    "data": {
                        "unionId": function () {
                            return "@Model.UnionId";
                        }
                    }
                },
                "columns": [
                    {
                        "data": "",
                        "defaultContent": "1",
                        "render": function (data, type, row, meta) {
                            return meta.settings._iDisplayStart + meta.row + 1;
                        }
                    },
                    //{
                    //    "data": "UnionName",
                    //    "width": "45%",
                    //    "defaultContent": ""
                    //},
                    {
                        "data": "FullName",
                        "defaultContent": "",
                        //"width": "55%",
                        "render": function (data, type, row, meta) {
                            var html = ' <div class="mx-2 my-auto"><div class="text-600 text-primary-d1"><span class="text-110">{0}</span></div><span class="text-100 text-danger-d1"><i class="fas fa-at"></i>&nbsp;{1}</span></div>'
                                .format(data, row["Email"]);
                            if (type === "display") {
                                return html;
                            }
                            return data;
                        }
                    },
                    {
                        "data": "PositionName",
                        //"width": "20%",
                        "defaultContent": ""
                    },
                    {
                        "data": "PermitName",
                        //"width": "20%",
                        "defaultContent": ""
                    },
                    {
                        "data": "UnionId",
                        "width": "25%",
                        "orderable": false,
                        "render": function (data, type, row, meta) {
                            var html = '<span class="d-none d-lg-inline">';

                            if (type === "display") {
                                //html += _renderButton(true,
                                //    "EditMember",
                                //    "btn px-4 btn-lighter-primary mr-1 v-hover",
                                //    "/Cate/Union/EditMember?unionId={0}&userName={1}".format(data, row["UserName"]),
                                //    '<i class="far fa-edit text-primary text-120"></i>',
                                //    "Cập nhật");

                                html += _renderButton(true,
                                    "DeleteMember",
                                    "btn px-4 btn-lighter-danger mr-1 v-hover",
                                    "/Cate/Union/DeleteMember?unionId={0}&userName={1}".format(data, row["UserName"]),
                                    '<i class="far fa-trash-alt text-danger text-120"></i>',
                                    "Xoá");
                            }
                            html += "</span>";

                            return html;
                        }
                    }
                ]
            });
        }

        function UnionMember_OnProcessSuccess(response, formId) {
            if (response.status != undefined) {
                if ($("#ModalContent #modal_" + formId + " #chkNotDismissModal").is(":checked")) {
                    if (response.status != undefined) {
                        eval(response.message);
                        _tableMember.ajax.reload(null, false);
                        response.status = undefined;
                        var urlAction = $("#ModalContent #modal_" + formId + " form").attr("action");
                        $("#ModalContent #modal_" + formId + " #modal-content").load(urlAction, function (data, textStatus, xhr) {
                            _initElements(this);
                        });
                    }
                } else {
                    $("#ModalContent #modal_" + formId).modal("hide");
                    $("#ModalContent #modal_" + formId).on("hidden.bs.modal",
                        function () {
                            if (response.status != undefined) {
                                eval(response.message);
                                _tableMember.ajax.reload(null, false);
                                response.status = undefined;
                            }
                        });
                }
            } else {
                $("#ModalContent #modal_" + formId + " #bodyForm").html(response);
            }
        }

    
    </script>
}
@section SubmitControl{

}
