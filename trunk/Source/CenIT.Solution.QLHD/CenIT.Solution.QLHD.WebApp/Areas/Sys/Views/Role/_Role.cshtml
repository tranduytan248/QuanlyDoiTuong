@using TSFramework.App.Processors
@model Cores.Sys.Models.Sys.SysRoleModel

@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.RoleId)

<div class="form-group row">
    <div class="col-md-12">
        @Html.TitleFor(model => model.Name, new { @class = "col-form-label pr-0 font-bold" })
        @Html.TextBoxFor(model => model.Name, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Role_Label_Name") })
        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
    </div>
</div>