@using Cores.eContract.Consts
@using TSFramework.App.Processors
@model Modules.Major.Areas.Major.Models.SearchCustomerModel
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Customer_Title");
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
    @*@Html.Button(true, "AddCustomer", Url.Action("Add", new { area = "Major" }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right", data_width = "1024px" })*@
    
    <div class="dropdown d-inline-block mb-1" id="ButtonAddCus">
        <button class="btn px-3 h-6 waves-effect btn-primary btn-h-outline-primary btn-a-outline-primary py-1 text-600 pull-left dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class='fa fa-plus'></i>
            @AppProcessor.Messagor.GetMessage("Button_Add_Customer")
        </button>
        <div class="dropdown-menu dropdown-caret dropdown-menu-right">
            @{
                var mappingIconTypeCustomers = new Dictionary<string, string>
                {
                    {$"{ConstsCusType.CONSUMER}", "fas fa-user"}, //Cá nhân
                    {$"{ConstsCusType.BUSINESS}", "fas fa-user-tie"} //Doanh nghiệp
                };
                var mappingColorTypeCustomers = new Dictionary<string, string>
                {
                    {$"{ConstsCusType.CONSUMER}", "info"}, //Cá nhân
                    {$"{ConstsCusType.BUSINESS}", "success"}, //Doanh nghiệp
                };

                foreach (var typeCus in Model.ListTypeCuss)
                {
                    @Html.Button(true, "AddCustomer", Url.Action("Add", new { area = "Major", typeCus = typeCus.Value }), $"<i class=\"{mappingIconTypeCustomers[typeCus.Value]}\"></i>", typeCus.Text, new { @class = $"dropdown-item text-105 btn btn-outline-{mappingColorTypeCustomers[typeCus.Value]}", data_width = "860px", data_scrollbars_inside = true })
                }
            }
        </div>
    </div>
}

@Html.Partial("_Search")

<div class="mt-3">
    <div class="card dcard">
        <div class="p-2 table-responsive-md d-none">
            <table id="DSCustomer" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        @*<th>@AppProcessor.Messagor.GetMessage("Customer_Label_CusType")</th>*@
                        <th>@AppProcessor.Messagor.GetMessage("Customer_Label_CusName")</th>
                        @*<th style="width:30%">@AppProcessor.Messagor.GetMessage("Customer_Label_Address")</th>
                            <th>@AppProcessor.Messagor.GetMessage("Customer_Label_PhoneNumber")</th>*@
                        <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="@Url.Content("~/Areas/Major/Views/Customer/Customer.js")"></script>
}