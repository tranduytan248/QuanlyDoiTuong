@using TSFramework.App.Processors
@model Cores.Major.Models.MajorReportModel

@Html.AntiForgeryToken()
@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(model => model.ForUser)
@Html.HiddenFor(model => model.FullName)
@Html.HiddenFor(model => model.Email)

<link rel="stylesheet" href="~/Contents/Modules/Sys/plugins/bootstrap-multiselect/css/bootstrap-multiselect.css" type="text/css"/>

<div id="PermitReports">
	<div class="form-group row">
		@Html.TitleFor(model => model.FullName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
		<div class="col-md-9">
			@Html.TextBoxFor(model => model.FullName, new { @class = "form-control col-md-8", disabled = true, placeholder = AppProcessor.Messagor.GetMessage("User_Title") })
			@Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
		</div>
	</div>
	<div class="form-group row">
		@Html.TitleFor(model => model.Email, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
		<div class="col-md-9">
			@Html.TextBoxFor(model => model.Email, new { @class = "form-control col-md-10", disabled = true, placeholder = AppProcessor.Messagor.GetMessage("User_Label_Email") })
			@Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
		</div>
	</div>
    
    <div class="form-group row">
        @Html.TitleFor(model => model.SelectedReports, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
        <div class="col-md-9">
            @Html.DropDownList("PermitReport", new SelectList(Model.ListReports, "Value", "Text"),
                new { @class = "form-control col-md-10 none-select2", multiple = "multiple", placeholder = AppProcessor.Messagor.GetMessage("Combobox_Select_User") })
        </div>
        @Html.HiddenFor(model => model.SelectedReports)
    </div>
</div>

<script type="text/javascript" src="~/Contents/Modules/Sys/plugins/bootstrap-multiselect/js/bootstrap-multiselect.js"></script>

<script type="text/javascript">

    //debugger;

    $(document).ready(function() {
        $('#PermitReports select#PermitReport').multiselect({
            maxHeight: 400,
            numberDisplayed: 1,
            includeSelectAllOption: true,
            selectAllNumber: true,
            selectAllText: 'Chọn tất cả!',
            nonSelectedText: 'Chọn báo cáo',
            resetText: "Bỏ chọn tất cả",
            enableFiltering: true,
            enableCaseInsensitiveFiltering: true,
            includeResetOption: true,
            includeResetDivider: true,
            filterPlaceholder: 'Tìm kiếm báo cáo',
            allSelectedText: 'Chọn tất cả',
            nSelectedText: 'báo cáo đã được chọn',
            enableClickableOptGroups: true,
            enableCollapsibleOptGroups: true,
            onChange: function(option, checked, select) {
                var selectedValues = $('#PermitReports input[type="hidden"][id$="SelectedReports"]').val();
                var arrSelectedValues = selectedValues != undefined && selectedValues.length > 0
                    ? selectedValues.split(',')
                    : [];
                var idxOpt = arrSelectedValues.indexOf($(option).val());

                if (checked) {
                    if (idxOpt < 0) {
                        arrSelectedValues.push($(option).val());
                        $('#PermitReports input[type="hidden"][id$="SelectedReports"]').val(arrSelectedValues);
                    }
                } else {
                    if (idxOpt > -1) {
                        arrSelectedValues.splice(idxOpt, 1);
                        $('#PermitReports input[type="hidden"][id$="SelectedReports"]').val(arrSelectedValues);
                    }
                }
            },
            onSelectAll: function() {
                var arrSelectedValues = $('#PermitReports select#PermitReport option:selected').map(function (a, item) { return item.value; });
                $('#PermitReports input[type="hidden"][id$="SelectedReports"]').val(arrSelectedValues.toArray());
            },
            onDeselectAll: function() {
                $('#PermitReports input[type="hidden"][id$="SelectedReports"]').val('');
            }
        });
    });

    $(function() {
        var selectedValues = $('#PermitReports input[type="hidden"][id$="SelectedReports"]').val();
        $('#PermitReports select#PermitReport').multiselect('select', selectedValues.split(","));
    });
</script>