@using TSFramework.App.Processors
@model Cores.Major.Models.MajorContractConfirmModel

@Html.AntiForgeryToken()

@Html.HiddenFor(model => model.ContractId)
@Html.HiddenFor(model => model.CusName)
@Html.HiddenFor(model => model.ContractNo)
@Html.HiddenFor(model => model.ContractSignal)

<div id="ApproveContract">
    <div class="form-row">
        <div class="form-row col-md-7">
            <div class="col">
                @Html.TitleFor(model => model.ContractNo, new { @class = "col-form-label pr-0 font-bold" })
                @Html.TextBoxFor(model => model.ContractNoInfo, new { @readonly = true, @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Contract_ContractNo") })
            </div>
            @*<div class="mx-1"></div>
                <div class="col">
                    @Html.TitleFor(model => model.ContractSignal, new { @class = "col-form-label pr-0 font-bold" })
                    @Html.TextBoxFor(model => model.ContractSignal, new { @readonly = true, @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Contract_ContractSignal") })
                </div>*@
        </div>
        <div class="col-md-5">
            @Html.TitleFor(model => model.FormattedTotal, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                @Html.TextBoxFor(model => model.FormattedTotal, new { @readonly = true, @class = "form-control col-md-12 text-500 text-danger-d1 text-110", placeholder = AppProcessor.Messagor.GetMessage("Contract_Total") })
                <div class="input-group-append">
                    <span class="input-group-text">đ</span>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.FormattedTotal, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-row">
        <div class="col-md-6">
            @Html.TitleFor(model => model.ReceivedOn, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                @Html.TextBoxFor(model => model.ReceivedOn, "{0:dd/MM/yyyy HH:mm}", new { disabled = true, @class = "form-control col-md-12 datepicker", placeholder = AppProcessor.Messagor.GetMessage("Contract_ReceivedOn") })
                <div class="input-group-addon input-group-append">
                    <div class="input-group-text">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                </div>
            </div>
            @Html.HiddenFor(model => model.ReceivedOn)
            @Html.ValidationMessageFor(model => model.ReceivedOn, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6">
            @Html.TitleFor(model => model.ApprovedOn, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                @Html.TextBoxFor(model => model.ApprovedOn, "{0:dd/MM/yyyy HH:mm}", new { disabled = true, @class = "form-control col-md-12 datetimepicker", placeholder = AppProcessor.Messagor.GetMessage("Contract_ConfirmOn") })
                <div class="input-group-addon input-group-append">
                    <div class="input-group-text">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                </div>
            </div>
            @Html.HiddenFor(model => model.ApprovedOn)
            @Html.ValidationMessageFor(model => model.ApprovedOn, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group row">
        <div class="col-md-6">
            @Html.TitleFor(model => model.HandleTime, new { @class = "col-form-label pr-0 font-bold" })
            @Html.TextBoxFor(model => model.HandleTime, new { @class = "form-control col-md-6", placeholder = AppProcessor.Messagor.GetMessage("Contract_HandleTime"), onchange= "_onChangeReturnResult('#ApproveContract #ApprovedOn',this,'#ApproveContract #GiveResultOn')" })
            @Html.ValidationMessageFor(model => model.HandleTime, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6">
            @Html.TitleFor(model => model.GiveResultOn, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                @Html.TextBoxFor(model => model.GiveResultOn, "{0:dd/MM/yyyy}", new { @class = "form-control col-md-12 datepicker", placeholder = AppProcessor.Messagor.GetMessage("Contract_GiveResultOn") })
                <div class="input-group-addon input-group-append">
                    <div class="input-group-text">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.GiveResultOn, "", new { @class = "text-danger" })
        </div>
    </div>
    <hr class="border-none border-t-3 brc-grey-l2 border-double">

    <div class="form-group row">
        <div class="col-md-12">
            @Html.TitleFor(model => model.RefFiles, new { @class = "col-form-label pr-0 font-bold" })
            @Html.FileFor(model => model.RefFiles, ".doc,.docx,.pdf", false, new { @class = "form-control col-md-12" })
            @Html.ValidationMessageFor(model => model.RefFiles, "", new { @class = "text-danger" })
        </div>
    </div>
</div>
@Html.RenderScripts(ScriptPosition.BodyInside)

<script src="~/Contents/Modules/Major/plugins/jquery.masknumber/jquery.masknumber.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {

        $('#ApproveContract [name="FormattedTotal"]').maskNumber({ integer: true });
        $('#ApproveContract [name="FormattedTotal"]').trigger('keyup');
    });
    //debugger;
    function _onChangeReturnResult(eleApprovedOn, eleHandleTime, eleGiveResultOn) {

        var approvedOn = $(eleApprovedOn).val();
        var handleTime = $(eleHandleTime).val();

        if (approvedOn == null || approvedOn.length <= 0 || handleTime == null || handleTime.length <= 0 || handleTime < 0) return;
        var dateApproved = moment(approvedOn, "DD/MM/YYYY hh:mm").format("YYYY-MM-DD")

        var urlCalcReturnResult =
            "@Url.Action("CalcReturnResult", "Contract", new { area = "Major" })?fromDate=" + dateApproved + "&handleTime=" + handleTime;
        $.ajax({
            type: "GET",
            url: urlCalcReturnResult,
            dataType: "JSON",
            success: function (response) {
                var giveResultOn = response.data;
                $(eleGiveResultOn).val(giveResultOn);
            }
        });
    }
</script>