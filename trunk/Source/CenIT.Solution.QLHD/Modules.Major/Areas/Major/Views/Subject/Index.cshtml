@using TSFramework.App.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Subject_Title") ?? "Quản lý Đối tượng";
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
    @Html.Button(true, "AddSubject", Url.Action("Add", new { area = "Major" }), "<i class='fa fa-user-plus'></i>", "Thêm đối tượng", new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right", data_width = "1350px" })
}

@Html.Partial("_Search")

<div class="mt-3">
    <div class="card dcard">
        <div class="p-2 table-responsive-md">
            <table id="DSSubject" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="text-center" style="width:50px;">STT</th>
                        <th class="text-center" style="width:70px;">Ảnh</th>
                        <th style="width:140px;">Số CCCD/Định danh</th>
                        <th>Họ và tên khai sinh</th>
                        <th class="text-center" style="width:110px;">Ngày sinh</th>
                        <th class="text-center" style="width:80px;">Giới tính</th>
                        <th style="width:120px;">Điện thoại</th>
                        <th>Nơi ở hiện tại</th>
                        <th class="text-center" style="width:100px;">Số lần VP</th>
                        <th class="text-center" style="width:160px;">Thao tác</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="~/Areas/Major/Views/Subject/Subject.js"></script>
}
