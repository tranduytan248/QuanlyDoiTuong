@using TSFramework.App.Processors
@model Cores.Cate.Models.CateUnionModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Union_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Union", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Union_OnProcessSuccess(data, 'DeleteUnion')"
    }, new { @class = "form-horizontal", id = "DeleteUnion" }))
    {
	    <div id="bodyForm">
		    @Html.Partial("_DelBody")
	    </div>
    }
}