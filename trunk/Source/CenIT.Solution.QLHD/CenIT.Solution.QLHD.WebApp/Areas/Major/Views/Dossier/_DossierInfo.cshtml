<script type="text/javascript">

    function _onChangeTab(tab){
        if($(tab.target).hasClass('active')) return;
        var hrefActiveTab = $(tab.target).attr("href");
        $("input[type=hidden][id='ActiveTab']").val(hrefActiveTab);
    }

    function Doc_OnProcessSuccess(response, formId) {
        $("#ModalContent #modal_" + formId).modal("hide");
        $("#ModalContent #modal_" + formId).on("hidden.bs.modal", function () {
            if (response.status != undefined) {
                eval(response.message);
                $("#" + response.fileId).remove();
                response.status = undefined;
            }
        });
    }

</script>

