@using Modules.Major.Cores.Enums
@using Cores.Major.Enums
@using TSFramework.App.Processors

<link rel="stylesheet" href="~/Contents/Base/plugins/bootstrap-datetimepicker/css/bootstrap-datetimepicker.css" />

<div class="" id="DecisionPenalize">
    <div class="form-group row">
        <h3 class="text-center font-500 col-12 text-primary-d2">BIÊN BẢN VI PHẠM HÀNH CHÍNH</h3>
    </div>
    <hr class="brc-danger-m1" />

    <div class="form-group row">
        <div class="col-3 input-floating-label text-danger-d2 brc-danger-m1">
            <input required="" type="text" placeholder="Số biên bản" class="form-control shadow-none" id="SoBBVPHC" name="SoBBVPHC" />
            <span class="floating-label text-danger-m3 text-500">
                Biên bản số (*)
            </span>
        </div>
        <div class="col-4 input-floating-label text-danger-d2 brc-danger-m1">
            <input required="" type="text" placeholder="Lập biên bản ngày" class="form-control shadow-none datepicker" id="NgayLapBBVPHC" name="NgayLapBBVPHC" />
            <span class="floating-label text-danger-m3 text-500">
                Lập biên bản ngày (*)
            </span>
        </div>
    </div>

    @*<div class="form-group row">
	    <span class="has-float-label input-floating-label col-11 text-danger-d2 brc-danger-m1">
		    <textarea required class="form-control shadow-none" id="DiaChiLap" name="DiaChiLap" placeholder="Tại địa chỉ (*)" rows="2"></textarea>
		    <label class="floating-label text-danger-m3 text-500" for="DiaChiLap">
			    Tại địa chỉ (*)
		    </label>
	    </span>
    </div>*@
    
    @*<div class="form-group row">
	    <span class="has-float-label input-floating-label col-11 text-danger-d2 brc-danger-m1">
		    <textarea disabled="disabled" class="form-control shadow-none" id="LapBienBanTai" name="LapBienBanTai" placeholder="Lý do lập biên bản tại (*)" rows="2"></textarea>
		    <label class="floating-label text-danger-m3 text-500" for="LapBienBanTai">
			    Lý do lập biên bản tại (*)
		    </label>
	    </span>
    </div>*@

    <div class="form-group row">
	    <div class="col-12 input-floating-label text-danger-d2 brc-danger-m1">
		    <input required="" type="text" placeholder="Căn cứ" class="form-control shadow-none" id="CanCuLapBBVPHC" name="CanCuLapBBVPHC"/>
		    <span class="floating-label text-danger-m3 text-500">
			    Căn cứ (*)
		    </span>
	    </div>
    </div>

    <hr class="brc-danger-m1" />

    <div class="form-group row mt-2">
        <label for="TypeViolator" class="col-sm-3 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("TypeViolator_Title")</label>
        <label class="col-form-label col-4">
            <input type="radio" name="TypeViolator" value="@((int)EnumTypeViolator.Persional)" checked="checked" id="Persional" , onchange="_onChangeTypeViolator(this);" />
            @Html.Label(AppProcessor.Messagor.GetMessage("TypeViolator_Persional"), new { @for = "Persional" })
        </label>
        <label class="col-form-label col-4">
            <input type="radio" name="TypeViolator" value="@((int)EnumTypeViolator.Organization)" id="Organization" , onchange="_onChangeTypeViolator(this);" />
            @Html.Label(AppProcessor.Messagor.GetMessage("TypeViolator_Organization"), new { @for = "Organization" })
        </label>
    </div>

    <div class="card dcard mb-4" draggable="false">
        <div class="card-header">
            <h5 class="card-title text-120 text-danger-d2 text-500">
                <i class="fas fa-wrench"></i>&nbsp;@AppProcessor.Messagor.GetMessage("TypeViolator_Title")
            </h5>
            <div class="card-toolbar">
                <div class="card-toolbar no-border">
                    <a href="#" data-action="toggle" class="card-toolbar-btn btn btn-sm radius-1 btn-outline-default mx-2px" draggable="false">
                        <i class="fa fa-angle-double-up w-2 mx-1px"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body p-2">
            <div id="ViolatorInfo" class="mt-1">
                @Html.Partial("_Violator")
            </div>
        </div>
    </div>

    <div class="form-group row">
	    <span class="has-float-label input-floating-label col-11 text-danger-d2 brc-danger-m1">
		    <textarea required class="form-control shadow-none" id="HanhViViPham" name="HanhViViPham" placeholder="Hành vi vi phạm (*)" rows="4"></textarea>
		    <label class="floating-label text-danger-m3 text-500" for="HanhViViPham">
			    Hành vi vi phạm (*)
		    </label>
	    </span>
    </div>

    <div class="form-group row">
        <div class="col-10 input-floating-label text-danger-d2 brc-danger-m1">
            <input required="" type="text" placeholder="Căn cứ" class="form-control shadow-none" id="QuyDinh" name="QuyDinh" />
            <span class="floating-label text-danger-m3 text-500">
                Quy định tại (*)
            </span>
        </div>
    </div>
</div>

<script type="text/javascript" src="~/Contents/Base/plugins/bootstrap-datetimepicker/js/moment-with-locales.js"></script>
