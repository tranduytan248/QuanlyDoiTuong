@using TSFramework.App.Processors
@model Modules.Major.Areas.Major.Models.ReportModel
<div id="_01BaoCaoChiTietHopDongCongNo">
    <div class="form-group row">
        <div class="col-2 col-form-label text-sm-right pr-0 font-bold mt-1 mr-3">
            <label for="FromDate" class="mb-0">
                Từ ngày
            </label>
        </div>
        <div class="col-4">
            <div class="input-group date">
                <div class="input-group-addon input-group-prepend">
                    <div class="input-group-text">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                </div>
                @Html.TextBox("FromDate", DateTime.Now.ToString("dd/MM/yyyy"), new { @class = "form-control datepicker" })
            </div>
        </div>

        <div class="col-1 col-form-label text-sm-right pr-0 font-bold mt-1 mr-3">
            <label for="ToDate" class="mb-0">
                đến
            </label>
        </div>
        <div class="col-4">
            <div class="input-group date">
                <div class="input-group-addon input-group-prepend">
                    <div class="input-group-text">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                </div>
                @Html.TextBox("ToDate", DateTime.Now.ToString("dd/MM/yyyy"), new { @class = "form-control datepicker" })
            </div>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-2 col-form-label text-sm-right pr-0 font-bold mt-1 mr-3">
            <label for="UnionId" class="mb-0">
                Địa bàn
            </label>
        </div>
        <div class="col-sm-9">
            @Html.SelectFor(model => model.Unions, Model.ListUnions, AppProcessor.Messagor.GetMessage("Union_Title"), new { multiple = true, @class = "form-control col-11", onchange = "_onChangeCombo(this, '#_01BaoCaoChiTietHopDongCongNo #UnionName', true)" })
            @Html.HiddenFor(model => model.UnionName)
        </div>
    </div>
</div>
