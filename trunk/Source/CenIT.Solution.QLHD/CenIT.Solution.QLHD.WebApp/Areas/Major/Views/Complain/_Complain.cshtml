<script>
    // Khóa API từ Google Cloud Platform
    var googleMapsAPIKey = "AIzaSyBSfrxuLaMDEe0Nn5hhqaq0C0eDh7Jzhxk";

    // Địa chỉ mặc định để hiển thị trên bản đồ
    var defaultAddress = "04 Lê Lợi, Xương Huân, Nha Trang, Khánh Hòa 650000, Việt Nam";

    // Biến để lưu trữ tọa độ
    var _Latitude;
    var _Longitude;

    // Biến global để lưu trữ hiển thị tọa độ
    var latitudeDisplay = document.getElementById('latitudeDisplay');
    var longitudeDisplay = document.getElementById('longitudeDisplay');

    // Sự kiện xảy ra khi trang web đã được tải xong
    $(document).ready(function () {
        // Gọi hàm để thiết lập và hiển thị bản đồ
        initializeMap();

        // Lắng nghe sự kiện click trên toàn bộ trang web
        document.addEventListener('click', function (event) {
            var suggestionsContainer = document.getElementById('suggestionsContainer');
            var searchInput = document.getElementById('searchInput');

            // Kiểm tra xem phần tử có tồn tại không
            if (!suggestionsContainer || !searchInput) {
                return;
            }

            // Kiểm tra xem sự kiện click có xảy ra trong input hay phần tử chứa danh sách gợi ý hay không
            var isClickInsideInput = searchInput.contains(event.target);
            var isClickInsideSuggestions = suggestionsContainer.contains(event.target);

            // Nếu không phải là input hoặc phần tử chứa danh sách gợi ý, ẩn danh sách gợi ý
            if (!isClickInsideInput && !isClickInsideSuggestions) {
                hideSuggestions();
            }
        });

        // Hàm để thiết lập và hiển thị bản đồ
        function initializeMap() {
            hideSuggestions();
            // Gọi hàm để lấy tọa độ từ địa chỉ
            getCoordinatesFromAddress(defaultAddress);
        }

        // Hàm để lấy tọa độ từ địa chỉ sử dụng Google Geocoding API
        function getCoordinatesFromAddress(address) {
            // Tạo URL query để gửi lời gọi API
            var queryURL = 'https://maps.googleapis.com/maps/api/geocode/json?key=' + googleMapsAPIKey + '&address=' + address;

            // Gửi lời gọi API sử dụng jQuery
            $.getJSON(queryURL, function (data) {
                // Kiểm tra xem lời gọi API có thành công không
                if (data.status === 'OK') {
                    // Lấy thông tin vị trí từ kết quả API
                    var locationData = data.results[0];
                    var latitude = locationData.geometry.location.lat;
                    var longitude = locationData.geometry.location.lng;

                    // Gọi hàm để hiển thị bản đồ với tọa độ đã lấy được
                    displayMap(latitude, longitude);
                } else {
                    // Hiển thị thông báo nếu có lỗi khi lấy tọa độ
                    console.error('Lỗi khi lấy tọa độ từ địa chỉ: ' + data.status);
                }
            });
        }

        // Hàm để cập nhật tọa độ và hiển thị
        function updateCoordinates(latitude, longitude) {
            // Cập nhật hiển thị tọa độ
            latitudeDisplay.textContent = 'Vĩ độ: ' + latitude;
            longitudeDisplay.textContent = 'Kinh độ: ' + longitude;

            //Cập nhật giá trị tọa độ
            _Latitude = latitude;
            _Longitude = longitude;

            // Cập nhật giá trị tọa độ cho hidden fields
            $('#Latitude').val(latitude);
            $('#Longitude').val(longitude);
        }

        // Hàm để hiển thị bản đồ với tọa độ được cung cấp
        function displayMap(latitude, longitude) {
            // Gọi hàm cập nhật tọa độ và hiển thị
            updateCoordinates(latitude, longitude);

            // Tạo đối tượng bản đồ
            var map = new google.maps.Map(document.getElementById('map_canvas'), {
                zoom: 18,
                center: new google.maps.LatLng(latitude, longitude),
                mapTypeId: google.maps.MapTypeId.ROADMAP
            });

            // Tạo điểm đánh dấu có thể kéo
            var draggableMarker = new google.maps.Marker({
                position: new google.maps.LatLng(latitude, longitude),
                draggable: true
            });

            // Lắng nghe sự kiện khi điểm đánh dấu được kéo
            google.maps.event.addListener(draggableMarker, 'dragend', function (event) {
                var newLatitude = event.latLng.lat();
                var newLongitude = event.latLng.lng();

                // Gọi hàm cập nhật tọa độ và hiển thị
                updateCoordinates(newLatitude, newLongitude);
            });

            // Đặt điểm đánh dấu lên bản đồ
            draggableMarker.setMap(map);

            // Thêm thanh tìm kiếm địa chỉ
            var searchInput = document.getElementById('searchInput');
            var searchBox = new google.maps.places.SearchBox(searchInput);

            // Lắng nghe sự kiện khi người dùng chọn một địa chỉ từ thanh tìm kiếm
            searchBox.addListener('places_changed', function () {
                var places = searchBox.getPlaces();

                if (places.length == 0) {
                    return;
                }

                var newLatitude = places[0].geometry.location.lat();
                var newLongitude = places[0].geometry.location.lng();

                $('#Latitude').val(newLatitude);
                $('#Longitude').val(newLongitude);
                
                map.setCenter(new google.maps.LatLng(newLatitude, newLongitude));
                draggableMarker.setPosition(new google.maps.LatLng(newLatitude, newLongitude));
            });

            // Lắng nghe sự kiện khi người dùng nhập vào trường tìm kiếm
            searchInput.addEventListener('input', function (e) {
                var searchQuery = searchInput.value;

                if (searchQuery.trim() !== '') {
                    getSuggestions(searchQuery);
                } else {
                    hideSuggestions();
                }
            });

            // Lắng nghe sự kiện click của nút tìm kiếm
            document.getElementById('viewOnGoogleMapsBtn').addEventListener('click', function () {
                // Tạo liên kết và mở trong một tab mới
                var googleMapsLink = createGoogleMapsLink(_Latitude, _Longitude);
                window.open(googleMapsLink, '_blank');
            });

            // Lắng nghe sự kiện keydown trên ô tìm kiếm
            searchInput.addEventListener('keydown', function (e) {
                // Kiểm tra nếu phím bấm là "Enter"
                if (e.key === 'Enter') {
                    // Lấy giá trị từ ô tìm kiếm
                    var searchQuery = searchInput.value.trim();

                    // Kiểm tra xem ô tìm kiếm có giá trị không
                    if (searchQuery !== '') {
                        // Gọi hàm để lấy tọa độ từ địa chỉ
                        getCoordinatesFromAddress(searchQuery);

                        // Đồng thời tắt phần gợi ý
                        hideSuggestions();
                    }
                }
            });
        }

        // Hàm để lấy danh sách gợi ý từ Google Places AutocompleteService
        function getSuggestions(query) {
            // Tạo yêu cầu để lấy danh sách gợi ý
            var request = {
                input: query,
                types: ['geocode'],
            };

            // Sử dụng AutocompleteService để lấy danh sách gợi ý
            var service = new google.maps.places.AutocompleteService();
            service.getPlacePredictions(request, function (predictions, status) {
                if (status === google.maps.places.PlacesServiceStatus.OK) {
                    // Hiển thị danh sách gợi ý nếu thành công
                    showSuggestions(predictions);
                } else {
                    // Hiển thị thông báo lỗi nếu có vấn đề
                    console.error('Lỗi khi lấy danh sách gợi ý: ' + status);
                }
            });
        }

        // Hàm để hiển thị danh sách gợi ý
        function showSuggestions(predictions) {
            var suggestionsList = document.getElementById('suggestionsList');

            // Xóa nội dung cũ của danh sách
            suggestionsList.innerHTML = '';

            // Tạo mục gợi ý cho mỗi kết quả
            predictions.forEach(function (prediction) {
                var suggestionItem = document.createElement('li');

                // Giới hạn độ dài của địa chỉ và thêm "..." nếu quá dài
                var displayText = prediction.description.length > 60
                    ? prediction.description.substring(0, 60) + '...'
                    : prediction.description;

                suggestionItem.textContent = displayText;
                suggestionItem.title = prediction.description; // Hiển thị toàn bộ địa chỉ khi di chuột qua

                suggestionItem.className = 'dropdown-item';

                // Lắng nghe sự kiện khi người dùng chọn một gợi ý
                suggestionItem.addEventListener('click', function () {
                    getCoordinatesFromAddress(prediction.description);

                    // Đồng thời tắt phần gợi ý
                    hideSuggestions();

                    // Đặt giá trị cho ô tìm kiếm
                    document.getElementById('searchInput').value = prediction.description;
                });

                // Thêm mục gợi ý vào danh sách
                suggestionsList.appendChild(suggestionItem);
            });

            // Hiển thị container chứa danh sách gợi ý
            var suggestionsContainer = document.getElementById('suggestionsContainer');
            suggestionsContainer.style.display = 'block';
        }

        // Hàm để ẩn danh sách gợi ý
        function hideSuggestions() {
            var suggestionsContainer = document.getElementById('suggestionsContainer');
            suggestionsContainer.style.display = 'none';
        }

        // Hàm để tạo liên kết đến Google Maps
        function createGoogleMapsLink(latitude, longitude) {
            return 'https://www.google.com/maps/search/?api=1&query=' + latitude + ',' + longitude;
        }
    });

</script>