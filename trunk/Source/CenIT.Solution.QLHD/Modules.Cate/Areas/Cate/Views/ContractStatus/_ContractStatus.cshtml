@using TSFramework.App.Processors
@model Cores.Cate.Models.CateContractStatusModel

@Html.AntiForgeryToken()

@Html.HiddenFor(model => model.ContractStatusId)
<div class="form-group row">
    @Html.TitleFor(model => model.ContractStatusCode, new { @class = "col-md-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-7">
        @Html.TextBoxFor(model => model.ContractStatusCode, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("ContractStatus_Label_Code"), @rows = 3 })
        @Html.ValidationMessageFor(model => model.ContractStatusCode, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row">
    @Html.TitleFor(model => model.ContractStatusName, new { @class = "col-md-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-7">
        @Html.TextBoxFor(model => model.ContractStatusName, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("ContractStatus_Label_Name"), @rows = 3 })
        @Html.ValidationMessageFor(model => model.ContractStatusName, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group col-12 row">
    @Html.TitleFor(model => model.IsEContract, new { @class = "col-md-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-1">
        <div class="form-check">
            @Html.CheckBoxFor(model => model.IsEContract, new { @class = "form-check-input", id = "IsEContract" })
            @Html.ValidationMessageFor(model => model.IsEContract, "", new { @class = "text-danger" })
        </div>
        @Html.ValidationMessageFor(model => model.IsEContract, "", new { @class = "text-danger" })
    </div>

    @Html.TitleFor(model => model.EnumId, new { @class = "col-md-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-3">
        @Html.TextBoxFor(model => model.EnumId, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("ContractStatus_Label_Enum")})
        @Html.ValidationMessageFor(model => model.EnumId, "", new { @class = "text-danger" })
    </div>
</div>
