@using TSFramework.App.Processors
@model Cores.Sys.Models.Cate.CateDistrictModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("District_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "District", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "District_OnProcessSuccess(data, 'DeleteDistrict')"
    }, new { @class = "form-horizontal", id = "DeleteDistrict" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.DistrictId)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}