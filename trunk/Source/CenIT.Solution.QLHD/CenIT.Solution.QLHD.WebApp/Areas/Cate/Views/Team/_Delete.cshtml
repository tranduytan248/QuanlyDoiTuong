@using TSFramework.App.Processors
@model Cores.Sys.Models.Cate.CateTeamModel

@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Team_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{
    @using (Ajax.BeginForm("Delete", "Team", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Team_OnProcessSuccess(data, 'DeleteTeam')"
    }, new { @class = "form-horizontal", id = "DeleteTeam" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.TeamId)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}