@using Newtonsoft.Json
@using TSFramework.App.Processors
@model Cores.Major.Models.MajorContractModel
@{
    ViewBag.Title = $"{AppProcessor.Messagor.GetMessage("Contract_Title")} - [{Model.ContractTypeName} - {Model.ContractNoInfo}]";
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    purple
}

@section FormIcon{
    <i class="fas fa-file-contract"></i>
}

@section FormBody{

    <div class="row mt-3">
        <div class="col-12 col-lg-8">
            <div id="ContractContents">
                <div class="alert bgc-primary-l4 brc-primary-m4 align-items-center text-dark-tp2" role="alert">
                    <h5 class="alert-heading text-primary-m1 font-bolder">
                        <i class="fas fa-user-tie mr-1 mb-1"></i>
                        Thông tin khách hàng
                    </h5>
                    <hr class="border-none border-t-3 brc-primary-l2 border-double">
                    <div class="text-110 text-500 text-primary-d1">@Model.CusName</div>
                    <span class="badge badge-lg badge-success radius-4 mb-1">
                        <span class="px-2">@Model.TypeCusName</span>
                    </span>
                    @{
                        if (!Model.CusInfo.IsRepresenter)
                        {
                            <span class="badge badge-lg bgc-danger brc-danger text-white radius-4 mb-1">
                                <span class="px-2">@(Model.CusInfo.Gender == 1 ? AppProcessor.Messagor.GetMessage("Gender_Male") : AppProcessor.Messagor.GetMessage("Gender_Female"))</span>
                            </span>
                        }
                    }
                    @if (Model.CusInfo.TypeCus == "BUSINESS")
                    {
                        <span class="badge badge-info badge-lg arrowed-in-right mb-1">
                            @AppProcessor.Messagor.GetMessage("Customer_TaxCode")
                        </span>
                        <span class="badge btn-pink badge-lg arrowed ml-n1 mb-1">
                            @Model.CusInfo.TaxCode
                        </span>
                    }
                    else
                    {
                        if (!string.IsNullOrEmpty(Model.CusInfo.IdentifierNo))
                        {
                            <span class="badge badge-info badge-lg arrowed-in-right mb-1">
                                @Model.CusInfo.TypeIdentifierName
                            </span>
                            <span class="badge btn-pink badge-lg arrowed ml-n1 mb-1">
                                @Model.CusInfo.IdentifierNo
                            </span>
                        }
                    }

                    <span class="d-inline-block radius-round bgc-default-l2 text-primary-d1 px-25 py-3px mx-2px my-2px text-500">
                        <i class="fa fa-phone text-purple"></i> @Model.CusInfo.Phone
                    </span>
                    <span class="d-inline-block radius-round bgc-default-l2 text-primary-d1 px-25 py-3px mx-2px my-2px text-500">
                        <i class="fa fa-map-marker text-orange-d1"></i> @Model.CusInfo.Address
                    </span>
                </div>

                <div class="alert bgc-warning-l4 brc-warning-m4 align-items-center text-dark-tp2" role="alert">
                    <h5 class="alert-heading text-success-m1 font-bolder">
                        <i class="fas fa-file-contract mr-1 mb-1"></i>Thông tin hợp đồng
                    </h5>
                    <hr class="border-none border-t-3 brc-info-l2 border-double">
                    <span class="d-inline-block radius-round bgc-default-l2 text-primary-d1 px-25 py-3px mx-2px my-2px text-500">
                        <i class="far fa-hand-point-right"></i> @Model.PurposeName
                    </span>
                    <span class="d-inline-block radius-round bgc-default-l2 text-primary-d1 px-25 py-3px mx-2px my-2px text-500">
                        <i class="fa fa-map-marker"></i> @(string.IsNullOrEmpty(Model.LandParcelNo) || string.IsNullOrEmpty(Model.MapNo) ? Model.Address : "Thửa đất số " + Model.LandParcelNo + " thuộc bản đồ số " + Model.MapNo + " - " + Model.Address)
                    </span>
                    <hr class="border-none border-t-3 brc-info-l2 border-double">
                    <div class="p-2 table-responsive-md px-1">
                        <span class="text-primary-d3 text-105 text-500">
                            <i class="fa fa-info mr-1"></i>
                            Chi tiết
                        </span>
                        <hr class="w-100 mx-auto mb-0 brc-default-l2">
                        <table id="ViewContractTasks" class="table table table-striped-default table-borderless bgc-transparent" width="100%">
                            <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                                <tr>
                                    <th class="w-50">@AppProcessor.Messagor.GetMessage("ContractTask_Contents")</th>
                                    <th class="w-50" id="total">@AppProcessor.Messagor.GetMessage("ContractTask_Total")</th>
                                </tr>
                            </thead>
                            <tfoot class="bgc-lightgrey-l3 d-none">
                                <tr class="text-500 text-primary text-105">
                                    <th>@AppProcessor.Messagor.GetMessage("ContractTask_Totals")</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card acard">
                <div class="card-header border-0 py-0">
                    <a href="javascript::void(0)" class="d-flex d-style w-100 align-items-center px-2 py-1 text-grey-d1 text-105 bgc-h-primary-l3 radius-1 no-underline">
                        <span class="d-collapsed">
                            <i class="fas fa-cogs"></i>&nbsp;Cài đặt
                        </span>

                        <span class="d-n-collapsed text-dark-m3 text-600 ">
                            <i class="fas fa-cogs"></i>&nbsp;Cài đặt
                        </span>
                    </a>
                </div>
                <hr class="border-none border-t-3 brc-grey-l2 border-double">
                <div class="card-body py-0 px-25">
                    <div class="col-12">
                        @*<a class="d-style btn btn-white btn-h-lighter-blue btn-a-blue shadow-sm radius-round text-600 letter-spacing px-4 mb-1" href="#">
                                <i class="fas fa-eye mr-2 f-n-hover"></i>
                                Xem trước
                            </a>*@

                        @Html.Button(true, "RenderContract", Url.Action("ShowRender", new { area = "Major", contractId = Model.ContractId, fileType = ".docx" }), "<i class=\"fas fa-eye mr-2 f-n-hover\"></i>", "Xem trước", new { @class = "d-style btn btn-white btn-h-lighter-blue btn-a-blue shadow-sm radius-round text-600 letter-spacing px-4 mb-1", data_width = "fullscreen" })

                    </div>
                    <hr />

                    <div class="col-12 form-row">
                        <label class="col my-auto">
                            <input type="checkbox" class="mr-2" name="IncludeQRCode" onchange="_onCheckQRCode(this, 'a[data-modal-id=\'RenderContract\']');">
                            Thêm QR Code
                        </label>
                        <label class="col">
                            <i class="fas fa-qrcode fa-3x"></i>
                        </label>
                    </div>
                    <hr />

                    <div class="col-12 form-row">
                        <label class="col">
                            <input type="radio" name="FileType" checked="checked" class="mr-1" value=".docx" onchange="_onChangeFileType('.docx', 'a[data-modal-id=\'RenderContract\']')">
                            Word
                        </label>
                        @*<label class="col">
                                <input type="radio" name="FileType" class="mr-1" value=".pdf" onchange="_onChangeFileType('.pdf', 'a[data-modal-id=\'RenderContract\']')">
                                PDF
                            </label>*@
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Contents/Modules/Major/plugins/jquery.masknumber/jquery.masknumber.min.js"></script>
    <script type="text/javascript">

        //debugger

        var typeContract = @(Model.ContractTypeId ?? 1);
        var _tableContractTasks;
        $(document).ready(function () {
            _initTableContractTasks();
        });

        function _initTableContractTasks() {
            _tableContractTasks = $("#ViewContractTasks").DataTable({
                fixedHeader: {
                    header: true,
                    footer: true
                },
                "Responsive": true,
                "language": {
                    "processing":
                        "<div class='overlay'><i class='fas fa-cog fa-spin'></i></div>"
                },
                "order": [[0, 'desc']],
                "lengthChange": true,
                "processing": true,
                "serverSide": false,
                "sortable": false,
                "paging": false, "info": false,
                "columns": [
                    {
                        "data": "Contents",
                        "sortable": false,
                        "defaultContent": "1",
                        "render": function (data, type, row, meta) {
                            if (type == "display") {
                                //var rowIdx = meta.settings._iDisplayStart + meta.row + 1;
                                if (typeContract == 1 || typeContract == 3) {
                                    if (row["Area"] == null) {
                                        return "{0}. {1}".format(row.Ordinal, data);
                                    } else {
                                        if (row["RateFormula"] == null) return "{2}. {0} ({1})".format(data, row["Area"], row.Ordinal);
                                        return "{3}. {0} (KL*ĐG*{1}) - ({2})".format(data, row["RateFormula"], row["Area"], row.Ordinal);
                                    }
                                } else if (typeContract == 2) {
                                    if (row["Area"] == null) {
                                        return "{0}. {1} - <b>{2}</b>".format(row.Ordinal, data, row.SubSectionName);
                                    } else {
                                        if (row["RateFormula"] == null) return "{2}. {0} - <b>{3}</b> ({1})".format(data, row["Area"], row.Ordinal, row.SubSectionName);
                                        return "{3}. {0} - <b>{4}</b> (KL*ĐG*{1}) - ({2})".format(data, row["RateFormula"], row["Area"], row.Ordinal, row.SubSectionName);
                                    }
                                }
                            }
                            return data;
                        }
                    },
                    {
                        "data": "Total",
                        "sortable": false,
                        "defaultContent": "",
                        "render": function (data, type, row, meta) {
                            if (type === "display") {
                                return '<span class="d-inline-block radius-round bgc-default-l2 text-primary-d2 text-500 px-25 py-3px mx-2px my-2px">{0}</span>'.format("{0} x {1} ({2}) * {3} = {4}".format(VND.format(row["Price"]), row["Amount"], row["Unit"], row["Rate"].toLocaleString(undefined, { style: 'percent', minimumFractionDigits: 0 }), VND.format(data)));
                            }
                            return data;
                        }
                    },
                ],
                "footerCallback": function (row, data, start, end, display) {
                    var api = this.api();

                    api.columns('#total', {
                        page: 'current'
                    }).every(function () {
                        var sum = this
                            .data()
                            .reduce(function (a, b) {
                                var x = parseFloat(a) || 0;
                                var y = parseFloat(b) || 0;
                                return x + y;
                            }, 0);
                        //var totalAmount = Math.round(sum);

                        var totalAmount = Math.round(sum / 1000) * 1000;
                        $(this.footer()).html(VND.format(totalAmount));
                    });
                }
            });

            _tableContractTasks.on('draw', function () {
                var btnSubmit = $('#ContractInfo').parents('.modal-content').find('button[type="submit"]')[0];
                var tblFooter = _tableContractTasks.footer();

                if (_tableContractTasks.data().count() > 0) {
                    $(btnSubmit).removeClass('disabled');
                    $(tblFooter).removeClass('d-none');
                } else {
                    if (!$(btnSubmit).hasClass('disabled')) {
                        $(btnSubmit).addClass('disabled');
                    }

                    if (!$(tblFooter).hasClass('d-none')) {
                        $(tblFooter).addClass('d-none');
                    }
                }
            });

            var dataTasks = JSON.parse('@Html.Raw(JsonConvert.SerializeObject(Model.ListTasks))');
            if (typeof dataTasks != null) {
                _tableContractTasks.clear().rows.add(dataTasks).draw();
                //_tableContractTasks.column(0).data().sort();
            }
        }

        function _onCheckQRCode(chk, btnRenderContract) {
            var urlRenderContract = "@Html.Raw(Url.Action("ShowRender", new { area = "Major", contractId = Model.ContractId }))";
            if ($(chk).is(":checked")) {
                urlRenderContract += "&includeQRCode=true"
            }
            var fileType = $('[name="FileType"]:checked').val();
            urlRenderContract += "&fileType=" + fileType

            $(btnRenderContract).attr("href", urlRenderContract);
        }

        function _onChangeFileType(fileType, btnRenderContract) {
            var urlRenderContract = "@Html.Raw(Url.Action("ShowRender", new { area = "Major", contractId = Model.ContractId }))";
            if ($('[name="IncludeQRCode"]').is(":checked")) {
                urlRenderContract += "&includeQRCode=true";
            }
            urlRenderContract += "&fileType=" + fileType

            $(btnRenderContract).attr("href", urlRenderContract);
        }

    </script>
}

@section SubmitControl{

}