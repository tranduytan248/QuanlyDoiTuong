@using TSFramework.App.Processors
@model Cores.Cate.Models.CatePositionModel

@Html.AntiForgeryToken()

@Html.HiddenFor(model => model.PositionID)
<div class="form-group row">
    @Html.TitleFor(model => model.PositionCode, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-4">
        @Html.TextBoxFor(model => model.PositionCode, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Position_Label_Code"), @rows = 3 })
        @Html.ValidationMessageFor(model => model.PositionCode, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row">
    @Html.TitleFor(model => model.PositionName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-6">
        @Html.TextBoxFor(model => model.PositionName, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Position_Label_Name"), @rows = 3 })
        @Html.ValidationMessageFor(model => model.PositionName, "", new { @class = "text-danger" })
    </div>
</div>