@using TSFramework.App.Processors
@model Cores.Sys.Models.Cate.CateStreetModel

@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.StreetId)
@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<div class="form-group row">
    @Html.TitleFor(model => model.ProvinceId, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-8">
        @Html.DropDownListFor(model => model.ProvinceId, new SelectList(Model.Provinces, "Value", "Text"), "", new { @class = "form-control col-md-10", onchange = "OnChangeProvince(this, $('select#DistrictId'))" })
        @Html.ValidationMessageFor(model => model.ProvinceId, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row">
    @Html.TitleFor(model => model.DistrictId, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-8">
        @Html.DropDownListFor(model => model.DistrictId, new SelectList(Model.Districts, "Value", "Text"), "", new { @class = "form-control col-md-10", onchange = "OnChangeDistrict(this, $('select#SelectedWardIds'))" })
        @Html.ValidationMessageFor(model => model.DistrictId, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group row">
    @Html.TitleFor(model => model.SelectedWardIds, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-8">
        @Html.DropDownListFor(model => model.SelectedWardIds, new SelectList(Model.Wards, "Value", "Text"), "", new { multiple = true, @class = "form-control col-md-10" })
        @Html.ValidationMessageFor(model => model.SelectedWardIds, "", new { @class = "text-danger" })
    </div>
</div>

@{
    if (Model.StreetId > 0)
    {
        <div class="form-group row">
            @Html.TitleFor(model => model.StreetCode, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
            <div class="col-md-8">
                @Html.TextBoxFor(model => model.StreetCode, new { @class = "form-control col-md-5", @readonly = "readonly" })
            </div>
        </div>
    }
}
<div class="form-group row">
    @Html.TitleFor(model => model.StreetName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-8">
        @Html.TextBoxFor(model => model.StreetName, new { @class = "form-control col-md-10", placeholder = AppProcessor.Messagor.GetMessage("Street_Label_Name") })
        @Html.ValidationMessageFor(model => model.StreetName, "", new { @class = "text-danger" })
    </div>
</div>

<script type="text/javascript">

    function OnChangeProvince(cbbProvince, cbbDistrict) {
        if ($("#ProvinceName").length > 0) {
            $("#ProvinceName").val($(cbbProvince).children("option:selected").text());
        }

        var selectedProvince = $(cbbProvince).val();
        var urlDistrictsViaProvince =
            "@Url.Action("GetDistrictsBelongProvince", "Ajax", new { area = "Cate" })?provinceIds=" + selectedProvince;
        $.ajax({
            type: "GET",
            url: urlDistrictsViaProvince,
            dataType: "JSON",
            success: function(response) {
                $(cbbDistrict).empty();
                $(cbbDistrict).append('<option value=""></option>');

                $.each(response.Districts,
                    function(index, item) {
                        $(cbbDistrict).append('<optgroup label="' + index + '">');
                        $.each(item,
                            function(idx, district) {
                                $(cbbDistrict).append('<option value="' + district.DistrictId + '">' + district.DistrictName + "</option>");
                            });
                        $(cbbDistrict).append('</optgroup>');
                    });
            }
        });
    }

    function OnChangeDistrict(cbbDistrict, cbbWard) {
        if ($("#DistrictName").length > 0) {
            $("#DistrictName").val($(cbbDistrict).children("option:selected").text());
        }

        var selectedDistrict = $(cbbDistrict).val();
        var urlWardsViaDistrict =
            "@Url.Action("GetWardsBelongDistrict", "Ajax", new { area = "Cate" })?districtIds=" + selectedDistrict;
        $.ajax({
            type: "GET",
            url: urlWardsViaDistrict,
            dataType: "JSON",
            success: function(response) {
                $(cbbWard).empty();
                $(cbbWard).append('<option value=""></option>');

                $.each(response.Wards,
                    function(index, item) {
                        $(cbbWard).append('<optgroup label="' + index + '">');
                        $.each(item,
                            function(idx, ward) {
                                $(cbbWard).append('<option value="' + ward.WardId + '">' + ward.WardName + "</option>");
                            });
                        $(cbbWard).append('</optgroup>');
                    });
            }
        });
    }

    $(document).ready(function() {
        var selectedValues = '@string.Join(",", Model.SelectedWardIds)';
        $('select#SelectedWardIds').val(selectedValues.split(","));
    });

</script>