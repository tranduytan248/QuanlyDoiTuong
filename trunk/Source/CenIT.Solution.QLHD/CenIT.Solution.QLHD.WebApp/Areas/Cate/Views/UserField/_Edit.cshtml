@model Cores.Cate.Models.CateUserFieldModel
@{
    ViewBag.Title = "Phân quyền lĩnh vực";
    Layout = "~/Views/Shared/_Form.cshtml";
}
@section FormType{ primary }
@section FormIcon{ <i class="fa fa-layer-group"></i> }
@section FormBody{
    @using (Ajax.BeginForm("Edit", "UserField", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "UserField_OnProcessSuccess(data, 'EditUserField')"
    }, new { @class = "form-horizontal", id = "EditUserField" }))
    {
        <div id="bodyForm">@Html.Partial("_UserField", Model)</div>
    }

    <script>
        /* Ham xu ly ket qua sau khi luu.
           Dinh nghia ngay trong modal de hoat dong duoc du modal duoc mo tu bat
           ky man hinh nao - khong phu thuoc trang cha da nap file .js hay chua. */
        if (typeof UserField_OnProcessSuccess !== "function") {
            window.UserField_OnProcessSuccess = function (response, formId) {
                if (response.status === undefined) {
                    $("#ModalContent #modal_" + formId + " #bodyForm").html(response);
                    return;
                }

                $("#ModalContent #modal_" + formId).modal("hide");
                $("#ModalContent #modal_" + formId).on("hidden.bs.modal", function () {
                    if (response.status === undefined) return;
                    if (response.message) { eval(response.message); }

                    /* Lam moi bang du lieu cua man hinh dang mo, neu co */
                    if (typeof _tableUserField !== "undefined" && _tableUserField) { _tableUserField.ajax.reload(null, false); }
                    if (typeof _tableSubject !== "undefined" && _tableSubject) { _tableSubject.ajax.reload(null, false); }
                    if (typeof _tableUserField !== "undefined" && _tableUserField) { _tableUserField.ajax.reload(null, false); }

                    response.status = undefined;
                });
            };
        }
    </script>
}
