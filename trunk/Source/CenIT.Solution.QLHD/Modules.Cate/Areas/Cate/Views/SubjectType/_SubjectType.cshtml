﻿@using TSFramework.App.Processors
@model Cores.Cate.Models.CateSubjectTypeModel

@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.SubjectTypeId)

<div class="form-group row">
    <div class="col-md-4">
        <label class="col-form-label pr-0 font-bold">Mã loại đối tượng <span class="text-danger">(*)</span></label>
        @Html.TextBoxFor(model => model.SubjectTypeCode, new { @class = "form-control", placeholder = "Ví dụ: SDMT, MBD, TROM_CAP..." })
        @Html.ValidationMessageFor(model => model.SubjectTypeCode, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-8">
        <label class="col-form-label pr-0 font-bold">Tên loại đối tượng <span class="text-danger">(*)</span></label>
        @Html.TextBoxFor(model => model.SubjectTypeName, new { @class = "form-control", placeholder = "Ví dụ: Sử dụng ma túy, Mua bán dâm..." })
        @Html.ValidationMessageFor(model => model.SubjectTypeName, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group row">
    <div class="col-md-9">
        <label class="col-form-label pr-0 font-bold">Mô tả / Ghi chú</label>
        @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = "3", placeholder = "Nhập mô tả chi tiết loại đối tượng..." })
        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-3">
        <label class="col-form-label pr-0 font-bold">Thứ tự hiển thị</label>
        @Html.TextBoxFor(model => model.SortOrder, new { @class = "form-control", type = "number", min = "0", placeholder = "0" })
        @Html.ValidationMessageFor(model => model.SortOrder, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group row">
    <div class="col-md-12">
        <div class="custom-control custom-checkbox">
            @Html.CheckBoxFor(model => model.IsActive, new { @class = "custom-control-input", id = "SubjectType_IsActive" })
            <label class="custom-control-label font-bold" for="SubjectType_IsActive">Đang hoạt động</label>
        </div>
    </div>
</div>
