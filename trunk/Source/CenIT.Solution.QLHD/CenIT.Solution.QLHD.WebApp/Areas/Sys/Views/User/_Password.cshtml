@using TSFramework.App.Processors
@model Modules.Sys.Areas.Sys.Models.ChangePasswordModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@*@Html.HiddenFor(model => model.FullName)*@
@*@Html.HiddenFor(model => model.Email)*@
@*@Html.HiddenFor(model => model.UserName)*@
<div id="User">
    <div class="form-group row">
        <div class="col-md-12">
        @Html.TitleFor(model => model.FullName, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="far fa-user-circle"></i>
                    </span>
                </div>
                @Html.TextBoxFor(model => model.FullName, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("User_Current_FullName"), @readonly = true })
            </div>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-5">
        @Html.TitleFor(model => model.UserName, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="far fa-user"></i>
                    </span>
                </div>
                @Html.TextBoxFor(model => model.UserName, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("User_Current_UserName"), @readonly = true })
            </div>
        </div>
        <div class="col-md-7">
        @Html.TitleFor(model => model.Email, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fa fa-envelope"></i>
                    </span>
                </div>
                @Html.TextBoxFor(model => model.Email, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("User_Current_Email"), @readonly = true })
            </div>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-6">
        @Html.TitleFor(model => model.NewPassword, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fa fa-key"></i>
                    </span>
                </div>
                <div class="d-inline-flex align-items-center col-md-10 p-0">
                    @Html.TextBoxFor(model => model.NewPassword, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Authorize_New_Password"), type = "password" })
                    <a href="javascript:void(0);" onclick="_showPassword($('#NewPassword'));" class="btn btn-sm border-0 btn-white btn-h-light-orange btn-a-light-orange ml-n5 no-underline radius-1 d-style">
                        <i class="fa fa-eye-slash d-n-active w-3"></i>
                        <i class="fa fa-eye d-active w-3"></i>
                    </a>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6">
        @Html.TitleFor(model => model.ConfirmPassword, new { @class = "col-form-label pr-0 font-bold" })
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fa fa-key"></i>
                    </span>
                </div>
                <div class="d-inline-flex align-items-center col-md-10 p-0">
                    @Html.TextBoxFor(model => model.ConfirmPassword, new { @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("User_Label_ConfirmPassword"), type = "password" })
                    <a href="javascript:void(0);" onclick="_showPassword($('#ConfirmPassword'));" class="btn btn-sm border-0 btn-white btn-h-light-orange btn-a-light-orange ml-n5 no-underline radius-1 d-style">
                        <i class="fa fa-eye-slash d-n-active w-3"></i>
                        <i class="fa fa-eye d-active w-3"></i>
                    </a>
                </div>
            </div>

            @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-12">
            @Html.TitleFor(model => model.Reason, new { @class = "col-form-label pr-0 font-bold" })
            @Html.TextAreaFor(model => model.Reason, new { rows = "2", @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("Reason_Label") })
            @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
        </div>
    </div>
</div>