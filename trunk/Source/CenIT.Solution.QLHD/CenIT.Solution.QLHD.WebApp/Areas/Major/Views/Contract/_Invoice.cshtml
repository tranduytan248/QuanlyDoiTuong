@using HtmlAgilityPack
@model Modules.Major.Areas.Major.Models.PublishInvModel


<div id="Invoice">
    @Html.HiddenFor(model => model.ContractId)

    <div class="card-body p-0">
        <div class="row col-12 px-0 mx-auto">
            @{
                var htmlDoc = new HtmlDocument();
                var html = Html.RenderXml(Model.DataInvHtmlView, Model.TemplateInvViewPath);

                htmlDoc.LoadHtml(html.ToHtmlString());
                @*@Html.Raw(htmlDoc.DocumentNode.OuterHtml)*@
            }
            <iframe width="100%" style="height:calc(100vh - 225px);" srcdoc="@htmlDoc.DocumentNode.OuterHtml">
            </iframe>
        </div>
    </div>
</div>
