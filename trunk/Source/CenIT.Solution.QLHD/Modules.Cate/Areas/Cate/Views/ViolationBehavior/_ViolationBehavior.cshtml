@using TSFramework.App.Processors
@using Cores.Cate.Models
@model Cores.Cate.Models.CateViolationBehaviorModel
@{
    var listFields = ViewBag.ListFields as List<CateFieldModel> ?? new List<CateFieldModel>();
}

@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.BehaviorId)

<div class="form-group row">
    <div class="col-md-6">
        <label class="col-form-label pr-0 font-bold">Thuộc Lĩnh vực <span class="text-danger">(*)</span></label>
        <select class="form-control" id="FieldId" name="FieldId">
            <option value="">-- Chọn lĩnh vực --</option>
            @foreach (var f in listFields)
            {
                <option value="@f.FieldId" @(Model != null && Model.FieldId == f.FieldId ? "selected" : "")>[@f.FieldCode] @f.FieldName</option>
            }
        </select>
        @Html.ValidationMessageFor(model => model.FieldId, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-6">
        <label class="col-form-label pr-0 font-bold">Mã hành vi <span class="text-danger">(*)</span></label>
        @Html.TextBoxFor(model => model.BehaviorCode, new { @class = "form-control", placeholder = "Nhập mã hành vi vi phạm..." })
        @Html.ValidationMessageFor(model => model.BehaviorCode, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group row">
    <div class="col-md-12">
        <label class="col-form-label pr-0 font-bold">Tên hành vi vi phạm <span class="text-danger">(*)</span></label>
        @Html.TextAreaFor(model => model.BehaviorName, new { @class = "form-control", rows = "2", placeholder = "Nhập tên hành vi vi phạm..." })
        @Html.ValidationMessageFor(model => model.BehaviorName, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group row">
    <div class="col-md-12">
        <label class="col-form-label pr-0 font-bold">Ghi chú / Mô tả</label>
        @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = "3", placeholder = "Nhập mô tả chi tiết..." })
        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group row">
    <div class="col-md-12">
        <div class="custom-control custom-checkbox">
            @Html.CheckBoxFor(model => model.IsActive, new { @class = "custom-control-input", id = "Behavior_IsActive" })
            <label class="custom-control-label font-bold" for="Behavior_IsActive">Đang hoạt động</label>
        </div>
    </div>
</div>
