@using TSFramework.App.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("cateImplementContent_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{


    @using (Html.BeginForm("Add", "ImplementContent", new { area = "Cate" }, FormMethod.Post, new { encType = "multipart/form-data", id = "AddImplementContent", @class = "form-horizontal" }))
    {
        <div id="bodyForm">
            @Html.Partial("_ImplementContent")
        </div>
    }

    <script type="text/javascript">

 $('form#AddImplementContent').ajaxForm({
     success: function (response) {
         if (response.status != undefined) {
             if ($("#ModalContent #modal_AddImplementContent #chkNotDismissModal").is(":checked")) {
                 if (response.status != undefined) {
                     eval(response.message);
                     _tableImplementContent.ajax.reload(null, false);
                     response.status = undefined;
                     $("#ModalContent #modal_AddImplementContent form")[0].reset();
                 }
             } else {
                 if (!response.status && response.errorCode == 1) {
                     eval(response.message);
                     response.status = undefined;
                 } else {
                     $("#ModalContent #modal_AddImplementContent").modal("hide");
                     $("#ModalContent #modal_AddImplementContent").on('hidden.bs.modal',
                         function () {
                             if (response.status != undefined) {
                                 eval(response.message);
                                 _tableImplementContent.ajax.reload(null, true);
                                 response.status = undefined;
                             }
                         });
                     location.reload();
                 }
             }
         } else {
             $("#ModalContent #modal_AddImplementContent" + " #bodyForm").html(response);
         }
     }
 });
    </script>
}