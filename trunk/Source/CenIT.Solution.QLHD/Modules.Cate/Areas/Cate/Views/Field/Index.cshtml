@using TSFramework.App.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Field_Title") ?? "Danh mục Lĩnh vực";
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
    @Html.Button(true, "AddField", Url.Action("Add", new { area = "Cate" }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add") ?? "Thêm mới", new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right", data_width = "860px" })
}

@Html.Partial("_Search")

<div class="mt-3">
    <div class="card dcard">
        <div class="p-2 table-responsive-md">
            <table id="DSField" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="text-center" style="width:50px;">STT</th>
                        <th style="width:150px;">Mã lĩnh vực</th>
                        <th>Tên lĩnh vực</th>
                        <th>Ghi chú / Mô tả</th>
                        <th class="text-center" style="width:100px;">Trạng thái</th>
                        <th class="text-center" style="width:120px;">Thao tác</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="~/Areas/Cate/Views/Field/Field.js"></script>
}
