@using TSFramework.App.Processors
@model Modules.Cate.Areas.Cate.Models.SearchHolidayModel
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Holiday_Title");
}

@section PageTitle
{
    @ViewBag.Title
}
@section PageAction
{
    @Html.Button(true, "AddHoliday", Url.Action("Add", new { area = "Cate" }), "<i class='fa fa-plus'></i>", AppProcessor.Messagor.GetMessage("Button_Add"), new { @class = "btn btn-light-blue btn-h-blue btn-a-blue border-0 radius-3 py-2 text-600 text-90 pull-right" })
}
<div class="mt-3">
    @Html.Partial("_Search")
</div>

<div class="mt-3">
    <div class="card dcard">
        <div class="p-2 table-responsive-md">
            <table id="DSHoliday" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th class="nls-w">@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Holiday_Label_LunarCalendar")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Holiday_Label_Date")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Holiday_Label_HolidayName")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Holiday_Label_IsPermanent")</th>
                        <th class="nls-w">@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="~/Areas/Cate/Views/Holiday/Holiday.js"></script>
}