@using TSFramework.App.Processors
@*@model Cores.Cate.Models.CateDistrictModel*@
@model Cores.Sys.Models.Cate.CateDistrictModel
@Html.AntiForgeryToken()
@Html.HiddenFor(model => model.DistrictId)
@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@{
    if (Model.DistrictId > 0)
    {
        <div class="form-group row">
            @Html.TitleFor(model => model.ProvinceId, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
            <div class="col-md-8">
                @Html.DropDownListFor(model => model.ProvinceId, new SelectList(Model.Provinces, "Value", "Text"), new { @class = "form-control col-sm-8" })
                @Html.HiddenFor(model => model.ProvinceId)
            </div>
        </div>
    }
    else
    {
        <div class="form-group row">
            @Html.TitleFor(model => model.ProvinceId, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
            <div class="col-md-8">
                @Html.DropDownListFor(model => model.ProvinceId, new SelectList(Model.Provinces, "Value", "Text"), new { @class = "form-control col-sm-8" })
                @Html.HiddenFor(model => model.ProvinceId)
                @Html.ValidationMessageFor(model => model.ProvinceId, "", new { @class = "text-danger" })
            </div>
        </div>
    }
}
@{
    if (Model.DistrictId > 0)
    {
        <div class="form-group row">
            @Html.TitleFor(model => model.DistrictCode, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
            <div class="col-md-8">
                @Html.TextBoxFor(model => model.DistrictCode, new { @class = "form-control col-sm-7", @readonly = "readonly" })

            </div>
        </div>
    }
    @*else
        {
            <div class="form-group row hidden">
                @Html.TitleFor(model => model.DistrictCode, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.DistrictCode, new { @class = "form-control col-sm-7" })

                </div>
            </div>
        }*@
}
<div class="form-group row">
    @Html.TitleFor(model => model.DistrictName, new { @class = "col-sm-3 col-form-label text-sm-right pr-0 font-bold" })
    <div class="col-md-8">
        @Html.TextBoxFor(model => model.DistrictName, new { @class = "form-control col-sm-8", placeholder = AppProcessor.Messagor.GetMessage("District_Label_Name") })
        @Html.ValidationMessageFor(model => model.DistrictName, "", new { @class = "text-danger" })
    </div>
</div>