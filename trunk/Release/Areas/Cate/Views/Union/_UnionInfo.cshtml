
@using Cores.eContract.Consts
@using TSFramework.App.Processors
@model Cores.Cate.Models.CateUnionModel

<div id="UnionInfo">
    @Html.HiddenFor(model => model.UnionId)

    <div class="form-group row">
        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="EnterpriseName"><span class="text-danger">Tên đơn vị(*)</span></label>
        <div class="col-md-9">
            <input class="form-control col-md-12" data-val="true" data-val-required="Dữ liệu [Tên đơn vị] bắt buộc nhập" id="EnterpriseName" name="EnterpriseName" placeholder="Tên đơn vị" readonly="true" type="text" value="@Model.UnionName">
            <span class="field-validation-valid text-danger" data-valmsg-for="EnterpriseName" data-valmsg-replace="true"></span>
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="EnterpriseNameUpperCase"><span class="text-danger">Tên viết hoa(*)</span></label>
        <div class="col-md-9">
            <input class="form-control col-md-12" data-val="true" data-val-required="Dữ liệu [Tên viết hoa] bắt buộc nhập" id="EnterpriseNameUpperCase" name="EnterpriseNameUpperCase" placeholder="Tên đơn vị" readonly="true" type="text" value="@Model.UnionName.ToUpper()">
            <span class="field-validation-valid text-danger" data-valmsg-for="EnterpriseNameUpperCase" data-valmsg-replace="true"></span>
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="TaxCode"><span class="text-danger">Mã số thuế (*)</span></label>
        <div class="col-md-3">
            <input class="form-control col-md-12" data-val="true" data-val-requiredif="Dữ liệu [Mã số thuế] bắt buộc nhập" id="TaxCode" name="TaxCode" placeholder="Mã số thuế" type="text" value="">
            <span class="field-validation-valid text-danger" data-valmsg-for="TaxCode" data-valmsg-replace="true"></span>
        </div>
        <label class="col-sm-2 col-form-label text-sm-right pr-0 font-bold" for="Phone"><span class="text-danger">Điện thoại (*)</span></label>
        <div class="col-md-4">
            <input class="form-control col-md-12" id="Phone" name="Phone" data-val="true" data-val-required="Dữ liệu [Số điện thoại] bắt buộc nhập" placeholder="Điện thoại" type="text" value="">
            <span class="field-validation-valid text-danger" data-valmsg-for="Phone" data-valmsg-replace="true"></span>
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="EnterpriseAddress"><span class="text-danger">Email (*)</span></label>
        <div class="col-md-6">
            <input class="form-control col-md-12" id="Email" name="Email" data-val="true" data-val-required="Dữ liệu [Email] bắt buộc nhập" placeholder="Email" type="text" value="">
            <span class="field-validation-valid text-danger" data-valmsg-for="Email" data-valmsg-replace="true"></span>
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="BankAccountNo"><span class="text-danger">Số TK ngân hàng (*)</span></label>
        <div class="col-md-6">
            <input class="form-control col-md-12" data-val="true" data-val-requiredif="Dữ liệu [Số TK ngân hàng] bắt buộc nhập" id="BankAccountNo" name="BankAccountNo" placeholder="Số TK ngân hàng" type="text" value="">
            <span class="field-validation-valid text-danger" data-valmsg-for="BankAccountNo" data-valmsg-replace="true"></span>
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="BankName"><span class="text-danger">Tại ngân hàng (*)</span></label>
        <div class="col-md-9">
            <input class="form-control col-md-11" id="BankName" name="BankName" placeholder="Tên ngân hàng" type="text" value="">
            <span class="field-validation-valid text-danger" data-valmsg-for="BankName" data-valmsg-replace="true"></span>
        </div>
    </div>
    <div class="form-group row">
        <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="EnterpriseAddress"><span class="text-danger">Địa chỉ trụ sở (*)</span></label>
        <div class="col-md-9">
            <textarea class="form-control col-md-11" cols="20" data-val="true" data-val-required="Dữ liệu [Địa chỉ trụ sở] bắt buộc nhập" id="EnterpriseAddress" name="EnterpriseAddress" placeholder="Địa chỉ trụ sở" rows="3"></textarea>
            <span class="field-validation-valid text-danger" data-valmsg-for="EnterpriseAddress" data-valmsg-replace="true"></span>
        </div>
    </div>

    <hr class="border-none border-t-3 brc-grey-l2 border-double">
    <div class="ccard h-100 d-flex flex-column">
        <div class="card-header bg-transparent">
            <h5 class="card-title">
                <i class="fas fa-user-friends text-blue opacity-1"></i>&nbsp;Người đại diện
            </h5>
        </div>
        <div class="card-body">
            <div class="card-body p-0">
                <ul class="w-100 nav nav-tabs nav-tabs-simple bgc-green-d2 radius-t-1 pt-2 pl-2" role="tablist">
                    <li class="nav-item mr-3px">
                        <a class="active btn btn-brc-tp btn-outline-white btn-h-light-green btn-h-text-dark btn-a-text-green btn-a-white px-3 px-lg-4 py-25 border-0 radius-b-0" id="consumer-tab-btn" data-toggle="tab" href="#consumer" role="tab" aria-controls="consumer" aria-selected="true">
                            <i class="fas fa-user text-105 mr-3px"></i>&nbsp;@($"{AppProcessor.Messagor.GetMessage("Customer_Title")} {AppProcessor.Messagor.GetMessage("CusType_Consumer")}")
                        </a>
                    </li>

                    <li class="nav-item mr-3px">
                        <a class="btn btn-brc-tp btn-outline-white btn-h-light-green btn-h-text-dark btn-a-text-green btn-a-white px-3 px-lg-4 py-25 border-0 radius-b-0" id="business-tab-btn" data-toggle="tab" href="#business" role="tab" aria-controls="business" aria-selected="false">
                            <i class="fas fa-user-tie text-105 mr-3px"></i>&nbsp;@($"{AppProcessor.Messagor.GetMessage("Customer_Title")} {AppProcessor.Messagor.GetMessage("CusType_Business")}")
                        </a>
                    </li>
                </ul>

                <div class="tab-content tab-sliding px-1 px-md-3 text-grey-d3 border-1 border-t-0 radius-b-1 brc-secondary-l2">
                    <div class="tab-pane show active p-2" id="consumer" role="tabpanel" aria-labelledby="consumer-tab-btn">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="@(ConstsCusType.CONSUMER).RepresenterName"><span class="text-danger">Tên (*)</span></label>
                            <div class="col-md-9">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="@(ConstsCusType.CONSUMER).ViewAlias">Ông</span>
                                    </div>
                                    <input class="form-control col-md-11" data-val="true" data-val-requiredif="Dữ liệu [Tên] bắt buộc nhập" id="@(ConstsCusType.CONSUMER).RepresenterName" name="@(ConstsCusType.CONSUMER).RepresenterName" placeholder="Tên" type="text" value="">
                                </div>
                                <span class="field-validation-valid text-danger" data-valmsg-for="@(ConstsCusType.CONSUMER).RepresenterName" data-valmsg-replace="true"></span>
                            </div>
                            <input type="hidden" name="@(ConstsCusType.CONSUMER).RepresenterAlias" />
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="@(ConstsCusType.CONSUMER).RepresenterGender">Giới tính</label>
                            <div class="col-md-9">
                                <label class="px-0 pt-2">
                                    <input checked="checked" data-val="true" id="@(ConstsCusType.CONSUMER).RepresenterGender" name="@(ConstsCusType.CONSUMER).RepresenterGender" type="radio" value="1" onchange="_onChangeGender('#UnionInfo [name=\'@(ConstsCusType.CONSUMER).RepresenterAlias\']','#UnionInfo [id=\'@(ConstsCusType.CONSUMER).ViewAlias\']','Ông')">
                                    <span class="badge bgc-danger brc-danger text-white badge-lg arrowed arrowed-in-right mb-1">
                                        <span class="px-3">@AppProcessor.Messagor.GetMessage("Gender_Male")</span>
                                    </span>
                                </label>
                                <label class="px-0 pt-2">
                                    <input id="@(ConstsCusType.CONSUMER).RepresenterGender" name="@(ConstsCusType.CONSUMER).RepresenterGender" type="radio" value="0" onchange="_onChangeGender('#UnionInfo [name=\'@(ConstsCusType.CONSUMER).RepresenterAlias\']','#UnionInfo [id=\'@(ConstsCusType.CONSUMER).ViewAlias\']','Bà')">
                                    <span class="badge bgc-purple brc-purple text-white badge-lg arrowed arrowed-in-right mb-1">
                                        <span class="px-3">@AppProcessor.Messagor.GetMessage("Gender_Female")</span>
                                    </span>
                                </label>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="@(ConstsCusType.CONSUMER).RepresenterTitle"><span class="text-danger">Chức vụ (*)</span></label>
                            <div class="col-md-9">
                                <input class="form-control col-md-9" data-val="true" data-val-requiredif="Dữ liệu [Chức vụ] bắt buộc nhập" id="RepresenterTitle" name="@(ConstsCusType.CONSUMER).RepresenterTitle" placeholder="Chức vụ" type="text" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="@(ConstsCusType.CONSUMER).RepresenterTitle" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane p-2" id="business" role="tabpanel" aria-labelledby="business-tab-btn">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="@(ConstsCusType.BUSINESS).RepresenterName"><span class="text-danger">Tên (*)</span></label>
                            <div class="col-md-9">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text" id="ViewAlias">Ông</span>
                                    </div>
                                    <input class="form-control col-md-11" data-val="true" data-val-requiredif="Dữ liệu [Tên] bắt buộc nhập" id="@(ConstsCusType.BUSINESS).RepresenterName" name="@(ConstsCusType.BUSINESS).RepresenterName" placeholder="Tên" type="text" value="">
                                </div>
                                <span class="field-validation-valid text-danger" data-valmsg-for="@(ConstsCusType.BUSINESS).RepresenterName" data-valmsg-replace="true"></span>
                            </div>
                            <input type="hidden" name="@(ConstsCusType.BUSINESS).RepresenterAlias" />
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="@(ConstsCusType.BUSINESS).RepresenterGender">Giới tính</label>
                            <div class="col-md-9">
                                <label class="px-0 pt-2">
                                    <input checked="checked" data-val="true" id="@(ConstsCusType.BUSINESS).RepresenterGender" name="@(ConstsCusType.BUSINESS).RepresenterGender" type="radio" value="1" onchange="_onChangeGender('#UnionInfo [name=\'@(ConstsCusType.BUSINESS).RepresenterAlias\']','#UnionInfo [id=\'@(ConstsCusType.BUSINESS).ViewAlias\']','Ông')">
                                    <span class="badge bgc-danger brc-danger text-white badge-lg arrowed arrowed-in-right mb-1">
                                        <span class="px-3">@AppProcessor.Messagor.GetMessage("Gender_Male")</span>
                                    </span>
                                </label>
                                <label class="px-0 pt-2">
                                    <input id="@(ConstsCusType.BUSINESS).RepresenterGender" name="@(ConstsCusType.BUSINESS).RepresenterGender" type="radio" value="0" onchange="_onChangeGender('#UnionInfo [name=\'@(ConstsCusType.BUSINESS).RepresenterAlias\']','#UnionInfo [id=\'@(ConstsCusType.BUSINESS).ViewAlias\']','Bà')">
                                    <span class="badge bgc-purple brc-purple text-white badge-lg arrowed arrowed-in-right mb-1">
                                        <span class="px-3">@AppProcessor.Messagor.GetMessage("Gender_Female")</span>
                                    </span>
                                </label>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label text-sm-right pr-0 font-bold" for="@(ConstsCusType.BUSINESS)RepresenterTitle"><span class="text-danger">Chức vụ (*)</span></label>
                            <div class="col-md-9">
                                <input class="form-control col-md-9" data-val="true" data-val-requiredif="Dữ liệu [Chức vụ] bắt buộc nhập" id="@(ConstsCusType.BUSINESS).RepresenterTitle" name="@(ConstsCusType.BUSINESS).RepresenterTitle" placeholder="Chức vụ" type="text" value="">
                                <span class="field-validation-valid text-danger" data-valmsg-for="@(ConstsCusType.BUSINESS).RepresenterTitle" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div><!-- /.card -->

    </div>
</div>

<script type="text/javascript">

    $(document).ready(function () {
        var unionInfo =  @(string.IsNullOrEmpty(Model.UnionInfo)? Html.Raw("[]") : Html.Raw(Model.UnionInfo));

        for (var key in unionInfo) {
             if (key == "EnterpriseName") {
                     $("#EnterpriseName").val(@Html.Raw(Json.Encode(Model.UnionName)));
             }
             else if (key == "EnterpriseNameUpperCase") {
                 $("#EnterpriseNameUpperCase").val(@Html.Raw(Json.Encode(Model.UnionName.ToUpper())));
             }
            else {
                if($("#UnionInfo input[name='"+key+"']").is(':radio') || $("#UnionInfo input[name='"+key+"']").is(':checkbox')){
                    $("#UnionInfo input[name='"+key+"'][value='"+unionInfo[key]+"']").prop('checked', true).trigger('change');
                }
                else{
                    $("#UnionInfo input[name='" + key + "'], #UnionInfo textarea[name='" + key +"']").val(unionInfo[key]);
                }
            }
        }
    });

    function _onChangeGender(eleName, eleViewAlias, name) {
        $(eleName).val(name);
        $(eleViewAlias).html(name);
    }
</script>