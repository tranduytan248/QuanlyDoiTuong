@using TSFramework.App.Processors
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Add"), AppProcessor.Messagor.GetMessage("ContractForm_Title"));
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    primary
}

@section FormIcon{
    <i class="fa fa-plus"></i>
}

@section FormBody{

    @*@using (Ajax.BeginForm("Add", "ContractForm", new { area = "Cate" }, new AjaxOptions
        {
            HttpMethod = "POST",
            OnSuccess = "ContractForm_OnProcessSuccess(data, 'AddContractForm')"
        }, new { @class = "form-horizontal", id = "AddContractForm" }))*@
    @using (Html.BeginForm("Add", "ContractForm", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", id = "AddContractForm" }))
    {
        <div id="bodyForm">
            @Html.Partial("_ContractForm")
        </div>
    }

    <script type="text/javascript">

        $('form#AddContractForm').ajaxForm({
            success: function (response) {
                if (response.status != undefined) {
                    if ($("#ModalContent #modal_AddContractForm #chkNotDismissModal").is(":checked")) {
                        if (response.status != undefined) {
                            eval(response.message);
                            _tableContractForm.ajax.reload(null, false);
                            response.status = undefined;
                            var urlAction = $("#ModalContent #modal_AddContractForm form").attr("action");
                            $("#ModalContent #modal_AddContractForm #modal-content").load(urlAction, function (data, textStatus, xhr) {
                                _initElement();
                            });
                        }
                    } else {
                        $("#ModalContent #modal_AddContractForm").modal("hide");
                        $("#ModalContent #modal_AddContractForm").on("hidden.bs.modal",
                            function () {
                                if (response.status != undefined) {
                                    eval(response.message);
                                    _tableContractForm.ajax.reload(null, false);
                                    response.status = undefined;
                                }
                            });
                    }
                } else {
                    $("#ModalContent #modal_AddContractForm #bodyForm").html(response);
                }
            }
        });
    </script>
}

@section ContinueForm{

}