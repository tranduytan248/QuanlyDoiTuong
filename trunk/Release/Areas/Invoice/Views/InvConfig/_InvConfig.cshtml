@using TSFramework.App.Processors
@model Core.Inv.Models.MajorInvConfigModel
@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(model => model.ConfigId)

<div id="InvConfig">
    @{
        if (Model.ConfigId == null || Model.ConfigId == Guid.Empty)
        {
            <div class="form-row">
                <div class="col-md-10">
                    @Html.TitleFor(model => model.ConfigKey, new { @class = "col-form-label pr-0 font-bold" })
                    @Html.TextBoxFor(model => model.ConfigKey, new { @class = "form-control col-md-11", placeholder = AppProcessor.Messagor.GetMessage("InvConfig_Key") })
                    @Html.ValidationMessageFor(model => model.ConfigKey, "", new { @class = "text-danger" })
                </div>
            </div>
        }
        else
        {
            <div class="form-row">
                <div class="col-md-10">
                    @Html.TitleFor(model => model.ConfigKey, new { disabled = true, @class = "col-form-label pr-0 font-bold" })
                    @Html.TextBoxFor(model => model.ConfigKey, new { @class = "form-control col-md-11", placeholder = AppProcessor.Messagor.GetMessage("InvConfig_Key") })
                    @Html.HiddenFor(model => model.ConfigKey)
                    @Html.ValidationMessageFor(model => model.ConfigKey, "", new { @class = "text-danger" })
                </div>
            </div>
        }
    }

    <div class="form-row">
        <div class="col-md-12">
            @Html.TitleFor(model => model.ConfigValue, new { @class = "col-form-label pr-0 font-bold" })
            @Html.TextAreaFor(model => model.ConfigValue, new { rows = 5, @class = "form-control col-md-11", placeholder = AppProcessor.Messagor.GetMessage("InvConfig_Value") })
            @Html.ValidationMessageFor(model => model.ConfigValue, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-row">
        <div class="col-md-11">
            @Html.TitleFor(model => model.ConfigDesc, new { @class = "col-form-label pr-0 font-bold" })
            @Html.TextAreaFor(model => model.ConfigDesc, new { rows = 3, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("InvConfig_Desc") })
            @Html.ValidationMessageFor(model => model.ConfigDesc, "", new { @class = "text-danger" })
        </div>
    </div>

</div>
