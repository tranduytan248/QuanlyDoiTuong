@using TSFramework.App.Processors
@model Cores.Major.Models.MajorDossierTaskModel

@Html.HiddenFor(model => model.ProcUnionId)
@Html.HiddenFor(model => model.AllowChangeHandler)
@Html.HiddenFor(model => model.UnionHandle)
@Html.HiddenFor(model => model.UnionHandleName)

<div class="card ccard" id="StepChangeHandles">
    <div class="card-header">
        <h5 class="card-title text-120 text-primary-d2">
            <i class="fas fa-user-check"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Step_AssigneeToHandler")
        </h5>

        <div class="card-toolbar">

            <div class="card-toolbar no-border">
                <a href="#" data-action="toggle" class="card-toolbar-btn btn btn-sm radius-1 btn-outline-default mx-2px">
                    <i class="fa fa-angle-double-up w-2 mx-1px"></i>
                </a>
            </div>
        </div>
    </div><!-- /.card-header -->
    <ul class="nav nav-tabs nav-tabs-simple nav-tabs-scroll border-b-1 brc-dark-l3 mx-0 mx-md-0 px-3 px-md-1 pt-2px" role="tablist">
        @{
            var lstErrKeys = ViewData.ModelState.Where(v => v.Value.Errors.Any()).Select(v => v.Key).ToList();
            
            for (int idx = 0; idx < Model.ListStepsChangeHandler.Count; idx++)
            {
                if (lstErrKeys.Contains($"{Html.NameFor(model => model.ListStepsChangeHandler[idx].UnionId)}") || lstErrKeys.Contains($"{Html.NameFor(model => model.ListStepsChangeHandler[idx].StaffId)}"))
                {
                    <li class="nav-item mr-1">
                        <a class="nav-link @(idx == 0 ? "active" : "")  p-3 bgc-h-danger-l4 radius-0 text-danger-d1" id="step@(Model.ListStepsChangeHandler[idx].StepId)-tab-btn" data-toggle="tab" href="#step@(Model.ListStepsChangeHandler[idx].StepId)" role="tab" aria-controls="step@(Model.ListStepsChangeHandler[idx].StepId)" aria-selected="true">
                            <i class="fas fa-tasks  text-danger-d1 mr-3px"></i>
                            @Model.ListStepsChangeHandler[idx].StepName (*)
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item mr-1">
                        <a class="nav-link @(idx == 0 ? "active" : "")  p-3 bgc-h-primary-l4 radius-0" id="step@(Model.ListStepsChangeHandler[idx].StepId)-tab-btn" data-toggle="tab" href="#step@(Model.ListStepsChangeHandler[idx].StepId)" role="tab" aria-controls="step@(Model.ListStepsChangeHandler[idx].StepId)" aria-selected="true">
                            <i class="fas fa-tasks text-success mr-3px"></i>
                            @Model.ListStepsChangeHandler[idx].StepName
                        </a>
                    </li>
                }
            }
        }

    </ul>

    <div class="card-body px-0 py-2">
        <div class="tab-content tab-sliding border-0 px-0" style="min-height: calc(90vh - 300px);">
            @{
                for (int idx = 0; idx < Model.ListStepsChangeHandler.Count; idx++)
                {
                    @Html.HiddenFor(model => model.ListStepsChangeHandler[idx].DossierId)
                    @Html.HiddenFor(model => model.ListStepsChangeHandler[idx].TaskId)
                    @Html.HiddenFor(model => model.ListStepsChangeHandler[idx].StepId)
                    @Html.HiddenFor(model => model.ListStepsChangeHandler[idx].StepName)
                    @Html.HiddenFor(model => model.ListStepsChangeHandler[idx].StepDesc)

                    <div class="@(Model.ListStepsChangeHandler[idx].StepId) tab-pane @(idx == 0 ? "show active" : "") px-25" id="step@(Model.ListStepsChangeHandler[idx].StepId)" role="tabpanel" aria-labelledby="step@(Model.ListStepsChangeHandler[idx].StepId)-tab-btn">
                        <div class="form-group row">
                            <div class="col-md-8">
                                <label class="">
                                    @Html.CheckBoxFor(model => model.ListStepsChangeHandler[idx].AllowSwitchHandler, new { @class = "checkbox mr-2" })
                                    @Html.LabelFor(model => model.ListStepsChangeHandler[idx].AllowSwitchHandler, AppProcessor.Messagor.GetMessage("Step_AllowSwitchHandler"), new { @class = "font-bold" })
                                </label>
                            </div>
                        </div>
                        <hr class="border-none border-t-3 brc-grey-l2 border-double" />

                        <div class="form-group row">
                            <div class="col-12 mt-4 mt-lg-0">

                                @Html.ValidationMessageFor(model => model.ListStepsChangeHandler[idx].UnionId, "", new { @class = "text-danger d-block mb-1" })
                                @Html.ValidationMessageFor(model => model.ListStepsChangeHandler[idx].StaffId, "", new { @class = "text-danger d-block mb-1" })

                                <div class="card ccard radius-t-0 h-100">
                                    <div class="position-tl w-102 border-t-3 brc-primary-tp3 ml-n1px mt-n1px"></div><!-- the blue line on top -->

                                    <div class="card-header brc-secondary-l3 pb-3">
                                        <h5 class="card-title mb-2 mb-md-0 text-danger-m3">
                                            @AppProcessor.Messagor.GetMessage("Staff_Handle_Title") (*)
                                        </h5>

                                        <div class="card-toolbar no-border pl-0 pl-md-2">
                                        </div>
                                    </div>

                                    <div class="card-body bgc-white p-0 pb-15">
                                        <div class="form-group row my-3">
                                            <label class="col-sm-2 col-form-label text-sm-right pr-0 font-bold">@AppProcessor.Messagor.GetMessage("Department_Title")</label>
                                            <div class="col-md-6">
                                                @Html.SelectFor(model => model.ListStepsChangeHandler[idx].UnionId, Model.ListUnions, "", new { @class = "form-control col-md-12 none-select2", onchange = $"_onLoadStaffViaUnion(this, '#step{idx}_Staffs','{Html.NameFor(model => model.ListStepsChangeHandler[idx].StaffId)}','#{Html.IdFor(model => model.ListStepsChangeHandler[idx].StaffName)}', '{Html.NameFor(model => model.ListStepsChangeHandler[idx].UnionName)}', '{Model.ListStepsChangeHandler[idx].StaffId}')" })
                                                @Html.HiddenFor(model => model.ListStepsChangeHandler[idx].UnionName)
                                            </div>
                                        </div>

                                        <hr class="border-none border-t-3 brc-grey-l2 border-double">

                                        <div class="card-body pt-2 pb-1" id="step@(idx)_Staffs">
                                            @{
                                                foreach (var staff in Model.ListStaffs)
                                                {
                                                    <div class="task-item d-flex align-items-center border-t-1 bgc-h-green-l3 brc-secondary-l3 px-2">
                                                        <label class="">
                                                            <input name="@Html.NameFor(model => model.ListStepsChangeHandler[idx].StaffId)" type="radio" class="align-middle ml-2 mr-25" onchange="_onSelectedStaff('@Html.IdFor(model => model.ListStepsChangeHandler[idx].StaffName)','@staff.FullName')" id="@(Model.ListStepsChangeHandler[idx].StepId).staff-@staff.UserName" value="@staff.UserName" />
                                                        </label>

                                                        <label class="flex-grow-1 mr-3 py-3 text-105 text-500" for="@(Model.ListStepsChangeHandler[idx].StepId).staff-@staff.UserName">
                                                            <span class="align-middle">
                                                                @staff.FullName
                                                            </span>
                                                        </label>

                                                        <span class="badge bgc-danger-l3 border-r-2 radius-r-0 brc-danger-m2 text-danger-d1 ml-1 mr-2 text-90">
                                                            @staff.PositionName
                                                        </span>
                                                    </div>
                                                }
                                            }
                                        </div>
                                        @Html.HiddenFor(model => model.ListStepsChangeHandler[idx].StaffName)

                                    </div><!-- /.card-body -->
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

        </div>
    </div>
</div><!-- /.card -->

<script type="text/javascript">

    //debugger;

    $(document).ready(function () {

        setTimeout(function () {
            $.each($('#StepChangeHandles .tab-pane.active select'), function (idx, selc) {
                _initSelect($(selc));
                $(selc).trigger("change");
            });
            $('#StepChangeHandles .tab-pane select').trigger("change");
        }, 1000);

        $('#StepChangeHandles a[data-toggle="tab"]').on('shown.bs.tab', function () {
            var tabActivePanel = $(this).attr("href");

            _initSelect(tabActivePanel + " select[id*=UnionId]");

            //_initSelect(tabActivePanel + " select[id*=DeptHandle]");
            //_initSelect(tabActivePanel + " select#PositionId");
        });
    });

    function _onLoadStaffViaUnion(cbbUnions, eleStaffs, eleNameStaff, eleStaffName, eleUnionName, staffId) {

        $('[name="' + eleUnionName +'"]').val($(cbbUnions).children("optgroup").children("option:selected").text());
        var unionId = $(cbbUnions).val();

        var urlStaffsViaUnionAndPosition ="@Url.Action("StaffsViaUnion", "Dossier", new { area = "Major" })?unionId=" + unionId;

        $.ajax({
            type: "GET",
            url: urlStaffsViaUnionAndPosition,
            dataType: "JSON",
            success: function (response) {
                $(eleStaffs).empty();
                $.each(response, function (index, staff) {
                    var staffHtmlTemplate = '<div class="task-item d-flex align-items-center border-t-1 bgc-h-green-l3 brc-secondary-l3 px-2"><label class=""><input name="{0}" type="radio" class="align-middle ml-2 mr-25" id="{0}.staff-{2}" value="{2}" onchange="_onSelectedStaff(\'{1}\',\'{3}\')" /></label><label class="flex-grow-1 mr-3 py-3 text-105 text-500" for="{0}.staff-{2}"><span class="align-middle">{3}</span></label><span class="badge bgc-danger-l3 border-r-2 radius-r-0 brc-danger-m2 text-danger-d1 ml-1 mr-2 text-90">{4}</span></div >'.format(eleNameStaff, eleStaffName, staff.UserName, staff.FullName, staff.PositionName);
                    $(eleStaffs).append(staffHtmlTemplate);
                });
                if (staffId != null && staffId != undefined && staffId.length > 0) {
                    $('[name="{0}"][value="{1}"]'.format(eleNameStaff, staffId)).prop('checked', true);
                }
            }
        });
    }

    function _onSelectedStaff(eleStaffName,staffName) {
        $(eleStaffName).val(staffName);
    }

</script>