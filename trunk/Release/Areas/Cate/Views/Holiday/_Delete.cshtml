@using TSFramework.App.Processors
@model Cores.Cate.Models.CateHolidayModel
@{
    ViewBag.Title = string.Format(AppProcessor.Messagor.GetMessage("Modal_Title_Delete"), AppProcessor.Messagor.GetMessage("Holiday_Title"));
    Layout = "~/Views/Shared/_FormConfirm.cshtml";
}

@section FormType{
    danger
}

@section FormBody{

    @using (Ajax.BeginForm("Delete", "Holiday", new { area = "Cate" }, new AjaxOptions
    {
        HttpMethod = "POST",
        OnSuccess = "Holiday_OnProcessSuccess(data, 'DeleteHoliday')"
    }, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.HolidayId)
        @Html.HiddenFor(model => model.HolidayName)
        @Html.HiddenFor(model => model.IsPermanent)
        @Html.HiddenFor(model => model.IsLunarCalendar)
        <h5> @Html.Raw(ViewBag.ConfirmMessage)</h5>
    }
}