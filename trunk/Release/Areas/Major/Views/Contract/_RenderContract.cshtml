@using TSFramework.App.Processors
@model Cores.Major.Models.MajorContractModel

@{
    ViewBag.Title = Html.Raw($"{AppProcessor.Messagor.GetMessage("Contract_Title")} - {Model.ContractTypeName} [{Model.ContractNo}/{Model.ContractSignal}]");
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    info
}

@section FormIcon{
    <i class="fas fa-eye"></i>
}

@section FormBody{
    <div class="row modal-body py-0" id="bodyForm">
        <div class="col-12">
            <a class="btn px-4 btn-outline-success mb-1" onclick="_onDownloadDoc(this);" href="@Url.Action("RenderContract", "Contract", new{ renderId = Model.RenderContractId}, Request.Url.Scheme)"><i class="fas fa-cloud-download-alt"></i>&nbsp;@AppProcessor.Messagor.GetMessage("Button_Download")</a>

            <a href="javascript:void(0);" onclick="_onFullscreen();" class="btn px-4 btn-outline-primary mb-1">
                <i class="fa fa-expand d-n-active"></i> Toàn màn hình
            </a>
        </div>
        <div class="col-12 table-responsive-md" id="DocViewer">
            <div class="bs-card-loading-overlay" id="loadingOverlay">
                <i class="bs-card-loading-icon fa fa-spinner fa-spin fa-2x text-white"></i>
            </div>
            <iframe id="previewFrame" width='100%' height='100%' style="min-height:calc(100vh - 250px);" frameborder='0'></iframe>
        </div>
    </div>

    <script type="text/javascript">

        var appViewerUrl = "@Html.Raw(ViewBag.AppViewerUrl)";
        @*var docUrl = appViewerUrl.format("@Html.Raw(Url.Action("RenderContract", "Contract", new{ renderId = Model.RenderContractId, contractId = Model.ContractId, contractNoInfo = Model.ContractNoInfo, includeQRCode = Model.IncludeQRCode, fileType = ".docx" }, Request.Url.Scheme))");*@

        var docUrl = appViewerUrl.format("@Html.Raw(Url.Action("RenderContract", "Contract", new{ renderId = Model.RenderContractId }, Request.Url.Scheme))");

        $(document).ready(function () {

            @{
                if (Model.FileType == ".pdf")
                {
                    @Html.Raw("$.ajax({url:'"+ Html.Raw(Url.Action("RenderContract", "Contract", new { renderId = Model.RenderContractId })) + "',type:'GET',xhrFields:{responseType:'blob'},success:function(e){var r=URL.createObjectURL(e);$(\"#previewFrame\").attr(\"src\",r),_onFullscreen()},error:function(e,r,s){console.error(e.responseText)}});");
                }
                else
                {
                    @Html.Raw("$(\"#DocViewer iframe\").attr(\"src\",docUrl),$(\"#DocViewer iframe\").on(\"load\",(function(){_endWaiting(),_onFullscreen()}));");
                }
            }

            @*$.ajax({
                url: "@Html.Raw(Url.Action("RenderContract", "Contract", new { contractId = Model.ContractId, contractNoInfo = Model.ContractNoInfo, includeQRCode = Model.IncludeQRCode, fileType=".pdf" }))",
                type: "POST",
                xhrFields: {
                    responseType: 'blob' // Xác định kiểu dữ liệu nhận được là Blob
                },
                success: function (data) {
                    var blobUrl = URL.createObjectURL(data); // Tạo URL cho Blob
                    $("#previewFrame").attr("src", blobUrl); // Gán URL cho iframe
                    _onFullscreen();
                },
                error: function (xhr, status, error) {
                    console.error(xhr.responseText);
                }

            });*@


        });

        function _onFullscreen() {
            var iframe = document.querySelector('#previewFrame');
            if (iframe.requestFullscreen) {
                iframe.requestFullscreen();
            } else if (iframe.webkitRequestFullscreen) {
                iframe.webkitRequestFullscreen();
            } else if (iframe.mozRequestFullScreen) {
                iframe.mozRequestFullScreen();
            } else if (iframe.msRequestFullscreen) {
                iframe.msRequestFullscreen();
            }
            $("#loadingOverlay").remove();
        }
    </script>
}
@section SubmitControl{

}