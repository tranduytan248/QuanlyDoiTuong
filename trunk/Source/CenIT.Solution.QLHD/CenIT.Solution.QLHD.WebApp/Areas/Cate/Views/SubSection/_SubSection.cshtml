@using TSFramework.App.Processors
@model Cores.Cate.Models.CateSubSectionModel

@Html.AntiForgeryToken()
@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(model => model.SubSectionId)
@Html.HiddenFor(model => model.Cate_MainSectionId)
@Html.HiddenFor(model => model.MainSectionName)
<div id="SubSection">
    <div class="form-group row col-md-12">
        @Html.TitleFor(model => model.SubSectionName, new { @class = "col-md-12 col-form-label pr-0 font-bold" })
        <div class="col-md-12">
            @Html.TextAreaFor(model => model.SubSectionName, new { rows = 3, @class = "form-control col-md-12", placeholder = AppProcessor.Messagor.GetMessage("SubSection_Label_Name") })
            @Html.ValidationMessageFor(model => model.SubSectionName, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-6">
            @Html.TitleFor(model => model.Unit, new { @class = "col-md-12 col-form-label pr-0 font-bold" })
            <div class="col-md-12">
                @Html.TextBoxFor(model => model.Unit, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Price_Label_Unit") })
                @Html.ValidationMessageFor(model => model.Unit, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-6">
            @Html.TitleFor(model => model.Price, new { @class = "col-md-12 col-form-label pr-0 font-bold" })
            <div class="col-md-12">
                @Html.TextBoxFor(model => model.Price, new { @class = "form-control", placeholder = AppProcessor.Messagor.GetMessage("Price_Label_UnitPrice"), type = "number", id = "soTienInput", oninput = "formatNumber()" })
                <p id="UnitPriceCost" class="text-danger-d1 text-500 text-105 m-2"></p>
                @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    window.onload = formatNumber()
    document.addEventListener("DOMContentLoaded", function () {
        var inputElement = document.getElementById("soTienInput");
        var isUserInput = false; // Biến trạng thái để theo dõi sự kiện người dùng

        inputElement.addEventListener("keyup", function (event) {
            if (isUserInput) {
                var inputValue = event.target.value;
                var formattedValue = formatNumber(inputValue);
                event.target.value = formattedValue;
            } else {
                isUserInput = true;
            }
        });
    });

    function formatNumber() {
        var number = document.getElementById("soTienInput").value;
        // Xử lý số và định dạng ở đây
        var cost = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(number)
        document.getElementById('UnitPriceCost').innerHTML = cost
    }
</script>
