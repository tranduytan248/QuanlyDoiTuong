@using TSFramework.App.Processors
@model Modules.Major.Areas.Major.Models.SearchCustomerModel

@{
    ViewBag.Title = Html.Raw($"{AppProcessor.Messagor.GetMessage("Button_Search")} {AppProcessor.Messagor.GetMessage("Customer_Title")}");
    Layout = "~/Views/Shared/_Form.cshtml";
}

@section FormType{
    info
}

@section FormIcon{
    <i class="fas fa-user-tie"></i>
}

@section FormBody{
    <div class="row" id="bodyForm">
        <div class="col-md-12">
            @Html.Partial("_SearchCus")
        </div>
        <div class="col-md-12">
            <div class="mt-3">
                <div class="card dcard">
                    <div class="p-2 table-responsive-md">
                        <table id="Customers" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table" width="100%">
                            <thead class="sticky-nav text-secondary-m1 text-uppercase text-85">
                                <tr>
                                    <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                                    <th>@AppProcessor.Messagor.GetMessage("Customer_Label_CusName")</th>
                                    <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        //debugger;

        var _CustomerActionURLs = {
            Customer_GetData: "@Url.Action("GetListCustomer", "Contract", new { area = "Major" })"
        };
        var _tableCustomer;
        $(document).ready(function () {
            initTableCustomer();
        });

        function initTableCustomer() {
            _tableCustomer = $("#Customers").DataTable({
                "Responsive": true,
                "language": {
                    "processing": '<div id="tableLoading" class="pageload-overlay show pageload-loading" data-opening="M 0,0 80,-10 80,60 0,70 0,0" data-closing="M 0,-10 80,-20 80,-10 0,0 0,-10" style=""><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 80 60" preserveAspectRatio="none"><path d="M 0,70 80,60 80,80 0,80 0,70"></path></svg></div>'
                        //"<div class='overlay'><i class='fas fa-cog fa-spin'></i></div>"
                },
                //"scrollCollapse": true,
                //"scrollY": '40vh',
                "lengthChange": false,
                "info": false,
                "pageLength": 50,
                "searching": false,
                "processing": true,
                "serverSide": true,
                "autoWidth": false,
                "ordering": false,
                "ajax":
                {
                    "url": _CustomerActionURLs.Customer_GetData,
                    "type": "POST",
                    "dataType": "JSON",
                    "data": {
                        "Keyword": function () {
                            return $("#Search #Keyword").val() != null &&
                                $("#Search #Keyword").val().length > 0
                                ? $("#Search #Keyword").val()
                                : "";
                        },
                        "TypeCus": function () {
                            return $("#Search #TypeCus").val() != null &&
                                $("#Search #TypeCus").val().length > 0
                                ? $("#Search #TypeCus").val()
                                : "";
                        },
                    }
                },
                "columns": [
                    {
                        "data": "",
                        "className": "text-center",
                        "defaultContent": "1",
                        "render": function (data, type, row, meta) {
                            return meta.row + 1;
                        }
                    },
                    {
                        "data": "CusName",
                        "defaultContent": "",
                        "render": function (data, type, row, meta) {
                            if (type == 'display') {
                                var arrTypeCus = { "CONSUMER": "info", "BUSINESS": "success" };
                                var arrTypeCusName = { "CONSUMER": "Cá nhân", "BUSINESS": "Doanh nghiệp" };

                                return '<span class="text-100 text-600">{0}</span> <div class="mt-2"><span class="d-table badge bgc-{1} brc-{1} text-white badge-lg arrowed arrowed-in-right mb-1"><span class="px-2">{2}</span></span><span class="d-table badge radius-2 bgc-white border-1 brc-default-m2 btn-text-default text-95 px-2 py-1 m-2px"><span class="pos-rel">{3}</span></span><span class="d-inline-block badge radius-2 bgc-white border-1 brc-red-m2 btn-text-red text-95 px-2 py-1 m-2px text-500"><i class="fa fa-phone text-danger"></i> {4}</span>{5}</div>'.format(data, arrTypeCus[row.TypeCus], arrTypeCusName[row.TypeCus], row.Address, row.Phone, (row.TypeCus === 'CONSUMER' ? (row.IdentifierNo != null && row.IdentifierNo.length > 0 ? '<span class="badge badge-info badge-lg arrowed-in-right mb-1">{0}</span><span class="badge btn-pink badge-lg arrowed ml-n1 mb-1">{1}</span>'.format(row.TypeIdentifierName, row.IdentifierNo) : "") : (row.TaxCode != null && row.TaxCode.length > 0 ? '<span class="badge badge-info badge-lg arrowed-in-right mb-1">{0}</span><span class="badge btn-pink badge-lg arrowed ml-n1 mb-1">{1}</span>'.format("@AppProcessor.Messagor.GetMessage("Customer_TaxCode")", row.TaxCode) : "")));
                            }

                            return data;
                        }
                    },
                    {
                        "data": "CusId",
                        "style": "width:100px;",
                        "orderable": false,
                        "render": function (data, type, row, meta) {
                            var html = '<span class="d-none d-lg-inline">';
                            if (type === "display") {
                                html = '<button onclick="selectCus(' + meta.row +')" class="btn px-4 btn-lighter-success mr-1 v-hover" title="Chọn" data-rel="tooltip"><i class="fa fa-check-circle text-success text-120"></i></button>'
                            }
                            html += "</span>";

                            return html;
                        }
                    }
                ]
            });

            $('#Customers tbody').on('click', 'tr', function () {
                var rowIdx = _tableCustomer.row(this).index();
                selectCus(rowIdx);
            });
        }

        function ContractCustomer_OnProcessSuccess(response, formId) {
            if (response.status != undefined) {
                if ($("#ModalContent #modal_" + formId + " #chkNotDismissModal").is(":checked")) {
                    if (response.status != undefined) {
                        eval(response.message);
                        _tableCustomer.ajax.reload(null, false);
                        response.status = undefined;
                        var urlAction = $("#ModalContent #modal_" + formId + " form").attr("action");
                        $("#ModalContent #modal_" + formId + " #modal-content").load(urlAction, function (data, textStatus, xhr) {
                            _initElements(this);
                        });
                    }
                } else {
                    $("#ModalContent #modal_" + formId).modal("hide");
                    $("#ModalContent #modal_" + formId).on("hidden.bs.modal",
                        function () {
                            if (response.status != undefined) {
                                eval(response.message);
                                _tableCustomer.ajax.reload(null, false);
                                response.status = undefined;
                            }
                        });
                }
            } else {
                $("#ModalContent #modal_" + formId + " #bodyForm").html(response).promise().done(function () {_initElements(this);});
            }
        }

        function selectCus(rowIdx) {
            var cusData = _tableCustomer.rows().data()[rowIdx];

            var cusPrefix = "@(Model.PrefixCus ?? "")";
            var cusInfo = $("input[type='hidden'][id='CusInfo']").val();
            var arrCusInfos = cusInfo.split(';');
            $.each(arrCusInfos, function (idx, cusInfo) {
                if (cusPrefix.length > 0) {
                    if ($('[name="' + cusPrefix + cusInfo + '"]').is("input[type='text']") ||
                        $('[name="' + cusPrefix + cusInfo + '"]').is("input[type='hidden']") ||
                        $('[name="' + cusPrefix + cusInfo + '"]').is("textarea")) {
                        $('[name="' + cusPrefix + cusInfo + '"]').val(cusData[cusInfo]).trigger('change');
                    }
                    else if ($('[name="' + cusPrefix + cusInfo + '"]').is("input[type='radio']") ||
                        $('[name="' + cusPrefix + cusInfo + '"]').is("input[type='checkbox']")) {
                        $('[name="' + cusPrefix + cusInfo + '"][value="' + cusData[cusInfo] + '"]').prop('checked', true);
                    }
                }
            });

            // Đóng modal
            $("#ModalContent #modal_FindCustomer").modal("hide");
        }

    </script>
}
@section SubmitControl{

}