@using TSFramework.App.Processors
@{
    ViewBag.Title = AppProcessor.Messagor.GetMessage("Invoice_Title");
}

@section HeadCss{
    <style type="text/css">
        .max-width-280 {
            max-width: 280px;
        }
    </style>
}

@section PageTitle
{
    @ViewBag.Title
}

@section PageAction
{
    
}
<div class="mt-3">
    @Html.Partial("_Search")
</div>
<div class="mt-3">
    <div class="card dcard">
        <div class="p-2 table-responsive-md">
            <table id="DSInvoice" class="d-style w-100 table text-dark-m1 text-95 border-y-1 brc-black-tp11 collapsed dtr-table dtr-inline" width="100%">
                <thead class="sticky-nav text-secondary-m1 text-uppercase text-85 bgc-secondary-l1">
                    <tr>
                        <th>@AppProcessor.Messagor.GetMessage("Column_No")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Inv_InvNo")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_Name")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Customer_Code")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Inv_Type")</th>
                        <th>@AppProcessor.Messagor.GetMessage("InvPattern_Status")</th>
                        <th>@AppProcessor.Messagor.GetMessage("Column_Action")</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section BottomScript
{
    <script src="@Url.Content("~/Areas/Invoice/Views/Inv/Inv.js")"></script>
}